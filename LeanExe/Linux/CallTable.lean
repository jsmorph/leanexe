/-- Whether a parameter gives an output region. -/
def Param.writes : Param → Bool
  | .output | .record _ => true
  | _ => false

/-- Every described call has at most one output region, which `step` writes. -/
theorem table_one_output : ∀ c ∈ table, (c.params.filter Param.writes).length ≤ 1 := by
  decide

theorem regions_openat {M : Type} (I : Memory M) (m : M) (x0 x1 x2 x3 : UInt64) :
    inputRegions I m [x0, x1, x2, x3] 0 openatCall.params = [(x1, I.pathLength m x1)] ∧
      outputRegions [x0, x1, x2, x3] 0 openatCall.params = [] := ⟨rfl, rfl⟩

theorem regions_close {M : Type} (I : Memory M) (m : M) (x0 : UInt64) :
    inputRegions I m [x0] 0 closeCall.params = [] ∧
      outputRegions [x0] 0 closeCall.params = [] := ⟨rfl, rfl⟩

