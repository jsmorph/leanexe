import LeanExe.Native.Translate
import LeanExe.Native.Print

/-!
The C text of a translated module: the printer of `Print.lean` with the names of the
translation's globals and functions, the names of `tempName` for temporaries, and the call
temporaries of `callId`, which the text leaves to `clightgen` to create.
-/

namespace LeanExe.Native

open LClight

def isCallTemp (id : ident) : Bool := id % 8 == 6

/-- The C name of a global or function of the translation. -/
def Translation.gname (t : Translation) (id : ident) : String :=
  (t.names.lookup id).getD s!"lx_unnamed_{id}"

/-- Whether the code of `f` begins with the test of the call depth that the verified compiler puts
at the start of a function that takes the depth, `guardCode` of `Verified/Compile.lean`: local 0, an
`i64` parameter, compared with 1,000, and `unreachable` when it is not below. -/
def takesDepth (f : Wasm.Function) : Bool :=
  match f.params, f.body with
  | .i64 :: _, .localGet 0 :: .constI64 1000 :: .geUI64 :: .iff 0 0 [.unreachable] [] [] [] :: _ =>
      true
  | _, _ => false

/-- The C names of the functions of the translation `t` of `m` that take the call depth. -/
def Translation.depthNames (t : Translation) (m : Wasm.Module) : List String :=
  t.funcs.filterMap fun k =>
    match m.funcs[k]? with
    | some f => if takesDepth f then some (t.gname (funId k)) else none
    | none => none

def Translation.text (t : Translation) : Except String String := do
  let body ← LeanExe.Native.cprogram t.gname tempName isCallTemp t.cprogram
  pure ("/* Generated by LeanExe's translator from WebAssembly to C. */\n" ++ body)

end LeanExe.Native
