/-- Hankel's expansion truncated to degree 26 with dyadic coefficients. -/
def casym : AsymPiece where
  X := asym.X
  A := [1, 0, 15 / 2 ^ 7, 0, -4725 / 2 ^ 15, 0, 2837835 / 2 ^ 22, 0, -14783093325 / 2 ^ 31, 0, 2089035875489 / 2 ^ 34, 0, -886446969205 / 2 ^ 28, 0, 66920787553 / 2 ^ 19, 0, -213003767 / 2 ^ 5, 0, 7204457605 / 2 ^ 4, 0, -38338575200, 0, 4011838599168, 0, -506056850538496, 0, 75726164512997376]
  B := [0, 3 / 2 ^ 3, 0, -105 / 2 ^ 10, 0, 72765 / 2 ^ 18, 0, -66891825 / 2 ^ 25, 0, 468131288625 / 2 ^ 34, 0, -648372640333 / 2 ^ 30, 0, 330819451849 / 2 ^ 24, 0, -3646660103 / 2 ^ 12, 0, 3398663047 / 2 ^ 6, 0, -4043620325, 0, 382701134592, 0, -44064814202880, 0, 6065091359277056, 0]
  m := asym.m

theorem asym_close : absSum (1 / asym.X) (subP asym.A casym.A) ≤ 1 / 2 ^ 72 ∧
    absSum (1 / asym.X) (subP asym.B casym.B) ≤ 1 / 2 ^ 72 := by
  decide +kernel

theorem near_seg (q : Piece × Piece) (hq : segOk q = true) (hpc : q.1 ∈ pieces ++ [last]) (x : ℝ)
    (hx : x ∈ Icc (q.2.a : ℝ) q.2.b) :
    |P1 x - q.2.fA x| ≤ 1 / 2 ^ 70 ∧ |Q1 x - q.2.fB x| ≤ 1 / 2 ^ 70 := by
  simp only [segOk, Bool.and_eq_true, decide_eq_true_eq] at hq
  obtain ⟨⟨⟨hok, hab⟩, hA⟩, hB⟩ := hq
  obtain ⟨-, -, hca, hbc⟩ := ok_facts hok
  have ha : (q.1.a : ℝ) ≤ q.2.a := by exact_mod_cast hab.1
  have hb' : (q.2.b : ℝ) ≤ q.1.b := by exact_mod_cast hab.2
  have hb := pieces_bound q.1 hpc x ⟨ha.trans hx.1, hx.2.trans hb'⟩
  have hH : (0 : ℚ) ≤ q.2.H := by
    exact_mod_cast (by linarith [hx.1, hx.2] : (0 : ℝ) ≤ q.2.H)
  have hxc : |x - q.2.c| ≤ ((q.2.H : ℚ) : ℝ) := by
    rw [abs_le]; constructor <;> linarith [hx.1, hx.2]
  have eA := abs_eval_le q.2.H hH (subP (shift (q.2.c - q.1.c) q.1.A) q.2.A) (x - q.2.c) hxc
  have eB := abs_eval_le q.2.H hH (subP (shift (q.2.c - q.1.c) q.1.B) q.2.B) (x - q.2.c) hxc
  have hd : (((q.2.c - q.1.c : ℚ)) : ℝ) + (x - q.2.c) = x - q.1.c := by push_cast; ring
  rw [eval_subP, eval_shift, hd] at eA eB
  have cA : ((absSum q.2.H (subP (shift (q.2.c - q.1.c) q.1.A) q.2.A) : ℚ) : ℝ) ≤ 1 / 2 ^ 71 :=
    le_trans (Rat.cast_le.mpr hA) (by norm_num)
  have cB : ((absSum q.2.H (subP (shift (q.2.c - q.1.c) q.1.B) q.2.B) : ℚ) : ℝ) ≤ 1 / 2 ^ 71 :=
    le_trans (Rat.cast_le.mpr hB) (by norm_num)
  have f1 : q.1.fA x = eval q.1.A (x - q.1.c) := rfl
  have f2 : q.1.fB x = eval q.1.B (x - q.1.c) := rfl
  have g1 : q.2.fA x = eval q.2.A (x - q.2.c) := rfl
  have g2 : q.2.fB x = eval q.2.B (x - q.2.c) := rfl
  constructor
  · calc |P1 x - q.2.fA x| ≤ |P1 x - q.1.fA x| + |q.1.fA x - q.2.fA x| := abs_sub_le _ _ _
      _ ≤ 1 / 2 ^ 80 + 1 / 2 ^ 71 := by
          have hb1 : |P1 x - eval q.1.A (x - q.1.c)| ≤ 1 / 2 ^ 80 := hb.1
          rw [f1, g1]; linarith
      _ ≤ 1 / 2 ^ 70 := by norm_num
  · calc |Q1 x - q.2.fB x| ≤ |Q1 x - q.1.fB x| + |q.1.fB x - q.2.fB x| := abs_sub_le _ _ _
      _ ≤ 1 / 2 ^ 80 + 1 / 2 ^ 71 := by
          have hb2 : |Q1 x - eval q.1.B (x - q.1.c)| ≤ 1 / 2 ^ 80 := hb.2
          rw [f2, g2]; linarith
      _ ≤ 1 / 2 ^ 70 := by norm_num

theorem near_asym (x : ℝ) (hx : 30 ≤ x) :
    |P1 x - casym.fA x| ≤ 1 / 2 ^ 70 ∧ |Q1 x - casym.fB x| ≤ 1 / 2 ^ 70 := by
  obtain ⟨hA, hB⟩ := asym_close
  have hb := asym_bound x hx
  have hX : ((asym.X : ℚ) : ℝ) = 30 := by norm_num [asym]
  have ht : |1 / x| ≤ ((1 / asym.X : ℚ) : ℝ) := by
    rw [abs_of_pos (by positivity)]; push_cast; rw [hX]
    exact one_div_le_one_div_of_le (by norm_num) hx
  have h0 : (0 : ℚ) ≤ 1 / asym.X := by norm_num [asym]
  have eA := abs_eval_le _ h0 (subP asym.A casym.A) (1 / x) ht
  have eB := abs_eval_le _ h0 (subP asym.B casym.B) (1 / x) ht
  rw [eval_subP] at eA eB
  have cA : ((absSum (1 / asym.X) (subP asym.A casym.A) : ℚ) : ℝ) ≤ 1 / 2 ^ 72 :=
    le_trans (Rat.cast_le.mpr hA) (by norm_num)
  have cB : ((absSum (1 / asym.X) (subP asym.B casym.B) : ℚ) : ℝ) ≤ 1 / 2 ^ 72 :=
    le_trans (Rat.cast_le.mpr hB) (by norm_num)
  constructor
  · calc |P1 x - casym.fA x| ≤ |P1 x - asym.fA x| + |asym.fA x - casym.fA x| := abs_sub_le _ _ _
      _ ≤ 1 / 2 ^ 80 + 1 / 2 ^ 72 := by
          have hb1 : |P1 x - eval asym.A (1 / x)| ≤ 1 / 2 ^ 80 := hb.1
          simp only [AsymPiece.fA]; linarith
      _ ≤ 1 / 2 ^ 70 := by norm_num
  · calc |Q1 x - casym.fB x| ≤ |Q1 x - asym.fB x| + |asym.fB x - casym.fB x| := abs_sub_le _ _ _
      _ ≤ 1 / 2 ^ 80 + 1 / 2 ^ 72 := by
          have hb2 : |Q1 x - eval asym.B (1 / x)| ≤ 1 / 2 ^ 80 := hb.2
          simp only [AsymPiece.fB]; linarith
      _ ≤ 1 / 2 ^ 70 := by norm_num

/-- One segment of a comparison with `pFd R S`. -/
theorem p_step (q : Piece × Piece) (hq : segOk q = true) (hpc : q.1 ∈ pieces ++ [last])
    (R S : List ℚ) (hR : R.length ≤ S.length + 1) (lo hi : ℚ) (sE sW e : ℕ) (L H : ℤ) (t : ℕ)
    (hs : isScaled sE (pE q.2 R S) = true ∧ isScaled sW (sTilde q.2.c S) = true)
    (hc : ratioCheckI (toInt sE (pE q.2 R S)) (toInt sW (sTilde q.2.c S)) sE sW 68 e L H t 12 = true)
    (hend : (L : ℚ) / 2 ^ t = lo - q.2.c ∧ (H : ℚ) / 2 ^ t = hi - q.2.c)
    (hsub : 0 < lo ∧ q.2.a ≤ lo ∧ hi ≤ q.2.b) (x : ℝ) (hx : x ∈ Icc (lo : ℝ) hi) :
    |P1 x - pFd R S x| ≤ (e : ℝ) / 2 ^ 68 + 1 / 2 ^ 70 := by
  have hs' : (0 : ℝ) < lo ∧ (q.2.a : ℝ) ≤ lo ∧ (hi : ℝ) ≤ q.2.b := by
    obtain ⟨h1, h2, h3⟩ := hsub
    exact ⟨by exact_mod_cast h1, by exact_mod_cast h2, by exact_mod_cast h3⟩
  have h1 := (near_seg q hq hpc x ⟨hs'.2.1.trans hx.1, hx.2.trans hs'.2.2⟩).1
  have h2 := p_piece q.2 R S hR sE sW 68 e L H t 12 hs.1 hs.2 hc x
    (ends lo q.2.c L t hend.1 x hx.1) (ends' hi q.2.c H t hend.2 x hx.2) (lt_of_lt_of_le hs'.1 hx.1)
  calc |P1 x - pFd R S x| ≤ |P1 x - q.2.fA x| + |q.2.fA x - pFd R S x| := abs_sub_le _ _ _
    _ ≤ (e : ℝ) / 2 ^ 68 + 1 / 2 ^ 70 := by linarith

/-- One segment of a comparison with `qFd q₀ R S`. -/
theorem q_step (q : Piece × Piece) (hq : segOk q = true) (hpc : q.1 ∈ pieces ++ [last])
    (R S : List ℚ) (hR : R.length ≤ S.length + 1) (lo hi : ℚ) (sE sW e : ℕ) (L H : ℤ) (t : ℕ)
    (hs : isScaled sE (qE (3 / 8) q.2 R S) = true ∧ isScaled sW (qW q.2 S) = true)
    (hc : ratioCheckI (toInt sE (qE (3 / 8) q.2 R S)) (toInt sW (qW q.2 S)) sE sW 68 e L H t 12 = true)
    (hend : (L : ℚ) / 2 ^ t = lo - q.2.c ∧ (H : ℚ) / 2 ^ t = hi - q.2.c)
    (hsub : 0 < lo ∧ q.2.a ≤ lo ∧ hi ≤ q.2.b) (x : ℝ) (hx : x ∈ Icc (lo : ℝ) hi) :
    |Q1 x - qFd (3 / 8) R S x| ≤ (e : ℝ) / 2 ^ 68 + 1 / 2 ^ 70 := by
  have hs' : (0 : ℝ) < lo ∧ (q.2.a : ℝ) ≤ lo ∧ (hi : ℝ) ≤ q.2.b := by
    obtain ⟨h1, h2, h3⟩ := hsub
    exact ⟨by exact_mod_cast h1, by exact_mod_cast h2, by exact_mod_cast h3⟩
  have h1 := (near_seg q hq hpc x ⟨hs'.2.1.trans hx.1, hx.2.trans hs'.2.2⟩).2
  have h2 := q_piece (3 / 8) q.2 R S hR sE sW 68 e L H t 12 hs.1 hs.2 hc x
    (ends lo q.2.c L t hend.1 x hx.1) (ends' hi q.2.c H t hend.2 x hx.2) (lt_of_lt_of_le hs'.1 hx.1)
  calc |Q1 x - qFd (3 / 8) R S x| ≤ |Q1 x - q.2.fB x| + |q.2.fB x - qFd (3 / 8) R S x| := abs_sub_le _ _ _
    _ ≤ (e : ℝ) / 2 ^ 68 + 1 / 2 ^ 70 := by linarith

theorem p_asym_step (R S : List ℚ) (sE sW e : ℕ)
    (hs : isScaled sE (pEa casym R S) = true ∧ isScaled sW (sAsym S) = true)
    (hc : ratioCheckI (toInt sE (pEa casym R S)) (toInt sW (sAsym S)) sE sW 68 e 0 35 10 12 = true)
    (x : ℝ) (hx : 30 ≤ x) : |P1 x - pFd R S x| ≤ (e : ℝ) / 2 ^ 68 + 1 / 2 ^ 70 := by
  have h1 := (near_asym x hx).1
  have h2 := p_asym casym R S sE sW 68 e 35 10 12 hs.1 hs.2 hc x (by linarith) (one_div_le x hx)
  calc |P1 x - pFd R S x| ≤ |P1 x - casym.fA x| + |casym.fA x - pFd R S x| := abs_sub_le _ _ _
    _ ≤ (e : ℝ) / 2 ^ 68 + 1 / 2 ^ 70 := by linarith

theorem q_asym_step (R S : List ℚ) (sE sW e : ℕ)
    (hs : isScaled sE (qEa (3 / 8) casym R S) = true ∧ isScaled sW (sAsym S) = true)
    (hc : ratioCheckI (toInt sE (qEa (3 / 8) casym R S)) (toInt sW (sAsym S)) sE sW 68 e 0 35 10 12 = true)
    (x : ℝ) (hx : 30 ≤ x) : |Q1 x - qFd (3 / 8) R S x| ≤ (e : ℝ) / 2 ^ 68 + 1 / 2 ^ 70 := by
  have h1 := (near_asym x hx).2
  have h2 := q_asym (3 / 8) casym R S sE sW 68 e 35 10 12 hs.1 hs.2 hc x (by linarith) (one_div_le x hx)
  calc |Q1 x - qFd (3 / 8) R S x| ≤ |Q1 x - casym.fB x| + |casym.fB x - qFd (3 / 8) R S x| := abs_sub_le _ _ _
    _ ≤ (e : ℝ) / 2 ^ 68 + 1 / 2 ^ 70 := by linarith

