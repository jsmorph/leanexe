+    /// Fixes the bytes of `value` at `address`, an expression over the solver's variables: an
+    /// untagged read of `value.len() / 8` bytes returns `value` when the solver proves the
+    /// read's address equal to `address`.
+    pub fn add_fixed(&mut self, address: Exp<Sym>, value: B, solver: &mut Solver<B>) -> Result<(), ExecError> {
+        let tcx: HashMap<Sym, Ty> =
+            address.variables().into_iter().filter_map(|v| Some((v, Ty::BitVec(solver.length(v)?)))).collect();
+        match address.infer(&tcx, &HashMap::new()) {
+            Some(Ty::BitVec(width)) => {
+                self.fixed.push((address, width, value));
+                Ok(())
+            }
+            _ => Err(ExecError::Type(format!("fixed memory address {:?}", address), SourceLoc::unknown())),
+        }
+    }
+
+    fn read_fixed(&self, address: &Val<B>, bytes: u32, solver: &mut Solver<B>) -> Result<Option<B>, ExecError> {
+        if self.fixed.is_empty() {
+            return Ok(None);
+        }
+        let (address, width) = match address {
+            Val::Bits(bv) => (crate::primop_util::smt_sbits(*bv), bv.len()),
+            Val::Symbolic(v) => match solver.length(*v) {
+                Some(width) => (Exp::Var(*v), width),
+                None => return Ok(None),
+            },
+            _ => return Ok(None),
+        };
+        for (entry, entry_width, value) in &self.fixed {
+            if *entry_width == width && value.len() == 8 * bytes {
+                let differs = Exp::Neq(Box::new(address.clone()), Box::new(entry.clone()));
+                match solver.check_sat_with(&differs, SourceLoc::unknown()) {
+                    SmtResult::Unsat => return Ok(Some(*value)),
+                    SmtResult::Unknown => return Err(ExecError::Z3Unknown),
+                    SmtResult::Sat => (),
+                }
+            }
+        }
+        Ok(None)
+    }
