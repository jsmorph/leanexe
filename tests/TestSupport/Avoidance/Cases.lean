def cases : IO Unit := do
  for (xs, n) in inputs do
    for m in [n, 64] do
      let ys := authorize xs.toArray m
      let result := ", ".intercalate (ys.toList.map fun y => toString y.toBits)
      line "avoidance" "authorize" "array-u64" [arrF xs, u m] s!"[{result}]"
  for b in boxes do
    match b with
    | [a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, r] =>
      for m in [64, 4096] do
        let p := Demos.Conjunction.pcBox a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 r m
        line "avoidance" "pcBox" "list:i64,f64,f64"
          ([a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, r].map fl ++ [u m])
          s!"{p.status} {p.lo.toBits} {p.hi.toBits}"
    | _ => pure ()

end TestSupport.Avoidance.Cases
