      Expr.evalResults_u64 (Expr.eval_mul (Expr.eval_get ((State.get_update_ne (state := s1) (j := 5) (index := 10) (by decide)).trans ((State.get_update_ne (state := start) (j := 5) (index := 9) (by decide)).trans (sg5)))) (Expr.eval_get ((State.get_update_ne (state := s1) (j := 6) (index := 10) (by decide)).trans ((State.get_update_ne (state := start) (j := 6) (index := 9) (by decide)).trans (sg6))))) <|
      Expr.evalResults_get ((State.get_update_ne (state := s1) (j := 7) (index := 10) (by decide)).trans ((State.get_update_ne (state := start) (j := 7) (index := 9) (by decide)).trans (sg7))) <|
      Expr.evalResults_nil)
    ⟨[.i64 ph], _, rfl, ⟨ph, rfl, (hLive2.tempsOwned _ (List.mem_cons_self ..)).borrowed⟩,
