    (x := (cache, nh * dh, (2 * layers + 1) * (nh * dh))) (afterArgs := start)
    (vals := [.i64 pCache, .i64 (nh * dh), .i64 ((2 * layers + 1) * (nh * dh))])
    (Expr.evalResults_get (sg0) <|
