    compile_funcs (funcs := gpt.funcs) (i := 25) rfl
  let x := lastHiddenTuple (cache, nh * dh, (2 * layers + 1) * (nh * dh))
  let h := layerNormRowsTuple (x, gf, bf, 0, 1, nh * dh, eps)
  let start : State :=
    { params := [.i64 pCache, .i64 pWte, .i64 pGf, .i64 pBf, .i64 layers, .i64 nh, .i64 dh, .i64 vocab,
        .f64 eps.toBits]
      locals := [.i64 0, .i64 0, .i64 0, .i64 0] }
  have hStart : start.params.length + start.locals.length = 13 := rfl
  have hLen : ∀ (s : State) (j : Nat) (v : Value),
      (s.update j v).params.length + (s.update j v).locals.length =
        s.params.length + s.locals.length := fun s j v => by
    simp [State.update_params_length, State.update_locals_length]
  have sg0 : start.get 0 = some (.i64 pCache) := rfl
  have sg1 : start.get 1 = some (.i64 pWte) := rfl
  have sg2 : start.get 2 = some (.i64 pGf) := rfl
  have sg3 : start.get 3 = some (.i64 pBf) := rfl
  have sg4 : start.get 4 = some (.i64 layers) := rfl
