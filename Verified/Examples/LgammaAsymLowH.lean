/-- The fit within `(1 / 2 ^ 87)` of `lgamma`, relative, on the pieces' interval. -/
theorem cover : ∀ x : ℝ, ((14705968021503 : ℝ) / 2 ^ 40) ≤ x →
    x ≤ ((14705968021503 : ℝ) / 2 ^ 40) + 2 * ((1 : ℝ) / 16) * 11 →
    |lgamma x - fit c0Asym pAsym x| ≤ (1 / 2 ^ 87) * lgamma x := by
  refine cover_pieces (K := 11) (by norm_num) (lo := ((14705968021503 : ℝ) / 2 ^ 40))
    (r := ((1 : ℝ) / 16)) (by norm_num)
    (fun x => |lgamma x - fit c0Asym pAsym x| ≤ (1 / 2 ^ 87) * lgamma x) ?_
  intro j hj t ht
  interval_cases j
  · have e : ((14705968021503 : ℝ) / 2 ^ 40) +
        ((1 : ℝ) / 16) * (2 * ((0 : ℕ) : ℝ) + 1) + t =
        (((14774687498239 / 2 ^ 40) : ℚ) : ℝ) + t := by
      norm_num
    rw [e]
    have h := piece_rel 9 3 _ _ _ _ _ (14774687498239 / 2 ^ 40)
      (14705968021503 / 2 ^ 40) c0Asym
      (1508888130316050847 / 2 ^ 56) (1508888130316050847 / 2 ^ 106)
      (702630789 / 2 ^ 112) (1 / 2 ^ 87) pAsym
      0 f_0 p_0 (by norm_num) (by norm_num [cfgF]) (by norm_num) (by norm_num) t
      (by simp only [cfgF]; push_cast; exact ht)
    push_cast at h ⊢
    exact h
  · have e : ((14705968021503 : ℝ) / 2 ^ 40) +
        ((1 : ℝ) / 16) * (2 * ((1 : ℕ) : ℝ) + 1) + t =
        (((14912126451711 / 2 ^ 40) : ℚ) : ℝ) + t := by
      norm_num
    rw [e]
    have h := piece_rel 9 3 _ _ _ _ _ (14912126451711 / 2 ^ 40)
      (14843406974975 / 2 ^ 40) c0Asym
