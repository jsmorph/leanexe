/-- The kernel's checks of row `i` of `Tacc`: the words that the loops read, finite with the values
of `taq i` and below the magnitudes, the bounds of the loops, the bound `MU` on `U` from the row's
interval of `x`, the bound on the derivative, and the final bounds. -/
def TRow (i : ℕ) : Prop :=
  (∀ j < 8 + i, Finite Erfc.asymAccTable[(30 * UInt64.ofNat i + 19 + UInt64.ofNat i -
      UInt64.ofNat j).toNat]! ∧
    ratOfWord Erfc.asymAccTable[(30 * UInt64.ofNat i + 19 + UInt64.ofNat i -
      UInt64.ofNat j).toNat]! = (taq i).getD (19 + i - j) 0 ∧
    qabs ((taq i).getD (19 + i - j) 0) ≤ (mcAL.getD i []).getD j 0) ∧
  Finite Erfc.asymAccTable[(30 * UInt64.ofNat i + 20 + UInt64.ofNat i).toNat]! ∧
  ratOfWord Erfc.asymAccTable[(30 * UInt64.ofNat i + 20 + UInt64.ofNat i).toNat]! =
    (taq i).getD (20 + i) 0 ∧
  qabs ((taq i).getD (20 + i) 0) ≤ ((bsAL.getD i []).getD 0 0).1 ∧
  ((bsAL.getD i []).getD 0 0).2.1 = 0 ∧ ((bsAL.getD i []).getD 0 0).2.2 = 0 ∧
  (∀ j < 6, Finite Erfc.asymAccTable[(30 * UInt64.ofNat i + 10 - 2 * UInt64.ofNat j).toNat]! ∧
    ratOfWord Erfc.asymAccTable[(30 * UInt64.ofNat i + 10 - 2 * UInt64.ofNat j).toNat]! =
      (taq i).getD (10 - 2 * j) 0 ∧
    qabs ((taq i).getD (10 - 2 * j) 0) ≤ (mcBL.getD i []).getD j 0 ∧
    Finite Erfc.asymAccTable[(30 * UInt64.ofNat i + 11 - 2 * UInt64.ofNat j).toNat]! ∧
    ratOfWord Erfc.asymAccTable[(30 * UInt64.ofNat i + 11 - 2 * UInt64.ofNat j).toNat]! =
      (taq i).getD (11 - 2 * j) 0 ∧
    qabs ((taq i).getD (11 - 2 * j) 0) ≤ (mdBL.getD i []).getD j 0) ∧
  ChkA (bsAL.getD i []) (mcAL.getD i []) (muA.getD i 0) (muA.getD i 0 / 2 ^ 50) (8 + i) ∧
  (bsBL.getD i []).getD 0 0 = (bsAL.getD i []).getD (8 + i) 0 ∧
  ChkB (bsBL.getD i []) (mcBL.getD i []) (mdBL.getD i []) (muA.getD i 0)
    (muA.getD i 0 / 2 ^ 50) 6 ∧
  (8 + UInt64.ofNat i).toNat = 8 + i ∧
