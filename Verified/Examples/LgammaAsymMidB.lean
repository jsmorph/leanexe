/-- The fit within `(1 / 2 ^ 87)` of `lgamma`, relative, on the pieces' interval. -/
theorem cover : ∀ x : ℝ, ((24739011624959 : ℝ) / 2 ^ 40) ≤ x →
    x ≤ ((24739011624959 : ℝ) / 2 ^ 40) + 2 * ((1 : ℝ) / 2) * 13 →
    |lgamma x - fit c0Asym pAsym x| ≤ (1 / 2 ^ 87) * lgamma x := by
  refine cover_pieces (K := 13) (by norm_num) (lo := ((24739011624959 : ℝ) / 2 ^ 40))
