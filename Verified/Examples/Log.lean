/-- The path of Arm's `log` for `x` within about `2 ^ -4` of 1, other than 1: the polynomial of
degree 12 in `r = x - 1`, whose term `-r²/2` after `r` is computed from `r = rhi + rlo` with `rhi`
of 26 bits, so that `rhi²` is exact. -/
def logNear1 (x : Float) : Float :=
  let B0 := Float.ofBits 0xBFE0000000000000   -- -0x1p-1
  let B1 := Float.ofBits 0x3FD5555555555577   --  0x1.5555555555577p-2
  let B2 := Float.ofBits 0xBFCFFFFFFFFFFDCB   -- -0x1.ffffffffffdcbp-3
  let B3 := Float.ofBits 0x3FC999999995DD0C   --  0x1.999999995dd0cp-3
  let B4 := Float.ofBits 0xBFC55555556745A7   -- -0x1.55555556745a7p-3
  let B5 := Float.ofBits 0x3FC24924A344DE30   --  0x1.24924a344de3p-3
  let B6 := Float.ofBits 0xBFBFFFFFA4423D65   -- -0x1.fffffa4423d65p-4
  let B7 := Float.ofBits 0x3FBC7184282AD6CA   --  0x1.c7184282ad6cap-4
  let B8 := Float.ofBits 0xBFB999EB43B068FF   -- -0x1.999eb43b068ffp-4
  let B9 := Float.ofBits 0x3FB78182F7AFD085   --  0x1.78182f7afd085p-4
  let B10 := Float.ofBits 0xBFB5521375D145CD  -- -0x1.5521375d145cdp-4
  let r := x - 1.0
  let r2 := r * r
  let r3 := r * r2
  let y := r3 * (B1 + r * B2 + r2 * B3
    + r3 * (B4 + r * B5 + r2 * B6 + r3 * (B7 + r * B8 + r2 * B9 + r3 * B10)))
  let w := r * Float.ofBits 0x41A0000000000000  -- 0x1p27
  let rhi := r + w - w
  let rlo := r - rhi
  let w := rhi * rhi * B0
  let hi := r + w
  let lo := r - hi + w
  let lo := lo + B0 * rlo * (rhi + r)
  let y := y + lo
  y + hi

/-- The main path of Arm's `log` for the bits `ix` of a positive normal `x`, or of a subnormal
`x` scaled by `2 ^ 52` with 52 taken from the exponent field.  `tmp >>> 52`, extended by the sign
of `tmp`, is C's arithmetic shift of `(int64_t) tmp`, and `kd` is its conversion to a double. -/
def logCore (tab tab2 : Array UInt64) (ix : UInt64) : Float :=
  let ln2hi := Float.ofBits 0x3FE62E42FEFA3800  --  0x1.62e42fefa3800p-1
  let ln2lo := Float.ofBits 0x3D2EF35793C76730  --  0x1.ef35793c76730p-45
  let A0 := Float.ofBits 0xBFE0000000000001     -- -0x1.0000000000001p-1
  let A1 := Float.ofBits 0x3FD555555551305B     --  0x1.555555551305bp-2
  let A2 := Float.ofBits 0xBFCFFFFFFFEB4590     -- -0x1.fffffffeb459p-3
  let A3 := Float.ofBits 0x3FC999B324F10111     --  0x1.999b324f10111p-3
  let A4 := Float.ofBits 0xBFC55575E506C89F     -- -0x1.55575e506c89fp-3
  let tmp := ix - 0x3fe6000000000000
  let i := (tmp >>> 45) % 128
  let k := (tmp >>> 52) ||| (if tmp >>> 63 == 1 then 0xFFFFFFFFFFFFF000 else 0)
  let iz := ix - (tmp &&& ((0xfff : UInt64) <<< 52))
  let invc := Float.ofBits tab[(2 * i).toNat]!
  let logc := Float.ofBits tab[(2 * i + 1).toNat]!
  let z := Float.ofBits iz
  let r := (z - Float.ofBits tab2[(2 * i).toNat]! - Float.ofBits tab2[(2 * i + 1).toNat]!) * invc
  let kd := if k >>> 63 == 1 then -(0 - k).toFloat else k.toFloat
  let w := kd * ln2hi + logc
  let hi := w + r
  let lo := w - hi + r + kd * ln2lo
  let r2 := r * r
  lo + r2 * A0 + r * r2 * (A1 + r * A2 + r2 * (A3 + r * A4)) + hi

/-- Arm's `log` with the tables `tab` and `tab2`.  The bits from `1 - 2 ^ -4` to below
`1 + 0x1.09p-4` take `logNear1`, and 1 itself gives 0.  `top` is the top 16 bits of `x`: `±0`
gives `-∞` as `__math_divzero` computes it, `∞` gives `∞`, a negative number or NaN gives NaN as
`__math_invalid` computes it, and a subnormal is scaled by `2 ^ 52`.  Arm compares 32-bit words,
where `top - 0x0010` wraps for `top < 0x0010`; the comparison on 64-bit words gives the same
result, since the wrapped difference exceeds `0x7ff0 - 0x0010` either way. -/
def logWith (tab tab2 : Array UInt64) (x : Float) : Float :=
  let ix := x.toBits
  let top := ix >>> 48
  if ix - 0x3FEE000000000000 < 0x3FF1090000000000 - 0x3FEE000000000000 then
    if ix == 0x3FF0000000000000 then 0.0 else logNear1 x
  else if top - 0x0010 ≥ 0x7ff0 - 0x0010 then
    if ix * 2 == 0 then -1.0 / 0.0
    else if ix == 0x7FF0000000000000 then x
    else if top &&& 0x8000 != 0 || top &&& 0x7ff0 == 0x7ff0 then (x - x) / (x - x)
    else logCore tab tab2 ((x * Float.ofBits 0x4330000000000000).toBits - ((52 : UInt64) <<< 52))
  else logCore tab tab2 ix

/-- `log x`, from the tables `logTable` and `logTable2`. -/
def log (x : Float) : Float := logWith logTable logTable2 x

verified_compile compiled := [logNear1, logCore, logWith, log]

end Verified.Examples.Log
