/-- The double whose bits are entry `i` of `tab`. -/
def entry (tab : Array UInt64) (i : UInt64) : Float := Float.ofBits tab[i.toNat]!

/-- `fasttwosum`: `s = x + y` and `y - (s - x)`, the error of `s` when `|x| ≥ |y|`. -/
def fastTwoSum (x y : Float) : Float × Float :=
  let s := x + y
  let z := s - x
  (s, y - z)

/-- `twosum`: `fastTwoSum` with the operand of larger magnitude first. -/
def twoSum (x y : Float) : Float × Float :=
  if x.abs > y.abs then fastTwoSum x y else fastTwoSum y x

/-- `fastsum`: the sum of the double-doubles `xh + xl` and `yh + yl`, for `|xh| ≥ |yh|`. -/
def fastSum (xh xl yh yl : Float) : Float × Float :=
  let (sh, sl) := fastTwoSum xh yh
  (sh, (xl + yl) + sl)

/-- `sumdd`: `fastSum` with the high part of larger magnitude first. -/
def sumDD (xh xl yh yl : Float) : Float × Float :=
  let (sh, sl) := if xh.abs > yh.abs then fastTwoSum xh yh else fastTwoSum yh xh
  (sh, (xl + yl) + sl)

/-- `muldd`: the product of the double-doubles `xh + xl` and `ch + cl`. -/
def mulDD (xh xl ch cl : Float) : Float × Float :=
  let a := ch * xh
  (a, (ch * xl + cl * xh) + Fma.fma ch xh (-a))

/-- `muldd3`: the product of the double-doubles `xh + xl` and `yh + yl`, renormalized. -/
def mulDD3 (xh xl yh yl : Float) : Float × Float :=
  let ch := xh * yh
  let cl1 := Fma.fma xh yh (-ch)
  let tl0 := xl * yl
  let tl1 := tl0 + xh * yl
  let cl2 := tl1 + xl * yh
  let cl3 := cl1 + cl2
  fastTwoSum ch cl3

/-- `mulddd`: the product of the double `x` and the double-double `ch + cl`. -/
def mulDDD (x ch cl : Float) : Float × Float :=
  let a := ch * x
  (a, cl * x + Fma.fma ch x (-a))

/-- `polyddd`: the double-double `c 0 + c 1 · x + ⋯ + (c (n - 1) + l) · x ^ (n - 1)` for the
double-double coefficients `c k`, with the high part at entry `o + 2 k` of `tab` and the low part
after it.  The loop's step `j` handles the coefficient `n - 2 - j`. -/
def polyDDD (tab : Array UInt64) (o n : UInt64) (x l : Float) : Float × Float :=
  let (ch, cl) := fastTwoSum (entry tab (o + 2 * (n - 1))) l
  LeanExe.loop (n - 1) (ch, cl + entry tab (o + 2 * (n - 1) + 1)) fun j s =>
    let i := n - 2 - j
    let (ch, cl) := mulDDD x s.1 s.2
    sumDD (entry tab (o + 2 * i)) (entry tab (o + 2 * i + 1)) ch cl

/-- `splt`: `x` as `xh + xl` with `xh` a multiple of `2 ^ -25`, exact for `|x| ≤ 2 ^ 26`. -/
def splt (x : Float) : Float × Float :=
  let off := Float.ofBits 0x41A8000000000000  -- 0x1.8p27
  let xh := (x + off) - off
  (xh, x - xh)

/-- `sprod`: `x · (x0 + x1 + x2)` as the triple `(l0, l1, l2)`. -/
def sprod (x x0 x1 x2 : Float) : Float × Float × Float :=
  let z0 := x * x0
  let z0l := Fma.fma x x0 (-z0)
  let z1 := x * x1
  let z2 := x * x2 + Fma.fma x x1 (-z1)
  let (z0, e) := splt z0
  let (e, z0l) := fastTwoSum e z0l
  let (l1, e) := twoSum e z1
  (z0, l1, e + z0l + z2)

/-- `poly3`: the polynomial in `d` with the `imax` double coefficients at `oh` and the `jmax`
double-double ones at `ol`, as a double-double.  The loop's step `k` handles coefficient `k + 1` of
the first set. -/
def poly3 (tab : Array UInt64) (d : Float) (oh imax ol jmax : UInt64) : Float × Float :=
  let (_, _, _, s0, s1, s2) := LeanExe.loop (imax - 1)
    ((1.0 : Float), (0.0 : Float), (0.0 : Float), entry tab oh, (0.0 : Float), (0.0 : Float))
    fun k st =>
      let (t0, t1, t2, s0, s1, s2) := st
      let c := entry tab (oh + k + 1)
      let (t0, t1, t2) := sprod d t0 t1 t2
      let s0 := s0 + t0 * c
      let (fh, fl) := mulDDD c t1 t2
      let (s1, s2) := sumDD s1 s2 fh fl
      (t0, t1, t2, s0, s1, s2)
  let (fh, fl) := polyDDD tab ol jmax d 0.0
  let (s1, s2) := sumDD s1 s2 fh fl
  let (s0, s1) := fastTwoSum s0 s1
  let (s1, _) := fastTwoSum s1 s2
  (s0, s1)

/-- `roundeven_finite`: `x` rounded to an integer, ties to even, with the sign of `x`, from the
addition and subtraction of `2 ^ 52`, exact for `|x| < 2 ^ 52`. -/
def roundEven (x : Float) : Float :=
  let a := x.abs
  let big := Float.ofBits 0x4330000000000000  -- 2 ^ 52
  let r := if a < big then (a + big) - big else a
  if x.toBits >>> 63 == 1 then -r else r

/-- `floor` of a finite `x`. -/
def floorF (x : Float) : Float :=
  let r := roundEven x
  if r > x then r - 1.0 else r

/-- The two's complement word of an integer-valued `v` with `|v| < 2 ^ 63`, C's conversion to an
integer type. -/
def toWord (v : Float) : UInt64 := if v < 0.0 then 0 - (-v).toUInt64 else v.toUInt64

/-- The arithmetic shift right of the two's complement word `k` by `n < 64`. -/
def sar (k n : UInt64) : UInt64 :=
  if k >>> 63 == 1 then ((k ^^^ 0xFFFFFFFFFFFFFFFF) >>> n) ^^^ 0xFFFFFFFFFFFFFFFF else k >>> n

/-- Whether the two's complement word `v` is at most 0. -/
def nonPositive (v : UInt64) : Bool := v == 0 || v >>> 63 == 1

/-- `as_logd`: `log x` as a double-double for a positive normal `x`, with the tables of `logdTable`.
`ed` is the unbiased exponent as a double. -/
def asLogd (tab : Array UInt64) (x : Float) : Float × Float :=
  let u := x.toBits
  let ex := u >>> 52
  let ed := if ex ≥ 0x3ff then (ex - 0x3ff).toFloat else -((0x3ff - ex).toFloat)
  let m := u &&& 0xFFFFFFFFFFFFF
  let i := m >>> 47
  let d := m &&& 0x7FFFFFFFFFFF
  let j := (m + (tab[(2 * i).toNat]! <<< 33) + tab[(2 * i + 1).toNat]! * (d >>> 16)) >>> 42
  let t := Float.ofBits (m ||| 0x3FF0000000000000)
  let i1 := j >>> 5
  let i2 := j &&& 0x1f
  let r := entry tab (64 + i1) * entry tab (97 + i2)
  let o := r * t
  let dxl := Fma.fma r t (-o)
  let dxh := o - 1.0
  let dx := Fma.fma r t (-1.0)
  let dx2 := dx * dx
  let f := dx2 * ((entry tab 260 + dx * entry tab 261) + dx2 * (entry tab 262 + dx * entry tab 263))
  let lt := (entry tab (130 + 2 * i1 + 1) + entry tab (196 + 2 * i2 + 1)) +
    ed * Float.ofBits 0x3FE62E42FEF80000  -- 0x1.62e42fef8p-1
  let lh := lt + dxh
  let ll := (lt - lh) + dxh
  let ll := ll + (((entry tab (130 + 2 * i1) + entry tab (196 + 2 * i2)) +
    Float.ofBits 0x3DB1CF79ABC9E3B4 * ed) + dxl)  -- 0x1.1cf79abc9e3b4p-36
  (lh, ll + f)

/-- `as_sinpid`: `sin (π x)` as a double-double for `0 ≤ x < 1`, from `sin` and `cos` at the
multiples of `π/128` in `sinpidTable` and polynomials in the remainder `d`. -/
def asSinpid (tab : Array UInt64) (x : Float) : Float × Float :=
  let x := (x - 0.5).abs * 128.0
  let ix := roundEven x
  let d := ix - x
  let d2 := d * d
  let ky := ix.toUInt64
  let kx := 64 - ky
  let sh := entry tab (2 * kx + 1)
  let sl := entry tab (2 * kx)
  let ch := entry tab (2 * ky + 1)
  let cl := entry tab (2 * ky)
  let c0 := Float.ofBits 0xBBD692B66E3CF6E8  -- -0x1.692b66e3cf6e8p-66
  let s0 := Float.ofBits 0x3C31A624B88C9448  -- 0x1.1a624b88c9448p-60
  let p := d2 * (entry tab 131 + d2 * (entry tab 132 + d2 * entry tab 133))
  let q := d2 * (entry tab 135 + d2 * (entry tab 136 + d2 * entry tab 137))
  let (qh, ql) := fastTwoSum (entry tab 134) q
  let (ch, cl) := mulDD qh (ql + s0) ch cl
  let (th, tl) := fastTwoSum (entry tab 130) p
  let (th, tl) := mulDDD d th (tl + c0)
  let (ph, pl) := mulDD th tl sh sl
  let (ch, cl) := fastSum ch cl ph pl
  let (ch, cl) := mulDDD d ch cl
  fastSum sh sl ch cl

/-- `as_expd`: `exp (x + l)` as a double-double `(h, l)` and a two's complement exponent `e`, with
`exp (x + l) = (h + l) · 2 ^ e`. -/
def asExpd (tab : Array UInt64) (x l : Float) : Float × Float × UInt64 :=
  let (xh, xl) := mulDD x l (Float.ofBits 0x40971547652B82FE)  -- 0x1.71547652b82fep+10
    (Float.ofBits 0x3D1777D0FFDA0D24)  -- 0x1.777d0ffda0d24p-46
  let ix := roundEven xh
  let (xh, xl) := fastTwoSum (xh - ix) xl
  let k := toWord ix
  let i0 := (k >>> 5) &&& 31
  let i1 := k &&& 31
  let (rh, rl) := mulDD (entry tab (2 * i0 + 1)) (entry tab (2 * i0)) (entry tab (64 + 2 * i1 + 1))
    (entry tab (64 + 2 * i1))
  let fl := xh * (entry tab 130 + xh * (entry tab 132 + xh * (entry tab 134 + xh * entry tab 136)))
  let (fh, fl) := fastTwoSum (entry tab 128) fl
  let (fh, fl) := mulDD xh xl fh (fl + entry tab 129)
  let (fh, el) := fastTwoSum 1.0 fh
  let (rh, rl) := mulDD rh rl fh (fl + el)
  (rh, rl, sar k 10)

/-- `as_lgamma_asym`: `lgamma (xh + xl)` from Stirling's series, for `xh` above 3, as a
double-double. -/
def asLgammaAsym (logTab tab : Array UInt64) (xh xl : Float) : Float × Float :=
  let zh := 1.0 / xh
  let dz := xl * zh
  let zl := (Fma.fma zh (-xh) 1.0 - dz) * zh
  let (lh, ll) := asLogd logTab xh
  let (lh, ll) := mulDD (xh - 0.5) xl (lh - 1.0) (ll + dz)
  let (z2h, z2l) := mulDD zh zl zh zl
  let x2 := z2h * z2h
  let (lh, ll, fh, fl) :=
    if xh > 11.5 then
      let (lh, ll) := fastSum lh ll (entry tab 0) (entry tab 1)
      let q0 := entry tab 4 + z2h * entry tab 6
      let q2 := entry tab 8 + z2h * entry tab 10
      let q4 := entry tab 12 + z2h * entry tab 14
      let fl := z2h * (q0 + x2 * (q2 + x2 * q4))
      let (fh, fl) := fastTwoSum (entry tab 2) fl
      (lh, ll, fh, fl + entry tab 3)
    else
      let (lh, ll) := fastSum lh ll (entry tab 16) (entry tab 17)
      let x4 := x2 * x2
      let q0 := entry tab 22 + z2h * entry tab 24
      let q2 := entry tab 26 + z2h * entry tab 28
      let q4 := entry tab 30 + z2h * entry tab 32
      let q6 := entry tab 34 + z2h * entry tab 36
      let q8 := entry tab 38 + z2h * entry tab 40
      let q4 := q4 + x2 * (q6 + x2 * q8)
      let q0 := q0 + x2 * q2
      let q0 := q0 + x4 * q4
      let fl := z2h * q0
      let (fh, fl) := fastTwoSum (entry tab 20) fl
      let (fh, fl) := mulDD z2h z2l fh (fl + entry tab 21)
      let (fh, fl) := fastSum (entry tab 18) (entry tab 19) fh fl
      (lh, ll, fh, fl)
  let (fh, fl) := mulDD zh zl fh fl
  fastSum lh ll fh fl

/-- `as_tgamma_database`: the correctly rounded `Γ x` for the inputs that the fast and accurate
paths cannot round, and `f` otherwise.  A linear scan replaces the binary search, with the same
result, since the inputs are distinct. -/
def database (tab : Array UInt64) (x f : Float) : Float :=
  LeanExe.loop 57 f fun k acc =>
    if entry tab (3 * k) == x then entry tab (3 * k + 1) + entry tab (3 * k + 2) else acc

/-- The table offsets and counts of `as_tgamma_accurate`'s range for `ix = floor x`, as
`(ch, imax, cl, jmax, j, eoff)`, with `jm = j - ix`. -/
def accurateRange (ix : Float) : UInt64 × UInt64 × UInt64 × UInt64 × Float × UInt64 :=
  if ix > 159.0 then (64, 14, 78, 34, 160.0, 942)
  else if ix > 127.0 then (146, 14, 160, 33, 128.0, 713)
  else if ix > 95.0 then (226, 13, 239, 32, 96.0, 495)
  else if ix > 63.0 then (303, 13, 316, 32, 64.0, 293)
  else if ix > 31.0 then (380, 12, 392, 30, 32.0, 115)
  else if ix > 25.0 then (452, 12, 464, 29, 26.0, 86)
  else if ix > 15.0 then (522, 11, 533, 29, 16.0, 42)
  else if ix > 7.0 then (591, 10, 601, 28, 8.0, 14)
  else (657, 9, 666, 26, 4.0, 3)

/-- `as_tgamma_accurate`: `Γ x` to about 100 bits, rounded once, for the arguments where the fast
paths cannot decide the rounding.  Below `1/4` in magnitude it is `1/x` plus a polynomial.  Above,
it is a polynomial `f` in `d = 2 (x - floor x - 1/2)` on the range of `floor x`, times or divided by
the product `w` of the `|jm|` factors that move `x` into the range, scaled by `2 ^ eoff`.  `jm` is
an integer-valued double, and `eoff` a two's complement word.  The rounding of the scaled sum covers
a subnormal result. -/
def accurate (accTab dbTab : Array UInt64) (x : Float) : Float :=
  if x.abs < 0.25 then
    let x2 := x * x
    let x4 := x2 * x2
    let c0 := entry accTab 56 + x * entry accTab 57 + x2 * (entry accTab 58 + x * entry accTab 59)
    let c4 := entry accTab 60 + x * entry accTab 61 + x2 * (entry accTab 62 + x * entry accTab 63)
    let c0 := c0 + x4 * c4
    let (ch, cl) := polyDDD accTab 0 28 x (x * c0)
    let fh := 1.0 / x
    let dh := Fma.fma fh (-x) 1.0
    let fl := dh * fh
    let fll := Fma.fma fl (-x) dh * fh
    let (fl, fll) := sumDD fl fll ch cl
    let (fl, fll) := twoSum fl fll
    let (fh, fl) := fastTwoSum fh fl
    let (fl, fll) := fastTwoSum fl fll
    let (_, et) := fastTwoSum fh (2.0 * fl)
    let fl :=
      if et == 0.0 then
        if fl.toBits >>> 63 == fll.toBits >>> 63 then fl * (1.0 + Float.ofBits 0x3CD0000000000000)
        else fl * (1.0 - Float.ofBits 0x3CD0000000000000)  -- 0x1p-50
      else fl
    fh + fl
  else
    let ix := floorF x
    let d := 2.0 * (x - (ix + 0.5))
    let (oh, imax, ol, jmax, j, eoff) := accurateRange ix
    let jm := j - ix
    let (fh, fl) := poly3 accTab d oh imax ol jmax
    let (wh, wl, eoff) :=
      if jm > 0.0 then
        let (_, _, wh, wl, eoff) := LeanExe.loop (jm - 1.0).toUInt64
          (x, (0.0 : Float), x, (0.0 : Float), eoff) fun _ s =>
            let (xph, xpl, wh, wl, eoff) := s
            let (xph, l) := if xph.abs > 1.0 then fastTwoSum xph 1.0 else fastTwoSum 1.0 xph
            let (xph, xpl) := fastTwoSum xph (xpl + l)
            let (wh, wl) := mulDD3 xph xpl wh wl
            if wh.abs > Float.ofBits 0x6050000000000000 then  -- 0x1p518
              (xph, xpl, wh * Float.ofBits 0x20B0000000000000, wl * Float.ofBits 0x20B0000000000000,
                eoff - 500)  -- 0x1p-500
            else (xph, xpl, wh, wl, eoff)
        (wh, wl, eoff)
      else if jm < 0.0 then
        let (_, _, wh, wl) := LeanExe.loop (-1.0 - jm).toUInt64
          (x - 1.0, (0.0 : Float), x - 1.0, (0.0 : Float)) fun _ s =>
            let (xph, xpl, wh, wl) := s
            let (xph, l) := fastTwoSum xph (-1.0)
            let (xph, xpl) := fastTwoSum xph (xpl + l)
            let (wh, wl) := mulDD3 xph xpl wh wl
            (xph, xpl, wh, wl)
        (wh, wl, eoff)
      else ((1.0 : Float), (0.0 : Float), eoff)
    let (fh, fl) :=
      if jm > 0.0 then
        let rh := 1.0 / wh
        mulDD3 fh fl rh ((Fma.fma rh (-wh) 1.0 - wl * rh) * rh)
      else if jm < 0.0 then mulDD3 fh fl wh wl
      else (fh, fl)
    let p54 := Float.ofBits 0x3C90000000000000  -- 0x1p-54
    let p53 := Float.ofBits 0x3CA0000000000000  -- 0x1p-53
    let p107 := Float.ofBits 0x3940000000000000  -- 0x1p-107
    let fl :=
      if jm ≤ 0.0 then
        let crr := ((p54 + p107) - p54) + ((p53 - p107) - p53)
        fl + fh * (jm * crr)
      else
        let op := p53 - p107
        let om := -p53 + p107
        let crr := if op == -om then p53 - op else 0.0
        fl - fh * ((jm - 5.0) * crr * Float.ofBits 0x3FF0A3D70A3D70A4)  -- 1.04
    let eps := Float.ofBits 0x398E000000000000 * fh  -- 0x1.ep-103
    let ub := fh + (fl + eps)
    let lb := fh + (fl - eps)
    let res := (fh + fl).toBits
    let re := (res >>> 52) &&& 0x7ff
    let res :=
      if nonPositive (re + eoff) then
        let r := (res - ((eoff + re - 1) <<< 52)) &&& 0xFFF0000000000000
        let (fh, l) := fastTwoSum (Float.ofBits r) fh
        (fh + (fl + l)).toBits &&& 0x800FFFFFFFFFFFFF
      else res + (eoff <<< 52)
    if ub != lb then database dbTab x (Float.ofBits res) else Float.ofBits res

/-- `cr_tgamma` with the tables of the module. -/
def tgammaWith (dbTab accTab smallTab mainTab logTab sinTab expTab asymTab : Array UInt64)
    (x : Float) : Float :=
  let u := x.toBits
  let ax := u <<< 1
  if ax ≥ 0xFFE0000000000000 then
    if ax == 0xFFE0000000000000 then (if u >>> 63 == 1 then x / x else x) else x + x
  else if x.abs < 0.25 then
    if ax < 0x71E0000000000000 then
      if u == 0x0004000000000000 then  -- 0x1p-1024
        -- 0x1.fffffffffffffp+1023 + 0x1p+970
        Float.ofBits 0x7FEFFFFFFFFFFFFF + Float.ofBits 0x7C90000000000000
      else
        let r := 1.0 / x
        if x == 0.0 then r
        else if Fma.fma r x (-1.0) == 0.0 then r - 0.5 else r
    else
      let x2 := x * x
      let x4 := x2 * x2
      let x8 := x4 * x4
      let c0 := entry smallTab 10 + x * entry smallTab 11 +
        x2 * (entry smallTab 12 + x * entry smallTab 13)
      let c4 := entry smallTab 14 + x * entry smallTab 15 +
        x2 * (entry smallTab 16 + x * entry smallTab 17)
      let c8 := entry smallTab 18 + x * entry smallTab 19 +
        x2 * (entry smallTab 20 + x * entry smallTab 21)
      let c12 := entry smallTab 22 + x * entry smallTab 23 +
        x2 * (entry smallTab 24 + x * entry smallTab 25)
      let c0 := c0 + x4 * c4
      let c8 := c8 + x4 * c12
      let (ch, cl) := polyDDD smallTab 0 5 x (x * (c0 + x8 * c8))
      let fh := 1.0 / x
      let (fh, fl) := fastSum fh (Fma.fma fh (-x) 1.0 * fh) ch cl
      let eps := fh * (Float.ofBits 0x3C19D35025BFF857 +  -- 3.5e-19
        (x2 * x4) * Float.ofBits 0x3CF203AF9EE75616)  -- 4e-15
      let ub := fh + (fl + eps)
      let lb := fh + (fl - eps)
      if ub != lb then accurate accTab dbTab x else ub
  else if x ≥ Float.ofBits 0x406573FAE561F648 then  -- 0x1.573fae561f648p+7
    Float.ofBits 0x7FEF000000000000 + Float.ofBits 0x7FEF000000000000  -- 0x1.fp1023
  else
    let fx := floorF x
    if fx == x then
      if x == 0.0 then 1.0 / x
      else if x < 0.0 then 0.0 / 0.0
      else
        let (t0h, t0l, _) := LeanExe.loop (fx - 1.0).toUInt64
          ((1.0 : Float), (0.0 : Float), (1.0 : Float)) fun _ s =>
            let (t0h, t0l, x0) := s
            let (t0h, t0l) := mulDDD x0 t0h t0l
            (t0h, t0l, x0 + 1.0)
        t0h + t0l
    else if x ≤ -184.0 then
      let tiny := Float.ofBits 0x0010000000000000  -- 0x1p-1022
      tiny * (if (-fx).toUInt64 &&& 1 == 0 then tiny else -tiny)
    else if x < -3.0 then
      let (lh, ll) := fastTwoSum (-x) 1.0
      let (lh, ll) := asLgammaAsym logTab asymTab lh ll
      let (lh, ll, e) := asExpd expTab lh ll
      let dx := x - fx
      let (sh, sl) := asSinpid sinTab dx
      let (lh, ll) := mulDD sh sl lh ll
      let pih := Float.ofBits 0x400921FB54442D18  -- 0x1.921fb54442d18p+1
      let pil := Float.ofBits 0x3CA1A62633145C07  -- 0x1.1a62633145c07p-53
      let rcp := 1.0 / lh
      let rh := rcp * pih
      let rl := rcp * (pil - ll * rh - Fma.fma rh lh (-pih))
      let odd := (-fx).toUInt64 &&& 1 == 1
      let rh := if odd then -rh else rh
      let rl := if odd then -rl else rl
      let eps := rh * (Float.ofBits 0x3BC48AD3CAEFE280 -  -- 8.7e-21
        x * Float.ofBits 0x3B661019F74442B7)  -- 1.46e-22
      if fx ≥ -170.0 then
        let ub := rh + (rl + eps)
        let lb := rh + (rl - eps)
        if ub != lb then accurate accTab dbTab x
        else Float.ofBits (ub.toBits - (e <<< 52))
      else
        let re := (rh.toBits >>> 52) &&& 0x7ff
        if nonPositive (re - e) then
          let th := (rh.toBits + ((e - re + 1) <<< 52)) &&& 0xFFF0000000000000
          let (rh, l) := fastTwoSum (Float.ofBits th) rh
          let rl := rl + l
          let ub := rh + (rl + eps)
          let lb := rh + (rl - eps)
          if ub != lb then accurate accTab dbTab x
          else Float.ofBits (ub.toBits &&& 0x800FFFFFFFFFFFFF)
        else
          let ub := rh + (rl + eps)
          let lb := rh + (rl - eps)
          if ub != lb then accurate accTab dbTab x
          else Float.ofBits (ub.toBits - (e <<< 52))
    else if x > 4.0 then
      let (lh, ll) := asLgammaAsym logTab asymTab x 0.0
      let (lh, ll, e) := asExpd expTab lh ll
      let eps := lh * (Float.ofBits 0x3BA2E3B40A0E9B4F +  -- 2e-21
        x * Float.ofBits 0x3B6BCE27BCE24D11)  -- 1.84e-22
      let ub := lh + (ll + eps)
      let lb := lh + (ll - eps)
      if ub != lb then accurate accTab dbTab x
      else Float.ofBits (ub.toBits + (e <<< 52))
    else
      let i := roundEven (x - 3.5)
      let d := x - (i + 3.5)
      let d2 := d * d
      let d4 := d2 * d2
      let fl := d * ((entry mainTab 46 + d * entry mainTab 47) +
        d2 * (entry mainTab 48 + d * entry mainTab 49) +
        d4 * ((entry mainTab 50 + d * entry mainTab 51) +
          d2 * (entry mainTab 52 + d * entry mainTab 53)))
      let (fh, fl) := polyDDD mainTab 0 10 d fl
      let jm := i.abs
      let (wh, wl, _, _) :=
        if jm > 0.0 then
          LeanExe.loop (jm - 1.0).toUInt64 (x, (0.0 : Float), x, (0.0 : Float)) fun _ s =>
            let (wh, wl, xph, xpl) := s
            let (xph, l) := if xph.abs > 1.0 then fastTwoSum xph 1.0 else fastTwoSum 1.0 xph
            let xpl := xpl + l
            let (wh, wl) := mulDD xph xpl wh wl
            (wh, wl, xph, xpl)
        else ((1.0 : Float), (0.0 : Float), x, (0.0 : Float))
      let rh := 1.0 / wh
      let (fh, fl) := mulDD rh ((Fma.fma rh (-wh) 1.0 - wl * rh) * rh) fh fl
      let eps := fh * Float.ofBits 0x3B92E3B40A0E9B4F  -- 1e-21
      let ub := fh + (fl + eps)
      let lb := fh + (fl - eps)
      if ub != lb then accurate accTab dbTab x else ub

/-- `Γ x`, CORE-MATH's correctly rounded `tgamma`. -/
def tgamma (x : Float) : Float :=
  tgammaWith dbTable accurateTable smallTable mainTable logdTable sinpidTable expdTable asymTable x

