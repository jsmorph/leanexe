/-- The fit within `(1 / 2 ^ 87)` of `lgamma`, relative, on the pieces' interval. -/
theorem cover : ∀ x : ℝ, ((4123168604159 : ℝ) / 2 ^ 40) ≤ x →
    x ≤ ((4123168604159 : ℝ) / 2 ^ 40) + 2 * ((1 : ℝ) / 16) * 11 →
    |lgamma x - fit c0Asym pAsym x| ≤ (1 / 2 ^ 87) * lgamma x := by
  refine cover_pieces (K := 11) (by norm_num) (lo := ((4123168604159 : ℝ) / 2 ^ 40))
    (r := ((1 : ℝ) / 16)) (by norm_num)
    (fun x => |lgamma x - fit c0Asym pAsym x| ≤ (1 / 2 ^ 87) * lgamma x) ?_
  intro j hj t ht
  interval_cases j
  · have e : ((4123168604159 : ℝ) / 2 ^ 40) +
        ((1 : ℝ) / 16) * (2 * ((0 : ℕ) : ℝ) + 1) + t =
        (((4191888080895 / 2 ^ 40) : ℚ) : ℝ) + t := by
      norm_num
    rw [e]
    have h := piece_rel 19 13 _ _ _ _ _ (4191888080895 / 2 ^ 40)
      (4123168604159 / 2 ^ 40) c0Asym
      (1714181653943582153 / 2 ^ 60) (1714181653943582153 / 2 ^ 110)
      (1596456071 / 2 ^ 117) (1 / 2 ^ 87) pAsym
      0 f_0 p_0 (by norm_num) (by norm_num [cfgF]) (by norm_num) (by norm_num) t
      (by simp only [cfgF]; push_cast; exact ht)
    push_cast at h ⊢
    exact h
  · have e : ((4123168604159 : ℝ) / 2 ^ 40) +
        ((1 : ℝ) / 16) * (2 * ((1 : ℕ) : ℝ) + 1) + t =
        (((4329327034367 / 2 ^ 40) : ℚ) : ℝ) + t := by
      norm_num
    rw [e]
    have h := piece_rel 19 13 _ _ _ _ _ (4329327034367 / 2 ^ 40)
      (4260607557631 / 2 ^ 40) c0Asym
