/-- The double whose bits are entry `i` of `tab`. -/
def entry (tab : Array UInt64) (i : UInt64) : Float := Float.ofBits tab[i.toNat]!

/-- `roundeven_finite`: `x` rounded to an integer, ties to even, with the sign of `x`, from the
addition and subtraction of `2 ^ 52`, exact for `|x| < 2 ^ 52`. -/
def roundEven (x : Float) : Float :=
  let a := x.abs
  let big := Float.ofBits 0x4330000000000000  -- 2 ^ 52
  let r := if a < big then (a + big) - big else a
  if x.toBits >>> 63 == 1 then -r else r

/-- `__builtin_floor` of a finite `x`. -/
def floorF (x : Float) : Float :=
  let r := roundEven x
  if r > x then r - 1.0 else r

/-- The two's complement word of an integer-valued `v` with `|v| < 2 ^ 63`, C's conversion to an
integer type. -/
def toWord (v : Float) : UInt64 := if v < 0.0 then 0 - (-v).toUInt64 else v.toUInt64

/-- The arithmetic shift right of the two's complement word `k` by `n < 64`. -/
def sar (k n : UInt64) : UInt64 :=
  if k >>> 63 == 1 then ((k ^^^ 0xFFFFFFFFFFFFFFFF) >>> n) ^^^ 0xFFFFFFFFFFFFFFFF else k >>> n

/-- `2 ^ e` for an integer-valued `e` from -1074 to 1023. -/
def pow2 (e : Float) : Float :=
  if e ≥ -1022.0 then Float.ofBits ((e + 1023.0).toUInt64 <<< 52)
  else Float.ofBits ((1 : UInt64) <<< (e + 1074.0).toUInt64)

/-- `__builtin_ldexp (v, e)` for an integer-valued `e` from -1074 to 2046, where `v · 2 ^ 1023` is
exact when `e > 1023`. -/
def ldexp (v e : Float) : Float :=
  if e > 1023.0 then (v * pow2 1023.0) * pow2 (e - 1023.0) else v * pow2 e

/-- `fast_two_sum`: `a + b` and its error when `|a| ≥ |b|`. -/
def fastTwoSum (a b : Float) : Float × Float :=
  let hi := a + b
  let e := hi - a
  (hi, b - e)

/-- `two_sum`: `a + b` and its error. -/
def twoSum (a b : Float) : Float × Float :=
  let hi := a + b
  let aa := hi - b
  let bb := hi - aa
  let da := a - aa
  let db := b - bb
  (hi, da + db)

/-- `a_mul`: `a b` and its error. -/
def aMul (a b : Float) : Float × Float :=
  let hi := a * b
  (hi, Library.Numerics.Arithmetic.Fma.fma a b (-hi))

/-- `s_mul`: the double `a` times the double-double `bh + bl`. -/
def sMul (a bh bl : Float) : Float × Float :=
  let (hi, lo) := aMul a bh
  (hi, Library.Numerics.Arithmetic.Fma.fma a bl lo)

/-- `d_mul`: `(ah + al) (bh + bl)` without the product `al bl`. -/
def dMul (ah al bh bl : Float) : Float × Float :=
  let (hi, lo) := aMul ah bh
  let lo := Library.Numerics.Arithmetic.Fma.fma ah bl lo
  (hi, Library.Numerics.Arithmetic.Fma.fma al bh lo)

/-- `fast_sum`: `a + (bh + bl)` for `|a| ≥ |bh|`. -/
def fastSum (a bh bl : Float) : Float × Float :=
  let (hi, lo) := fastTwoSum a bh
  (hi, lo + bl)

/-- `cr_erf_fast` below `1/16`: `erf z` as `(h, l)` from an odd polynomial. -/
def erfFastTiny (z : Float) : Float × Float :=
  let c0 := Float.ofBits 0x3FF20DD750429B6D  -- 0x1.20dd750429b6dp+0
  let c1 := Float.ofBits 0x3C71AE3A7862D9C4  -- 0x1.1ae3a7862d9c4p-56
  let c2 := Float.ofBits 0xBFD812746B0379E7  -- -0x1.812746b0379e7p-2
  let c3 := Float.ofBits 0x3C6F1A64D72722A2  -- 0x1.f1a64d72722a2p-57
  let c4 := Float.ofBits 0x3FBCE2F21A042B7F  -- 0x1.ce2f21a042b7fp-4
  let c5 := Float.ofBits 0xBF9B82CE31189904  -- -0x1.b82ce31189904p-6
  let c6 := Float.ofBits 0x3F7565BBF8A0FE0B  -- 0x1.565bbf8a0fe0bp-8
  let c7 := Float.ofBits 0xBF4BF9F8D2C202E4  -- -0x1.bf9f8d2c202e4p-11
  let (z2h, z2l) := aMul z z
  let z4 := z2h * z2h
  let c9 := Library.Numerics.Arithmetic.Fma.fma c7 z2h c6
  let c5 := Library.Numerics.Arithmetic.Fma.fma c5 z2h c4
  let c5 := Library.Numerics.Arithmetic.Fma.fma c9 z4 c5
  let (th, tl) := aMul z2h c5
  let (h, l) := fastTwoSum c2 th
  let l := l + (tl + c3)
  let hCopy := h
  let (th, tl) := aMul z2h h
  let tl := tl + Library.Numerics.Arithmetic.Fma.fma z2h l c1
  let (h, l) := fastTwoSum c0 th
  let l := l + Library.Numerics.Arithmetic.Fma.fma z2l hCopy tl
  let (h, tl) := aMul h z
  (h, Library.Numerics.Arithmetic.Fma.fma l z tl)

/-- `cr_erf_fast` from `1/16`: `erf z` as `(h, l)` from the polynomial of row `i - 1` of `C` at
`z - (2 i + 1)/32`, for `i = ⌊16 z⌋`. -/
def erfFastMain (tab : Array UInt64) (z : Float) : Float × Float :=
  let v := floorF (16.0 * z)
  let o := 13 * (v.toUInt64 - 1)
  let z := (z - 0.03125) - 0.0625 * v
  let z2 := z * z
  let z4 := z2 * z2
  let c9 := Library.Numerics.Arithmetic.Fma.fma (entry tab (o + 12)) z (entry tab (o + 11))
  let c7 := Library.Numerics.Arithmetic.Fma.fma (entry tab (o + 10)) z (entry tab (o + 9))
  let c5 := Library.Numerics.Arithmetic.Fma.fma (entry tab (o + 8)) z (entry tab (o + 7))
  let (c3h, c3l) := fastTwoSum (entry tab (o + 5)) (z * entry tab (o + 6))
  let c7 := Library.Numerics.Arithmetic.Fma.fma c9 z2 c7
  let (c3h, tl) := fastTwoSum c3h (c5 * z2)
  let c3l := c3l + tl
  let (c3h, tl) := fastTwoSum c3h (c7 * z4)
  let c3l := c3l + tl
  let (th, tl) := aMul z c3h
  let (c2h, c2l) := fastTwoSum (entry tab (o + 4)) th
  let c2l := c2l + Library.Numerics.Arithmetic.Fma.fma z c3l tl
  let (th, tl) := aMul z c2h
  let (h, l) := fastTwoSum (entry tab (o + 2)) th
  let l := l + (tl + Library.Numerics.Arithmetic.Fma.fma z c2l (entry tab (o + 3)))
  let (th, tl) := aMul z h
  let tl := Library.Numerics.Arithmetic.Fma.fma z l tl
  let (h, l) := fastTwoSum (entry tab o) th
  (h, l + (tl + entry tab (o + 1)))

/-- `cr_erf_fast`: `erf z` for `0 ≤ z ≤ 0x1.7afb48dc96626p+2` as `(h, l, err)`, with the relative
error bound `err`. -/
def erfFast (tab : Array UInt64) (z : Float) : Float × Float × Float :=
  if z < 0.0625 then
    let (h, l) := erfFastTiny z
    (h, l, Float.ofBits 0x3BA7800000000000)  -- 0x1.78p-69
  else
    let (h, l) := erfFastMain tab z
    (h, l, Float.ofBits 0x3BA1100000000000)  -- 0x1.11p-69

/-- `h + l` times `z ^ 2`, as `cr_erf_accurate_tiny`'s loops compute it. -/
def mulZ2 (h l z : Float) : Float × Float :=
  let (th, tl) := aMul h z
  let tl := Library.Numerics.Arithmetic.Fma.fma l z tl
  let (h, l) := aMul th z
  (h, Library.Numerics.Arithmetic.Fma.fma tl z l)

/-- `cr_erf_accurate_tiny`'s coefficient `p[k]`. -/
def tinyCoeff (k : UInt64) : Float :=
  Float.ofBits <|
    if k == 0 then 0x3FF20DD750429B6D  -- 0x1.20dd750429b6dp+0
    else if k == 1 then 0x3C71AE3A914FED80  -- 0x1.1ae3a914fed8p-56
    else if k == 2 then 0xBFD812746B0379E7  -- -0x1.812746b0379e7p-2
    else if k == 3 then 0x3C6EE12E49CA96BA  -- 0x1.ee12e49ca96bap-57
    else if k == 4 then 0x3FBCE2F21A042BE2  -- 0x1.ce2f21a042be2p-4
    else if k == 5 then 0xBC52871BC0A0A0D0  -- -0x1.2871bc0a0a0dp-58
    else if k == 6 then 0xBF9B82CE31288B51  -- -0x1.b82ce31288b51p-6
    else if k == 7 then 0x3C21003ACCF1355C  -- 0x1.1003accf1355cp-61
    else if k == 8 then 0x3F7565BCD0E6A53F  -- 0x1.565bcd0e6a53fp-8
    else if k == 9 then 0xBF4C02DB40040CC3  -- -0x1.c02db40040cc3p-11
    else if k == 10 then 0x3F1F9A326FA3CF50  -- 0x1.f9a326fa3cf5p-14
    else if k == 11 then 0xBEEF4D25E3C73CE9  -- -0x1.f4d25e3c73ce9p-17
    else if k == 12 then 0x3EBB9EB332B31646  -- 0x1.b9eb332b31646p-20
    else if k == 13 then 0xBE864A4BD5ECA4D7  -- -0x1.64a4bd5eca4d7p-23
    else 0x3E6C0ACC2502E94E  -- 0x1.c0acc2502e94ep-25

/-- `cr_erf_accurate_tiny`: `erf z` as `(h, l)` for `2 ^ -61 ≤ z < 1/8`.  The first loop's step `k`
handles degree `19 - 2 k`, the second's degree `11 - 2 k`, and the third's degree `7 - 2 k`. -/
def erfAccurateTiny (z : Float) : Float × Float :=
  let z2 := z * z
  let h := LeanExe.loop 4 (tinyCoeff 14) fun k h => Library.Numerics.Arithmetic.Fma.fma h z2 (tinyCoeff (13 - k))
  let (h, l) := LeanExe.loop 2 (h, (0.0 : Float)) fun k s =>
    let (h, l) := mulZ2 s.1 s.2 z
    let (h, tl) := fastTwoSum (tinyCoeff (9 - k)) h
    (h, l + tl)
  let (h, l) := LeanExe.loop 4 (h, l) fun k s =>
    let (h, l) := mulZ2 s.1 s.2 z
    let (h, tl) := fastTwoSum (tinyCoeff (6 - 2 * k)) h
    (h, l + (tinyCoeff (7 - 2 * k) + tl))
  let (h, tl) := aMul h z
  (h, Library.Numerics.Arithmetic.Fma.fma l z tl)

/-- `cr_erf_accurate`: `erf z` as `(h, l)` for `2 ^ -61 ≤ z ≤ 0x1.7afb48dc96626p+2`, from the
polynomial of row `i - 1` of `C2` at `z - (2 i + 1)/16` for `i = ⌊8 z⌋` from `1/8`.  The first
loop's step `k` handles degree `17 - k`, the second's degree `10 - k`, and the third's degree
`7 - k`. -/
def erfAccurate (tab : Array UInt64) (z : Float) : Float × Float :=
  if z < 0.125 then erfAccurateTiny z
  else
    let v := floorF (8.0 * z)
    let o := 27 * (v.toUInt64 - 1)
    let z := (z - 0.0625) - 0.125 * v
    let h := LeanExe.loop 7 (entry tab (o + 26)) fun k h => Library.Numerics.Arithmetic.Fma.fma h z (entry tab (o + 25 - k))
    let (h, l) := LeanExe.loop 3 (h, (0.0 : Float)) fun k s =>
      let (th, tl) := aMul s.1 z
      let tl := Library.Numerics.Arithmetic.Fma.fma s.2 z tl
      let (h, l) := twoSum (entry tab (o + 18 - k)) th
      (h, l + tl)
    LeanExe.loop 8 (h, l) fun k s =>
      let (th, tl) := aMul s.1 z
      let tl := Library.Numerics.Arithmetic.Fma.fma s.2 z tl
      let (h, l) := twoSum (entry tab (o + 2 * (7 - k))) th
      (h, l + (entry tab (o + 2 * (7 - k) + 1) + tl))

/-- `q_1`: `exp (zh + zl)` as a double-double for `|zh + zl| < 0.000130273`. -/
def q1 (zh zl : Float) : Float × Float :=
  let z := zh + zl
  let q := Library.Numerics.Arithmetic.Fma.fma (Float.ofBits 0x3FA55555558489DC) zh  -- 0x1.55555558489dcp-5
    (Float.ofBits 0x3FC5555555995D37)  -- 0x1.5555555995d37p-3
  let q := Library.Numerics.Arithmetic.Fma.fma q z 0.5
  let (hi, lo) := fastTwoSum 1.0 (q * z)
  let (hi, lo) := dMul zh zl hi lo
  fastSum 1.0 hi lo

/-- `exp_1`: `exp (xh + xl)` as a double-double, from `2 ^ (k/4096)` with `k` nearest to
`(xh + xl) · 4096/log 2`, the tables `T1` and `T2` of `2 ^ (i/64)` and `2 ^ (i/4096)`, and `q_1`. -/
def exp1 (tab : Array UInt64) (xh xl : Float) : Float × Float :=
  let k := roundEven (xh * Float.ofBits 0x40B71547652B82FE)  -- 0x1.71547652b82fep+12
  let (kh, kl) := sMul k (Float.ofBits 0x3F262E42FEFA39EF)  -- 0x1.62e42fefa39efp-13
    (Float.ofBits 0x3BBABC9E3B39803F)  -- 0x1.abc9e3b39803fp-68
  let (yh, yl) := fastTwoSum (xh - kh) xl
  let yl := yl - kl
  let kw := toWord k
  let m := sar kw 12 + 0x3ff
  let i2 := sar kw 6 &&& 0x3f
  let i1 := kw &&& 0x3f
  let (hi, lo) := dMul (entry tab (128 + 2 * i1)) (entry tab (128 + 2 * i1 + 1))
    (entry tab (2 * i2)) (entry tab (2 * i2 + 1))
  let (qh, ql) := q1 yh yl
  let (hi, lo) := dMul hi lo qh ql
  let d := Float.ofBits (m <<< 52)
  (hi * d, lo * d)

/-- `exp_accurate`: `exp (xh + xl)` as `(h, l, e)` with `exp (xh + xl) ≈ (h + l) · 2 ^ e`, for
`-742 ≤ xh + xl ≤ -2.92`, from the reduced argument `xh + xl - e log 2` and the polynomial `E2`.
`e` is an integer-valued double.  The second loop's step `k` handles degree `14 - k`, and the
third's degree `7 - k`. -/
def expAccurate (tab : Array UInt64) (xh xl : Float) : Float × Float × Float :=
  let k := roundEven (xh * Float.ofBits 0x3FF71547652B82FE)  -- 0x1.71547652b82fep+0
  let log2h := Float.ofBits 0x3FE62E42FEFA39EF  -- 0x1.62e42fefa39efp-1
  let log2l := Float.ofBits 0x3C7ABC9E3B398000  -- 0x1.abc9e3b398p-56
  let log2tiny := Float.ofBits 0x398F97B57A079A19  -- 0x1.f97b57a079a19p-103
  let yh := Library.Numerics.Arithmetic.Fma.fma (-k) log2h xh
  let (th, tl) := twoSum (-k * log2l) xl
  let (yh, yl) := fastTwoSum yh th
  let yl := Library.Numerics.Arithmetic.Fma.fma (-k) log2tiny (yl + tl)
  let h := LeanExe.loop 3 (entry tab 27) fun j h => Library.Numerics.Arithmetic.Fma.fma h yh (entry tab (26 - j))
  let (th, tl) := aMul h yh
  let tl := Library.Numerics.Arithmetic.Fma.fma h yl tl
  let (h, l) := fastTwoSum (entry tab 23) th
  let l := l + tl
  let (h, l) := LeanExe.loop 7 (h, l) fun j s =>
    let (th, tl) := aMul s.1 yh
    let tl := Library.Numerics.Arithmetic.Fma.fma s.1 yl tl
    let tl := Library.Numerics.Arithmetic.Fma.fma s.2 yh tl
    let (h, l) := fastTwoSum (entry tab (22 - j)) th
    (h, l + tl)
  let (h, l) := LeanExe.loop 8 (h, l) fun j s =>
    let (th, tl) := aMul s.1 yh
    let tl := Library.Numerics.Arithmetic.Fma.fma s.1 yl tl
    let tl := Library.Numerics.Arithmetic.Fma.fma s.2 yh tl
    let (h, l) := fastTwoSum (entry tab (2 * (7 - j))) th
    (h, l + (tl + entry tab (2 * (7 - j) + 1)))
  (h, l, k)

/-- The index of `erfc_asympt_fast`'s interval of `1/x`: the first `i` with `yh ≤ threshold[i]`.
Above `0x1.713786d9c7c09p+1`, `yh` is at most `0x1.62fffffffffffp-2`, below the last threshold
`0x1.63p-2`, so the chain ends at 5 without comparing with it. -/
def asymptIndex (yh : Float) : UInt64 :=
  if yh ≤ Float.ofBits 0x3FBD500000000000 then 0  -- 0x1.d5p-4
  else if yh ≤ Float.ofBits 0x3FC59DA6CA291BA6 then 1  -- 0x1.59da6ca291ba6p-3
  else if yh ≤ Float.ofBits 0x3FCBC00000000000 then 2  -- 0x1.bcp-3
  else if yh ≤ Float.ofBits 0x3FD0C00000000000 then 3  -- 0x1.0cp-2
  else if yh ≤ Float.ofBits 0x3FD3800000000000 then 4  -- 0x1.38p-2
  else 5

/-- `erfc_asympt_fast`: `erfc x` as `(h, l, err)` for `0x1.713786d9c7c09p+1 < x`, as
`exp (-x²) p (1/x)`, with the absolute error bound `err`; from `0x1.9db1bb14e15cap+4` on it gives
`(0, 0, 1)`, which sends the input to the accurate path.  The loop's step `j` handles degree
`15 - 2 j`. -/
def erfcAsymptFast (expTab asymTab : Array UInt64) (x : Float) : Float × Float × Float :=
  if x ≥ Float.ofBits 0x4039DB1BB14E15CA then  -- 0x1.9db1bb14e15cap+4
    (0.0, 0.0, 1.0)
  else
    let (uh, ul) := aMul x x
    let (eh, el) := exp1 expTab (-uh) (-ul)
    let yh := 1.0 / x
    let yl := yh * Library.Numerics.Arithmetic.Fma.fma (-x) yh 1.0
    let o := 13 * asymptIndex yh
    let (uh, ul) := aMul yh yh
    let ul := Library.Numerics.Arithmetic.Fma.fma (2.0 * yh) yl ul
    let zh := entry asymTab (o + 12)
    let zh := Library.Numerics.Arithmetic.Fma.fma zh uh (entry asymTab (o + 11))
    let zh := Library.Numerics.Arithmetic.Fma.fma zh uh (entry asymTab (o + 10))
    let (h, l) := sMul zh uh ul
    let (zh, zl) := fastTwoSum (entry asymTab (o + 9)) h
    let zl := zl + l
    let (zh, zl) := LeanExe.loop 7 (zh, zl) fun j s =>
      let (h, l) := dMul s.1 s.2 uh ul
      let (zh, zl) := fastTwoSum (entry asymTab (o + 8 - j)) h
      (zh, zl + l)
    let (h, l) := dMul zh zl uh ul
    let (zh, zl) := fastTwoSum (entry asymTab o) h
    let zl := zl + (l + entry asymTab (o + 1))
    let (uh, ul) := dMul zh zl yh yl
    let (h, l) := dMul uh ul eh el
    if h ≥ Float.ofBits 0x044151B9A3FDD5C9 then  -- 0x1.151b9a3fdd5c9p-955
      (h, l, Float.ofBits 0x3BBD900000000000 * h)  -- 0x1.d9p-68
    else (h, l, Float.ofBits 0x0010000000000000)  -- 0x1p-1022

/-- `cr_erfc_fast`: `erfc x` as `(h, l, err)` for `-0x1.7744f8f74e94bp2 < x < 0x1.b39dc41e48bfdp+4`,
with the absolute error bound `err`. -/
def erfcFast (fastTab expTab asymTab : Array UInt64) (x : Float) : Float × Float × Float :=
  if x < 0.0 then
    let (h, l, err) := erfFast fastTab (-x)
    let err := err * h
    let (h, t) := fastTwoSum 1.0 h
    (h, t + l, err + Float.ofBits 0x3994000000000000)  -- 0x1.4p-102
  else if x ≤ Float.ofBits 0x400713786D9C7C09 then  -- 0x1.713786d9c7c09p+1
    let (h, l, err) := erfFast fastTab x
    let err := err * h
    let (h, t) := fastTwoSum 1.0 (-h)
    let l := t - l
    if x ≥ Float.ofBits 0x3FDE861FBB24C00A then (h, l, err)  -- 0x1.e861fbb24c00ap-2
    else (h, l, err + Float.ofBits 0x3974000000000000)  -- 0x1.4p-104
  else erfcAsymptFast expTab asymTab x

/-- `h + l` for the row of the table of hard cases at `o + 3 k` whose input is `x`, for `k < n`, and
`f` if there is none. -/
def hardCase (tab : Array UInt64) (o n : UInt64) (x f : Float) : Float :=
  LeanExe.loop n f fun k acc =>
    if entry tab (o + 3 * k) == x then entry tab (o + 3 * k + 1) + entry tab (o + 3 * k + 2)
    else acc

/-- The index of `erfc_asympt_accurate`'s interval of `1/x`: the first `i` with
`yh ≤ threshold[i]`.  Above `0x1.b59ffb450828cp+0`, `yh` is at most `0x1.2b81f34bfce35p-1`, below
the last threshold `0x1.3p-1`, so the chain ends at 9 without comparing with it. -/
def asymptAccIndex (yh : Float) : UInt64 :=
  if yh ≤ Float.ofBits 0x3FB4500000000000 then 0  -- 0x1.45p-4
  else if yh ≤ Float.ofBits 0x3FBE000000000000 then 1  -- 0x1.e0p-4
  else if yh ≤ Float.ofBits 0x3FC3F00000000000 then 2  -- 0x1.3fp-3
  else if yh ≤ Float.ofBits 0x3FC9500000000000 then 3  -- 0x1.95p-3
  else if yh ≤ Float.ofBits 0x3FCF500000000000 then 4  -- 0x1.f5p-3
  else if yh ≤ Float.ofBits 0x3FD3100000000000 then 5  -- 0x1.31p-2
  else if yh ≤ Float.ofBits 0x3FD7100000000000 then 6  -- 0x1.71p-2
  else if yh ≤ Float.ofBits 0x3FDBC00000000000 then 7  -- 0x1.bcp-2
  else if yh ≤ Float.ofBits 0x3FE0B00000000000 then 8  -- 0x1.0bp-1
  else 9

/-- `erfc_asympt_accurate` without its tables of hard cases: `erfc x` for
`0x1.b59ffb450828cp+0 < x < 0x1.b39dc41e48bfdp+4` as `exp (-x²) p (1/x)`, with `p` of degree
`29 + 2 i` on interval `i`, rounded once, also in the subnormal range.  The first loop's step `j`
handles degree `27 + 2 i - 2 j`, and the second's degree `11 - 2 j`. -/
def asymptAccurate (expAccTab tab : Array UInt64) (x : Float) : Float :=
  let (uh, ul) := aMul x x
  let (eh, el, e) := expAccurate expAccTab (-uh) (-ul)
  let yh := 1.0 / x
  let yl := yh * Library.Numerics.Arithmetic.Fma.fma (-x) yh 1.0
  let i := asymptAccIndex yh
  let o := 30 * i
  let (uh, ul) := aMul yh yh
  let ul := Library.Numerics.Arithmetic.Fma.fma (2.0 * yh) yl ul
  let (zh, zl) := LeanExe.loop (8 + i) (entry tab (o + 20 + i), (0.0 : Float)) fun j s =>
    let (h, l) := aMul s.1 uh
    let l := Library.Numerics.Arithmetic.Fma.fma s.1 ul l
    let l := Library.Numerics.Arithmetic.Fma.fma s.2 uh l
    let (zh, zl) := twoSum (entry tab (o + 19 + i - j)) h
    (zh, zl + l)
  let (zh, zl) := LeanExe.loop 6 (zh, zl) fun j s =>
    let (h, l) := aMul s.1 uh
    let l := Library.Numerics.Arithmetic.Fma.fma s.1 ul l
    let l := Library.Numerics.Arithmetic.Fma.fma s.2 uh l
    let (zh, zl) := twoSum (entry tab (o + 10 - 2 * j)) h
    (zh, zl + (l + entry tab (o + 11 - 2 * j)))
  let (uh, ul) := aMul zh yh
  let ul := Library.Numerics.Arithmetic.Fma.fma zh yl ul
  let ul := Library.Numerics.Arithmetic.Fma.fma zl yh ul
  let (uh, ul) := fastTwoSum uh ul
  let (h, l) := aMul uh eh
  let l := Library.Numerics.Arithmetic.Fma.fma uh el l
  let l := Library.Numerics.Arithmetic.Fma.fma ul eh l
  let res := ldexp (h + l) e
  if res < Float.ofBits 0x0010000000000000 then  -- 0x1p-1022
    let corr := h - ldexp res (-e)
    let corr := corr + l
    res + ldexp corr e
  else res

/-- `erfc_asympt_accurate`: the hard cases, the subnormal input `0x1.a8f7bfbd15495p+4`, and
`asymptAccurate`. -/
def erfcAsymptAccurate (expAccTab asymAccTab excTab : Array UInt64) (x : Float) : Float :=
  if x == Float.ofBits 0x403A8F7BFBD15495 then  -- 0x1.a8f7bfbd15495p+4
    Library.Numerics.Arithmetic.Fma.fma (Float.ofBits 0x0000000000000001) (-0.25)  -- 0x1p-1074
      (Float.ofBits 0x000667BD620FD95B)  -- 0x1.99ef5883f656cp-1024
  else hardCase excTab 0 22 x (asymptAccurate expAccTab asymAccTab x)

/-- `cr_erfc_accurate`: `erfc x` to about 104 bits, rounded once, for the arguments where the fast
path cannot decide the rounding. -/
def erfcAccurate (accTab expAccTab asymAccTab excTab : Array UInt64) (x : Float) : Float :=
  if x < 0.0 then
    hardCase excTab 66 17 x
      (let (h, l) := erfAccurate accTab (-x)
       let (h, t) := fastTwoSum 1.0 h
       h + (t + l))
  else if x ≤ Float.ofBits 0x3FFB59FFB450828C then  -- 0x1.b59ffb450828cp+0
    hardCase excTab 117 29 x
      (let (h, l) := erfAccurate accTab x
       let (h, t) := fastTwoSum 1.0 (-h)
       h + (t - l))
  else erfcAsymptAccurate expAccTab asymAccTab excTab x

/-- The main path of `cr_erfc`: the fast path when its rounding test passes, and the accurate path
otherwise. -/
def erfcMain (fastTab accTab expTab asymTab asymAccTab expAccTab excTab : Array UInt64)
    (x : Float) : Float :=
  let (h, l, err) := erfcFast fastTab expTab asymTab x
  let left := h + (l - err)
  let right := h + (l + err)
  if left == right then left else erfcAccurate accTab expAccTab asymAccTab excTab x

/-- `cr_erfc` with the tables of the module. -/
def erfcWith (fastTab accTab expTab asymTab asymAccTab expAccTab excTab : Array UInt64)
    (x : Float) : Float :=
  let t := x.toBits
  let ax := t &&& 0x7FFFFFFFFFFFFFFF
  if t ≥ 0x8000000000000000 then
    if t ≥ 0xC017744F8F74E94B then  -- -0x1.7744f8f74e94bp2
      if t ≥ 0xFFF0000000000000 then
        if t == 0xFFF0000000000000 then 2.0 else x + x
      else 2.0 - Float.ofBits 0x3C90000000000000  -- 0x1p-54
    else if Float.ofBits 0xBC9C5BF891B4EF6A ≤ x then  -- -0x1.c5bf891b4ef6ap-54
      Library.Numerics.Arithmetic.Fma.fma (-x) (Float.ofBits 0x3C90000000000000) 1.0  -- 0x1p-54
    else erfcMain fastTab accTab expTab asymTab asymAccTab expAccTab excTab x
  else if ax ≥ 0x403B39DC41E48BFD then  -- 0x1.b39dc41e48bfdp+4
    if ax ≥ 0x7FF0000000000000 then
      if ax == 0x7FF0000000000000 then 0.0 else x + x
    else Float.ofBits 0x0000000000000001 * 0.25  -- 0x1p-1074
  else if x ≤ Float.ofBits 0x3C8C5BF891B4EF6A then  -- 0x1.c5bf891b4ef6ap-55
    Library.Numerics.Arithmetic.Fma.fma (-x) (Float.ofBits 0x3C90000000000000) 1.0  -- 0x1p-54
  else erfcMain fastTab accTab expTab asymTab asymAccTab expAccTab excTab x

/-- `erfc x`, CORE-MATH's correctly rounded complementary error function. -/
def erfc (x : Float) : Float :=
  erfcWith fastTable accTable expTable asymTable asymAccTable expAccTable excTable x

end Library.Numerics.Float64.Erfc
