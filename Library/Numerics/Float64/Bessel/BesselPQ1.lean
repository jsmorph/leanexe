  obtain ⟨hp, hSp, hpb'⟩ := ratio_at pr0 ps0 fpr fps (by decide) y hxf _ _ hv.1 hv.2 (by norm_num)
    (by norm_num) (16385 / 4722366482869645213696 : ℚ) (1 / 360287970189639680 : ℚ) (207 / 100000 : ℚ) (-1 / 1125899906842624 : ℚ) (1 / 512 : ℚ) [(1 / 256 : ℚ), (3 / 512 : ℚ), (1 / 128 : ℚ), (5 / 512 : ℚ), (3 / 256 : ℚ), (7 / 512 : ℚ), (17179869185 / 1099511627776 : ℚ)] check_p0 bounds_p0
    (by norm_num [unitRoundoff64]) (by norm_num) (by norm_num [lastD])
  obtain ⟨hq, hSq, hqb'⟩ := ratio_at qr0 qs0 fqr fqs (by decide) y hxf _ _ hv.1 hv.2 (by norm_num)
    (by norm_num) (16385 / 4722366482869645213696 : ℚ) (1 / 360287970189639680 : ℚ) (37 / 20000 : ℚ) (-1 / 1125899906842624 : ℚ) (1 / 512 : ℚ) [(1 / 256 : ℚ), (3 / 512 : ℚ), (1 / 128 : ℚ), (5 / 512 : ℚ), (3 / 256 : ℚ), (7 / 512 : ℚ), (17179869185 / 1099511627776 : ℚ)] check_q0 bounds_q0
    (by norm_num [unitRoundoff64]) (by norm_num) (by norm_num [lastD])
  have hpb := ratio_abs _ _ _ _ ⟨hSp, hpb'⟩
  have hqb := ratio_abs _ _ _ _ ⟨hSq, hqb'⟩
  have hpsg : 0 ≤ eval (pr0.map ratOfWord) (1 / v ^ 2) / eval (1 :: ps0.map ratOfWord) (1 / v ^ 2) :=
    div_nonneg (eval_nonneg _ (by decide +kernel) _ (by positivity)) hSp.le
  have hqsg : eval (qr0.map ratOfWord) (1 / v ^ 2) / eval (1 :: qs0.map ratOfWord) (1 / v ^ 2) ≤ 0 :=
    div_nonpos_of_nonpos_of_nonneg (eval_nonpos _ (by decide +kernel) _ (by positivity)) hSq.le
  set ρp := eval (pr0.map ratOfWord) (1 / v ^ 2) / eval (1 :: ps0.map ratOfWord) (1 / v ^ 2)
