    (by decide) hlt).mpr hlo
  have h2 := F64PositiveOrder.value_strict (left := x.toBits) (right := (0x4800000100000000 : UInt64))
    (by decide) hhi
  have e1 : value (0x4020000000000000 : UInt64) = (8 : ℝ) := by
    rw [← ratOfWord_cast]
    have : ratOfWord 0x4020000000000000 = (8 : ℚ) := by decide +kernel
    rw [this]; push_cast; ring
  have e2 : value (0x4800000100000000 : UInt64) ≤ (1361129467683753853853498429727072845824 : ℝ) := by
    rw [← ratOfWord_cast]
    have : ratOfWord 0x4800000100000000 ≤ (1361129467683753853853498429727072845824 : ℚ) := by decide +kernel
    have h := (Rat.cast_le (K := ℝ)).mpr this
    push_cast at h
    linarith
  constructor <;> linarith

theorem pAsym_0 (x : Float) (h : Bessel.rangeOf ((x.toBits >>> 32) &&& 0x7fffffff) = 0) :
    Bessel.pAsym Bessel.j1Table x = 1.0 + hornerF (pr0.map Float.ofBits) (1.0 / (x * x)) /
      hornerF (1.0 :: ps0.map Float.ofBits) (1.0 / (x * x)) := by
  unfold Bessel.pAsym
  rw [h]
  rfl

theorem qRatio_0 (x : Float) (h : Bessel.rangeOf ((x.toBits >>> 32) &&& 0x7fffffff) = 0) :
    Bessel.qRatio Bessel.j1Table x = hornerF (qr0.map Float.ofBits) (1.0 / (x * x)) /
      hornerF (1.0 :: qs0.map Float.ofBits) (1.0 / (x * x)) := by
  unfold Bessel.qRatio
  rw [h]
  rfl

/-- `pAsym` and the `Q` term on range 0. -/
theorem pq_r0 (y : Float) (hxf : Finite y.toBits) (hlo : 0x4020000000000000 ≤ y.toBits.toNat)
    (hhi : y.toBits.toNat < 0x4800000100000000) :
