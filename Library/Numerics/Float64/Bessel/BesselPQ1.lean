      FApprox ((0.375 + Bessel.qRatio Bessel.j1Table y) / y) (Q1 (value y.toBits)) (((1 / 360287970189639680 : ℝ) + 𝐮 / 4) / (8 : ℝ) + (3 / 8 + ((1 / 360287970189639680 : ℝ) + 𝐮 / 4)) / (8 : ℝ) / 2 ^ 53 + 1 / 2 ^ 1075 + (20 / 2 ^ 68 + 1 / 2 ^ 70 : ℝ)) ∧
