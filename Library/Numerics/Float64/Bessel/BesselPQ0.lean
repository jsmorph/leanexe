  have e1 : value (0x4020000000000000 : UInt64) = (8 : ℝ) := by
    rw [← ratOfWord_cast]
    have : ratOfWord 0x4020000000000000 = (8 : ℚ) := by decide +kernel
    rw [this]; push_cast; ring
  have e2 : value (0x4800000100000000 : UInt64) ≤ (1361129467683753853853498429727072845824 : ℝ) := by
    rw [← ratOfWord_cast]
    have : ratOfWord 0x4800000100000000 ≤ (1361129467683753853853498429727072845824 : ℚ) := by decide +kernel
    have h := (Rat.cast_le (K := ℝ)).mpr this
    push_cast at h
    linarith
  constructor <;> linarith

theorem pAsym_0 (x : Float) (h : Bessel.rangeOf ((x.toBits >>> 32) &&& 0x7fffffff) = 0) :
    Bessel.pAsym Bessel.j0Table x = 1.0 + hornerF (pr0.map Float.ofBits) (1.0 / (x * x)) /
      hornerF (1.0 :: ps0.map Float.ofBits) (1.0 / (x * x)) := by
  unfold Bessel.pAsym
  rw [h]
  rfl

theorem qRatio_0 (x : Float) (h : Bessel.rangeOf ((x.toBits >>> 32) &&& 0x7fffffff) = 0) :
    Bessel.qRatio Bessel.j0Table x = hornerF (qr0.map Float.ofBits) (1.0 / (x * x)) /
      hornerF (1.0 :: qs0.map Float.ofBits) (1.0 / (x * x)) := by
  unfold Bessel.qRatio
  rw [h]
  rfl

/-- `pAsym` and the `Q` term on range 0. -/
theorem pq_r0 (x : Float) (hxf : Finite x.toBits) (hlo : 0x4020000000000000 ≤ x.toBits.toNat)
    (hhi : x.toBits.toNat < 0x4800000100000000) :
    FApprox (Bessel.pAsym Bessel.j0Table x) (P0 (value x.toBits)) ((3 / 1801439850948198400 : ℝ) + 𝐮 + (261 / 2 ^ 68 + 1 / 2 ^ 70 : ℝ)) ∧
      FApprox ((Bessel.qRatio Bessel.j0Table x - 0.125) / x) (Q0 (value x.toBits)) (((9 / 4503599627370496000 : ℝ) + 𝐮 / 8) / (8 : ℝ) + (1 / 8 + ((9 / 4503599627370496000 : ℝ) + 𝐮 / 8)) / (8 : ℝ) / 2 ^ 53 + 1 / 2 ^ 1075 + (18 / 2 ^ 68 + 1 / 2 ^ 70 : ℝ)) ∧
      1 - (31 / 25000 : ℝ) - (261 / 2 ^ 68 + 1 / 2 ^ 70 : ℝ) ≤ P0 (value x.toBits) ∧ P0 (value x.toBits) ≤ 1 + (261 / 2 ^ 68 + 1 / 2 ^ 70 : ℝ) ∧
      |Q0 (value x.toBits)| ≤ 1 / 8 / (8 : ℝ) + (18 / 2 ^ 68 + 1 / 2 ^ 70 : ℝ) := by
  obtain ⟨fpr, fps, fqr, fqs⟩ := words_0
  obtain ⟨lpr, lps, lqr, lqs⟩ := lists_0
  have hv := value_0 x hlo hhi
  set v := value x.toBits with hvdef
  have hv0 : 0 < v := by linarith [hv.1]
  have hk := range_0 x hlo hhi
  obtain ⟨hp, hSp, hpb'⟩ := ratio_at pr0 ps0 fpr fps (by decide) x hxf _ _ hv.1 hv.2 (by norm_num)
    (by norm_num) (16385 / 4722366482869645213696 : ℚ) (3 / 1801439850948198400 : ℚ) (31 / 25000 : ℚ) (-1 / 1125899906842624 : ℚ) (1 / 512 : ℚ) [(1 / 256 : ℚ), (3 / 512 : ℚ), (1 / 128 : ℚ), (5 / 512 : ℚ), (3 / 256 : ℚ), (7 / 512 : ℚ), (17179869185 / 1099511627776 : ℚ)] check_p0 bounds_p0
    (by norm_num [unitRoundoff64]) (by norm_num) (by norm_num [lastD])
  obtain ⟨hq, hSq, hqb'⟩ := ratio_at qr0 qs0 fqr fqs (by decide) x hxf _ _ hv.1 hv.2 (by norm_num)
    (by norm_num) (16385 / 4722366482869645213696 : ℚ) (9 / 4503599627370496000 : ℚ) (33 / 25000 : ℚ) (-1 / 1125899906842624 : ℚ) (1 / 512 : ℚ) [(1 / 256 : ℚ), (3 / 512 : ℚ), (1 / 128 : ℚ), (5 / 512 : ℚ), (3 / 256 : ℚ), (7 / 512 : ℚ), (17179869185 / 1099511627776 : ℚ)] check_q0 bounds_q0
    (by norm_num [unitRoundoff64]) (by norm_num) (by norm_num [lastD])
  have hpb := ratio_abs _ _ _ _ ⟨hSp, hpb'⟩
  have hqb := ratio_abs _ _ _ _ ⟨hSq, hqb'⟩
  have hpsg : eval (pr0.map ratOfWord) (1 / v ^ 2) / eval (1 :: ps0.map ratOfWord) (1 / v ^ 2) ≤ 0 :=
    div_nonpos_of_nonpos_of_nonneg (eval_nonpos _ (by decide +kernel) _ (by positivity)) hSp.le
  have hqsg : 0 ≤ eval (qr0.map ratOfWord) (1 / v ^ 2) / eval (1 :: qs0.map ratOfWord) (1 / v ^ 2) :=
    div_nonneg (eval_nonneg _ (by decide +kernel) _ (by positivity)) hSq.le
  set ρp := eval (pr0.map ratOfWord) (1 / v ^ 2) / eval (1 :: ps0.map ratOfWord) (1 / v ^ 2)
    with hρp
  set ρq := eval (qr0.map ratOfWord) (1 / v ^ 2) / eval (1 :: qs0.map ratOfWord) (1 / v ^ 2)
    with hρq
  have hpfd : 1 + ρp = pFd BesselFd0b.pR8 BesselFd0b.pS8 v := by
    rw [hρp, ← lpr, ← lps, eval_one_cons, BesselRatio.pFd]
  have hqfd : (ρq - 1 / 8) / v = qFd (-1 / 8) BesselFd0b.qR8 BesselFd0b.qS8 v := by
    rw [hρq, ← lqr, ← lqs, eval_one_cons, BesselRatio.qFd]
    push_cast
    ring
  have happ := BesselFd0b.pzero_8 v (by push_cast; linarith)
  have happq := BesselFd0b.qzero_8 v (by push_cast; linarith)
  rw [← hpfd] at happ
  rw [← hqfd] at happq
  refine ⟨?_, ?_, ?_⟩
  · rw [pAsym_0 x hk]
    have h1 := p_of_ratio hp hpb (by norm_num [unitRoundoff64])
    have h2 := fshift (v' := P0 v) (d := (261 / 2 ^ 68 + 1 / 2 ^ 70 : ℝ)) h1 (by rw [abs_sub_comm]; exact happ)
    exact fmono h2 (le_of_eq (by push_cast; ring))
  · rw [qRatio_0 x hk]
    have h1 := q0_of_ratio hq hxf hqsg (abs_le.mp hqb).2 (by norm_num) (by norm_num) (by norm_num) hv.1
    have h2 := fshift (v' := Q0 v) (d := (18 / 2 ^ 68 + 1 / 2 ^ 70 : ℝ)) h1 (by rw [abs_sub_comm]; exact happq)
    exact fmono h2 (le_of_eq (by push_cast; ring))
  · refine ⟨?_, ?_, ?_⟩
    · have := (abs_le.mp hpb).1
      have := (abs_le.mp happ).1
      linarith
    · have := (abs_le.mp happ).2
      linarith
    have h1 : |(ρq - 1 / 8) / v| ≤ 1 / 8 / (8 : ℝ) := by
      rw [abs_div, abs_of_pos hv0, div_le_div_iff₀ hv0 (by norm_num)]
      have : |ρq - 1 / 8| ≤ 1 / 8 := by rw [abs_le]; constructor <;> linarith [(abs_le.mp hqb).2]
      nlinarith [hv.1]
    have := abs_sub_abs_le_abs_sub (Q0 v) ((ρq - 1 / 8) / v)
    linarith

