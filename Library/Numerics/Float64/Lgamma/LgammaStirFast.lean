import LeanExe.ProofKit.GammaFits
import Library.Numerics.Float64.Tgamma.TgammaFactsBase
import Library.Numerics.Float64.Lgamma.Compiled
import Library.Numerics.Float64.Tgamma.GammaPi

/-!
The fast path's Stirling fit of `cr_lgamma` from `0x1.0974p+3 - 2 ^ -40` to 16 (`lgamma.c` lines
970-1000, commit `ff2f71f6`), read from `Lgamma.mainTable` at words 397 to 405: on each of 16
pieces a Taylor model of `lgamma` bounds the fit within `7 · 10 ^ -20` of `lgamma` at the piece's
left end, and the monotony of `lgamma` above 2 makes the bound relative (`piece_rel`).
-/

namespace Library.Numerics.Float64.Lgamma.LgammaStirFast

open Real LeanExe.ProofKit PolyBound TaylorModel GammaBasic GammaModels GammaFits GammaThresholds
  Library.Numerics.Float64.Tgamma.TgammaFactsBase

/-- The fast path's Stirling fit from 8.29541 on: the constant and the coefficients. -/
def c0Fast : ℚ := q Lgamma.mainTable 397 + q Lgamma.mainTable 398

def pFast : List ℚ :=
  (q Lgamma.mainTable 399 + q Lgamma.mainTable 400) :: coeffs Lgamma.mainTable 401 1 5

/-- The Taylor-model parameters of the pieces: the pieces' radius, degree 18, 100 bits, at most 60
series terms with factor below `2 ^ -100`, and `π` within `2 ^ -128`. -/
def cfgF : Cfg :=
  ⟨8471286120449 / 2 ^ 45, 18, 100, 60, 1 / 2 ^ 100, Library.Numerics.Float64.Tgamma.GammaPi.piLo128, Library.Numerics.Float64.Tgamma.GammaPi.piHi128⟩

theorem cfgF_pi : ((cfgF.piLo : ℚ) : ℝ) ≤ π ∧ π ≤ ((cfgF.piHi : ℚ) : ℝ) := Library.Numerics.Float64.Tgamma.GammaPi.pi_bounds128

/-- The parameters of the values at points: radius 0. -/
def cfgZ : Cfg := ⟨0, 2, 100, 60, 1 / 2 ^ 100, Library.Numerics.Float64.Tgamma.GammaPi.piLo128, Library.Numerics.Float64.Tgamma.GammaPi.piHi128⟩

theorem cfgZ_pi : ((cfgZ.piLo : ℚ) : ℝ) ≤ π ∧ π ≤ ((cfgZ.piHi : ℚ) : ℝ) := Library.Numerics.Float64.Tgamma.GammaPi.pi_bounds128

/-- One piece: the fit within `ε` of `lgamma`, and `lgamma` at the piece's left end `b` at least
`Lq - e`, give the relative bound `rel` on the piece. -/
theorem piece_rel (n nb : ℕ) (ly lp ld lyb lpb : LogData) (a b C0 Lq e ε rel : ℚ) (P : List ℚ)
    (depth : ℕ)
    (hf : lgammaDiffOk cfgF ⟨a, n, log2Lo, log2Hi, ly, lp⟩ (fitExpr a ld log2Lo log2Hi C0 P) ε
      depth = true)
    (hp : lgammaDiffOk cfgZ ⟨b, nb, log2Lo, log2Hi, lyb, lpb⟩ (.const Lq) e 0 = true)
    (hb2 : (2 : ℝ) ≤ b) (hba : (b : ℝ) = a - cfgF.r) (hε : (ε : ℝ) ≤ rel * (Lq - e))
    (hrel : (0 : ℝ) ≤ rel) (t : ℝ) (ht : |t| ≤ (cfgF.r : ℝ)) :
    |lgamma (a + t) - fit C0 P (a + t)| ≤ rel * lgamma (a + t) := by
  have h1 := fit_piece cfgF cfgF_pi ⟨a, n, log2Lo, log2Hi, ly, lp⟩ ld C0 P ε depth hf t ht
  have h2 := lgammaDiffOk_sound cfgZ ⟨b, nb, log2Lo, log2Hi, lyb, lpb⟩ (.const Lq) e 0 cfgZ_pi hp
    (t := 0) (by simp [cfgZ])
  simp only [TaylorModel.Expr.eval, add_zero] at h2
  have hm : lgamma b ≤ lgamma (a + t) :=
    lgamma_mono hb2 (by have := (abs_le.mp ht).1; linarith)
  have h2' := (abs_le.mp h2).1
  calc |lgamma (a + t) - fit C0 P (a + t)| ≤ ε := h1
    _ ≤ rel * (Lq - e) := hε
    _ ≤ rel * lgamma (a + t) := mul_le_mul_of_nonneg_left (by linarith) hrel

