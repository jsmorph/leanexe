/-- The fit within `(1 / 2 ^ 87)` of `lgamma`, relative, on the pieces' interval. -/
theorem cover : ∀ x : ℝ, ((11682311045119 : ℝ) / 2 ^ 40) ≤ x →
    x ≤ ((11682311045119 : ℝ) / 2 ^ 40) + 2 * ((1 : ℝ) / 16) * 11 →
    |lgamma x - fit c0Asym pAsym x| ≤ (1 / 2 ^ 87) * lgamma x := by
  refine cover_pieces (K := 11) (by norm_num) (lo := ((11682311045119 : ℝ) / 2 ^ 40))
    (r := ((1 : ℝ) / 16)) (by norm_num)
    (fun x => |lgamma x - fit c0Asym pAsym x| ≤ (1 / 2 ^ 87) * lgamma x) ?_
  intro j hj t ht
  interval_cases j
  · have e : ((11682311045119 : ℝ) / 2 ^ 40) +
        ((1 : ℝ) / 16) * (2 * ((0 : ℕ) : ℝ) + 1) + t =
        (((11751030521855 / 2 ^ 40) : ℚ) : ℝ) + t := by
      norm_num
    rw [e]
    have h := piece_rel 12 6 _ _ _ _ _ (11751030521855 / 2 ^ 40)
      (11682311045119 / 2 ^ 40) c0Asym
      (1025327517608573907 / 2 ^ 56) (1025327517608573907 / 2 ^ 106)
      (1909821327 / 2 ^ 114) (1 / 2 ^ 87) pAsym
      0 f_0 p_0 (by norm_num) (by norm_num [cfgF]) (by norm_num) (by norm_num) t
      (by simp only [cfgF]; push_cast; exact ht)
    push_cast at h ⊢
    exact h
  · have e : ((11682311045119 : ℝ) / 2 ^ 40) +
        ((1 : ℝ) / 16) * (2 * ((1 : ℕ) : ℝ) + 1) + t =
        (((11888469475327 / 2 ^ 40) : ℚ) : ℝ) + t := by
