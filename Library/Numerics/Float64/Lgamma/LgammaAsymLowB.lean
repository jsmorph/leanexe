/-!
The accurate path's Stirling fit of `cr_lgamma` on `[15/4 - 2 ^ -40, 29/2 + 2 ^ -40]` (`lgamma.c`,
commit `ff2f71f6`), read from `Lgamma.asymTable` at words 40 to 95, on
`[41/8 - 2 ^ -40, 13/2 - 2 ^ -40]`: on each of 11 pieces a Taylor model of `lgamma` bounds the fit
within `2 ^ -87` of `lgamma` at the piece's left end, and the monotony of `lgamma` above 2 makes the
bound relative (`piece_rel`).
-/

namespace Library.Numerics.Float64.Lgamma.LgammaAsymLowB

open Real LeanExe.ProofKit PolyBound TaylorModel GammaBasic GammaModels GammaFits GammaThresholds
  Library.Numerics.Float64.Tgamma.TgammaFactsBase

/-- `as_lgamma_asym_accurate`'s fit on `[15/4 - 2 ^ -40, 29/2 + 2 ^ -40]`: the constant and the
coefficients. -/
def c0Asym : ℚ := q Lgamma.asymTable 40 + q Lgamma.asymTable 41

def pAsym : List ℚ := ddCoeffs Lgamma.asymTable 42 27

/-- The Taylor-model parameters of the pieces: the pieces' radius, degree 14, 120 bits, at most 60
series terms with factor below `2 ^ -120`, and `π` within `2 ^ -128`. -/
def cfgF : Cfg :=
  ⟨1 / 16, 14, 120, 60, 1 / 2 ^ 120, Library.Numerics.Float64.Tgamma.GammaPi.piLo128, Library.Numerics.Float64.Tgamma.GammaPi.piHi128⟩

theorem cfgF_pi : ((cfgF.piLo : ℚ) : ℝ) ≤ π ∧ π ≤ ((cfgF.piHi : ℚ) : ℝ) := Library.Numerics.Float64.Tgamma.GammaPi.pi_bounds128

/-- The parameters of the values at points: radius 0. -/
def cfgZ : Cfg := ⟨0, 2, 120, 60, 1 / 2 ^ 120, Library.Numerics.Float64.Tgamma.GammaPi.piLo128, Library.Numerics.Float64.Tgamma.GammaPi.piHi128⟩

theorem cfgZ_pi : ((cfgZ.piLo : ℚ) : ℝ) ≤ π ∧ π ≤ ((cfgZ.piHi : ℚ) : ℝ) := Library.Numerics.Float64.Tgamma.GammaPi.pi_bounds128

/-- One piece: the fit within `ε` of `lgamma`, and `lgamma` at the piece's left end `b` at least
`Lq - e`, give the relative bound `rel` on the piece. -/
theorem piece_rel (n nb : ℕ) (ly lp ld lyb lpb : LogData) (a b C0 Lq e ε rel : ℚ) (P : List ℚ)
    (depth : ℕ)
    (hf : lgammaDiffOk cfgF ⟨a, n, log2Lo, log2Hi, ly, lp⟩ (fitExpr a ld log2Lo log2Hi C0 P) ε
      depth = true)
    (hp : lgammaDiffOk cfgZ ⟨b, nb, log2Lo, log2Hi, lyb, lpb⟩ (.const Lq) e 0 = true)
    (hb2 : (2 : ℝ) ≤ b) (hba : (b : ℝ) = a - cfgF.r) (hε : (ε : ℝ) ≤ rel * (Lq - e))
    (hrel : (0 : ℝ) ≤ rel) (t : ℝ) (ht : |t| ≤ (cfgF.r : ℝ)) :
    |lgamma (a + t) - fit C0 P (a + t)| ≤ rel * lgamma (a + t) := by
  have h1 := fit_piece cfgF cfgF_pi ⟨a, n, log2Lo, log2Hi, ly, lp⟩ ld C0 P ε depth hf t ht
  have h2 := lgammaDiffOk_sound cfgZ ⟨b, nb, log2Lo, log2Hi, lyb, lpb⟩ (.const Lq) e 0 cfgZ_pi hp
    (t := 0) (by simp [cfgZ])
  simp only [TaylorModel.Expr.eval, add_zero] at h2
  have hm : lgamma b ≤ lgamma (a + t) :=
    lgamma_mono hb2 (by have := (abs_le.mp ht).1; linarith)
  have h2' := (abs_le.mp h2).1
  calc |lgamma (a + t) - fit C0 P (a + t)| ≤ ε := h1
    _ ≤ rel * (Lq - e) := hε
    _ ≤ rel * lgamma (a + t) := mul_le_mul_of_nonneg_left (by linarith) hrel

