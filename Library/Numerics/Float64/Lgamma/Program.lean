open Tgamma (entry fastTwoSum twoSum fastSum sumDD mulDD mulDDD roundEven floorF)

/-- `__builtin_copysign`: the magnitude of `a` with the sign of `b`. -/
def copySign (a b : Float) : Float :=
  Float.ofBits ((a.toBits &&& 0x7FFFFFFFFFFFFFFF) ||| (b.toBits &&& 0x8000000000000000))

/-- `polydd`: the double-double `c 0 + c 1 · x + ⋯ + (c (n - 1) + l) · x ^ (n - 1)` at the
double-double `xh + xl`, for the pairs `c k` at entry `o + 2 k` of `tab`, with `fastsum`. -/
def polyDD (tab : Array UInt64) (o n : UInt64) (xh xl l : Float) : Float × Float :=
  let (ch, cl) := fastTwoSum (entry tab (o + 2 * (n - 1))) l
  LeanExe.loop (n - 1) (ch, cl + entry tab (o + 2 * (n - 1) + 1)) fun j s =>
    let i := n - 2 - j
    let (ch, cl) := mulDD xh xl s.1 s.2
    fastSum (entry tab (o + 2 * i)) (entry tab (o + 2 * i + 1)) ch cl

/-- `polydddfst`: `polyDD` at a double `x`. -/
def polyDDDFst (tab : Array UInt64) (o n : UInt64) (x l : Float) : Float × Float :=
  let (ch, cl) := fastTwoSum (entry tab (o + 2 * (n - 1))) l
  LeanExe.loop (n - 1) (ch, cl + entry tab (o + 2 * (n - 1) + 1)) fun j s =>
    let i := n - 2 - j
    let (ch, cl) := mulDDD x s.1 s.2
    fastSum (entry tab (o + 2 * i)) (entry tab (o + 2 * i + 1)) ch cl

/-- `polyd`: `c 0 + c 1 · x + ⋯ + c (n - 1) · x ^ (n - 1)` in doubles, for the high parts `c k` at
entry `o + 2 k` of `tab`. -/
def polyD (tab : Array UInt64) (o n : UInt64) (x : Float) : Float :=
  LeanExe.loop (n - 1) (entry tab (o + 2 * (n - 1))) fun j ch =>
    entry tab (o + 2 * (n - 2 - j)) + x * ch

/-- The reduction of `as_logd` and `as_logd_accurate` for a positive finite `x`, subnormals
included: `(t, r, e, i1, i2)` with `x = t · 2 ^ e`, `1 ≤ t < 2`, the exponent `e` as a double, and
`r = r1 i1 · r2 i2` near `1/t`, from the tables of `Tgamma.logdTable`.  A subnormal `x` is
normalized with the count of its leading zero bits, `63 - Library.Numerics.Arithmetic.Fma.msb64`. -/
def logReduce (tab : Array UInt64) (x : Float) : Float × Float × Float × UInt64 × UInt64 :=
  let u := x.toBits
  let ex := u >>> 52
  let (u, ed) :=
    if ex == 0 then
      let k := 63 - Library.Numerics.Arithmetic.Fma.msb64 u
      (u <<< (k - 11), -((k + 1011).toFloat))
    else (u, if ex ≥ 0x3ff then (ex - 0x3ff).toFloat else -((0x3ff - ex).toFloat))
  let m := u &&& 0xFFFFFFFFFFFFF
  let i := m >>> 47
  let d := m &&& 0x7FFFFFFFFFFF
  let j := (m + (tab[(2 * i).toNat]! <<< 33) + tab[(2 * i + 1).toNat]! * (d >>> 16)) >>> 42
  let i1 := j >>> 5
  let i2 := j &&& 0x1f
  (Float.ofBits (m ||| 0x3FF0000000000000), entry tab (64 + i1) * entry tab (97 + i2), ed, i1, i2)

/-- `as_logd`: `log x` as a double-double for a positive finite `x`, with `Tgamma.logdTable`. -/
def asLogd (tab : Array UInt64) (x : Float) : Float × Float :=
  let (t, r, ed, i1, i2) := logReduce tab x
  let o := r * t
  let dxl := Library.Numerics.Arithmetic.Fma.fma r t (-o)
  let dxh := o - 1.0
  let dx := Library.Numerics.Arithmetic.Fma.fma r t (-1.0)
  let dx2 := dx * dx
  let f := dx2 * ((entry tab 260 + dx * entry tab 261) + dx2 * (entry tab 262 + dx * entry tab 263))
  let lt := (entry tab (130 + 2 * i1 + 1) + entry tab (196 + 2 * i2 + 1)) +
    ed * Float.ofBits 0x3FE62E42FEF80000  -- 0x1.62e42fef8p-1
  let lh := lt + dxh
  let ll := (lt - lh) + dxh
  let ll := ll + (((entry tab (130 + 2 * i1) + entry tab (196 + 2 * i2)) +
    Float.ofBits 0x3DB1CF79ABC9E3B4 * ed) + dxl)  -- 0x1.1cf79abc9e3b4p-36
  (lh, ll + f)

/-- `as_logd_accurate`: `log x` as a triple-double for a positive finite `x`, with
`Tgamma.logdTable` and `logAccurateTable`. -/
def asLogdAccurate (tab hTab : Array UInt64) (x : Float) : Float × Float × Float :=
  let (t, r, ed, i1, i2) := logReduce tab x
  let o := r * t
  let dxl := Library.Numerics.Arithmetic.Fma.fma r t (-o)
  let dxh := o - 1.0
  let (dxh, dxl) := fastTwoSum dxh dxl
  let fl := dxh * (entry hTab 210 + dxh * (entry hTab 212 + dxh * entry hTab 214))
  let (fh, fl) := polyDD hTab 198 6 dxh dxl fl
  let (fh, fl) := mulDD dxh dxl fh fl
  let s2 := entry hTab (3 * i1 + 2) + entry hTab (99 + 3 * i2 + 2)
  let s1 := entry hTab (3 * i1 + 1) + entry hTab (99 + 3 * i2 + 1)
  let s0 := entry hTab (3 * i1) + entry hTab (99 + 3 * i2)
  let l0 := Float.ofBits 0x3FE62E42FEFA3800 * ed  -- 0x1.62e42fefa38p-1
  let l1 := Float.ofBits 0x3D2EF35793C76000 * ed  -- 0x1.ef35793c76p-45
  let l2 := Float.ofBits 0x3A8CC01F97B57A08 * ed  -- 0x1.cc01f97b57a08p-87
  let l0 := l0 + s2
  let (l1, l2) := sumDD l1 l2 s1 s0
  let (l1, l2) := sumDD l1 l2 fh fl
  let (l0, l1) := fastTwoSum l0 l1
  let (l1, l2) := fastTwoSum l1 l2
  (l0, l1, l2)

/-- `as_sinpipid`: `sin (π x)/π` as a double-double for `0 ≤ x < 1`.  Within `2/128` of `1/2` it is
a polynomial in `z = 1/2 - |x - 1/2|`, and elsewhere `Tgamma.asSinpid` with the table `stpi` of
`sin (π k/128)/π`. -/
def asSinpipid (tab : Array UInt64) (x : Float) : Float × Float :=
  let ax := (x - 0.5).abs
  let ky := (roundEven (ax * 128.0)).toUInt64
  if 64 - ky < 2 then
    let z := 0.5 - ax
    let z2 := z * z
    let z2l := Library.Numerics.Arithmetic.Fma.fma z z (-z2)
    let fl := z2 * (entry tab 140 + z2 * (entry tab 141 + z2 * entry tab 142))
    let (fh, fl) := fastTwoSum (entry tab 138) fl
    let (fh, fl) := mulDD z2 z2l fh (fl + entry tab 139)
    let (fh, fl) := mulDDD z fh fl
    let (fh, e) := fastTwoSum z fh
    (fh, fl + e)
  else Tgamma.asSinpid tab x

/-- `as_sinpipid_accurate`: `sin (π x)/π` for `0 ≤ x < 1` to about 100 bits. -/
def asSinpipidAccurate (tab : Array UInt64) (x : Float) : Float × Float :=
  let x := (x - 0.5).abs * 128.0
  let ix := roundEven x
  let d := ix - x
  let ky := ix.toUInt64
  let kx := 64 - ky
  let sh := entry tab (2 * kx + 1)
  let sl := entry tab (2 * kx)
  let ch := entry tab (2 * ky + 1)
  let cl := entry tab (2 * ky)
  let d2h := d * d
  let d2l := Library.Numerics.Arithmetic.Fma.fma d d (-d2h)
  let (ph, pl) := polyDD tab 143 5 d2h d2l 0.0
  let (qh, ql) := polyDD tab 153 6 d2h d2l 0.0
  let (ph, pl) := mulDDD d ph pl
  let (ph, pl) := mulDD sh sl ph pl
  let (qh, ql) := mulDD ch cl qh ql
  let (ch, cl) := fastSum qh ql ph pl
  let (ch, cl) := mulDDD d ch cl
  fastSum sh sl ch cl

/-- `as_lgamma_asym_accurate`: `lgamma (xh + xl)` from Stirling's series as a triple-double, for
`xh` above 3.75. -/
def asLgammaAsymAccurate (logTab hTab tab : Array UInt64) (xh xl : Float) : Float × Float × Float :=
  let (l0, l1, l2) := asLogdAccurate logTab hTab xh
  if xh < Float.ofBits 0x4770000000000000 then  -- 0x1p120
    let zh := 1.0 / xh
    let dz := xl * zh
    let zl := (Library.Numerics.Arithmetic.Fma.fma zh (-xh) 1.0 - dz) * zh
    let (l1, l2) :=
      if xl != 0.0 then
        let (dl1, dl2) := mulDDD xl zh (Library.Numerics.Arithmetic.Fma.fma zh (-xh) 1.0 * zh)
        sumDD l1 l2 dl1 (dl2 - dl1 * dl1 / 2.0)
      else (l1, l2)
    let (wh, wl) := if xh.toBits >>> 52 > 0x3ff + 51 then (xh, xl - 0.5) else (xh - 0.5, xl)
    let l0 := l0 - 1.0
    let l0x := l0 * wh
    let l0xl := Library.Numerics.Arithmetic.Fma.fma l0 wh (-l0x)
    let l1x := l1 * wh
    let l1xl := Library.Numerics.Arithmetic.Fma.fma l1 wh (-l1x)
    let l2x := l2 * wh
    let (l1x, l2x) := sumDD l1x l2x l0xl l1xl
    let (l1x, l2x) := sumDD l1x l2x (l0 * wl) (l1 * wl)
    let (z2h, z2l) := mulDD zh zl zh zl
    let (o, n) : UInt64 × UInt64 :=
      if xh ≥ 48.0 then (0, 7) else if xh ≥ 14.5 then (16, 11) else (40, 27)
    let (l1x, l2x) := sumDD l1x l2x (entry tab o) (entry tab (o + 1))
    let (fh, fl) := polyDD tab (o + 2) n z2h z2l 0.0
    let (fh, fl) := mulDD zh zl fh fl
    let (l1x, l2x) := sumDD l1x l2x fh fl
    let (l0x, l1x) := fastTwoSum l0x l1x
    let (l1x, l2x) := fastTwoSum l1x l2x
    (l0x, l1x, l2x)
  else
    let wl := xl - 0.5
    let l0 := l0 - 1.0
    let l0x := l0 * xh
    let l0xl := Library.Numerics.Arithmetic.Fma.fma l0 xh (-l0x)
    let l1x := l1 * xh
    let l1xl := Library.Numerics.Arithmetic.Fma.fma l1 xh (-l1x)
    let l2x := l2 * xh
    let (l1x, l2x) := sumDD l1x l2x l0xl l1xl
    let (l1x, l2x) := sumDD l1x l2x (l0 * wl) (l1 * wl)
    (l0x, l1x, l2x)

/-- `as_lgamma_database`: the correctly rounded `lgamma x` for the inputs that the accurate path
cannot round, and `f` otherwise, by a scan of the 19 entries. -/
def database (tab : Array UInt64) (x f : Float) : Float :=
  LeanExe.loop 19 f fun k acc =>
    if entry tab (3 * k) == x then entry tab (3 * k + 1) + entry tab (3 * k + 2) else acc

/-- The range of `as_lgamma_accurate`'s polynomials near the zeros of `lgamma` from -10.5 to -2 that
applies to `sx` when `|fh| = afh`, as `(o, n, k, sc)`: the triple `x0` at `o`, the `n` pairs `c`
after it, the `k` of them evaluated in doubles, and the scale `sc`.  `o = 0` when no range applies.
`sxBound` is the double nearest -2.61. -/
def rootRange (afh sx : Float) : UInt64 × UInt64 × UInt64 × Float :=
  let sxBound := Float.ofBits 0xC004E147AE147AE1  -- -0x1.4e147ae147ae1p+1
  if afh < Float.ofBits 0x3FB7400000000000 && sx > sxBound && sx < -2.0 then  -- 0x1.74p-4
    (128, 26, 6, Float.ofBits 0x4020000000000000)  -- 0x1p+3
  else if afh < Float.ofBits 0x3FB1680000000000 && sx > -3.0 && sx < sxBound then  -- 0x1.168p-4
    (183, 27, 6, Float.ofBits 0x4030000000000000)  -- 0x1p+4
  else if afh < Float.ofBits 0x3FB2D40000000000 && sx > -3.5 && sx < -3.0 then  -- 0x1.2d4p-4
    (240, 20, 7, Float.ofBits 0x4050000000000000)  -- 0x1p+6
  else if afh < Float.ofBits 0x3FAEF00000000000 && sx > -4.0 && sx < -3.5 then  -- 0x1.efp-5
    (283, 20, 7, Float.ofBits 0x4070000000000000)  -- 0x1p+8
  else if afh < Float.ofBits 0x3FC0000000000000 && sx > -4.5 && sx < -4.0 then  -- 0x1p-3
    (326, 24, 7, Float.ofBits 0x4060000000000000)  -- 0x1p+7
  else if afh < Float.ofBits 0x3FB0800000000000 && sx > -5.0 && sx < -4.5 then  -- 0x1.08p-4
    (377, 19, 7, Float.ofBits 0x4090000000000000)  -- 0x1p+10
  else if afh < Float.ofBits 0x3FB1000000000000 && sx > -5.5 && sx < -5.0 then  -- 0x1.1p-4
    (418, 19, 6, Float.ofBits 0x4090000000000000)  -- 0x1p+10
  else if afh < Float.ofBits 0x3FC1300000000000 && sx > -6.0 && sx < -5.5 then  -- 0x1.13p-3
    (459, 24, 6, Float.ofBits 0x40B0000000000000)  -- 0x1p+12
  else if afh < Float.ofBits 0x3FC1500000000000 && sx > -6.5 && sx < -6.0 then  -- 0x1.15p-3
    (510, 24, 6, Float.ofBits 0x40B0000000000000)  -- 0x1p+12
  else if afh < Float.ofBits 0x3FC3400000000000 && sx > -7.0 && sx < -6.5 then  -- 0x1.34p-3
    (561, 25, 6, Float.ofBits 0x40D0000000000000)  -- 0x1p+14
  else if afh < Float.ofBits 0x3FC1450000000000 && sx > -7.5 && sx < -7.0 then  -- 0x1.145p-3
    (614, 24, 6, Float.ofBits 0x40E0000000000000)  -- 0x1p+15
  else if afh < Float.ofBits 0x3FC76B0000000000 && sx > -8.0 && sx < -7.5 then  -- 0x1.76bp-3
    (665, 27, 6, Float.ofBits 0x4100000000000000)  -- 0x1p+17
  else if afh < Float.ofBits 0x3FC76C0000000000 && sx > -8.5 && sx < -8.0 then  -- 0x1.76cp-3
    (722, 27, 6, Float.ofBits 0x4100000000000000)  -- 0x1p+17
  else if afh < Float.ofBits 0x3FC9900000000000 && sx > -9.0 && sx < -8.5 then  -- 0x1.99p-3
    (779, 28, 6, Float.ofBits 0x4130000000000000)  -- 0x1p+20
  else if afh < Float.ofBits 0x3FC9900000000000 && sx > -9.5 && sx < -9.0 then  -- 0x1.99p-3
    (838, 28, 6, Float.ofBits 0x4130000000000000)  -- 0x1p+20
  else if afh < Float.ofBits 0x3FC76B0000000000 && sx > -10.0 && sx < -9.5 then  -- 0x1.76bp-3
    (897, 27, 6, Float.ofBits 0x4170000000000000)  -- 0x1p+24
  else if afh < Float.ofBits 0x3FC76B0000000000 && sx > -10.5 && sx < -10.0 then  -- 0x1.76bp-3
    (954, 27, 6, Float.ofBits 0x4170000000000000)  -- 0x1p+24
  else (0, 0, 0, 0.0)

/-- `as_lgamma_accurate`: `lgamma x` to about 100 bits, rounded once, for the arguments where the
fast path cannot decide the rounding, with the table of hard cases for those where even this path
cannot. -/
def accurate (logTab hTab sinTab asymTab accTab dbTab : Array UInt64) (x : Float) : Float :=
  let sx := x
  let x := x.abs
  let (fh, fl) :=
    if x < Float.ofBits 0x39B0000000000000 then  -- 0x1p-100
      let (lh, ll, lll) := asLogdAccurate logTab hTab x
      let (fh, fl) := fastTwoSum (-lh) (-ll)
      let (fl, fll) := fastTwoSum fl (-lll)
      let (_, e) := fastTwoSum fh (2.0 * fl)
      let p54 := Float.ofBits 0x3C90000000000000  -- 0x1p-54
      if e == 0.0 && 1.0 + p54 == 1.0 - p54 then
        (fh, fl * (1.0 + copySign (Float.ofBits 0x3CB0000000000000) fl * copySign 1.0 fll))
      else (fh, fl)
    else if x < 0.25 then
      let (fh, fl) := polyDDDFst accTab 0 34 sx 0.0
      let (fh, fl) := mulDDD sx fh fl
      let (lh, ll, lll) := asLogdAccurate logTab hTab x
      let (fh, fl) := sumDD fh fl (-ll) (-lll)
      let (fh, fll) := twoSum (-lh) fh
      let (fl, fll) := twoSum fll fl
      let (_, e) := fastTwoSum fh (2.0 * fl)
      let p54 := Float.ofBits 0x3C90000000000000  -- 0x1p-54
      if e == 0.0 && 1.0 + p54 == 1.0 - p54 then
        (fh, fl * (1.0 + copySign (Float.ofBits 0x3CB0000000000000) fl * copySign 1.0 fll))
      else (fh, fl)
    else
      -- `addLog` adds the triple-double `(lh, ll, lll)` to `(fh, fl, fll)` as the C code does.
      let (fh, fl, fll) :=
        if (x - 0.5).abs < 0.25 then
          let (fh, fl) := polyDDDFst accTab 68 30 (x - 0.5) 0.0
          if sx > 0.0 then
            let (lh, ll, lll) := asLogdAccurate logTab hTab x
            let (fl, fll) := sumDD fl 0.0 (-ll) (-lll)
            let (fh, lh) := twoSum fh (-lh)
            let (fl, fll) := sumDD fl fll lh 0.0
            (fh, fl, fll)
          else (fh, fl, 0.0)
        else if (x - 2.5).abs < 0.25 then
          let (fh, fl) := polyDDDFst accTab 68 30 (x - 2.5) 0.0
          let (lh, ll, lll) := asLogdAccurate logTab hTab (x - 1.0)
          let (fl, fll) := sumDD fl 0.0 ll lll
          let (fh, lh) := twoSum fh lh
          let (fl, fll) := sumDD fl fll lh 0.0
          if sx < 0.0 then
            let (lh, ll, lll) := asLogdAccurate logTab hTab x
            let (fl, fll) := sumDD fl fll ll lll
            let (fh, lh) := twoSum fh lh
            let (fl, fll) := sumDD fl fll lh 0.0
            (fh, fl, fll)
          else (fh, fl, fll)
        else if (x - 3.5).abs < 0.25 then
          let (l2h, l2l, l2ll) := asLogdAccurate logTab hTab (x - 2.0)
          let (l1h, l1l, l1ll) := asLogdAccurate logTab hTab (x - 1.0)
          let (l1l, l1ll) := sumDD l1l l1ll l2l l2ll
          let (l1h, l2h) := fastTwoSum l1h l2h
          let (l1l, l1ll) := sumDD l1l l1ll l2h 0.0
          let (fh, fl) := polyDDDFst accTab 68 30 (x - 3.5) 0.0
          let (fl, fll) := sumDD fl 0.0 l1l l1ll
          let (fh, l1h) := twoSum fh l1h
          let (fl, fll) := sumDD fl fll l1h 0.0
          if sx < 0.0 then
            let (lh, ll, lll) := asLogdAccurate logTab hTab x
            let (fl, fll) := sumDD fl fll ll lll
            let (fh, lh) := twoSum fh lh
            let (fl, fll) := sumDD fl fll lh 0.0
            (fh, fl, fll)
          else (fh, fl, fll)
        else if (x - 1.0).abs < 0.25 then
          let (fh, fl) := polyDDDFst accTab 0 34 (x - 1.0) 0.0
          let (fh, fl) := mulDDD (x - 1.0) fh fl
          if sx < 0.0 then
            let (lh, ll, lll) := asLogdAccurate logTab hTab x
            let (fl, fll) := sumDD fl 0.0 ll lll
            let (fh, lh) := twoSum fh lh
            let (fl, fll) := sumDD fl fll lh 0.0
            (fh, fl, fll)
          else (fh, fl, 0.0)
        else if (x - 1.5).abs < 0.25 then
          let (fh, fl) := polyDDDFst accTab 68 30 (x - 1.5) 0.0
          if sx < 0.0 then
            let (lh, ll, lll) := asLogdAccurate logTab hTab x
            let (fl, fll) := sumDD fl 0.0 ll lll
            let (fh, lh) := twoSum fh lh
            let (fl, fll) := sumDD fl fll lh 0.0
            (fh, fl, fll)
          else (fh, fl, 0.0)
        else if (x - 2.0).abs < 0.25 then
          let (lh, ll, lll) := asLogdAccurate logTab hTab (x - 1.0)
          let (fh, fl) := polyDDDFst accTab 0 34 (x - 2.0) 0.0
          let (fh, fl) := mulDDD (x - 2.0) fh fl
          let (fl, fll) := sumDD fl 0.0 ll lll
          let (fh, lh) := twoSum fh lh
          let (fl, fll) := sumDD fl fll lh 0.0
          if sx < 0.0 then
            let (lh, ll, lll) := asLogdAccurate logTab hTab x
            let (fl, fll) := sumDD fl fll ll lll
            let (fh, lh) := twoSum fh lh
            let (fl, fll) := sumDD fl fll lh 0.0
            (fh, fl, fll)
          else (fh, fl, fll)
        else if (x - 3.0).abs < 0.25 then
          let (l2h, l2l, l2ll) := asLogdAccurate logTab hTab (x - 2.0)
          let (l1h, l1l, l1ll) := asLogdAccurate logTab hTab (x - 1.0)
          let (l1l, l1ll) := sumDD l1l l1ll l2l l2ll
          let (l1h, l2h) := fastTwoSum l1h l2h
          let (l1l, l1ll) := sumDD l1l l1ll l2h 0.0
          let (fh, fl) := polyDDDFst accTab 0 34 (x - 3.0) 0.0
          let (fh, fl) := mulDDD (x - 3.0) fh fl
          let (fl, fll) := sumDD fl 0.0 l1l l1ll
          let (fh, l1h) := twoSum fh l1h
          let (fl, fll) := sumDD fl fll l1h 0.0
          if sx < 0.0 then
            let (lh, ll, lll) := asLogdAccurate logTab hTab x
            let (fl, fll) := sumDD fl fll ll lll
            let (fh, lh) := twoSum fh lh
            let (fl, fll) := sumDD fl fll lh 0.0
            (fh, fl, fll)
          else (fh, fl, fll)
        else
          let (x, fl) := if sx < 0.0 then fastTwoSum x 1.0 else (x, 0.0)
          asLgammaAsymAccurate logTab hTab asymTab x fl
      let (fh, fl, fll) :=
        if sx < 0.0 then
          let phi := if sx < -0.5 then sx - floorF sx else -sx
          let (sh, sl) := asSinpipidAccurate sinTab phi
          let (lh, ll, lll) := asLogdAccurate logTab hTab sh
          let ll := ll + (sl / sh + lll)
          let (fl, fll) := sumDD fl fll ll 0.0
          let (fh, lh) := twoSum fh lh
          let (fl, fll) := sumDD fl fll lh 0.0
          (-fh, -fl, -fll)
        else (fh, fl, fll)
      let (fh, fl) := fastTwoSum fh fl
      let (fl, fll) := fastTwoSum fl fll
      let (fh, fl) := fastTwoSum fh fl
      let (fl, fll) := fastTwoSum fl fll
      let (_, e) := fastTwoSum fh (2.0 * fl)
      if e == 0.0 then
        let p26 := Float.ofBits 0x3E50000000000000  -- 0x1p-26
        (fh, fl * (1.0 + copySign p26 fl * copySign p26 fll))
      else (fh, fl)
  let (fh, fl) :=
    if fh.abs < Float.ofBits 0x3FD8000000000000 then  -- 0x1.8p-2
      let (o, n, k, sc) := rootRange fh.abs sx
      if o == 0 then (fh, fl)
      else
        let (zh, zl) := fastTwoSum (entry accTab o + sx) (entry accTab (o + 1))
        let zl := zl + entry accTab (o + 2)
        let sh := zh * sc
        let sl := zl * sc
        let fl := sh * polyD accTab (o + 3 + 2 * (n - k)) k sh
        let (fh, fl) := polyDD accTab (o + 3) (n - k) sh sl fl
        mulDD zh zl fh fl
    else (fh, fl)
  if (fl.toBits + 2) &&& 0xFFFFFFFF ≤ 2 then database dbTab sx (fh + fl) else fh + fl

/-- The piece of `cr_lgamma`'s piecewise polynomial for `au`, the top bits of a number from 0.5 to
8.29541, from the borders `ubrd`: an estimate of the index from a quadratic in `au - ubrd 0`,
corrected by one comparison. -/
def piece (tab : Array UInt64) (au : UInt64) : UInt64 :=
  let ou := au - tab[(0 : UInt64).toNat]!
  let j := ((0x157ced865 - ou * 0x150d) * ou + 0x128000000000) >>> 45
  if au < tab[j.toNat]! then j - 1 else j

/-- The polynomial of piece `j` at `z`, as a double-double: the low coefficients `cl j` in doubles
and the five pairs `ch j` in double-double. -/
def piecePoly (tab : Array UInt64) (j : UInt64) (z : Float) : Float × Float :=
  let q := 39 + 8 * j
  let z2 := z * z
  let z4 := z2 * z2
  let q0 := entry tab q + z * entry tab (q + 1)
  let q2 := entry tab (q + 2) + z * entry tab (q + 3)
  let q4 := entry tab (q + 4) + z * entry tab (q + 5)
  let q6 := entry tab (q + 6) + z * entry tab (q + 7)
  polyDDDFst tab (191 + 10 * j) 5 z (z * ((q0 + z2 * q2) + z4 * (q4 + z2 * q6)))

/-- `cr_lgamma` with the tables of the module, returning `(lgamma x, signgam)` with `signgam` as
`±1.0`. -/
def lgammaWith (logTab hTab sinTab asymTab accTab dbTab tab : Array UInt64) (x : Float) :
    Float × Float :=
  let u := x.toBits
  let nx := u <<< 1
  let neg := u >>> 63 == 1
  if nx ≥ 0xFEAEA9B24F16A34C then
    if u == 0x7F5754D9278B51A6 then  -- 0x1.ffffffffffffep+1023 - 0x1p+969
      (Float.ofBits 0x7FEFFFFFFFFFFFFE - Float.ofBits 0x7C80000000000000, 1.0)
    else if u == 0x7F5754D9278B51A7 then  -- 0x1.fffffffffffffp+1023 - 0x1p+969
      (Float.ofBits 0x7FEFFFFFFFFFFFFF - Float.ofBits 0x7C80000000000000, 1.0)
    else if nx ≥ 0xFFE0000000000000 then
      (if nx == 0xFFE0000000000000 then x.abs else x + x, 1.0)
    else if neg then (1.0 / 0.0, 1.0)
    else (Float.ofBits 0x7FEF000000000000 * Float.ofBits 0x7FEF000000000000, 1.0)  -- 0x1.fp1023
  else
    let fx := floorF x
    if fx == x && x ≤ 0.0 then (1.0 / 0.0, if neg then -1.0 else 1.0)
    else if fx == x && (x == 1.0 || x == 2.0) then (0.0, 1.0)
    else
      let au := nx >>> 38
      let (fh, fl, eps, sign) :=
        if au < tab[(0 : UInt64).toNat]! then
          let (lh, ll) := asLogd logTab x.abs
          let sign := if neg then -1.0 else 1.0
          if au < 0x1da0000 then
            (-lh, -ll, Float.ofBits 0x3B66AAD80C11872C, sign)  -- 1.5e-22
          else if au < 0x1fd0000 then
            let z := x
            let z2 := z * z
            let z4 := z2 * z2
            let q0 := entry tab 389 + z * entry tab 390
            let q2 := entry tab 391 + z * entry tab 392
            let q4 := entry tab 393 + z * entry tab 394
            let q6 := entry tab 395 + z * entry tab 396
            let (fh, fl) := polyDDDFst tab 381 4 z (z * ((q0 + z2 * q2) + z4 * (q4 + z2 * q6)))
            let (fh, fl) := mulDDD x fh fl
            let (fh, fl) := sumDD (-lh) (-ll) fh fl
            (fh, fl, Float.ofBits 0x3B66AAD80C11872C, sign)  -- 1.5e-22
          else
            let (t, xl) := fastTwoSum 1.0 x
            let au := t.toBits >>> 37
            let j := piece tab au
            let z := (t - entry tab (20 + j)) + xl
            let (fh, fl) := piecePoly tab j z
            let (fh, fl) := if j == 4 then mulDDD (-x) fh fl else (fh, fl)
            let eps := fh.abs * Float.ofBits 0x3BF87F4D7D0AF16B  -- 8.3e-20
            let (fh, fl) := sumDD (-lh) (-ll) fh fl
            (fh, fl, eps + lh.abs * Float.ofBits 0x3B82E3B40A0E9B4F, sign)  -- 5e-22
        else
          let ax := x.abs
          let (fh, fl, eps) :=
            if au ≥ tab[(19 : UInt64).toNat]! then
              let (lh, ll) := asLogd logTab ax
              let lh := lh - 1.0
              let (lh, ll) :=
                if au ≥ 0x2198000 then
                  let (lh, ll) := if au ≥ 0x3fabaa6 then fastTwoSum lh ll else (lh, ll)
                  let hlh := lh * 0.5
                  let (lh, ll) := mulDDD ax lh ll
                  (lh, ll - hlh)
                else mulDDD (ax - 0.5) lh ll
              let (lh, ll) := fastSum lh ll (entry tab 397) (entry tab 398)
              let (fh, fl) :=
                if ax < Float.ofBits 0x4630000000000000 then  -- 0x1p100
                  let zh := 1.0 / ax
                  let zl := Library.Numerics.Arithmetic.Fma.fma zh (-ax) 1.0 * zh
                  let z2h := zh * zh
                  let z4h := z2h * z2h
                  let q0 := entry tab 401 + z2h * entry tab 402
                  let q2 := entry tab 403 + z2h * entry tab 404
                  let fl := z2h * (q0 + z4h * (q2 + z4h * entry tab 405))
                  let (fh, fl) := fastTwoSum (entry tab 399) fl
                  mulDD fh (fl + entry tab 400) zh zl
                else (0.0, 0.0)
              let (fh, fl) := fastSum lh ll fh fl
              (fh, fl, fh.abs * Float.ofBits 0x3BEA90352E248A68)  -- 4.5e-20
            else
              let j := piece tab au
              let z := ax - entry tab (20 + j)
              let (fh, fl) := piecePoly tab j z
              let (fh, fl) := if j == 4 then mulDDD (1.0 - ax) fh fl else (fh, fl)
              let (fh, fl) := if j == 10 then mulDDD (ax - 2.0) fh fl else (fh, fl)
              (fh, fl, fh.abs * Float.ofBits 0x3BF9AD88BDABDB20 +  -- 8.7e-20
                Float.ofBits 0x3AF357C299A88EA7)  -- 1e-24
          if neg then
            let (sh, sl) := asSinpipid sinTab (x - fx)
            let (sh, sl) := mulDDD (-x) sh sl
            let (lh, ll) := asLogd logTab sh
            let (fh, fl) := sumDD fh fl lh (ll + sl / sh)
            (-fh, -fl, eps + lh.abs * Float.ofBits 0x3B8E392010175EE6,  -- 8e-22
              if (-fx).toUInt64 &&& 1 == 1 then -1.0 else 1.0)
          else (fh, fl, eps, 1.0)
      let ub := fh + (fl + eps)
      let lb := fh + (fl - eps)
      if ub != lb then (accurate logTab hTab sinTab asymTab accTab dbTab x, sign) else (ub, sign)

/-- `(lgamma x, s)` with `s` the sign of `Γ x` as `±1.0`, CORE-MATH's correctly rounded `lgamma` and
its `signgam`. -/
def lgammaR (x : Float) : Float × Float :=
  lgammaWith Tgamma.logdTable logAccurateTable sinpiTable asymTable accurateTable dbTable mainTable
    x

/-- `ln |Γ x|`, the first component of `lgammaWith`, with the tables as parameters, so that
`verified_compile` lists it as a definition. -/
def lgammaFirstWith (logTab hTab sinTab asymTab accTab dbTab tab : Array UInt64) (x : Float) :
    Float :=
  (lgammaWith logTab hTab sinTab asymTab accTab dbTab tab x).1

/-- `lgamma x = ln |Γ x|`. -/
def lgamma (x : Float) : Float :=
  lgammaFirstWith Tgamma.logdTable logAccurateTable sinpiTable asymTable accurateTable dbTable
    mainTable x

end Library.Numerics.Float64.Lgamma
