import Library.Numerics.Float64.Lgamma.LgammaZeroBase
import LeanExe.ProofKit.GammaReflect
import LeanExe.ProofKit.GammaThresholds

/-!
Bounds on `|lgamma|` at the doubles of `(-n - 1, -n)` for `n` from 10 to 16, the intervals where
the reflection of `as_lgamma_accurate` cancels next to the zeros.  For each zero of `lgamma`,
`negPointOk` encloses `lgamma` at the two doubles next to it within `1/64` of its value
(`GammaReflect`), and `LgammaZeroBase.interval_bound` turns the values into a bound at every
double.  The left zero on `(-17, -16)` lies between -17 and the first double, so `bound16` uses
`interval_bound_right`, and `bound10cut` bounds `(-11, -21/2]` through `interval_bound_cut`.
-/

namespace Library.Numerics.Float64.Lgamma.LgammaZerosB

open Real LeanExe.ProofKit TaylorModel GammaBasic GammaModels GammaReflect GammaThresholds
  LgammaZeroBase CodeLib.IEEE64

/-- The form `(m + 1) / 2 ^ k` of `interval_bound` as the cast of an integer. -/
theorem cast_succ_eq (m : ℤ) (k : ℕ) : ((m : ℝ) + 1) / 2 ^ k = ((m + 1 : ℤ) : ℝ) / 2 ^ k := by
  rw [Int.cast_add, Int.cast_one]

