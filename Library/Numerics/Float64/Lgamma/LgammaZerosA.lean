/-!
Bounds on `|lgamma|` at the doubles of `(-n - 1, -n)` for `n` from 2 to 9, the intervals of the
root ranges of `as_lgamma_accurate`.  For each zero of `lgamma`, `negPointOk` encloses `lgamma` at
the two doubles next to it within `1/64` of its value (`GammaReflect`), and
`LgammaZeroBase.interval_bound` turns the four values into a bound at every double.
-/

namespace Library.Numerics.Float64.Lgamma.LgammaZerosA

open Real LeanExe.ProofKit TaylorModel GammaBasic GammaModels GammaReflect GammaThresholds
  LgammaZeroBase CodeLib.IEEE64

/-- The form `(m + 1) / 2 ^ k` of `interval_bound` as the cast of an integer. -/
theorem cast_succ_eq (m : ℤ) (k : ℕ) : ((m : ℝ) + 1) / 2 ^ k = ((m + 1 : ℤ) : ℝ) / 2 ^ k := by
  rw [Int.cast_add, Int.cast_one]

