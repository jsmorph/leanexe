/-- The fit within `(1 / 2 ^ 87)` of `lgamma`, relative, on the pieces' interval. -/
theorem cover : ∀ x : ℝ, ((13194139533311 : ℝ) / 2 ^ 40) ≤ x →
    x ≤ ((13194139533311 : ℝ) / 2 ^ 40) + 2 * ((1 : ℝ) / 16) * 11 →
    |GammaBasic.lgamma x - fit c0Asym pAsym x| ≤ (1 / 2 ^ 87) * GammaBasic.lgamma x := by
  refine cover_pieces (K := 11) (by norm_num) (lo := ((13194139533311 : ℝ) / 2 ^ 40))
    (r := ((1 : ℝ) / 16)) (by norm_num)
    (fun x => |GammaBasic.lgamma x - fit c0Asym pAsym x| ≤ (1 / 2 ^ 87) * GammaBasic.lgamma x) ?_
  intro j hj t ht
  interval_cases j
  · have e : ((13194139533311 : ℝ) / 2 ^ 40) +
        ((1 : ℝ) / 16) * (2 * ((0 : ℕ) : ℝ) + 1) + t =
        (((13262859010047 / 2 ^ 40) : ℚ) : ℝ) + t := by
      norm_num
    rw [e]
    have h := piece_rel 11 5 _ _ _ _ _ (13262859010047 / 2 ^ 40)
      (13194139533311 / 2 ^ 40) c0Asym
      (630587096742330685 / 2 ^ 55) (630587096742330685 / 2 ^ 105)
      (293639999 / 2 ^ 111) (1 / 2 ^ 87) pAsym
      0 f_0 p_0 (by norm_num) (by norm_num [cfgF]) (by norm_num) (by norm_num) t
      (by simp only [cfgF]; push_cast; exact ht)
    push_cast at h ⊢
    exact h
