/-- The fit within `(1 / 2 ^ 87)` of `lgamma`, relative, on the pieces' interval. -/
theorem cover : ∀ x : ℝ, ((10170482556927 : ℝ) / 2 ^ 40) ≤ x →
    x ≤ ((10170482556927 : ℝ) / 2 ^ 40) + 2 * ((1 : ℝ) / 16) * 11 →
    |GammaBasic.lgamma x - fit c0Asym pAsym x| ≤ (1 / 2 ^ 87) * GammaBasic.lgamma x := by
  refine cover_pieces (K := 11) (by norm_num) (lo := ((10170482556927 : ℝ) / 2 ^ 40))
    (r := ((1 : ℝ) / 16)) (by norm_num)
    (fun x => |GammaBasic.lgamma x - fit c0Asym pAsym x| ≤ (1 / 2 ^ 87) * GammaBasic.lgamma x) ?_
  intro j hj t ht
  interval_cases j
  · have e : ((10170482556927 : ℝ) / 2 ^ 40) +
        ((1 : ℝ) / 16) * (2 * ((0 : ℕ) : ℝ) + 1) + t =
        (((10239202033663 / 2 ^ 40) : ℚ) : ℝ) + t := by
      norm_num
    rw [e]
    have h := piece_rel 13 7 _ _ _ _ _ (10239202033663 / 2 ^ 40)
      (10170482556927 / 2 ^ 40) c0Asym
      (1605933204091071553 / 2 ^ 57) (1605933204091071553 / 2 ^ 107)
      (747820923 / 2 ^ 113) (1 / 2 ^ 87) pAsym
      0 f_0 p_0 (by norm_num) (by norm_num [cfgF]) (by norm_num) (by norm_num) t
      (by simp only [cfgF]; push_cast; exact ht)
    push_cast at h ⊢
    exact h
