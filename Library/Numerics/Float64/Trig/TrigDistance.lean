/-- The check of the certificate `c` for exponent field `E`, with `K = 2291 - E`, so that
`β = (tableNum % 2 ^ K) / 2 ^ K` modulo 1. -/
def check (E : Nat) (c : Nat × Nat) : Bool :=
  Nat.gcd c.1 c.2 == 1 && decide (2 ^ 53 ≤ c.2) &&
    decide (c.2 * 2 ^ (2291 - E) < 2 ^ 62 * (2 ^ (2291 - E) - 2 ^ 53 *
      (((c.1 * 2 ^ (2291 - E) : Nat) : Int) - ((tableNum % 2 ^ (2291 - E) * c.2 : Nat) : Int)).natAbs))

def checkFrom : Nat → List (Nat × Nat) → Bool
  | _, [] => true
  | E, c :: rest => check E c && checkFrom (E + 1) rest

theorem certs_checked : checkFrom 1022 certs = true := by
  decide +kernel

theorem certs_length : certs.length = 1025 := by
  decide +kernel

theorem check_of_checkFrom (l : List (Nat × Nat)) (E : Nat) (h : checkFrom E l = true)
    (i : Nat) (hi : i < l.length) : check (E + i) l[i] = true := by
  induction l generalizing E i with
  | nil => simp at hi
  | cons c rest ih =>
    simp only [checkFrom, Bool.and_eq_true] at h
    cases i with
    | zero => simpa using h.1
    | succ i =>
      have h' := ih (E + 1) h.2 i (by simpa using hi)
      rw [show E + 1 + i = E + (i + 1) by omega] at h'
      simpa using h'

/-- A checked certificate bounds the distance of `m R / 2 ^ K` from every integer. -/
theorem check_sound (K p q R m : Nat) (hgcd : Nat.gcd p q = 1) (hq : 2 ^ 53 ≤ q)
    (hb : q * 2 ^ K < 2 ^ 62 * (2 ^ K - 2 ^ 53 *
      (((p * 2 ^ K : Nat) : Int) - ((R * q : Nat) : Int)).natAbs))
    (hm0 : 0 < m) (hm : m < 2 ^ 53) (n : Int) :
    1 / (2 : ℝ) ^ 62 < |(m : ℝ) * R / 2 ^ K - n| := by
  set D := (((p * 2 ^ K : Nat) : Int) - ((R * q : Nat) : Int)).natAbs with hD
  have hDK : 2 ^ 53 * D < 2 ^ K := by
    by_contra h
    have h0 : 2 ^ K - 2 ^ 53 * D = 0 := Nat.sub_eq_zero_of_le (not_lt.mp h)
    rw [h0, mul_zero] at hb
    exact absurd hb (Nat.not_lt_zero _)
  have hq0 : 0 < q := lt_of_lt_of_le (by positivity) hq
  have hne : (m : Int) * p - n * q ≠ 0 := by
    intro h
    have hdvd : (q : Int) ∣ ((m * p : Nat) : Int) := ⟨n, by push_cast; linarith⟩
    have hdvd' : q ∣ m * p := Int.natCast_dvd_natCast.mp hdvd
    have hqm : q ∣ m := (Nat.Coprime.symm hgcd).dvd_of_dvd_mul_right hdvd'
    have := Nat.le_of_dvd hm0 hqm
    omega
  have hone : (1 : ℝ) ≤ |(m : ℝ) * p - n * q| := by
    have h1 : (1 : Int) ≤ |(m : Int) * p - n * q| := Int.one_le_abs hne
    exact_mod_cast h1
  have hDr : |(p : ℝ) * 2 ^ K - R * q| = D := by
    rw [hD, Nat.cast_natAbs]
    push_cast
    rfl
  have hK : (0 : ℝ) < 2 ^ K := by positivity
  have hqr : (0 : ℝ) < q := by exact_mod_cast hq0
  have hmr : (m : ℝ) ≤ 2 ^ 53 := by exact_mod_cast hm.le
  have hD0 : (0 : ℝ) ≤ D := Nat.cast_nonneg _
  have hX : (q : ℝ) * 2 ^ K * ((m : ℝ) * R / 2 ^ K - n) =
      2 ^ K * ((m : ℝ) * p - n * q) - m * ((p : ℝ) * 2 ^ K - R * q) := by
    field_simp
    ring
  have hlow : (2 : ℝ) ^ K - 2 ^ 53 * D ≤ (q : ℝ) * 2 ^ K * |(m : ℝ) * R / 2 ^ K - n| := by
    have h1 : |(2 : ℝ) ^ K * ((m : ℝ) * p - n * q)| - |(m : ℝ) * ((p : ℝ) * 2 ^ K - R * q)| ≤
        |(2 : ℝ) ^ K * ((m : ℝ) * p - n * q) - m * ((p : ℝ) * 2 ^ K - R * q)| :=
      abs_sub_abs_le_abs_sub _ _
    rw [← hX, abs_mul, abs_mul, abs_mul, abs_mul, hDr, abs_of_pos hK, abs_of_pos hqr,
      abs_of_nonneg (Nat.cast_nonneg (α := ℝ) m)] at h1
    nlinarith [mul_le_mul_of_nonneg_right hmr hD0]
  have hb' : ((q * 2 ^ K : ℕ) : ℝ) < ((2 ^ 62 * (2 ^ K - 2 ^ 53 * D) : ℕ) : ℝ) :=
    Nat.cast_lt.mpr hb
  rw [Nat.cast_mul, Nat.cast_mul, Nat.cast_sub hDK.le] at hb'
  push_cast at hb'
  have hpos : 0 < (q : ℝ) * 2 ^ K := by positivity
  rw [div_lt_iff₀ (by positivity)]
  nlinarith

/-- For each exponent field from 1022 to 2046 and each 53-bit `m`, `m β` lies more than
`2 ^ -62` from every integer. -/
theorem table_distance (E m : Nat) (hE1 : 1022 ≤ E) (hE2 : E ≤ 2046) (hm1 : 2 ^ 52 ≤ m)
    (hm2 : m < 2 ^ 53) (n : Int) :
    1 / (2 : ℝ) ^ 62 < |(m : ℝ) * tableNum / 2 ^ (2291 - E) - n| := by
  have hi : E - 1022 < certs.length := by rw [certs_length]; omega
  have hc := check_of_checkFrom certs 1022 certs_checked (E - 1022) hi
  rw [show 1022 + (E - 1022) = E by omega] at hc
  simp only [check, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at hc
  obtain ⟨⟨hgcd, hq⟩, hb⟩ := hc
  set K := 2291 - E
  have hs := check_sound K _ _ (tableNum % 2 ^ K) m hgcd hq hb (by positivity) hm2
    (n - m * (tableNum / 2 ^ K : Nat))
  have hsplit : (m : ℝ) * tableNum / 2 ^ K - n =
      (m : ℝ) * (tableNum % 2 ^ K : Nat) / 2 ^ K -
        ((n - m * (tableNum / 2 ^ K : Nat) : Int) : ℝ) := by
    have hdm := Nat.div_add_mod tableNum (2 ^ K)
    have hc : (tableNum : ℝ) =
        (2 : ℝ) ^ K * (tableNum / 2 ^ K : Nat) + (tableNum % 2 ^ K : Nat) := by
      exact_mod_cast hdm.symm
    rw [Int.cast_sub, Int.cast_mul, Int.cast_natCast, Int.cast_natCast, hc]
    field_simp
    ring
  rw [hsplit]
  exact hs

/-- Every double from 1/2 on, `m · 2 ^ E / 2 ^ 1075` with exponent field `E` below 2047, has a
quotient by `π/2` more than `2 ^ -63` from every integer. -/
theorem quadrant_distance (E m : Nat) (hE1 : 1022 ≤ E) (hE2 : E ≤ 2046) (hm1 : 2 ^ 52 ≤ m)
    (hm2 : m < 2 ^ 53) (n : Int) :
    1 / (2 : ℝ) ^ 63 < |(m : ℝ) * 2 ^ E / 2 ^ 1075 * (2 / Real.pi) - n| := by
  have ht := table_distance E m hE1 hE2 hm1 hm2 n
  obtain ⟨hlo, hhi⟩ := table_bounds
  have hpi : Real.pi ≠ 0 := Real.pi_ne_zero
  have hab : (2 : ℝ) ^ E * 2 ^ (2291 - E) = 2 ^ 1075 * 2 ^ 1216 := by
    rw [← pow_add, ← pow_add, Nat.add_sub_cancel' (by omega)]
  set d := (m : ℝ) * 2 ^ E / (2 ^ 1075 * 2 ^ 1216) * (2 / Real.pi * 2 ^ 1216 - tableNum)
    with hd
  have hx : (m : ℝ) * 2 ^ E / 2 ^ 1075 * (2 / Real.pi) =
      (m : ℝ) * tableNum / 2 ^ (2291 - E) + d := by
    have hb' : (2 : ℝ) ^ (2291 - E) = 2 ^ 1075 * 2 ^ 1216 / 2 ^ E := by
      rw [eq_div_iff (by positivity), mul_comm, hab]
    rw [hd, hb']
    field_simp
    ring
  have hf0 : 0 ≤ 2 / Real.pi * 2 ^ 1216 - (tableNum : ℝ) := by linarith
  have hf : 2 / Real.pi * 2 ^ 1216 - (tableNum : ℝ) < 1 := by linarith
  have hd0 : 0 ≤ d := by
    rw [hd]
    exact mul_nonneg (div_nonneg (mul_nonneg (Nat.cast_nonneg _) (by positivity))
      (by positivity)) hf0
  have hd1 : d < 1 / 2 ^ 64 := by
    have hm : (m : ℝ) < 2 ^ 53 := by exact_mod_cast hm2
    have hE : (2 : ℝ) ^ E ≤ 2 ^ 2046 := pow_le_pow_right₀ (by norm_num) hE2
    have hP : (0 : ℝ) < 2 ^ 1075 * 2 ^ 1216 := by positivity
    have hmE : (m : ℝ) * 2 ^ E ≤ 2 ^ 53 * 2 ^ 2046 :=
      mul_le_mul hm.le hE (by positivity) (by positivity)
    have hq : (2 : ℝ) ^ 53 * 2 ^ 2046 / (2 ^ 1075 * 2 ^ 1216) = 1 / 2 ^ 192 := by
      rw [← pow_add, ← pow_add, div_eq_div_iff (by positivity) (by positivity), one_mul,
        ← pow_add]
    calc d ≤ (2 : ℝ) ^ 53 * 2 ^ 2046 / (2 ^ 1075 * 2 ^ 1216) * 1 := by
          rw [hd]
          exact mul_le_mul (div_le_div_of_nonneg_right hmE hP.le) hf.le hf0 (by positivity)
      _ = 1 / 2 ^ 192 := by rw [hq, mul_one]
      _ < 1 / 2 ^ 64 := by
          apply one_div_lt_one_div_of_lt (by positivity)
          exact pow_lt_pow_right₀ (by norm_num) (by norm_num)
  rw [hx]
  have hsplit := abs_sub_abs_le_abs_sub ((m : ℝ) * tableNum / 2 ^ (2291 - E) - n) (-d)
  rw [abs_neg, abs_of_nonneg hd0, show (m : ℝ) * tableNum / 2 ^ (2291 - E) - n - -d =
    (m : ℝ) * tableNum / 2 ^ (2291 - E) + d - n by ring] at hsplit
  have h62 : (1 : ℝ) / 2 ^ 62 = 1 / 2 ^ 63 + 1 / 2 ^ 64 + 1 / 2 ^ 64 := by norm_num
  linarith

