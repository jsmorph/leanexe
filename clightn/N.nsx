(data F32 (rocq Ctypes.F32) (lean LClight.floatsize.F32))
(data F64 (rocq Ctypes.F64) (lean LClight.floatsize.F64))
(data Tvoid (rocq Ctypes.Tvoid) (lean LClight.type.Tvoid))
