(data Vfloat (rocq Values.Vfloat) (lean LClight.val.Vfloat))
(data Vsingle (rocq Values.Vsingle) (lean LClight.val.Vsingle))
(data I16 (rocq Ctypes.I16) (lean LClight.intsize.I16))
