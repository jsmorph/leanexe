; Integer arithmetic and order, whose meaning the check trusts.
(base + (rocq BinInt.Z.add) (lean (HAdd.hAdd Int Int Int (instHAdd Int Int.instAdd))))
(base - (rocq BinInt.Z.sub) (lean (HSub.hSub Int Int Int (instHSub Int Int.instSub))))
(base * (rocq BinInt.Z.mul) (lean (HMul.hMul Int Int Int (instHMul Int Int.instMul))))
(base < (rocq BinInt.Z.lt) (lean (LT.lt Int Int.instLTInt)))
(base <= (rocq BinInt.Z.le) (lean (LE.le Int Int.instLEInt)))

; Symbols that the twin files NBase.v and Base.lean define, and that the laws at the end of this
; file characterize: a word's value (u32, u64) and the word of an integer (r32, r64), the signed
; value of a 64-bit word (s64), the quotient and remainder by a positive divisor (zdiv, zmod), the
; power of two of a number that is not negative (pow2), and the bitwise operations on numbers that
; are not negative (land, lor, lxor).
(base u32 (rocq NBase.u32) (lean ClightN.Base.u32))
(base r32 (rocq NBase.r32) (lean ClightN.Base.r32))
(base u64 (rocq NBase.u64) (lean ClightN.Base.u64))
(base r64 (rocq NBase.r64) (lean ClightN.Base.r64))
(base s64 (rocq NBase.s64) (lean ClightN.Base.s64))
(base zdiv (rocq NBase.zdiv) (lean ClightN.Base.zdiv))
(base zmod (rocq NBase.zmod) (lean ClightN.Base.zmod))
(base pow2 (rocq NBase.pow2) (lean ClightN.Base.pow2))
(base land (rocq NBase.land) (lean ClightN.Base.land))
(base lor (rocq NBase.lor) (lean ClightN.Base.lor))
(base lxor (rocq NBase.lxor) (lean ClightN.Base.lxor))

; The value of a pointer offset (uptr) and the offset of an integer (rptr), the concatenation of
; traces (app), and the floating-point numbers of bit patterns (f64_of_bits, f32_of_bits) with
; their inverses (f64_bits, f32_bits), which identify a floating-point number with its bit pattern
; in each prover.
(base uptr (rocq NBase.uptr) (lean ClightN.Base.uptr))
(base rptr (rocq NBase.rptr) (lean ClightN.Base.rptr))
(base app (rocq NBase.app) (lean ClightN.Base.app))
(base f64_of_bits (rocq NBase.f64_of_bits) (lean ClightN.Base.f64_of_bits))
(base f64_bits (rocq NBase.f64_bits) (lean ClightN.Base.f64_bits))
(base f32_of_bits (rocq NBase.f32_of_bits) (lean ClightN.Base.f32_of_bits))
(base f32_bits (rocq NBase.f32_bits) (lean ClightN.Base.f32_bits))

; The definitions under test: CompCert's in Rocq, and the Lean copy's at Archi.aarch64.
(interp sem_binop (rocq NBase.sem_binop) (lean ClightN.Base.sem_binop))
(interp sem_cast (rocq NBase.sem_cast) (lean ClightN.Base.sem_cast))
(interp bool_val (rocq NBase.bool_val) (lean ClightN.Base.bool_val))
(interp eval_expr (rocq NBase.eval_expr) (lean ClightN.Base.eval_expr))
(interp sem_unop (rocq NBase.sem_unop) (lean ClightN.Base.sem_unop))

; The floating-point equations: the operations on binary64 (float) and binary32 (float32) numbers
; that the leaf relations and the square root apply, each CompCert's definition in Rocq and the
; Lean copy's at Archi.aarch64.  N assumes that the two definitions of an equation agree on every
; argument, the numbers identified across the provers by their bit patterns through f64_of_bits,
; f64_bits, f32_of_bits, and f32_bits.  No proof in either prover supports an equation: the
; differential tests of the Lean copy against CompCert do (clightn/README.md).  The check
; confirms each equation's names and sort and lists the equations as assumptions.
(equation fadd64 (-> float (-> float float)) (rocq Floats.Float.add)
  (lean (LClight.Float.add LClight.Archi.aarch64)))
(equation fsub64 (-> float (-> float float)) (rocq Floats.Float.sub)
  (lean (LClight.Float.sub LClight.Archi.aarch64)))
(equation fmul64 (-> float (-> float float)) (rocq Floats.Float.mul)
  (lean (LClight.Float.mul LClight.Archi.aarch64)))
(equation fdiv64 (-> float (-> float float)) (rocq Floats.Float.div)
  (lean (LClight.Float.div LClight.Archi.aarch64)))
(equation fcmp64 (-> comparison (-> float (-> float bool))) (rocq Floats.Float.cmp)
  (lean LClight.Float.cmp))
(equation fneg64 (-> float float) (rocq Floats.Float.neg) (lean LClight.Float.neg))
(equation fabs64 (-> float float) (rocq Floats.Float.abs) (lean LClight.Float.abs))
(equation fsqrt64 (-> float float) (rocq Floats.Float.sqrt)
  (lean (LClight.Float.sqrt LClight.Archi.aarch64)))
(equation f64_of_longu (-> w64 float) (rocq Floats.Float.of_longu) (lean LClight.Float.of_longu))
(equation f64_to_longu (-> float (option w64)) (rocq Floats.Float.to_longu)
  (lean LClight.Float.to_longu))
(equation f64_of_single (-> float32 float) (rocq Floats.Float.of_single)
  (lean LClight.Float.of_single))
(equation f64_to_single (-> float float32) (rocq Floats.Float.to_single)
  (lean LClight.Float.to_single))
(equation fadd32 (-> float32 (-> float32 float32)) (rocq Floats.Float32.add)
  (lean (LClight.Float32.add LClight.Archi.aarch64)))
(equation fsub32 (-> float32 (-> float32 float32)) (rocq Floats.Float32.sub)
  (lean (LClight.Float32.sub LClight.Archi.aarch64)))
(equation fmul32 (-> float32 (-> float32 float32)) (rocq Floats.Float32.mul)
  (lean (LClight.Float32.mul LClight.Archi.aarch64)))
(equation fdiv32 (-> float32 (-> float32 float32)) (rocq Floats.Float32.div)
  (lean (LClight.Float32.div LClight.Archi.aarch64)))
(equation fcmp32 (-> comparison (-> float32 (-> float32 bool))) (rocq Floats.Float32.cmp)
  (lean LClight.Float32.cmp))
(equation fneg32 (-> float32 float32) (rocq Floats.Float32.neg) (lean LClight.Float32.neg))
(equation f32_of_int (-> w32 float32) (rocq Floats.Float32.of_int) (lean LClight.Float32.of_int))
(equation f32_of_intu (-> w32 float32) (rocq Floats.Float32.of_intu)
  (lean LClight.Float32.of_intu))
(equation f32_of_longu (-> w64 float32) (rocq Floats.Float32.of_longu)
  (lean LClight.Float32.of_longu))
(equation f32_to_int (-> float32 (option w32)) (rocq Floats.Float32.to_int)
  (lean LClight.Float32.to_int))
(equation f32_to_longu (-> float32 (option w64)) (rocq Floats.Float32.to_longu)
  (lean LClight.Float32.to_longu))

; ---------------------------------------------------------------------------------------------
; Macros

(macro noattr () (mk_attr false None))
(macro vattr () (mk_attr true None))
(macro tulong () (Tlong Unsigned (noattr)))
(macro tlong () (Tlong Signed (noattr)))
(macro tuint () (Tint I32 Unsigned (noattr)))
(macro tint () (Tint I32 Signed (noattr)))
(macro tuchar () (Tint I8 Unsigned (noattr)))
(macro tvuint () (Tint I32 Unsigned (vattr)))
(macro tvuchar () (Tint I8 Unsigned (vattr)))
(macro tdouble () (Tfloat F64 (noattr)))
(macro tfloat () (Tfloat F32 (noattr)))
(macro cc_default () (mkcallconv None false false))
(macro sqrt_sig () (mksignature (cons Xfloat nil) Xfloat (cc_default)))

; Sorts of N's states and of the program's lists: temporaries and scalar globals as partial maps
; from identifiers to values, the bytes of each array as a map from identifiers and offsets to
; numbers, the program's definitions, and the bindings of parameters and temporaries.
(macro tmap () (-> ident (option val)))
(macro amap () (-> ident (-> Z Z)))
(macro dlist () (list (prod ident globdef)))
(macro binds () (list (prod ident type)))

; m2 is m with x_upd set to v.
(macro upd (m2 m x v)
  (forall ((x_upd ident))
    (and (-> (= x_upd x) (= (m2 x_upd) (Some v))) (-> (not (= x_upd x)) (= (m2 x_upd) (m x_upd))))))

; Bit k of a.
(macro bit (a k) (zmod (zdiv a (pow2 k)) 2))

; Arrays.  An array of the program is a writable, non-volatile variable of n words of type
; unsigned long long whose initialization data is one Init_space of its 8 n bytes, such as lx_mem
; and lx_pun.  The translator reaches its bytes through three shapes of expression: the word at
; the index i, *(x + i); the byte at the index i, ((unsigned char *) x)[i]; and the cell of type
; ty at offset 0, *(ty *) x.
(macro tarr (n) (Tarray (tulong) n (noattr)))
(macro tpul () (Tpointer (tulong) (noattr)))
(macro tpuc () (Tpointer (tuchar) (noattr)))
(macro arr (defs x n)
  (in_defs defs x (Gvar (mkglobvar (tarr n) (cons (Init_space (* 8 n)) nil) false false))))
(macro word_e (x n i) (Ederef (Ebinop Oadd (Evar x (tarr n)) i (tpul)) (tulong)))
(macro byte_e (x n i) (Ederef (Ebinop Oadd (Ecast (Evar x (tarr n)) (tpuc)) i (tpuc)) (tuchar)))
(macro cell_e (x n ty) (Ederef (Ecast (Evar x (tarr n)) (Tpointer ty (noattr))) ty))

; The offset of the word at the index k, as CompCert's pointer arithmetic computes it, and the
; numbers that the four and the eight bytes of the array x of mb from offset o give in
; little-endian order.
(macro woff (k) (zmod (* 8 (u64 k)) 18446744073709551616))
(macro le4 (mb x o)
  (+ (mb x o) (+ (* 256 (mb x (+ o 1))) (+ (* 65536 (mb x (+ o 2))) (* 16777216 (mb x (+ o 3)))))))
(macro le8 (mb x o)
  (+ (le4 mb x o) (* 4294967296 (le4 mb x (+ o 4)))))

; mb2 is mb with the c bytes of the array x from offset o set to the bytes of the number w that
; is not negative, from the lowest.
(macro setbytes (mb2 mb x o c w)
  (forall ((y_sb ident) (j_sb Z))
    (and (-> (and (= y_sb x) (and (<= o j_sb) (< j_sb (+ o c))))
           (= (mb2 y_sb j_sb) (zmod (zdiv w (pow2 (* 8 (- j_sb o)))) 256)))
         (-> (not (and (= y_sb x) (and (<= o j_sb) (< j_sb (+ o c)))))
           (= (mb2 y_sb j_sb) (mb y_sb j_sb))))))

; The statement of a leaf form: the prover's operator, cast, or truth value at the form gives
; exactly the leaf relation.
(macro binop_form (op t1 t2)
  (forall ((ce cenv) (v1 val) (v2 val) (v val) (m mem))
    (iff (= (sem_binop ce op v1 t1 v2 t2 m) (Some v)) (binop_ok op t1 t2 v1 v2 v))))
(macro cast_form (t1 t2)
  (forall ((v1 val) (v val) (m mem))
    (iff (= (sem_cast v1 t1 t2 m) (Some v)) (cast_ok t1 t2 v1 v))))
(macro bool_form (t)
  (forall ((v val) (b bool) (m mem))
    (iff (= (bool_val v t m) (Some b)) (bool_ok t v b))))
(macro unop_form (op t)
  (forall ((v1 val) (v val) (m mem))
    (iff (= (sem_unop op v1 t m) (Some v)) (unop_ok op t v1 v))))

; ---------------------------------------------------------------------------------------------
; Leaf relations.  binop_ok op t1 t2 v1 v2 v: the operator op on v1 of type t1 and v2 of type t2
; gives v.  A comparison gives Vint 1 or Vint 0.

(relation binop_ok () (binary_operation type type val val val)
  ; unsigned long and unsigned long
  (ctor bo_add_ul (forall ((x w64) (y w64))
    (binop_ok Oadd (tulong) (tulong) (Vlong x) (Vlong y) (Vlong (r64 (+ (u64 x) (u64 y)))))))
  (ctor bo_sub_ul (forall ((x w64) (y w64))
    (binop_ok Osub (tulong) (tulong) (Vlong x) (Vlong y) (Vlong (r64 (- (u64 x) (u64 y)))))))
  (ctor bo_mul_ul (forall ((x w64) (y w64))
    (binop_ok Omul (tulong) (tulong) (Vlong x) (Vlong y) (Vlong (r64 (* (u64 x) (u64 y)))))))
  (ctor bo_div_ul (forall ((x w64) (y w64)) (-> (not (= (u64 y) 0))
    (binop_ok Odiv (tulong) (tulong) (Vlong x) (Vlong y) (Vlong (r64 (zdiv (u64 x) (u64 y))))))))
  (ctor bo_mod_ul (forall ((x w64) (y w64)) (-> (not (= (u64 y) 0))
    (binop_ok Omod (tulong) (tulong) (Vlong x) (Vlong y) (Vlong (r64 (zmod (u64 x) (u64 y))))))))
  (ctor bo_and_ul (forall ((x w64) (y w64))
    (binop_ok Oand (tulong) (tulong) (Vlong x) (Vlong y) (Vlong (r64 (land (u64 x) (u64 y)))))))
  (ctor bo_or_ul (forall ((x w64) (y w64))
    (binop_ok Oor (tulong) (tulong) (Vlong x) (Vlong y) (Vlong (r64 (lor (u64 x) (u64 y)))))))
  (ctor bo_xor_ul (forall ((x w64) (y w64))
    (binop_ok Oxor (tulong) (tulong) (Vlong x) (Vlong y) (Vlong (r64 (lxor (u64 x) (u64 y)))))))
  (ctor bo_shl_ul (forall ((x w64) (y w64)) (-> (< (u64 y) 64)
    (binop_ok Oshl (tulong) (tulong) (Vlong x) (Vlong y)
      (Vlong (r64 (* (u64 x) (pow2 (u64 y)))))))))
  (ctor bo_shr_ul (forall ((x w64) (y w64)) (-> (< (u64 y) 64)
    (binop_ok Oshr (tulong) (tulong) (Vlong x) (Vlong y)
      (Vlong (r64 (zdiv (u64 x) (pow2 (u64 y)))))))))
  (ctor bo_eq_ul_1 (forall ((x w64) (y w64)) (-> (= (u64 x) (u64 y))
    (binop_ok Oeq (tulong) (tulong) (Vlong x) (Vlong y) (Vint (r32 1))))))
  (ctor bo_eq_ul_0 (forall ((x w64) (y w64)) (-> (not (= (u64 x) (u64 y)))
    (binop_ok Oeq (tulong) (tulong) (Vlong x) (Vlong y) (Vint (r32 0))))))
  (ctor bo_ne_ul_1 (forall ((x w64) (y w64)) (-> (not (= (u64 x) (u64 y)))
    (binop_ok One (tulong) (tulong) (Vlong x) (Vlong y) (Vint (r32 1))))))
  (ctor bo_ne_ul_0 (forall ((x w64) (y w64)) (-> (= (u64 x) (u64 y))
    (binop_ok One (tulong) (tulong) (Vlong x) (Vlong y) (Vint (r32 0))))))
  (ctor bo_lt_ul_1 (forall ((x w64) (y w64)) (-> (< (u64 x) (u64 y))
    (binop_ok Olt (tulong) (tulong) (Vlong x) (Vlong y) (Vint (r32 1))))))
  (ctor bo_lt_ul_0 (forall ((x w64) (y w64)) (-> (<= (u64 y) (u64 x))
    (binop_ok Olt (tulong) (tulong) (Vlong x) (Vlong y) (Vint (r32 0))))))
  (ctor bo_le_ul_1 (forall ((x w64) (y w64)) (-> (<= (u64 x) (u64 y))
    (binop_ok Ole (tulong) (tulong) (Vlong x) (Vlong y) (Vint (r32 1))))))
  (ctor bo_le_ul_0 (forall ((x w64) (y w64)) (-> (< (u64 y) (u64 x))
    (binop_ok Ole (tulong) (tulong) (Vlong x) (Vlong y) (Vint (r32 0))))))
  (ctor bo_gt_ul_1 (forall ((x w64) (y w64)) (-> (< (u64 y) (u64 x))
    (binop_ok Ogt (tulong) (tulong) (Vlong x) (Vlong y) (Vint (r32 1))))))
  (ctor bo_gt_ul_0 (forall ((x w64) (y w64)) (-> (<= (u64 x) (u64 y))
    (binop_ok Ogt (tulong) (tulong) (Vlong x) (Vlong y) (Vint (r32 0))))))
  (ctor bo_ge_ul_1 (forall ((x w64) (y w64)) (-> (<= (u64 y) (u64 x))
    (binop_ok Oge (tulong) (tulong) (Vlong x) (Vlong y) (Vint (r32 1))))))
  (ctor bo_ge_ul_0 (forall ((x w64) (y w64)) (-> (< (u64 x) (u64 y))
    (binop_ok Oge (tulong) (tulong) (Vlong x) (Vlong y) (Vint (r32 0))))))
  ; long and long, and long shifted by unsigned long
  (ctor bo_lt_sl_1 (forall ((x w64) (y w64)) (-> (< (s64 x) (s64 y))
    (binop_ok Olt (tlong) (tlong) (Vlong x) (Vlong y) (Vint (r32 1))))))
  (ctor bo_lt_sl_0 (forall ((x w64) (y w64)) (-> (<= (s64 y) (s64 x))
    (binop_ok Olt (tlong) (tlong) (Vlong x) (Vlong y) (Vint (r32 0))))))
  (ctor bo_le_sl_1 (forall ((x w64) (y w64)) (-> (<= (s64 x) (s64 y))
    (binop_ok Ole (tlong) (tlong) (Vlong x) (Vlong y) (Vint (r32 1))))))
  (ctor bo_le_sl_0 (forall ((x w64) (y w64)) (-> (< (s64 y) (s64 x))
    (binop_ok Ole (tlong) (tlong) (Vlong x) (Vlong y) (Vint (r32 0))))))
  (ctor bo_shr_sl_ul (forall ((x w64) (y w64)) (-> (< (u64 y) 64)
    (binop_ok Oshr (tlong) (tulong) (Vlong x) (Vlong y)
      (Vlong (r64 (zdiv (s64 x) (pow2 (u64 y)))))))))
  ; unsigned int and unsigned int
  (ctor bo_add_ui (forall ((x w32) (y w32))
    (binop_ok Oadd (tuint) (tuint) (Vint x) (Vint y) (Vint (r32 (+ (u32 x) (u32 y)))))))
  (ctor bo_sub_ui (forall ((x w32) (y w32))
    (binop_ok Osub (tuint) (tuint) (Vint x) (Vint y) (Vint (r32 (- (u32 x) (u32 y)))))))
  (ctor bo_and_ui (forall ((x w32) (y w32))
    (binop_ok Oand (tuint) (tuint) (Vint x) (Vint y) (Vint (r32 (land (u32 x) (u32 y)))))))
  (ctor bo_shl_ui (forall ((x w32) (y w32)) (-> (< (u32 y) 32)
    (binop_ok Oshl (tuint) (tuint) (Vint x) (Vint y) (Vint (r32 (* (u32 x) (pow2 (u32 y)))))))))
  (ctor bo_shr_ui (forall ((x w32) (y w32)) (-> (< (u32 y) 32)
    (binop_ok Oshr (tuint) (tuint) (Vint x) (Vint y)
      (Vint (r32 (zdiv (u32 x) (pow2 (u32 y)))))))))
  (ctor bo_eq_ui_1 (forall ((x w32) (y w32)) (-> (= (u32 x) (u32 y))
    (binop_ok Oeq (tuint) (tuint) (Vint x) (Vint y) (Vint (r32 1))))))
  (ctor bo_eq_ui_0 (forall ((x w32) (y w32)) (-> (not (= (u32 x) (u32 y)))
    (binop_ok Oeq (tuint) (tuint) (Vint x) (Vint y) (Vint (r32 0))))))
  (ctor bo_ne_ui_1 (forall ((x w32) (y w32)) (-> (not (= (u32 x) (u32 y)))
    (binop_ok One (tuint) (tuint) (Vint x) (Vint y) (Vint (r32 1))))))
  (ctor bo_ne_ui_0 (forall ((x w32) (y w32)) (-> (= (u32 x) (u32 y))
    (binop_ok One (tuint) (tuint) (Vint x) (Vint y) (Vint (r32 0))))))
  (ctor bo_lt_ui_1 (forall ((x w32) (y w32)) (-> (< (u32 x) (u32 y))
    (binop_ok Olt (tuint) (tuint) (Vint x) (Vint y) (Vint (r32 1))))))
  (ctor bo_lt_ui_0 (forall ((x w32) (y w32)) (-> (<= (u32 y) (u32 x))
    (binop_ok Olt (tuint) (tuint) (Vint x) (Vint y) (Vint (r32 0))))))
  (ctor bo_gt_ui_1 (forall ((x w32) (y w32)) (-> (< (u32 y) (u32 x))
    (binop_ok Ogt (tuint) (tuint) (Vint x) (Vint y) (Vint (r32 1))))))
  (ctor bo_gt_ui_0 (forall ((x w32) (y w32)) (-> (<= (u32 x) (u32 y))
    (binop_ok Ogt (tuint) (tuint) (Vint x) (Vint y) (Vint (r32 0))))))
  (ctor bo_ge_ui_1 (forall ((x w32) (y w32)) (-> (<= (u32 y) (u32 x))
    (binop_ok Oge (tuint) (tuint) (Vint x) (Vint y) (Vint (r32 1))))))
  (ctor bo_ge_ui_0 (forall ((x w32) (y w32)) (-> (< (u32 x) (u32 y))
    (binop_ok Oge (tuint) (tuint) (Vint x) (Vint y) (Vint (r32 0))))))
  ; double and double
  (ctor bo_add_d (forall ((x float) (y float))
    (binop_ok Oadd (tdouble) (tdouble) (Vfloat x) (Vfloat y) (Vfloat (fadd64 x y)))))
  (ctor bo_sub_d (forall ((x float) (y float))
    (binop_ok Osub (tdouble) (tdouble) (Vfloat x) (Vfloat y) (Vfloat (fsub64 x y)))))
  (ctor bo_mul_d (forall ((x float) (y float))
    (binop_ok Omul (tdouble) (tdouble) (Vfloat x) (Vfloat y) (Vfloat (fmul64 x y)))))
  (ctor bo_div_d (forall ((x float) (y float))
    (binop_ok Odiv (tdouble) (tdouble) (Vfloat x) (Vfloat y) (Vfloat (fdiv64 x y)))))
  (ctor bo_eq_d_1 (forall ((x float) (y float)) (-> (= (fcmp64 Ceq x y) true)
    (binop_ok Oeq (tdouble) (tdouble) (Vfloat x) (Vfloat y) (Vint (r32 1))))))
  (ctor bo_eq_d_0 (forall ((x float) (y float)) (-> (= (fcmp64 Ceq x y) false)
    (binop_ok Oeq (tdouble) (tdouble) (Vfloat x) (Vfloat y) (Vint (r32 0))))))
  (ctor bo_ne_d_1 (forall ((x float) (y float)) (-> (= (fcmp64 Cne x y) true)
    (binop_ok One (tdouble) (tdouble) (Vfloat x) (Vfloat y) (Vint (r32 1))))))
  (ctor bo_ne_d_0 (forall ((x float) (y float)) (-> (= (fcmp64 Cne x y) false)
    (binop_ok One (tdouble) (tdouble) (Vfloat x) (Vfloat y) (Vint (r32 0))))))
  (ctor bo_lt_d_1 (forall ((x float) (y float)) (-> (= (fcmp64 Clt x y) true)
    (binop_ok Olt (tdouble) (tdouble) (Vfloat x) (Vfloat y) (Vint (r32 1))))))
  (ctor bo_lt_d_0 (forall ((x float) (y float)) (-> (= (fcmp64 Clt x y) false)
    (binop_ok Olt (tdouble) (tdouble) (Vfloat x) (Vfloat y) (Vint (r32 0))))))
  (ctor bo_le_d_1 (forall ((x float) (y float)) (-> (= (fcmp64 Cle x y) true)
    (binop_ok Ole (tdouble) (tdouble) (Vfloat x) (Vfloat y) (Vint (r32 1))))))
  (ctor bo_le_d_0 (forall ((x float) (y float)) (-> (= (fcmp64 Cle x y) false)
    (binop_ok Ole (tdouble) (tdouble) (Vfloat x) (Vfloat y) (Vint (r32 0))))))
  (ctor bo_ge_d_1 (forall ((x float) (y float)) (-> (= (fcmp64 Cge x y) true)
    (binop_ok Oge (tdouble) (tdouble) (Vfloat x) (Vfloat y) (Vint (r32 1))))))
  (ctor bo_ge_d_0 (forall ((x float) (y float)) (-> (= (fcmp64 Cge x y) false)
    (binop_ok Oge (tdouble) (tdouble) (Vfloat x) (Vfloat y) (Vint (r32 0))))))
  ; float and float
  (ctor bo_add_f (forall ((x float32) (y float32))
    (binop_ok Oadd (tfloat) (tfloat) (Vsingle x) (Vsingle y) (Vsingle (fadd32 x y)))))
  (ctor bo_sub_f (forall ((x float32) (y float32))
    (binop_ok Osub (tfloat) (tfloat) (Vsingle x) (Vsingle y) (Vsingle (fsub32 x y)))))
  (ctor bo_mul_f (forall ((x float32) (y float32))
    (binop_ok Omul (tfloat) (tfloat) (Vsingle x) (Vsingle y) (Vsingle (fmul32 x y)))))
  (ctor bo_div_f (forall ((x float32) (y float32))
    (binop_ok Odiv (tfloat) (tfloat) (Vsingle x) (Vsingle y) (Vsingle (fdiv32 x y)))))
  (ctor bo_eq_f_1 (forall ((x float32) (y float32)) (-> (= (fcmp32 Ceq x y) true)
    (binop_ok Oeq (tfloat) (tfloat) (Vsingle x) (Vsingle y) (Vint (r32 1))))))
  (ctor bo_eq_f_0 (forall ((x float32) (y float32)) (-> (= (fcmp32 Ceq x y) false)
    (binop_ok Oeq (tfloat) (tfloat) (Vsingle x) (Vsingle y) (Vint (r32 0))))))
  (ctor bo_ne_f_1 (forall ((x float32) (y float32)) (-> (= (fcmp32 Cne x y) true)
    (binop_ok One (tfloat) (tfloat) (Vsingle x) (Vsingle y) (Vint (r32 1))))))
  (ctor bo_ne_f_0 (forall ((x float32) (y float32)) (-> (= (fcmp32 Cne x y) false)
    (binop_ok One (tfloat) (tfloat) (Vsingle x) (Vsingle y) (Vint (r32 0))))))
  (ctor bo_lt_f_1 (forall ((x float32) (y float32)) (-> (= (fcmp32 Clt x y) true)
    (binop_ok Olt (tfloat) (tfloat) (Vsingle x) (Vsingle y) (Vint (r32 1))))))
  (ctor bo_lt_f_0 (forall ((x float32) (y float32)) (-> (= (fcmp32 Clt x y) false)
    (binop_ok Olt (tfloat) (tfloat) (Vsingle x) (Vsingle y) (Vint (r32 0))))))
  (ctor bo_le_f_1 (forall ((x float32) (y float32)) (-> (= (fcmp32 Cle x y) true)
    (binop_ok Ole (tfloat) (tfloat) (Vsingle x) (Vsingle y) (Vint (r32 1))))))
  (ctor bo_le_f_0 (forall ((x float32) (y float32)) (-> (= (fcmp32 Cle x y) false)
    (binop_ok Ole (tfloat) (tfloat) (Vsingle x) (Vsingle y) (Vint (r32 0))))))
  (ctor bo_ge_f_1 (forall ((x float32) (y float32)) (-> (= (fcmp32 Cge x y) true)
    (binop_ok Oge (tfloat) (tfloat) (Vsingle x) (Vsingle y) (Vint (r32 1))))))
  (ctor bo_ge_f_0 (forall ((x float32) (y float32)) (-> (= (fcmp32 Cge x y) false)
    (binop_ok Oge (tfloat) (tfloat) (Vsingle x) (Vsingle y) (Vint (r32 0)))))))

; cast_ok t1 t2 v1 v: the cast from t1 to t2 of v1 gives v.  On AArch64 a cast between two long
; types passes a pointer unchanged.  A cast from a floating-point type to an integer type is
; defined when the conversion is.
(relation cast_ok () (type type val val)
  (ctor co_si_ui (forall ((x w32)) (cast_ok (tint) (tuint) (Vint x) (Vint x))))
  (ctor co_ui_si (forall ((x w32)) (cast_ok (tuint) (tint) (Vint x) (Vint x))))
  (ctor co_ul_ui (forall ((x w64)) (cast_ok (tulong) (tuint) (Vlong x) (Vint (r32 (u64 x))))))
  (ctor co_ui_ul (forall ((x w32)) (cast_ok (tuint) (tulong) (Vint x) (Vlong (r64 (u32 x))))))
  (ctor co_ul_sl (forall ((x w64)) (cast_ok (tulong) (tlong) (Vlong x) (Vlong x))))
  (ctor co_ul_sl_ptr (forall ((b block) (o ptrofs))
    (cast_ok (tulong) (tlong) (Vptr b o) (Vptr b o))))
  (ctor co_sl_ul (forall ((x w64)) (cast_ok (tlong) (tulong) (Vlong x) (Vlong x))))
  (ctor co_sl_ul_ptr (forall ((b block) (o ptrofs))
    (cast_ok (tlong) (tulong) (Vptr b o) (Vptr b o))))
  (ctor co_uc_ul (forall ((x w32)) (cast_ok (tuchar) (tulong) (Vint x) (Vlong (r64 (u32 x))))))
  (ctor co_uc_ui (forall ((x w32)) (cast_ok (tuchar) (tuint) (Vint x) (Vint x))))
  (ctor co_ul_uc (forall ((x w64))
    (cast_ok (tulong) (tuchar) (Vlong x) (Vint (r32 (zmod (u64 x) 256))))))
  (ctor co_ui_uc (forall ((x w32))
    (cast_ok (tuint) (tuchar) (Vint x) (Vint (r32 (zmod (u32 x) 256))))))
  (ctor co_vuc_ul (forall ((x w32)) (cast_ok (tvuchar) (tulong) (Vint x) (Vlong (r64 (u32 x))))))
  (ctor co_vui_ul (forall ((x w32)) (cast_ok (tvuint) (tulong) (Vint x) (Vlong (r64 (u32 x))))))
  (ctor co_ui_vui (forall ((x w32)) (cast_ok (tuint) (tvuint) (Vint x) (Vint x))))
  (ctor co_ul_ul (forall ((x w64)) (cast_ok (tulong) (tulong) (Vlong x) (Vlong x))))
  (ctor co_ul_ul_ptr (forall ((b block) (o ptrofs))
    (cast_ok (tulong) (tulong) (Vptr b o) (Vptr b o))))
  (ctor co_ui_ui (forall ((x w32)) (cast_ok (tuint) (tuint) (Vint x) (Vint x))))
  (ctor co_uc_uc (forall ((x w32))
    (cast_ok (tuchar) (tuchar) (Vint x) (Vint (r32 (zmod (u32 x) 256))))))
  (ctor co_si_si (forall ((x w32)) (cast_ok (tint) (tint) (Vint x) (Vint x))))
  (ctor co_d_d (forall ((x float)) (cast_ok (tdouble) (tdouble) (Vfloat x) (Vfloat x))))
  (ctor co_f_f (forall ((x float32)) (cast_ok (tfloat) (tfloat) (Vsingle x) (Vsingle x))))
  (ctor co_ul_d (forall ((x w64))
    (cast_ok (tulong) (tdouble) (Vlong x) (Vfloat (f64_of_longu x)))))
  (ctor co_d_ul (forall ((x float) (y w64)) (-> (= (f64_to_longu x) (Some y))
    (cast_ok (tdouble) (tulong) (Vfloat x) (Vlong y)))))
  (ctor co_f_d (forall ((x float32))
    (cast_ok (tfloat) (tdouble) (Vsingle x) (Vfloat (f64_of_single x)))))
  (ctor co_d_f (forall ((x float))
    (cast_ok (tdouble) (tfloat) (Vfloat x) (Vsingle (f64_to_single x)))))
  (ctor co_si_f (forall ((x w32)) (cast_ok (tint) (tfloat) (Vint x) (Vsingle (f32_of_int x)))))
  (ctor co_ui_f (forall ((x w32))
    (cast_ok (tuint) (tfloat) (Vint x) (Vsingle (f32_of_intu x)))))
  (ctor co_ul_f (forall ((x w64))
    (cast_ok (tulong) (tfloat) (Vlong x) (Vsingle (f32_of_longu x)))))
  (ctor co_f_si (forall ((x float32) (y w32)) (-> (= (f32_to_int x) (Some y))
    (cast_ok (tfloat) (tint) (Vsingle x) (Vint y)))))
  (ctor co_f_ul (forall ((x float32) (y w64)) (-> (= (f32_to_longu x) (Some y))
    (cast_ok (tfloat) (tulong) (Vsingle x) (Vlong y))))))

; bool_ok t v b: the value v of type t, as the condition of an if statement, is b.
(relation bool_ok () (type val bool)
  (ctor bv_si_true (forall ((x w32)) (-> (not (= (u32 x) 0)) (bool_ok (tint) (Vint x) true))))
  (ctor bv_si_false (forall ((x w32)) (-> (= (u32 x) 0) (bool_ok (tint) (Vint x) false))))
  (ctor bv_ui_true (forall ((x w32)) (-> (not (= (u32 x) 0)) (bool_ok (tuint) (Vint x) true))))
  (ctor bv_ui_false (forall ((x w32)) (-> (= (u32 x) 0) (bool_ok (tuint) (Vint x) false)))))

; unop_ok op t v1 v: the unary operator op on v1 of type t gives v.
(relation unop_ok () (unary_operation type val val)
  (ctor uo_neg_d (forall ((x float)) (unop_ok Oneg (tdouble) (Vfloat x) (Vfloat (fneg64 x)))))
  (ctor uo_abs_d (forall ((x float))
    (unop_ok Oabsfloat (tdouble) (Vfloat x) (Vfloat (fabs64 x)))))
  (ctor uo_neg_f (forall ((x float32))
    (unop_ok Oneg (tfloat) (Vsingle x) (Vsingle (fneg32 x))))))

; ---------------------------------------------------------------------------------------------
; Leaf forms.  Each statement is proved in Rocq from CompCert 3.18's definitions (NProof.v) and in
; Lean from the Lean copy (Laws.lean and Leaf.lean), under the statement's name.  The forms on
; floating-point numbers give the operations of the floating-point equations.

(statement add_ul_ul (binop_form Oadd (tulong) (tulong)))
(statement sub_ul_ul (binop_form Osub (tulong) (tulong)))
(statement mul_ul_ul (binop_form Omul (tulong) (tulong)))
(statement div_ul_ul (binop_form Odiv (tulong) (tulong)))
(statement mod_ul_ul (binop_form Omod (tulong) (tulong)))
(statement and_ul_ul (binop_form Oand (tulong) (tulong)))
(statement or_ul_ul (binop_form Oor (tulong) (tulong)))
(statement xor_ul_ul (binop_form Oxor (tulong) (tulong)))
(statement shl_ul_ul (binop_form Oshl (tulong) (tulong)))
(statement shr_ul_ul (binop_form Oshr (tulong) (tulong)))
(statement eq_ul_ul (binop_form Oeq (tulong) (tulong)))
(statement ne_ul_ul (binop_form One (tulong) (tulong)))
(statement lt_ul_ul (binop_form Olt (tulong) (tulong)))
(statement le_ul_ul (binop_form Ole (tulong) (tulong)))
(statement gt_ul_ul (binop_form Ogt (tulong) (tulong)))
(statement ge_ul_ul (binop_form Oge (tulong) (tulong)))
(statement lt_sl_sl (binop_form Olt (tlong) (tlong)))
(statement le_sl_sl (binop_form Ole (tlong) (tlong)))
(statement shr_sl_ul (binop_form Oshr (tlong) (tulong)))
(statement add_ui_ui (binop_form Oadd (tuint) (tuint)))
(statement sub_ui_ui (binop_form Osub (tuint) (tuint)))
(statement and_ui_ui (binop_form Oand (tuint) (tuint)))
(statement shl_ui_ui (binop_form Oshl (tuint) (tuint)))
(statement shr_ui_ui (binop_form Oshr (tuint) (tuint)))
(statement eq_ui_ui (binop_form Oeq (tuint) (tuint)))
(statement ne_ui_ui (binop_form One (tuint) (tuint)))
(statement lt_ui_ui (binop_form Olt (tuint) (tuint)))
(statement gt_ui_ui (binop_form Ogt (tuint) (tuint)))
(statement ge_ui_ui (binop_form Oge (tuint) (tuint)))
(statement add_d_d (binop_form Oadd (tdouble) (tdouble)))
(statement sub_d_d (binop_form Osub (tdouble) (tdouble)))
(statement mul_d_d (binop_form Omul (tdouble) (tdouble)))
(statement div_d_d (binop_form Odiv (tdouble) (tdouble)))
(statement eq_d_d (binop_form Oeq (tdouble) (tdouble)))
(statement ne_d_d (binop_form One (tdouble) (tdouble)))
(statement lt_d_d (binop_form Olt (tdouble) (tdouble)))
(statement le_d_d (binop_form Ole (tdouble) (tdouble)))
(statement ge_d_d (binop_form Oge (tdouble) (tdouble)))
(statement add_f_f (binop_form Oadd (tfloat) (tfloat)))
(statement sub_f_f (binop_form Osub (tfloat) (tfloat)))
(statement mul_f_f (binop_form Omul (tfloat) (tfloat)))
(statement div_f_f (binop_form Odiv (tfloat) (tfloat)))
(statement eq_f_f (binop_form Oeq (tfloat) (tfloat)))
(statement ne_f_f (binop_form One (tfloat) (tfloat)))
(statement lt_f_f (binop_form Olt (tfloat) (tfloat)))
(statement le_f_f (binop_form Ole (tfloat) (tfloat)))
(statement ge_f_f (binop_form Oge (tfloat) (tfloat)))

(statement cast_si_ui (cast_form (tint) (tuint)))
(statement cast_ui_si (cast_form (tuint) (tint)))
(statement cast_ul_ui (cast_form (tulong) (tuint)))
(statement cast_ui_ul (cast_form (tuint) (tulong)))
(statement cast_ul_sl (cast_form (tulong) (tlong)))
(statement cast_sl_ul (cast_form (tlong) (tulong)))
(statement cast_uc_ul (cast_form (tuchar) (tulong)))
(statement cast_uc_ui (cast_form (tuchar) (tuint)))
(statement cast_ul_uc (cast_form (tulong) (tuchar)))
(statement cast_ui_uc (cast_form (tuint) (tuchar)))
(statement cast_vuc_ul (cast_form (tvuchar) (tulong)))
(statement cast_vui_ul (cast_form (tvuint) (tulong)))
(statement cast_ui_vui (cast_form (tuint) (tvuint)))
(statement cast_ul_ul (cast_form (tulong) (tulong)))
(statement cast_ui_ui (cast_form (tuint) (tuint)))
(statement cast_uc_uc (cast_form (tuchar) (tuchar)))
(statement cast_si_si (cast_form (tint) (tint)))
(statement cast_d_d (cast_form (tdouble) (tdouble)))
(statement cast_f_f (cast_form (tfloat) (tfloat)))
(statement cast_ul_d (cast_form (tulong) (tdouble)))
(statement cast_d_ul (cast_form (tdouble) (tulong)))
(statement cast_f_d (cast_form (tfloat) (tdouble)))
(statement cast_d_f (cast_form (tdouble) (tfloat)))
(statement cast_si_f (cast_form (tint) (tfloat)))
(statement cast_ui_f (cast_form (tuint) (tfloat)))
(statement cast_ul_f (cast_form (tulong) (tfloat)))
(statement cast_f_si (cast_form (tfloat) (tint)))
(statement cast_f_ul (cast_form (tfloat) (tulong)))

(statement bool_si (bool_form (tint)))
(statement bool_ui (bool_form (tuint)))

(statement neg_d (unop_form Oneg (tdouble)))
(statement abs_d (unop_form Oabsfloat (tdouble)))
(statement neg_f (unop_form Oneg (tfloat)))

; A constant evaluates to its value, whatever its type.
(statement const_int (forall ((ge genv) (e env) (le tenv) (m mem) (i w32) (ty type) (v val))
  (iff (eval_expr ge e le m (Econst_int i ty) v) (= v (Vint i)))))
(statement const_long (forall ((ge genv) (e env) (le tenv) (m mem) (i w64) (ty type) (v val))
  (iff (eval_expr ge e le m (Econst_long i ty) v) (= v (Vlong i)))))

; ---------------------------------------------------------------------------------------------
; Statements, calls, and programs.  N runs a program over the temporaries and the scalar globals,
; each a map from identifiers to values, and over the bytes of the arrays.  Its relations take the
; program's definitions as a parameter: a call finds its function among them, and an access to a
; global its variable.  The scalar globals are the writable, non-volatile variables of type
; unsigned int or unsigned long long.  A volatile variable of type volatile unsigned int receives
; the stores of the bare-metal main, and a volatile array of unsigned char or unsigned int the
; loads and stores of its elements, each an event of the trace.  Clight's relations exec_stmt and
; eval_funcall of ClightBigstep.v, with function_entry2, are the model of nexec, whose rule for a
; call executes the callee's body.  NExec.v proves in Rocq that each derivation of N is one of
; CompCert's, and Exec.lean proves in Lean that each execution of the Lean copy of a program that
; the translator's forms make up is one of N's.

; Lists of definitions and of bindings.
(relation in_defs () ((dlist) ident globdef)
  (ctor in_here (forall ((x ident) (g globdef) (rest (dlist)))
    (in_defs (cons (pair x g) rest) x g)))
  (ctor in_there (forall ((d (prod ident globdef)) (rest (dlist)) (x ident) (g globdef))
    (-> (in_defs rest x g) (in_defs (cons d rest) x g)))))
(relation out_defs () (ident (dlist))
  (ctor od_nil (forall ((x ident)) (out_defs x nil)))
  (ctor od_cons (forall ((x ident) (y ident) (g globdef) (rest (dlist)))
    (-> (not (= x y)) (-> (out_defs x rest) (out_defs x (cons (pair y g) rest)))))))
(relation norepet_defs () ((dlist))
  (ctor nd_nil (norepet_defs nil))
  (ctor nd_cons (forall ((x ident) (g globdef) (rest (dlist)))
    (-> (out_defs x rest) (-> (norepet_defs rest) (norepet_defs (cons (pair x g) rest)))))))
(relation out_names () (ident (binds))
  (ctor on_nil (forall ((x ident)) (out_names x nil)))
  (ctor on_cons (forall ((x ident) (y ident) (ty type) (rest (binds)))
    (-> (not (= x y)) (-> (out_names x rest) (out_names x (cons (pair y ty) rest)))))))
(relation norepet_names () ((binds))
  (ctor nn_nil (norepet_names nil))
  (ctor nn_cons (forall ((x ident) (ty type) (rest (binds)))
    (-> (out_names x rest) (-> (norepet_names rest) (norepet_names (cons (pair x ty) rest)))))))
(relation disjoint_names () ((binds) (binds))
  (ctor dn_nil (forall ((l (binds))) (disjoint_names nil l)))
  (ctor dn_cons (forall ((x ident) (ty type) (rest (binds)) (l (binds)))
    (-> (out_names x l) (-> (disjoint_names rest l) (disjoint_names (cons (pair x ty) rest) l))))))
(relation params_types () ((binds) (list type))
  (ctor pt_nil (params_types nil nil))
  (ctor pt_cons (forall ((x ident) (ty type) (rest (binds)) (tys (list type)))
    (-> (params_types rest tys) (params_types (cons (pair x ty) rest) (cons ty tys))))))

; A function's temporaries before its parameters are bound: each declared one holds Vundef.
(relation undef_temps () ((binds) (tmap))
  (ctor ut_nil (forall ((le (tmap)))
    (-> (forall ((x ident)) (= (le x) None)) (undef_temps nil le))))
  (ctor ut_cons (forall ((x ident) (ty type) (rest (binds)) (le0 (tmap)) (le (tmap)))
    (-> (undef_temps rest le0)
      (-> (upd le le0 x Vundef) (undef_temps (cons (pair x ty) rest) le))))))
; The parameters bound to the arguments, in order.
(relation bind_params () ((binds) (list val) (tmap) (tmap))
  (ctor bp_nil (forall ((le (tmap))) (bind_params nil nil le le)))
  (ctor bp_cons (forall ((x ident) (ty type) (rest (binds)) (v val) (vs (list val)) (le (tmap))
                         (le1 (tmap)) (le2 (tmap)))
    (-> (upd le1 le x v) (-> (bind_params rest vs le1 le2)
      (bind_params (cons (pair x ty) rest) (cons v vs) le le2))))))
; The temporaries after a call that stores its result in optid, or in none.
(relation set_opt () ((option ident) val (tmap) (tmap))
  (ctor so_none (forall ((v val) (le (tmap))) (set_opt None v le le)))
  (ctor so_some (forall ((x ident) (v val) (le (tmap)) (le2 (tmap)))
    (-> (upd le2 le x v) (set_opt (Some x) v le le2)))))

; The type of an expression of the forms that N evaluates.
(relation has_type () (expr type)
  (ctor ht_int (forall ((i w32) (ty type)) (has_type (Econst_int i ty) ty)))
  (ctor ht_long (forall ((i w64) (ty type)) (has_type (Econst_long i ty) ty)))
  (ctor ht_float (forall ((f float) (ty type)) (has_type (Econst_float f ty) ty)))
  (ctor ht_single (forall ((f float32) (ty type)) (has_type (Econst_single f ty) ty)))
  (ctor ht_temp (forall ((x ident) (ty type)) (has_type (Etempvar x ty) ty)))
  (ctor ht_var (forall ((x ident) (ty type)) (has_type (Evar x ty) ty)))
  (ctor ht_deref (forall ((a expr) (ty type)) (has_type (Ederef a ty) ty)))
  (ctor ht_binop (forall ((op binary_operation) (a1 expr) (a2 expr) (ty type))
    (has_type (Ebinop op a1 a2 ty) ty)))
  (ctor ht_cast (forall ((a expr) (ty type)) (has_type (Ecast a ty) ty)))
  (ctor ht_unop (forall ((op unary_operation) (a expr) (ty type)) (has_type (Eunop op a ty) ty))))

; Scalar globals: their types, the values they hold, and the initialization data that the
; program judgment accepts for them and for the other variables.  A global of type double or float
; initialized by the space of its bytes holds the number of the bits 0.
(relation scalar () (type)
  (ctor sc_ui (scalar (tuint)))
  (ctor sc_ul (scalar (tulong)))
  (ctor sc_d (scalar (tdouble)))
  (ctor sc_f (scalar (tfloat))))
(relation gval () (type val)
  (ctor gv_ui (forall ((x w32)) (gval (tuint) (Vint x))))
  (ctor gv_ul (forall ((x w64)) (gval (tulong) (Vlong x))))
  (ctor gv_d (forall ((f float)) (gval (tdouble) (Vfloat f))))
  (ctor gv_f (forall ((f float32)) (gval (tfloat) (Vsingle f)))))
(relation ginit () (type (list init_data) val)
  (ctor gi_ui (forall ((x w32)) (ginit (tuint) (cons (Init_int32 x) nil) (Vint x))))
  (ctor gi_ul (forall ((x w64)) (ginit (tulong) (cons (Init_int64 x) nil) (Vlong x))))
  (ctor gi_d (ginit (tdouble) (cons (Init_space 8) nil) (Vfloat (f64_of_bits (r64 0)))))
  (ctor gi_f (ginit (tfloat) (cons (Init_space 4) nil) (Vsingle (f32_of_bits (r32 0))))))
(relation init_ok () ((list init_data))
  (ctor io_nil (init_ok nil))
  (ctor io_int32 (forall ((x w32)) (init_ok (cons (Init_int32 x) nil))))
  (ctor io_int64 (forall ((x w64)) (init_ok (cons (Init_int64 x) nil))))
  (ctor io_space (forall ((n Z)) (init_ok (cons (Init_space n) nil)))))

; The value of a volatile load of the chunk ch from an element of the type ty and the size sz,
; whose event holds j.
(relation vload_ok () (chunk type Z w32 val)
  (ctor vl_uchar (forall ((j w32))
    (vload_ok Mint8unsigned (tvuchar) 1 j (Vint (r32 (zmod (u32 j) 256))))))
  (ctor vl_uint (forall ((j w32)) (vload_ok Mint32 (tvuint) 4 j (Vint j)))))

; The value of a function's result after the outcome of its body.
(relation result_ok () (outcome type val)
  (ctor rs_normal (result_ok Out_normal Tvoid Vundef))
  (ctor rs_none (result_ok (Out_return None) Tvoid Vundef))
  (ctor rs_some (forall ((v val) (t type) (ty type) (v2 val))
    (-> (not (= ty Tvoid))
      (-> (cast_ok t ty v v2) (result_ok (Out_return (Some (pair v t))) ty v2))))))

; neval defs le gv mb a v: the expression a evaluates to v.  A word, byte, or cell of an array is
; read from the bytes mb of the array within its 8 n bytes, and a cell of type double or float is
; the number of the bits of its bytes.
(relation neval ((defs (dlist)) (le (tmap)) (gv (tmap)) (mb (amap))) (expr val)
  (ctor nv_int (forall ((i w32) (ty type)) (neval defs le gv mb (Econst_int i ty) (Vint i))))
  (ctor nv_long (forall ((i w64) (ty type)) (neval defs le gv mb (Econst_long i ty) (Vlong i))))
  (ctor nv_float (forall ((f float) (ty type))
    (neval defs le gv mb (Econst_float f ty) (Vfloat f))))
  (ctor nv_single (forall ((f float32) (ty type))
    (neval defs le gv mb (Econst_single f ty) (Vsingle f))))
  (ctor nv_temp (forall ((x ident) (ty type) (v val))
    (-> (= (le x) (Some v)) (neval defs le gv mb (Etempvar x ty) v))))
  (ctor nv_global (forall ((x ident) (ty type) (init (list init_data)) (v val))
    (-> (in_defs defs x (Gvar (mkglobvar ty init false false))) (-> (scalar ty)
      (-> (= (gv x) (Some v)) (neval defs le gv mb (Evar x ty) v))))))
  (ctor nv_word (forall ((x ident) (n Z) (i expr) (k w64))
    (-> (arr defs x n) (-> (neval defs le gv mb i (Vlong k)) (-> (has_type i (tulong))
      (-> (<= (+ (woff k) 8) (* 8 n))
        (neval defs le gv mb (word_e x n i) (Vlong (r64 (le8 mb x (woff k)))))))))))
  (ctor nv_byte (forall ((x ident) (n Z) (i expr) (k w64))
    (-> (arr defs x n) (-> (neval defs le gv mb i (Vlong k)) (-> (has_type i (tulong))
      (-> (< (u64 k) (* 8 n))
        (neval defs le gv mb (byte_e x n i) (Vint (r32 (mb x (u64 k)))))))))))
  (ctor nv_cell64 (forall ((x ident) (n Z))
    (-> (arr defs x n) (-> (<= 1 n)
      (neval defs le gv mb (cell_e x n (tulong)) (Vlong (r64 (le8 mb x 0))))))))
  (ctor nv_cell32 (forall ((x ident) (n Z))
    (-> (arr defs x n) (-> (<= 1 n)
      (neval defs le gv mb (cell_e x n (tuint)) (Vint (r32 (le4 mb x 0))))))))
  (ctor nv_cellf64 (forall ((x ident) (n Z))
    (-> (arr defs x n) (-> (<= 1 n)
      (neval defs le gv mb (cell_e x n (tdouble)) (Vfloat (f64_of_bits (r64 (le8 mb x 0)))))))))
  (ctor nv_cellf32 (forall ((x ident) (n Z))
    (-> (arr defs x n) (-> (<= 1 n)
      (neval defs le gv mb (cell_e x n (tfloat)) (Vsingle (f32_of_bits (r32 (le4 mb x 0)))))))))
  (ctor nv_binop (forall ((op binary_operation) (a1 expr) (a2 expr) (ty type) (t1 type) (t2 type)
                          (v1 val) (v2 val) (v val))
    (-> (neval defs le gv mb a1 v1) (-> (has_type a1 t1) (-> (neval defs le gv mb a2 v2)
      (-> (has_type a2 t2) (-> (binop_ok op t1 t2 v1 v2 v)
        (neval defs le gv mb (Ebinop op a1 a2 ty) v))))))))
  (ctor nv_cast (forall ((a expr) (ty type) (t1 type) (v1 val) (v val))
    (-> (neval defs le gv mb a v1) (-> (has_type a t1) (-> (cast_ok t1 ty v1 v)
      (neval defs le gv mb (Ecast a ty) v))))))
  (ctor nv_unop (forall ((op unary_operation) (a expr) (ty type) (t1 type) (v1 val) (v val))
    (-> (neval defs le gv mb a v1) (-> (has_type a t1) (-> (unop_ok op t1 v1 v)
      (neval defs le gv mb (Eunop op a ty) v)))))))

; The arguments of a call, each cast to its parameter's type.
(relation neval_list ((defs (dlist)) (le (tmap)) (gv (tmap)) (mb (amap)))
    ((list expr) (list type) (list val))
  (ctor nl_nil (neval_list defs le gv mb nil nil nil))
  (ctor nl_cons (forall ((a expr) (al (list expr)) (ty type) (tys (list type)) (t1 type) (v1 val)
                         (v val) (vs (list val)))
    (-> (neval defs le gv mb a v1) (-> (has_type a t1) (-> (cast_ok t1 ty v1 v)
      (-> (neval_list defs le gv mb al tys vs)
        (neval_list defs le gv mb (cons a al) (cons ty tys) (cons v vs)))))))))

; nexec defs le gv mb s t le2 gv2 mb2 out: the statement s runs from the temporaries le, the
; scalar globals gv, and the bytes mb of the arrays to le2, gv2, and mb2 with the trace t and the
; outcome out.  A store to a cell of type double or float writes the bytes of the number's bits,
; and a call of the built-in __builtin_fsqrt sets its temporary to the square root of its
; argument, with no event.
(relation nexec ((defs (dlist)))
    ((tmap) (tmap) (amap) statement (list event) (tmap) (tmap) (amap) outcome)
  (ctor nx_skip (forall ((le (tmap)) (gv (tmap)) (mb (amap)))
    (nexec defs le gv mb Sskip nil le gv mb Out_normal)))
  (ctor nx_set (forall ((le (tmap)) (gv (tmap)) (mb (amap)) (x ident) (a expr) (v val)
                        (le2 (tmap)))
    (-> (neval defs le gv mb a v) (-> (upd le2 le x v)
      (nexec defs le gv mb (Sset x a) nil le2 gv mb Out_normal)))))
  (ctor nx_store (forall ((le (tmap)) (gv (tmap)) (mb (amap)) (x ident) (ty type)
                          (init (list init_data)) (a expr) (t1 type) (v1 val) (v val)
                          (gv2 (tmap)))
    (-> (in_defs defs x (Gvar (mkglobvar ty init false false))) (-> (scalar ty)
      (-> (neval defs le gv mb a v1) (-> (has_type a t1) (-> (cast_ok t1 ty v1 v) (-> (gval ty v)
        (-> (upd gv2 gv x v)
          (nexec defs le gv mb (Sassign (Evar x ty) a) nil le gv2 mb Out_normal))))))))))
  (ctor nx_store_word (forall ((le (tmap)) (gv (tmap)) (mb (amap)) (x ident) (n Z) (i expr)
                               (k w64) (a expr) (t1 type) (v1 val) (w w64) (mb2 (amap)))
    (-> (arr defs x n) (-> (neval defs le gv mb i (Vlong k)) (-> (has_type i (tulong))
      (-> (<= (+ (woff k) 8) (* 8 n))
        (-> (neval defs le gv mb a v1) (-> (has_type a t1)
          (-> (cast_ok t1 (tulong) v1 (Vlong w)) (-> (setbytes mb2 mb x (woff k) 8 (u64 w))
            (nexec defs le gv mb (Sassign (word_e x n i) a) nil le gv mb2 Out_normal)))))))))))
  (ctor nx_store_byte (forall ((le (tmap)) (gv (tmap)) (mb (amap)) (x ident) (n Z) (i expr)
                               (k w64) (a expr) (t1 type) (v1 val) (c w32) (mb2 (amap)))
    (-> (arr defs x n) (-> (neval defs le gv mb i (Vlong k)) (-> (has_type i (tulong))
      (-> (< (u64 k) (* 8 n))
        (-> (neval defs le gv mb a v1) (-> (has_type a t1)
          (-> (cast_ok t1 (tuchar) v1 (Vint c)) (-> (setbytes mb2 mb x (u64 k) 1 (u32 c))
            (nexec defs le gv mb (Sassign (byte_e x n i) a) nil le gv mb2 Out_normal)))))))))))
  (ctor nx_store_cell64 (forall ((le (tmap)) (gv (tmap)) (mb (amap)) (x ident) (n Z) (a expr)
                                 (t1 type) (v1 val) (w w64) (mb2 (amap)))
    (-> (arr defs x n) (-> (<= 1 n)
      (-> (neval defs le gv mb a v1) (-> (has_type a t1) (-> (cast_ok t1 (tulong) v1 (Vlong w))
        (-> (setbytes mb2 mb x 0 8 (u64 w))
          (nexec defs le gv mb (Sassign (cell_e x n (tulong)) a) nil le gv mb2 Out_normal)))))))))
  (ctor nx_store_cell32 (forall ((le (tmap)) (gv (tmap)) (mb (amap)) (x ident) (n Z) (a expr)
                                 (t1 type) (v1 val) (c w32) (mb2 (amap)))
    (-> (arr defs x n) (-> (<= 1 n)
      (-> (neval defs le gv mb a v1) (-> (has_type a t1) (-> (cast_ok t1 (tuint) v1 (Vint c))
        (-> (setbytes mb2 mb x 0 4 (u32 c))
          (nexec defs le gv mb (Sassign (cell_e x n (tuint)) a) nil le gv mb2 Out_normal)))))))))
  (ctor nx_store_cellf64 (forall ((le (tmap)) (gv (tmap)) (mb (amap)) (x ident) (n Z) (a expr)
                                  (t1 type) (v1 val) (f float) (mb2 (amap)))
    (-> (arr defs x n) (-> (<= 1 n)
      (-> (neval defs le gv mb a v1) (-> (has_type a t1) (-> (cast_ok t1 (tdouble) v1 (Vfloat f))
        (-> (setbytes mb2 mb x 0 8 (u64 (f64_bits f)))
          (nexec defs le gv mb (Sassign (cell_e x n (tdouble)) a) nil le gv mb2 Out_normal)))))))))
  (ctor nx_store_cellf32 (forall ((le (tmap)) (gv (tmap)) (mb (amap)) (x ident) (n Z) (a expr)
                                  (t1 type) (v1 val) (f float32) (mb2 (amap)))
    (-> (arr defs x n) (-> (<= 1 n)
      (-> (neval defs le gv mb a v1) (-> (has_type a t1) (-> (cast_ok t1 (tfloat) v1 (Vsingle f))
        (-> (setbytes mb2 mb x 0 4 (u32 (f32_bits f)))
          (nexec defs le gv mb (Sassign (cell_e x n (tfloat)) a) nil le gv mb2 Out_normal)))))))))
  (ctor nx_out (forall ((le (tmap)) (gv (tmap)) (mb (amap)) (x ident) (init (list init_data))
                        (a expr) (t1 type) (v1 val) (i w32))
    (-> (in_defs defs x (Gvar (mkglobvar (tvuint) init false true)))
      (-> (neval defs le gv mb a v1) (-> (has_type a t1) (-> (cast_ok t1 (tvuint) v1 (Vint i))
        (nexec defs le gv mb
          (Sbuiltin None (EF_vstore Mint32)
            (cons (Tpointer (tvuint) (noattr)) (cons (tvuint) nil))
            (cons (Eaddrof (Evar x (tvuint)) (Tpointer (tvuint) (noattr))) (cons a nil)))
          (cons (Event_vstore Mint32 x (rptr 0) (EVint i)) nil) le gv mb Out_normal)))))))
  (ctor nx_vload (forall ((le (tmap)) (gv (tmap)) (mb (amap)) (t ident) (x ident) (ty type) (n Z)
                          (init (list init_data)) (ch chunk) (sz Z) (i expr) (k w64) (j w32)
                          (v val) (le2 (tmap)))
    (-> (in_defs defs x (Gvar (mkglobvar (Tarray ty n (noattr)) init false true)))
      (-> (neval defs le gv mb i (Vlong k)) (-> (has_type i (tulong))
        (-> (vload_ok ch ty sz j v) (-> (upd le2 le t v)
          (nexec defs le gv mb
            (Sbuiltin (Some t) (EF_vload ch) (cons (Tpointer ty (noattr)) nil)
              (cons (Eaddrof (Ederef (Ebinop Oadd (Evar x (Tarray ty n (noattr))) i
                                       (Tpointer ty (noattr))) ty)
                      (Tpointer ty (noattr))) nil))
            (cons (Event_vload ch x (rptr (* sz (u64 k))) (EVint j)) nil) le2 gv mb
            Out_normal))))))))
  (ctor nx_vstore (forall ((le (tmap)) (gv (tmap)) (mb (amap)) (x ident) (n Z)
                           (init (list init_data)) (i expr) (k w64) (a expr) (t1 type) (v1 val)
                           (c w32))
    (-> (in_defs defs x (Gvar (mkglobvar (Tarray (tvuint) n (noattr)) init false true)))
      (-> (neval defs le gv mb i (Vlong k)) (-> (has_type i (tulong))
        (-> (neval defs le gv mb a v1) (-> (has_type a t1) (-> (cast_ok t1 (tvuint) v1 (Vint c))
          (nexec defs le gv mb
            (Sbuiltin None (EF_vstore Mint32)
              (cons (Tpointer (tvuint) (noattr)) (cons (tvuint) nil))
              (cons (Eaddrof (Ederef (Ebinop Oadd (Evar x (Tarray (tvuint) n (noattr))) i
                                       (Tpointer (tvuint) (noattr))) (tvuint))
                      (Tpointer (tvuint) (noattr)))
                (cons a nil)))
            (cons (Event_vstore Mint32 x (rptr (* 4 (u64 k))) (EVint c)) nil) le gv mb
            Out_normal)))))))))
  (ctor nx_call (forall ((le (tmap)) (gv (tmap)) (mb (amap)) (optid (option ident)) (x ident)
                         (tys (list type)) (ret type) (cc cconv) (al (list expr)) (vs (list val))
                         (params (binds)) (temps (binds)) (body statement) (le0 (tmap))
                         (le1 (tmap)) (t (list event)) (le2 (tmap)) (gv2 (tmap)) (mb2 (amap))
                         (out outcome) (v val) (le3 (tmap)))
    (-> (in_defs defs x (Gfun (Internal (mkfunction ret cc params nil temps body))))
      (-> (params_types params tys) (-> (neval_list defs le gv mb al tys vs)
        (-> (norepet_names params) (-> (disjoint_names params temps) (-> (undef_temps temps le0)
          (-> (bind_params params vs le0 le1) (-> (nexec defs le1 gv mb body t le2 gv2 mb2 out)
            (-> (result_ok out ret v) (-> (set_opt optid v le le3)
              (nexec defs le gv mb (Scall optid (Evar x (Tfunction tys ret cc)) al) t le3 gv2 mb2
                Out_normal)))))))))))))
  (ctor nx_sqrt (forall ((le (tmap)) (gv (tmap)) (mb (amap)) (optid (option ident)) (x ident)
                         (al (list expr)) (f float) (le2 (tmap)))
    (-> (in_defs defs x (Gfun (External (EF_builtin "__builtin_fsqrt" (sqrt_sig))
                                 (cons (tdouble) nil) (tdouble) (cc_default))))
      (-> (neval_list defs le gv mb al (cons (tdouble) nil) (cons (Vfloat f) nil))
        (-> (set_opt optid (Vfloat (fsqrt64 f)) le le2)
          (nexec defs le gv mb
            (Scall optid (Evar x (Tfunction (cons (tdouble) nil) (tdouble) (cc_default))) al) nil
            le2 gv mb Out_normal))))))
  (ctor nx_seq1 (forall ((le (tmap)) (gv (tmap)) (mb (amap)) (s1 statement) (s2 statement)
                         (t1 (list event)) (le1 (tmap)) (gv1 (tmap)) (mb1 (amap))
                         (t2 (list event)) (le2 (tmap)) (gv2 (tmap)) (mb2 (amap)) (out outcome))
    (-> (nexec defs le gv mb s1 t1 le1 gv1 mb1 Out_normal)
      (-> (nexec defs le1 gv1 mb1 s2 t2 le2 gv2 mb2 out)
        (nexec defs le gv mb (Ssequence s1 s2) (app t1 t2) le2 gv2 mb2 out)))))
  (ctor nx_seq2 (forall ((le (tmap)) (gv (tmap)) (mb (amap)) (s1 statement) (s2 statement)
                         (t1 (list event)) (le1 (tmap)) (gv1 (tmap)) (mb1 (amap)) (out outcome))
    (-> (nexec defs le gv mb s1 t1 le1 gv1 mb1 out) (-> (not (= out Out_normal))
      (nexec defs le gv mb (Ssequence s1 s2) t1 le1 gv1 mb1 out)))))
  (ctor nx_if_true (forall ((le (tmap)) (gv (tmap)) (mb (amap)) (a expr) (s1 statement)
                            (s2 statement) (v val) (ta type) (t (list event)) (le2 (tmap))
                            (gv2 (tmap)) (mb2 (amap)) (out outcome))
    (-> (neval defs le gv mb a v) (-> (has_type a ta) (-> (bool_ok ta v true)
      (-> (nexec defs le gv mb s1 t le2 gv2 mb2 out)
        (nexec defs le gv mb (Sifthenelse a s1 s2) t le2 gv2 mb2 out)))))))
  (ctor nx_if_false (forall ((le (tmap)) (gv (tmap)) (mb (amap)) (a expr) (s1 statement)
                             (s2 statement) (v val) (ta type) (t (list event)) (le2 (tmap))
                             (gv2 (tmap)) (mb2 (amap)) (out outcome))
    (-> (neval defs le gv mb a v) (-> (has_type a ta) (-> (bool_ok ta v false)
      (-> (nexec defs le gv mb s2 t le2 gv2 mb2 out)
        (nexec defs le gv mb (Sifthenelse a s1 s2) t le2 gv2 mb2 out)))))))
  (ctor nx_return_none (forall ((le (tmap)) (gv (tmap)) (mb (amap)))
    (nexec defs le gv mb (Sreturn None) nil le gv mb (Out_return None))))
  (ctor nx_return_some (forall ((le (tmap)) (gv (tmap)) (mb (amap)) (a expr) (v val) (ta type))
    (-> (neval defs le gv mb a v) (-> (has_type a ta)
      (nexec defs le gv mb (Sreturn (Some a)) nil le gv mb (Out_return (Some (pair v ta))))))))
  (ctor nx_break (forall ((le (tmap)) (gv (tmap)) (mb (amap)))
    (nexec defs le gv mb Sbreak nil le gv mb Out_break)))
  (ctor nx_continue (forall ((le (tmap)) (gv (tmap)) (mb (amap)))
    (nexec defs le gv mb Scontinue nil le gv mb Out_continue)))
  (ctor nx_loop_stop1 (forall ((le (tmap)) (gv (tmap)) (mb (amap)) (s1 statement) (s2 statement)
                               (t (list event)) (le1 (tmap)) (gv1 (tmap)) (mb1 (amap))
                               (out1 outcome) (out outcome))
    (-> (nexec defs le gv mb s1 t le1 gv1 mb1 out1)
      (-> (or (and (= out1 Out_break) (= out Out_normal))
              (exists ((r (option (prod val type))))
                (and (= out1 (Out_return r)) (= out (Out_return r)))))
        (nexec defs le gv mb (Sloop s1 s2) t le1 gv1 mb1 out)))))
  (ctor nx_loop_stop2 (forall ((le (tmap)) (gv (tmap)) (mb (amap)) (s1 statement) (s2 statement)
                               (t1 (list event)) (le1 (tmap)) (gv1 (tmap)) (mb1 (amap))
                               (out1 outcome) (t2 (list event)) (le2 (tmap)) (gv2 (tmap))
                               (mb2 (amap)) (out2 outcome) (out outcome))
    (-> (nexec defs le gv mb s1 t1 le1 gv1 mb1 out1)
      (-> (or (= out1 Out_normal) (= out1 Out_continue))
        (-> (nexec defs le1 gv1 mb1 s2 t2 le2 gv2 mb2 out2)
          (-> (or (and (= out2 Out_break) (= out Out_normal))
                  (exists ((r (option (prod val type))))
                    (and (= out2 (Out_return r)) (= out (Out_return r)))))
            (nexec defs le gv mb (Sloop s1 s2) (app t1 t2) le2 gv2 mb2 out)))))))
  (ctor nx_loop (forall ((le (tmap)) (gv (tmap)) (mb (amap)) (s1 statement) (s2 statement)
                         (t1 (list event)) (le1 (tmap)) (gv1 (tmap)) (mb1 (amap)) (out1 outcome)
                         (t2 (list event)) (le2 (tmap)) (gv2 (tmap)) (mb2 (amap))
                         (t3 (list event)) (le3 (tmap)) (gv3 (tmap)) (mb3 (amap)) (out outcome))
    (-> (nexec defs le gv mb s1 t1 le1 gv1 mb1 out1)
      (-> (or (= out1 Out_normal) (= out1 Out_continue))
        (-> (nexec defs le1 gv1 mb1 s2 t2 le2 gv2 mb2 Out_normal)
          (-> (nexec defs le2 gv2 mb2 (Sloop s1 s2) t3 le3 gv3 mb3 out)
            (nexec defs le gv mb (Sloop s1 s2) (app t1 (app t2 t3)) le3 gv3 mb3 out))))))))

; ninit defs gv mb: the definitions defs have distinct identifiers and initialization data that N
; accepts, gv holds the initial value of each scalar global, and mb holds zero in each byte of
; each array.
(relation ninit () ((dlist) (tmap) (amap))
  (ctor ni_intro (forall ((defs (dlist)) (gv (tmap)) (mb (amap)))
    (-> (norepet_defs defs)
      (-> (forall ((x ident) (ty type) (init (list init_data)) (ro bool) (vol bool))
            (-> (in_defs defs x (Gvar (mkglobvar ty init ro vol))) (init_ok init)))
        (-> (forall ((x ident) (ty type) (init (list init_data)))
              (-> (in_defs defs x (Gvar (mkglobvar ty init false false))) (-> (scalar ty)
                (exists ((v val)) (and (ginit ty init v) (= (gv x) (Some v)))))))
          (-> (forall ((x ident) (n Z) (j Z))
                (-> (arr defs x n) (-> (<= 0 j) (-> (< j (* 8 n)) (= (mb x j) 0)))))
            (ninit defs gv mb))))))))

; nprog defs main t r: the program of the definitions defs terminates with the trace t and the
; result r when its function main, of type int (void), runs from the initial state.
(relation nprog () ((dlist) ident (list event) w32)
  (ctor np_intro (forall ((defs (dlist)) (main ident) (temps (binds)) (body statement) (gv0 (tmap))
                          (mb0 (amap)) (le0 (tmap)) (t (list event)) (le2 (tmap)) (gv2 (tmap))
                          (mb2 (amap)) (out outcome) (r w32))
    (-> (ninit defs gv0 mb0)
      (-> (in_defs defs main
            (Gfun (Internal (mkfunction (tint) (cc_default) nil nil temps body))))
        (-> (undef_temps temps le0) (-> (nexec defs le0 gv0 mb0 body t le2 gv2 mb2 out)
          (-> (result_ok out (tint) (Vint r)) (nprog defs main t r)))))))))

; loop_in s init body post: the statement s runs init and then the loop Sloop body post, through
; sequences that precede or follow the loop.
(relation loop_in () (statement statement statement statement)
  (ctor li_loop (forall ((body statement) (post statement))
    (loop_in (Sloop body post) Sskip body post)))
  (ctor li_after (forall ((s statement) (init statement) (body statement) (post statement)
                          (rest statement))
    (-> (loop_in s init body post) (loop_in (Ssequence s rest) init body post))))
  (ctor li_before (forall ((s statement) (init statement) (body statement) (post statement)
                           (pre statement))
    (-> (loop_in s init body post)
      (loop_in (Ssequence pre s) (Ssequence pre init) body post)))))

; nreacts defs main t0 W: the function main of the program of the definitions defs, of type
; int (void), runs from the initial state the statements init before its loop with the trace t0,
; and then the loop, whose iteration n runs with the nonempty trace W n.  An invariant Inv over
; N's states, indexed by the iteration, holds after init, and every iteration preserves it.
(relation nreacts () ((dlist) ident (list event) (-> nat (list event)))
  (ctor nr_intro (forall ((defs (dlist)) (main ident) (temps (binds)) (body statement)
                          (gv0 (tmap)) (mb0 (amap)) (le0 (tmap)) (init statement)
                          (lbody statement) (lpost statement) (t0 (list event))
                          (W (-> nat (list event)))
                          (Inv (-> nat (-> (tmap) (-> (tmap) (-> (amap) Prop))))))
    (-> (forall ((n nat)) (not (= (W n) nil)))
      (-> (ninit defs gv0 mb0)
        (-> (in_defs defs main
              (Gfun (Internal (mkfunction (tint) (cc_default) nil nil temps body))))
          (-> (undef_temps temps le0) (-> (loop_in body init lbody lpost)
            (-> (exists ((le (tmap)) (gv (tmap)) (mb (amap)))
                  (and (nexec defs le0 gv0 mb0 init t0 le gv mb Out_normal) (Inv O le gv mb)))
              (-> (forall ((n nat) (le (tmap)) (gv (tmap)) (mb (amap)))
                    (-> (Inv n le gv mb)
                      (exists ((le2 (tmap)) (gv2 (tmap)) (mb2 (amap)))
                        (and (nexec defs le gv mb (Ssequence lbody lpost) (W n) le2 gv2 mb2
                               Out_normal)
                          (Inv (S n) le2 gv2 mb2)))))
                (nreacts defs main t0 W)))))))))))

; nreads s c t: the trace t holds only volatile loads and stores, and its k-th volatile load reads
; EVint (s (c + k)).
(relation nreads () ((-> nat w32) nat (list event))
  (ctor nr_nil (forall ((s (-> nat w32)) (c nat)) (nreads s c nil)))
  (ctor nr_load (forall ((s (-> nat w32)) (c nat) (ch chunk) (x ident) (o ptrofs)
                         (t (list event)))
    (-> (nreads s (S c) t) (nreads s c (cons (Event_vload ch x o (EVint (s c))) t)))))
  (ctor nr_store (forall ((s (-> nat w32)) (c nat) (ch chunk) (x ident) (o ptrofs)
                          (ev eventval) (t (list event)))
    (-> (nreads s c t) (nreads s c (cons (Event_vstore ch x o ev) t))))))

; ---------------------------------------------------------------------------------------------
; Laws of the base symbols.  They fix each symbol's meaning on the arguments with which the
; statements above use it, so that the twin files need no review beyond the names of the
; definitions under test: u32 and u64 map the words one to one onto the numbers below 2^32 and
; 2^64, and r32 and r64 invert them modulo the word size; zdiv and zmod are the quotient and
; remainder of Euclid's division by a positive divisor; pow2 doubles from pow2 0 = 1; two
; numbers that are not negative and have the same bits are equal; uptr and rptr relate pointer
; offsets to the numbers below 2^64 as u64 and r64 relate words; app concatenates traces; and the
; floating-point number of a bit pattern has that pattern.

(statement u32_range (forall ((x w32)) (and (<= 0 (u32 x)) (< (u32 x) 4294967296))))
(statement u32_r32 (forall ((z Z)) (= (u32 (r32 z)) (zmod z 4294967296))))
(statement r32_u32 (forall ((x w32)) (= (r32 (u32 x)) x)))
(statement u64_range (forall ((x w64)) (and (<= 0 (u64 x)) (< (u64 x) 18446744073709551616))))
(statement u64_r64 (forall ((z Z)) (= (u64 (r64 z)) (zmod z 18446744073709551616))))
(statement r64_u64 (forall ((x w64)) (= (r64 (u64 x)) x)))
(statement s64_low (forall ((x w64))
  (-> (< (u64 x) 9223372036854775808) (= (s64 x) (u64 x)))))
(statement s64_high (forall ((x w64))
  (-> (<= 9223372036854775808 (u64 x)) (= (s64 x) (- (u64 x) 18446744073709551616)))))
(statement zdiv_zmod (forall ((a Z) (b Z)) (-> (< 0 b)
  (and (= a (+ (* b (zdiv a b)) (zmod a b))) (and (<= 0 (zmod a b)) (< (zmod a b) b))))))
(statement pow2_zero (= (pow2 0) 1))
(statement pow2_succ (forall ((k Z)) (-> (<= 0 k) (= (pow2 (+ k 1)) (* 2 (pow2 k))))))
(statement land_bits (forall ((a Z) (b Z) (k Z)) (-> (<= 0 a) (-> (<= 0 b) (-> (<= 0 k)
  (= (bit (land a b) k) (* (bit a k) (bit b k))))))))
(statement land_nonneg (forall ((a Z) (b Z)) (-> (<= 0 a) (-> (<= 0 b) (<= 0 (land a b))))))
(statement lor_bits (forall ((a Z) (b Z) (k Z)) (-> (<= 0 a) (-> (<= 0 b) (-> (<= 0 k)
  (= (bit (lor a b) k) (- (+ (bit a k) (bit b k)) (* (bit a k) (bit b k)))))))))
(statement lor_nonneg (forall ((a Z) (b Z)) (-> (<= 0 a) (-> (<= 0 b) (<= 0 (lor a b))))))
(statement lxor_bits (forall ((a Z) (b Z) (k Z)) (-> (<= 0 a) (-> (<= 0 b) (-> (<= 0 k)
  (= (bit (lxor a b) k) (zmod (+ (bit a k) (bit b k)) 2)))))))
(statement lxor_nonneg (forall ((a Z) (b Z)) (-> (<= 0 a) (-> (<= 0 b) (<= 0 (lxor a b))))))
(statement uptr_range (forall ((x ptrofs))
  (and (<= 0 (uptr x)) (< (uptr x) 18446744073709551616))))
(statement uptr_rptr (forall ((z Z)) (= (uptr (rptr z)) (zmod z 18446744073709551616))))
(statement rptr_uptr (forall ((x ptrofs)) (= (rptr (uptr x)) x)))
(statement app_nil (forall ((t (list event))) (= (app nil t) t)))
(statement app_cons (forall ((e event) (t1 (list event)) (t2 (list event)))
  (= (app (cons e t1) t2) (cons e (app t1 t2)))))
(statement f64_bits_of_bits (forall ((x w64)) (= (f64_bits (f64_of_bits x)) x)))
(statement f64_of_bits_bits (forall ((f float)) (= (f64_of_bits (f64_bits f)) f)))
(statement f32_bits_of_bits (forall ((x w32)) (= (f32_bits (f32_of_bits x)) x)))
(statement f32_of_bits_bits (forall ((f float32)) (= (f32_of_bits (f32_bits f)) f)))
