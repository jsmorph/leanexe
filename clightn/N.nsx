; The reference semantics N of the Clight forms that the C translator emits, in the neutral
; language that clightn/nsx.py renders into Rocq and Lean and checks (clightn/README.md).  This
; file holds the symbol table with the floating-point equations, the leaf relations of the
; operator, cast, and condition forms on integers and floating-point numbers, the per-form
; statements, the relations of expressions, statements, calls, and whole programs over
; temporaries, scalar globals, and the bytes of arrays, the volatile accesses of the bare-metal
; main, the loop of a main that runs forever, and the laws of the base symbols.  N describes
; AArch64, where Archi.ptr64 is true.

; ---------------------------------------------------------------------------------------------
; Symbol table.  A sort, data constructor, base symbol, or interpreted symbol has one name in each
; prover, which the renderer writes and the check expects in the elaborated terms.  A name that is
; a list is an application whose arguments are fixed: the types and instance of an arithmetic
; operation, or the type arguments of a polymorphic type or constructor.  The sort ident is
; positive in Rocq and Nat in Lean, whose 0 no program uses.

(sort Z (rocq BinNums.Z) (lean Int))
(sort w32 (rocq Integers.Int.int) (lean UInt32))
(sort w64 (rocq Integers.Int64.int) (lean UInt64))
(sort bool (rocq bool) (lean Bool))
(sort block (rocq Values.block) (lean LClight.block))
(sort ptrofs (rocq Integers.Ptrofs.int) (lean LClight.ptrofs))
(sort val (rocq Values.val) (lean LClight.val))
(sort type (rocq Ctypes.type) (lean LClight.type))
(sort expr (rocq Clight.expr) (lean LClight.expr))
(sort binary_operation (rocq Cop.binary_operation) (lean LClight.binary_operation))
(sort mem (rocq Memory.Mem.mem) (lean LClight.mem))
(sort cenv (rocq Ctypes.composite_env) (lean Unit))
(sort genv (rocq Clight.genv) (lean LClight.genv))
(sort env (rocq Clight.env) (lean LClight.env))
(sort tenv (rocq Clight.temp_env) (lean LClight.temp_env))
(sort ident (rocq AST.ident) (lean LClight.ident))
(sort string (rocq String.string) (lean String))
(sort float (rocq Floats.float) (lean LClight.float))
(sort float32 (rocq Floats.float32) (lean LClight.float32))
(sort unary_operation (rocq Cop.unary_operation) (lean LClight.unary_operation))
(sort statement (rocq Clight.statement) (lean LClight.statement))
(sort outcome (rocq ClightBigstep.outcome) (lean LClight.outcome))
(sort function (rocq Clight.function) (lean LClight.function))
(sort fundef (rocq Clight.fundef) (lean (LClight.fundef LClight.function)))
(sort globvar (rocq (AST.globvar Ctypes.type)) (lean (LClight.globvar LClight.type)))
(sort globdef (rocq (AST.globdef Clight.fundef Ctypes.type))
  (lean (LClight.globdef (LClight.fundef LClight.function) LClight.type)))
(sort init_data (rocq AST.init_data) (lean LClight.init_data))
(sort ef (rocq AST.external_function) (lean LClight.external_function))
(sort signature (rocq AST.signature) (lean LClight.signature))
(sort cconv (rocq AST.calling_convention) (lean LClight.calling_convention))
(sort xtype (rocq AST.xtype) (lean LClight.xtype))
(sort chunk (rocq AST.memory_chunk) (lean LClight.memory_chunk))
(sort event (rocq Events.event) (lean LClight.event))
(sort eventval (rocq Events.eventval) (lean LClight.eventval))
(sort nat (rocq nat) (lean Nat))
(sort Prop (rocq Prop) (lean Prop))
(sort comparison (rocq Integers.comparison) (lean LClight.comparison))

