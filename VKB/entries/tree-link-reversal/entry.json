{
  "id": "tree-link-reversal",
  "goals": [
    "descend x path t = ascend x path (spec x t).2",
    "descend x path t = ascend x (spec x t).1 path (spec x t).2",
    "ascend x g (.node p k b c) t = if g then ascend x (growLeft t k b c).1 p (growLeft t k b c).2 else ascend x false p (.node t k b c)",
    "Ordered (spec x t).2",
    "keys (spec x t).2 = if x ∈ keys t then keys t else (keys t).orderedInsert (· ≤ ·) x",
    "b = -1 after simp, from a program that writes 0 - 1"
  ],
