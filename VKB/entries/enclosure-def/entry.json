    "Library.Numerics.Interval.encloses_ifLt",
    "Library.Numerics.Interval.encloses_sinI",
    "Library.Numerics.Interval.encloses_twoThirds",
    "Library.Numerics.Interval.encloses_ofInt'",
    "Library.Numerics.Interval.encloses_ratio'",
