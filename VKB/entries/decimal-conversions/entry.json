{
  "id": "decimal-conversions",
  "goals": [
    "parse64 general (words s) = (true, round64 n) from Derives general s n",
    "parse64 true (print64 w) = (true, canon64 w)",
    "Derives general s n ↔ decode general s = some n",
    "∃ s neg d e, print64 w = words s ∧ Derives false s (.dec neg d e) ∧ Shortest64 w neg d e",
    "isDigitW b.toUInt64 = isDigit b for every byte b",
    "LeanExe.build n f = words l",
    "limb (words s) j = (byteAt s j.toNat).toUInt64",
    "toString x for x : Int64 as the words of Nat.toDigits 10 of the magnitude",
    "(Nat.toDigits 10 m)[j] = Nat.digitChar (m / 10 ^ (L - 1 - j) % 10)",
    "readInt64 (printInt64 x) = (true, x)",
    "Option.map (fun n => -(n : Int)) applied to an Option Nat, elaborated as a do block"
  ],
