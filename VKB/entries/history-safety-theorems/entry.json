{
  "id": "history-safety-theorems",
  "goals": [
    "(answerAt x n).permit ≠ 0 → ∃ i j, Permitted x n i j",
    "failure (stateAt x t) (x t) = failureAt x t",
    "(stateAt x t).age = (List.range 3).map fun r => min (ageAt x r t) dEdm",
    "resetAcceptance x t = true ↔ (stateAt x t).mode = .resetRequired ∨ ... ∧ (stateAt x (t + 1)).mode = .standby",
    "a safety theorem of a record machine stated over the records and answers before an answer",
    "the last segment up to n at which a property holds"
