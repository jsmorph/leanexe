{
  "id": "m7-board-theorem",
  "goals": [
    "LeanExe.M7.StepCall m k words tick J",
    "∃ s, Reach platform σ code b s ∧ s.pc = head ∧ s.trace = initTrace init σ ++ windows (reqTrace (devBus devBase) tick g0 fun k => σ (k + initReads init)) N",
    "∀ k, ∃ t, run platform σ code k b = some t",
    "∃ (c : Nat) (cs : List Nat), cs.length = N ∧ (∀ x ∈ cs, x ≤ W) ∧ ∀ i ≤ N, ∃ s, run platform σ code (c + (cs.take i).sum) b = some s",
    "LeanExe.M7.staticCost m k = some c",
    "LeanExe.M7.reachCovered m k = true",
    "LeanExe.M7.setupOk m areaPages = true",
    "a board theorem of a step whose state has an Int64 field",
    "the Cortex-M7 generator's code, usesArea, and staticCost of a library function that no step calls yet",
    "a board theorem with an initialization list other than init",
    "∀ op ∈ ops, OpOk platform op"
  ],
