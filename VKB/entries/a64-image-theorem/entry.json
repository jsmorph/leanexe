{
  "id": "a64-image-theorem",
  "goals": [
    "∃ b', BootReach h (protectedBytes B n) (fetchFrom b.core.mem B (codeWords n)) b b' ∧ fetchFrom b.core.mem B (codeWords n) b'.core.pc = some (encode .hvc0) ∧ b'.core.x 0 = 0x84000008 ∧ b'.uartDone = true ∧ b'.core.out = b.core.out ++ LeanExe.Native.encodeWord (f x) ++ [0]",
    "LeanExe.A64.ProgramRuns m k args room cap .word (LeanExe.Native.encodeWord (f x)) fun _ => False",
    "LeanExe.A64.ProgramRuns m k args room cap .array (LeanExe.Native.encodeArray (f x)) fun c => c = 4",
    "LeanExe.A64.stackBound m k ≤ room.toNat",
    "(Verified.initialHeap compiled.tables).top.toNat + compiled.f.bound x ≤ 65536 * LeanExe.A64.initialPages compiled.module",
    "LeanExe.A64.entryOk m k [.f64] 1 .word = true",
    "w.toInt64.toInt = spec a b in an Image theorem",
    "an A64 Image theorem whose output names Real.exp, Real.sin, or a specification over ℤ"
  ],
