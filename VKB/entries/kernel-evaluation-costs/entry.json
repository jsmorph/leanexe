{
  "id": "kernel-evaluation-costs",
  "goals": [
    "(kernel) deterministic timeout",
    "(kernel) deep recursion detected",
    "a declaration that passes with set_option debug.skipKernelTC true and fails without it",
    "UInt64.decLt (a + M) (b + M) under a projection, with a large literal M",
    "Flat.flat ((fun x => …) a) = Flat.flat (ite …)",
    "a projection r.2.2.2 of a large block compared with another term",
    "@id T e compared with an ite or a definition of greater height",
    "simp with a lemma proved by omega leaves n + 0 inside a dependent argument",
    "a closed Nat sum such as 0 + 0 + Verified.loopCost … compared with a sum that differs inside it",
    "Eq.refl of a match alternative whose type omits the match",
    "(kernel) deep recursion in a comparison of two LeanExe.repeatWhile terms whose steps are compiled matches",
    "verified_compile whose kernel time grows faster than its number of functions"
  ],
  "modules": [
    "Verified.Reflect.Definitions",
    "Verified.Reflect.BoundPass",
    "Verified.Reflect.Command",
    "LeanExe.A64.Isla.Check",
    "LeanExe.A64.Isla.Walk",
    "LeanExe.M7.Isla.Arith",
    "Library.Numerics.Float64.Lgamma.LgammaSign",
    "LeanExe.M7.Proof.Straight",
    "Verified.BoundFacts",
    "Library.Numerics.Float64.Bessel.BesselYnTheorem"
  ],
  "declarations": [
    "Verified.Reflect.reflect",
    "Verified.Reflect.meaningAt",
    "Verified.Reflect.LemmaApp.argType",
    "Verified.Reflect.LemmaApp.assignHint",
    "LeanExe.A64.Isla.nat_add_zero",
    "LeanExe.A64.Isla.Opaque",
    "LeanExe.M7.Isla.awc_v",
    "Library.Numerics.Float64.Lgamma.LgammaSign.sgnOf",
    "Verified.Reflect.assignFamilyEquation",
    "Lean.Meta.mkExpectedTypeHint",
    "Verified.Expr.denote",
    "Lean.Meta.Simp.congrArgs",
    "LeanExe.M7.State.r_withPc",
    "LeanExe.M7.State.zFlag_setNZCV'",
    "Verified.loopCost",
    "Verified.loopCost_eq_zero",
    "Verified.Reflect.casesEq",
    "Verified.Reflect.tableChain",
    "Verified.Reflect.addDefinition",
    "Verified.Prog.cons",
