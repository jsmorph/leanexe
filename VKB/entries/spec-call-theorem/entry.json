{
  "id": "spec-call-theorem",
  "goals": [
    "Verified.Call compiled.module compiled.tables k f Pre Post",
    "Verified.CallSpec compiled.module compiled.tables k f B",
    "Verified.CallSpec compiled.module compiled.tables k expected compiled.f.bound",
    "Verified.Ready compiled.module compiled.tables (Verified.initialHeap compiled.tables) compiled.module.initialStore",
    "Runs false env compiled.module k store [.i64 ptr] fun final values => ∃ optr, values = [.i64 optr] ∧ ∃ heap', heap'.Owned final optr (expected xs)",
    "Runs false env compiled.module k store [.i64 n, .i64 ptr] fun final values => ∃ d, values.reverse = [...] ∧ spec ∧ ∃ heap', Verified.Ready compiled.module compiled.tables heap' final ∧ heap'.Borrowed final ptr msg",
    "Runs false env compiled.module k store [.i64 b, .i64 a] fun final values => final = store ∧ values = [.i64 (expected (a, b))]",
    "compute xs = expected xs from xs.size < 2 ^ 64",
    "Verified.Call.spec: unknown identifier, from a module that imports only Verified.Reflect.Command",
    "Verified.Ready compiled.module compiled.tables (Verified.initialHeap compiled.tables) { compiled.module.initialStore with memoryCaps := [cap] }",
    "final.mem.pages ≤ P after a call of a verified module",
    "Verified.Call compiled.module compiled.tables k expected (fun x heap store => P x ∧ Pre x heap store) Post",
    "ImplementsA false compiled.module k (fun x : Moved (Array UInt64) => expected x.val) Pre Post",
    "Spec x (f x) and Spec x r → Spec x r' → r = r'",
    "the funcIdx of an export, which differs from the position of its definition in the list of verified_compile",
    "Verified.CallSpec compiled.module compiled.tables k (fun xs : Array Float => (f xs).map Float.toBits) compiled.f.bound",
    "∃ x : Trajectory, x.AdmittedUntil p q c t"
  ],
