{
  "id": "array-memory-framing",
  "goals": [
    "LeanExe.ProofKit.UInt64Array.At final ptr xs from UInt64Array.At initial ptr xs",
    "UInt64Array.At (UInt64Array.writeElement store ptr k v) ptr (xs.set k v hk)",
    "UInt64Array.At store' pdst (Verified.overlay words xs k i) as a copy loop's invariant",
    "(mem.write64 a v).read64 b = mem.read64 b",
    "Verified.Bytes.At store'.mem root bytes after a write elsewhere"
  ],
