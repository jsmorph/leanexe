{
  "id": "sorted-permutation",
  "goals": [
    "f xs = (xs.toList.mergeSort fun a b => a ≤ b).toArray",
    "(f xs).toList.Pairwise (· ≤ ·) ∧ (f xs).toList.Perm xs.toList",
    "(swap i j xs).toList.Perm xs.toList",
    "(xs.toList.mergeSort fun a b => a ≤ b).toArray[k]! = R[k]!",
    "xs.size.toUInt64.toNat = xs.size"
  ],
