{
  "id": "packed-bytes",
  "goals": [
    "msg[(UInt64.ofNat i >>> 3).toNat]! >>> ((UInt64.ofNat i &&& 7) <<< 3)",
    "Library.Bytes.bytes msg n",
    "Library.Bytes.byteAt msg i",
    "List.foldr (fun b acc => b.toNat + 256 * acc) 0 bytes",
    "(p.drop i).take k for a list of bytes",
    "((LeanExe.Requests.wordBytes w 8)[r]!).toUInt8 = Library.Bytes.byteOf w (7 - r)",
    "(LeanExe.Requests.wordBytes w k).map UInt64.toUInt8 = (List.range k).map fun i => Library.Bytes.byteOf w (7 - i)"
  ],
