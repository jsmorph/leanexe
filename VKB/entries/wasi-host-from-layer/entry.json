{
  "id": "wasi-host-from-layer",
  "goals": [
    "(env : Wasm.HostEnv (Observed World)).Satisfies m (Verified.Wasi.hostSpec host) for an environment built on a lower layer",
    "a WASI host whose relations state the events of a lower layer that each WASI event makes",
    "Exec (linuxHost L replies) action w trace outcome w' → the world's events grow by images of trace",
    "NativeFunctionResult host startSignature ... → a statement about the host's world at the run's end",
    "LeanExe.Linux.Memory over Wasm.Mem",
    "LeanExe.Linux.readData 0 events = the bytes that the WASI trace's reads committed",
    "a host relation that would need a property of the store, such as a memory within a cap"
  ],
  "modules": [
    "Verified.Shim",
    "Verified.Examples.WasiReadAllShim"
  ],
