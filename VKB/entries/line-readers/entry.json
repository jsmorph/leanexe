    "Demos.Rcv.ReadProgram.findByte_spec",
    "Demos.Rcv.ReadProgram.findByte_splitOn",
    "Demos.Rcv.ReadProgram.findByte_split",
    "Demos.Rcv.ReadProgram.piecesFrom",
    "Demos.Rcv.ReadProgram.readLine_pieces",
    "Demos.Rcv.Spec.lineOf",
    "Demos.Rcv.Spec.faulty",
    "Demos.Rcv.Spec.piecesAt",
    "Demos.Rcv.Spec.takeLine_drop",
    "Demos.Rcv.Spec.readLine_drop",
