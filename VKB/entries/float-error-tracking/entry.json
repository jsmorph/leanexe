{
  "id": "float-error-tracking",
  "goals": [
    "LeanExe.ProofKit.F64Approx.FApprox x v e",
    "|value x.toBits - v| ≤ e for a Float computed by a chain of operations",
    "CodeLib.IEEE64.Finite (Wasm.IEEE64.add a b) → Finite a ∧ Finite b",
    "max a b with a NaN operand",
    "Library.Numerics.Arithmetic.Fma.FmaSpec.FmaNearest → |value (Fma.fma a b c).toBits - (value a.toBits * value b.toBits + value c.toBits)| ≤ e",
    "LeanExe.ProofKit.F64Outward.Sound up result x from result.status = 0",
    "the value of an operation that selects an operand, such as minmod"
  ],
  "modules": [
    "LeanExe.ProofKit.F64Approx",
    "Demos.Slew.Rounding",
    "Demos.Slew.Valid",
    "Demos.Slew.Check",
    "Demos.Slew.NanFree",
    "Demos.Slew.Safety",
    "LeanExe.ProofKit.F64NearReal",
    "LeanExe.ProofKit.F64OutwardAccepted",
    "LeanExe.ProofKit.F64Order",
    "Library.Numerics.Arithmetic.Fma.FmaSpec",
    "Library.Numerics.Float64.Tgamma.TgammaDD",
    "Library.Numerics.Float64.Erfc.ErfcTrack",
    "Library.Numerics.Bounds.Proof",
    "Library.Numerics.Limiters.Minmod.Proof",
    "Demos.Euler.Enclosure"
  ],
  "declarations": [
    "LeanExe.ProofKit.F64Approx.Approx",
    "LeanExe.ProofKit.F64Approx.Approx.mono",
    "LeanExe.ProofKit.F64Approx.FApprox",
