{
  "id": "linux-call-layer",
  "goals": [
    "LeanExe.Linux.step I m q r = some (m', e)",
    "I.read m' b = I.read m b outside the output region of a call",
    "LeanExe.Linux.Memory.Lawful I for a binding's memory",
    "a new call added to the Linux call layer's table",
    "a binding of the Linux call layer for another architecture or for C",
    "LeanExe.A64.ProcReachWith LeanExe.Linux.table R P code p p'",
    "LeanExe.A64.sysCall R P LeanExe.Linux.readCall p = some q",
    "a property of a kernel's replies beyond the frame, such as fresh descriptors",
    "a program that opens files while descriptors 0 to 2 may be closed",
    "the bytes of a block after reads whose replies set the whole output region",
    "heap.At store' after bytes written into an allocated block from outside the compiled code",
    "readData d tr and writeData d tr over a trace with failed calls",
    "the results of getrandom at which the shim's random_get does not trap"
  ],
  "modules": [
    "LeanExe.Linux.Replies",
    "LeanExe.Linux.Trace",
    "LeanExe.A64.Proof.LinuxCalls",
    "LeanExe.A64.Proof.StampRuns",
    "Demos.RandomHistogram.NativeCounts"
  ],
