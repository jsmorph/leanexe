{
  "id": "large-term-unfolding",
  "goals": [
    "maximum recursion depth has been reached",
    "(deterministic) timeout at whnf or isDefEq",
    "a goal that holds Nat.fold, Fin.foldl, or LeanExe.loop over many rounds",
    "compiled.module or compiled.f.bound inside a goal",
    "p.f.bound (x, f y) for a call f y passed as a tuple component",
    "(kernel) deep recursion detected at a verified_compile command",
    "#print axioms lists p.f.meaning_eq or p.f.fixed"
  ],
  "modules": [
    "Library.Hashing.Sha512.CompressProof",
    "Library.Hashing.Sha2.Equiv.SHA512.Foldl.Fused",
    "Library.Hashing.Sha256.Proof",
    "Library.Hashing.Sha3.SpongeProof",
    "Demos.RunningSumFp.PrintCharges",
    "Demos.RunningSumFp.ParseCharges",
    "Demos.RunningSumFp.Correct",
    "Verified.Wasi.PureTransport",
    "LeanExe.ProofKit.BorrowedKept",
    "Verified.TailTransport",
    "Verified.Reflect.Definitions",
    "Library.Numerics.Arithmetic.PrimeFactors.Compiled"
  ],
  "declarations": [
    "Library.Hashing.Sha256.foldl_append",
    "Library.Hashing.Sha3.SpongeProof.pad101_zeros",
    "Library.Hashing.Sha3.SpongeProof.padded_of_regions",
    "Library.Hashing.Sha3.SpongeProof.bit_padded",
    "Verified.Wasi.PureTransport.erase_restore",
    "LeanExe.ProofKit.BorrowedKept.borrowed_kept",
    "Verified.Tail.fixed_restate",
    "Verified.Reflect.addBoundDefinition"
  ],
  "examples": [
    "Library.Hashing.Sha512.compress_toVec",
    "SHS.Equiv.SHA512.Foldl.Fused.spec_compress_eq_fused",
    "Library.Hashing.Sha256.hashFrom_iv",
    "Demos.RunningSumFp.sciLayoutW_bound_le",
    "Demos.RunningSumFp.decRound_bound_le",
    "Demos.RunningSumFp.initial_memoryCap",
    "Library.Numerics.Arithmetic.PrimeFactors.compiled.countFactors.implements"
  ]
}
