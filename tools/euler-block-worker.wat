(module
 (import "side" "sideCheckedBits" (func $side (param i64 i64 i64 i64) (result i64 i64 i64 i64 i64 i64 i64 i64)))
 (import "flux" "fluxCheckedBits" (func $flux (param i64 i64 i64 i64 i64 i64 i64 i64) (result i64 i64 i64 i64 i64 i64)))
 (import "cell" "cellCheckedBits" (func $cell (param i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64 i64) (result i64 i64 i64 i64 i64 i64 i64 i64)))
 (memory (export "memory") 64)
 (func $q (param $p i32) (param $y i32) (result i64 i64 i64 i64)
  (i64.load (local.get $p))
  (i64.load (i32.add (local.get $p) (select (i32.const 16) (i32.const 8) (local.get $y))))
  (i64.load (i32.add (local.get $p) (select (i32.const 8) (i32.const 16) (local.get $y))))
  (i64.load offset=24 (local.get $p)))
 (func $positive (param $x f64) (result f64)
  (if (i32.eqz (i32.and (f64.gt (local.get $x) (f64.const 0)) (f64.lt (local.get $x) (f64.const inf)))) (then unreachable))
  (local.get $x))
 (func (export "initialize") (param $n i32) (param $rows i32)
  (local $i i32) (local $p i32) (local $out i32)
  (local $r0 i64) (local $r1 i64) (local $r2 i64) (local $r3 i64) (local $r4 i64) (local $r5 i64) (local $r6 i64) (local $r7 i64)
  (loop $cells
   (local.set $p (i32.add (i32.const 131072) (i32.mul (i32.add (local.get $n) (local.get $i)) (i32.const 40))))
   (local.set $out (i32.add (i32.const 2097152) (i32.mul (local.get $i) (i32.const 40))))
   (call $side (call $q (local.get $p) (i32.const 0)))
   local.set $r7 local.set $r6 local.set $r5 local.set $r4 local.set $r3 local.set $r2 local.set $r1 local.set $r0
   (if (i64.ne (local.get $r0) (i64.const 0)) (then unreachable))
   (memory.copy (local.get $out) (local.get $p) (i32.const 32))
   (i64.store offset=32 (local.get $out) (local.get $r2))
   (local.set $i (i32.add (local.get $i) (i32.const 1)))
   (br_if $cells (i32.lt_u (local.get $i) (i32.mul (local.get $n) (local.get $rows)))))
  (i64.store (i32.const 8) (i64.extend_i32_u (local.get $i))))
 (func $scan (export "scan") (param $n i32) (param $rows i32)
  (local $p i32) (local $end i32) (local $y i32) (local $speed f64) (local $maximum f64)
  (local $r0 i64) (local $r1 i64) (local $r2 i64) (local $r3 i64) (local $r4 i64) (local $r5 i64) (local $r6 i64) (local $r7 i64)
  (local.set $p (i32.add (i32.const 131072) (i32.mul (local.get $n) (i32.const 40))))
  (local.set $end (i32.add (local.get $p) (i32.mul (i32.mul (local.get $n) (local.get $rows)) (i32.const 40))))
  (loop $cells
   (local.set $y (i32.const 0))
   (loop $axes
    (call $side (call $q (local.get $p) (local.get $y)))
    local.set $r7 local.set $r6 local.set $r5 local.set $r4 local.set $r3 local.set $r2 local.set $r1 local.set $r0
    (if (i64.ne (local.get $r0) (i64.const 0)) (then unreachable))
    (local.set $speed (call $positive (f64.reinterpret_i64 (local.get $r3))))
    (local.set $maximum (f64.max (local.get $maximum) (local.get $speed)))
    (local.set $y (i32.add (local.get $y) (i32.const 1)))
    (br_if $axes (i32.lt_u (local.get $y) (i32.const 2))))
   (local.set $p (i32.add (local.get $p) (i32.const 40)))
   (br_if $cells (i32.lt_u (local.get $p) (local.get $end))))
  (i64.store (i32.const 8) (i64.extend_i32_u (i32.mul (i32.mul (local.get $n) (local.get $rows)) (i32.const 2))))
  (f64.store (i32.const 16) (local.get $maximum)))
 (func $edge (param $p i32) (param $y i32) (param $out i32)
  (local $r0 i64) (local $r1 i64) (local $r2 i64) (local $r3 i64) (local $r4 i64) (local $r5 i64)
  (call $flux (call $q (local.get $p) (local.get $y)) (call $q (local.get $p) (local.get $y)))
  local.set $r5 local.set $r4 local.set $r3 local.set $r2 local.set $r1 local.set $r0
  (if (i64.ne (local.get $r0) (i64.const 0)) (then unreachable))
  (i64.store (local.get $out) (local.get $r1))
  (i64.store offset=8 (local.get $out) (select (local.get $r3) (local.get $r2) (local.get $y)))
  (i64.store offset=16 (local.get $out) (select (local.get $r2) (local.get $r3) (local.get $y)))
  (i64.store offset=24 (local.get $out) (local.get $r4)))
 (func (export "sweep") (param $n i32) (param $start i32) (param $rows i32) (param $y i32) (param $ratio i64)
  (local $count i32) (local $index i32) (local $column i32) (local $p i32) (local $left i32) (local $right i32) (local $out i32)
  (local $k i32) (local $j i32) (local $edgeptr i32) (local $rho f64) (local $pressure f64) (local $courant f64) (local $velocity f64) (local $energy f64)
  (local $r0 i64) (local $r1 i64) (local $r2 i64) (local $r3 i64) (local $r4 i64) (local $r5 i64) (local $r6 i64) (local $r7 i64)
  (f64.store (i32.const 32) (f64.const inf))
  (f64.store (i32.const 40) (f64.const inf))
  (f64.store (i32.const 56) (f64.const inf))
  (local.set $count (i32.mul (local.get $n) (local.get $rows)))
  (loop $cells
   (local.set $column (i32.rem_u (local.get $index) (local.get $n)))
   (local.set $p (i32.add (i32.const 131072) (i32.mul (i32.add (local.get $n) (local.get $index)) (i32.const 40))))
   (if (local.get $y)
    (then
     (local.set $left (i32.sub (local.get $p) (i32.mul (local.get $n) (i32.const 40))))
     (local.set $right (i32.add (local.get $p) (i32.mul (local.get $n) (i32.const 40)))))
    (else
     (local.set $left (select (i32.sub (local.get $p) (i32.const 40)) (local.get $p) (i32.gt_u (local.get $column) (i32.const 0))))
     (local.set $right (select (i32.add (local.get $p) (i32.const 40)) (local.get $p) (i32.lt_u (i32.add (local.get $column) (i32.const 1)) (local.get $n))))))
   (call $cell (local.get $ratio) (call $q (local.get $left) (local.get $y)) (call $q (local.get $p) (local.get $y)) (call $q (local.get $right) (local.get $y)))
   local.set $r7 local.set $r6 local.set $r5 local.set $r4 local.set $r3 local.set $r2 local.set $r1 local.set $r0
   (i64.store (i32.const 8) (i64.extend_i32_u (i32.add (local.get $index) (i32.const 1))))
   (if (i64.ne (local.get $r0) (i64.const 0)) (then (i64.store (i32.const 0) (i64.const 1)) return))
   (local.set $rho (call $positive (f64.reinterpret_i64 (local.get $r1))))
   (local.set $pressure (call $positive (f64.reinterpret_i64 (local.get $r5))))
   (local.set $courant (call $positive (f64.reinterpret_i64 (local.get $r7))))
   (if (f64.gt (local.get $courant) (f64.const 0.5)) (then unreachable))
   (local.set $velocity (f64.div (f64.max (f64.abs (f64.reinterpret_i64 (local.get $r2))) (f64.abs (f64.reinterpret_i64 (local.get $r3)))) (local.get $rho)))
   (local.set $energy (call $positive (f64.div (f64.reinterpret_i64 (local.get $r4)) (local.get $rho))))
   (f64.store (i32.const 24) (f64.max (f64.load (i32.const 24)) (local.get $courant)))
   (f64.store (i32.const 32) (f64.min (f64.load (i32.const 32)) (local.get $rho)))
   (f64.store (i32.const 40) (f64.min (f64.load (i32.const 40)) (local.get $pressure)))
   (f64.store (i32.const 48) (f64.max (f64.load (i32.const 48)) (local.get $velocity)))
   (f64.store (i32.const 56) (f64.min (f64.load (i32.const 56)) (local.get $energy)))
   (local.set $out (i32.add (i32.const 2097152) (i32.mul (local.get $index) (i32.const 40))))
   (i64.store (local.get $out) (local.get $r1))
   (i64.store offset=8 (local.get $out) (select (local.get $r3) (local.get $r2) (local.get $y)))
   (i64.store offset=16 (local.get $out) (select (local.get $r2) (local.get $r3) (local.get $y)))
   (i64.store offset=24 (local.get $out) (local.get $r4))
   (i64.store offset=32 (local.get $out) (local.get $r5))
   (local.set $index (i32.add (local.get $index) (i32.const 1)))
   (br_if $cells (i32.lt_u (local.get $index) (local.get $count))))
  (if (local.get $y)
   (then
    (if (i32.or (i32.eqz (local.get $start)) (i32.eq (i32.add (local.get $start) (local.get $rows)) (local.get $n)))
     (then
      (local.set $edgeptr (i32.add (i32.const 131072) (i32.mul (select (local.get $n) (local.get $count) (i32.eqz (local.get $start))) (i32.const 40))))
      (loop $yedges
       (call $edge (i32.add (local.get $edgeptr) (i32.mul (local.get $j) (i32.const 40))) (i32.const 1) (i32.add (i32.const 256) (i32.mul (local.get $j) (i32.const 32))))
       (local.set $j (i32.add (local.get $j) (i32.const 1)))
       (br_if $yedges (i32.lt_u (local.get $j) (local.get $n)))))))
   (else
    (loop $xedges
     (local.set $edgeptr (i32.add (i32.const 131072) (i32.mul (i32.mul (i32.add (local.get $j) (i32.const 1)) (local.get $n)) (i32.const 40))))
     (call $edge (local.get $edgeptr) (i32.const 0) (i32.const 128))
     (call $edge (i32.add (local.get $edgeptr) (i32.mul (i32.sub (local.get $n) (i32.const 1)) (i32.const 40))) (i32.const 0) (i32.const 160))
     (local.set $k (i32.const 0))
     (loop $components
      (f64.store (i32.add (i32.const 256) (i32.add (i32.mul (local.get $j) (i32.const 32)) (local.get $k)))
       (f64.sub (f64.load (i32.add (i32.const 160) (local.get $k))) (f64.load (i32.add (i32.const 128) (local.get $k)))))
      (local.set $k (i32.add (local.get $k) (i32.const 8)))
      (br_if $components (i32.lt_u (local.get $k) (i32.const 32))))
     (local.set $j (i32.add (local.get $j) (i32.const 1)))
     (br_if $xedges (i32.lt_u (local.get $j) (local.get $rows))))))
 )
)
