#!/usr/bin/env python3
"""Repeatable acceptance, mutation, audit, and clean-checkout gate for scalar64."""
import argparse
import json
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import certified_scalar as cs


def command(args, cwd=cs.ROOT, expected=0):
    result = subprocess.run([str(a) for a in args], cwd=cwd, text=True,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    if (expected == 0 and result.returncode != 0) or (expected != 0 and result.returncode == 0):
        raise cs.Rejected('gate command had unexpected status:\n' + result.stdout[-14000:])
    return result.stdout


def mutate(packages, name, pilot, change, diagnostic):
    with tempfile.TemporaryDirectory(prefix='scalar-mutation-', dir=cs.ROOT/'tmp') as tmp:
        target = Path(tmp)/'package'
        shutil.copytree(packages/pilot, target)
        m = cs.read_json(target/'manifest.json')
        t = cs.read_json(target/'translation.json')
        raw = cs.read_json(target/'decoded.json')
        data = (target/'program.wasm').read_bytes()
        data = change(m, t, raw, data)
        (target/'program.wasm').write_bytes(data)
        (target/'translation.json').write_bytes(cs.canonical(t))
        (target/'decoded.json').write_bytes(cs.canonical(raw))
        # Regenerate canonical checking text and every file hash. Rejection must
        # come from the binding/proof/pin, not an accidentally stale checksum.
        try:
            checker=cs.checking_text(m, t, raw, data)
        except cs.Rejected:
            checker=(target/'Check.lean').read_text()
        (target/'Check.lean').write_text(checker)
        m['files'] = {f:cs.sha((target/f).read_bytes()) for f in sorted(cs.FILES)}
        (target/'manifest.json').write_bytes(cs.canonical(m))
        output = command([cs.ROOT/'tools/verify-certified', target], expected=1)
        cs.require(diagnostic.lower() in output.lower(), name + ': wrong rejection reason:\n' + output)
        print('mutation rejected:', name, flush=True)


def mutations(packages):
    def source(m,t,r,b):m['source']='LeanExe.Examples.Arithmetic.choose';return b
    def operation(m,t,r,b):t['functions'][0]['result'][1]='sub';return b
    def core(m,t,r,b):t['core'][0][1]='sub';return b
    def callee(m,t,r,b):t['functions'][1]['body'][2]=1;return b
    def arguments(m,t,r,b):t['functions'][1]['body'][3].reverse();return b
    def bytecode(m,t,r,b):
        b=bytearray(b);b[b.index(0x7c)]=0x7d
        r.clear();r.update(cs.decode_witness(bytes(b)));return bytes(b)
    def export(m,t,r,b):t['export']='wrong';return b
    def binary_export(m,t,r,b):
        b=b.replace(b'affine',b'x ffne')
        r.clear();r.update(cs.decode_witness(b));return b
    def abi(m,t,r,b):m['abi']['argument_order'].reverse();return b
    def arity(m,t,r,b):
        m['arity']=1;t['arity']=1;m['abi']={'params':['i64'],'result':'i64','argument_order':[0]};return b
    def declaration(m,t,r,b):m['certificate']=cs.PREFIX+'Pilots.chooseCertificate';return b
    def pin(m,t,r,b):m['pins']['lean-toolchain']='0'*64;return b
    def placeholder(m,t,r,b):m['source']='_';return b
    def wrong_namespace(m,t,r,b):m['source']='LeanExe.Examples.Prng.mix';return b
    def theorem(m,t,r,b):m['theorems'][0]='ScalarPackageCheck.fake';return b
    cases=[('source linkage','affine',source,'type mismatch'),
           ('IR arithmetic','affine',operation,'Lean check failed'),
           ('source core','affine',core,'Lean check failed'),
           ('call target','helper',callee,'Lean check failed'),
           ('call arguments','helper',arguments,'Lean check failed'),
           ('WASM opcode and decoded witness','affine',bytecode,'Lean check failed'),
           ('export metadata','affine',export,'Lean check failed'),
           ('binary export and decoded witness','affine',binary_export,'Lean check failed'),
           ('ABI argument order','affine',abi,'unsupported ABI'),
           ('ABI arity','affine',arity,'Lean check failed'),
           ('certificate declaration','affine',declaration,'type mismatch'),
           ('dependency pin','affine',pin,'pin mismatch'),
           ('theorem declaration','affine',theorem,'theorem declarations'),
           ('placeholder declaration','affine',placeholder,'invalid Lean identifier'),
           ('source module namespace','affine',wrong_namespace,'outside its named module')]
    for case in cases:mutate(packages,*case)
    command([cs.ROOT/'tools/compile-certified','unknown','--profile','scalar64','--output',packages/'unknown'], expected=1)
    command([cs.ROOT/'tools/compile-certified','affine','--profile','nat','--output',packages/'nat'], expected=1)
    print('unsupported source/profile rejected',flush=True)


def cold(packages):
    revisions={cs.read_json(packages/p/'manifest.json')['revision'] for p in cs.PILOTS}
    cs.require(len(revisions)==1,'cold gate needs packages from one revision')
    revision=revisions.pop()
    with tempfile.TemporaryDirectory(prefix='scalar-cold-', dir=cs.ROOT/'tmp') as tmp:
        checkout=Path(tmp)/'leanexe'
        command(['git','clone','--shared','--no-checkout',cs.ROOT,checkout])
        command(['git','checkout','--detach',revision],cwd=checkout)
        proof=checkout/'proofs/talos/lean'
        (proof/'.lake').mkdir()
        # Share only pinned external dependencies, never this project's oleans.
        (proof/'.lake/packages').symlink_to(cs.PROOF/'.lake/packages',target_is_directory=True)
        cs.require(not (checkout/'.lake/build').exists() and not (proof/'.lake/build').exists(),'cold checkout contains project cache')
        for pilot in cs.PILOTS:
            print('cold independent verification:',pilot,flush=True)
            print(command([checkout/'tools/verify-certified',packages/pilot],cwd=checkout),end='',flush=True)
        print('clean checkout passed:',revision,flush=True)


def main():
    p=argparse.ArgumentParser(description=__doc__)
    p.add_argument('--packages',type=Path,default=cs.ROOT/'tmp/certified')
    p.add_argument('--verify-only',action='store_true',help='do not run compilation')
    p.add_argument('--mutations',action='store_true')
    p.add_argument('--cold',action='store_true')
    o=p.parse_args();packages=o.packages.resolve()
    try:
        (cs.ROOT/'tmp').mkdir(exist_ok=True)
        for pilot in cs.PILOTS:
            package=packages/pilot
            if not package.exists() and not o.verify_only:
                print('compile and certify:',pilot,flush=True)
                print(command([cs.ROOT/'tools/compile-certified',pilot,'--profile','scalar64','--output',package]),end='',flush=True)
            else:
                print(command([cs.ROOT/'tools/verify-certified',package]),end='',flush=True)
        print(command(['node',cs.ROOT/'test/scalar64_runtime.js',packages]),end='',flush=True)
        for test in ['scalar64_profile.lean','scalar64_gcd.lean','scalar64_sources.lean']:
            print(cs.lean(['env','lean',str(cs.ROOT/'test'/test)]),end='',flush=True)
        print(cs.lean(['build',cs.PREFIX+'AdmissionTests']),end='',flush=True)
        print(cs.lean(['build',cs.PREFIX+'Audit']),end='',flush=True)
        if o.mutations:mutations(packages)
        if o.cold:cold(packages)
        print('scalar64 gate passed',flush=True)
    except (cs.Rejected,OSError,ValueError) as error:
        print('gate failed:',error,file=sys.stderr);return 1
    return 0

if __name__=='__main__':sys.exit(main())
