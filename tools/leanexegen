  const runtimeReadyFields = formalInterfaceVersion >= 2
    ? `hInputBelow, hOutputFit32, hOutputFitMemory,
      hHeapFit32, hHeapFitMemory, hPages`
    : "hInputBelow, hFit32, hFitMemory, hPages";
  const outputFit32 = formalInterfaceVersion >= 2 ? "hOutputFit32" : "hFit32";
  const outputFitMemory = formalInterfaceVersion >= 2 ? "hOutputFitMemory" : "hFitMemory";
  const modules = new Set(["Project.ProofKit.Array"]);
  if (proofRecipes === null) {
    for (const moduleName of [
      "Project.ProofKit.FixedArrayEqNode",
      "Project.ProofKit.FixedArrayLengthDispatch",
      "Project.ProofKit.FixedArrayLtNode",
      "Project.ProofKit.FixedArrayPairResult",
      "Project.ProofKit.FixedArraySearch",
      "Project.ProofKit.FixedArraySearchChain",
      "Project.ProofKit.FixedArraySearchTree",
    ]) modules.add(moduleName);
  } else {
    for (const composition of proofRecipes.compositions ?? []) {
      modules.add(composition.direct.module);
    }
    for (const recipe of proofRecipes.recipes) {
      modules.add(recipe.direct.module);
      for (const item of recipe.supporting) {
        const moduleName = proofKitModules.find((candidate) =>
          item.declaration === candidate || item.declaration.startsWith(`${candidate}.`));
        if (moduleName !== undefined) modules.add(moduleName);
      }
    }
    if (proofRecipes.recipes.some((recipe) => [
      "leanexe.array.eq-node.v1",
      "leanexe.array.lt-node.v1",
      "leanexe.array.pair-result.v1",
      "leanexe.array.search-key.v1",
    ].includes(recipe.regionKind))) {
