}

function runCodexOutcome(options) {
  createWorkspace(options.taskRoot);
  for (const [relative, bytes] of options.contextFiles) {
    writeAtomic(path.join(options.taskRoot, ...relative.split("/")), Buffer.from(bytes));
  }
  const schemaFile = path.join(options.taskRoot, ".leanexegen-output-schema.json");
  const outputFile = path.join(options.taskRoot, ".leanexegen-outcome.json");
  writeAtomic(schemaFile, Buffer.from(`${JSON.stringify(codexOutcomeSchema(), null, 2)}\n`));
  const codexArgs = codexCommandArgs(
    options.codex, options.taskRoot, schemaFile, outputFile);
  const args = [
    leanrun,
    "--timeout", `${Math.ceil(options.timeout / 1000)}s`,
    ...codexArgs,
  ];
  const execute = options.execute || ((command, runOptions) =>
    run(options.stage, `${options.task} Codex task`, command, runOptions));
  execute(args, {
    cwd: options.taskRoot,
    input: options.prompt,
    timeout: options.timeout + 60 * 1000,
    maxBuffer: 64 * 1024 * 1024,
  });
  let response;
  try {
    response = JSON.parse(fs.readFileSync(outputFile, "utf8"));
    if (response.outcome === "generated") {
      const candidate = path.join(options.taskRoot, ...options.candidateFile.split("/"));
      const stat = fs.lstatSync(candidate);
      if (!stat.isFile() || stat.isSymbolicLink()) {
        throw new Error(`${options.candidateFile} is not a regular file`);
      }
      response.source = fs.readFileSync(candidate, "utf8");
    }
    return validateCodexTaskOutcome(response, options.task);
  } catch (error) {
    throw new StageError(options.stage, options.task, `invalid Codex outcome: ${error.message}`);
  }
}

function reportDigest(report) {
  return sha256(Buffer.from(`${JSON.stringify(report, null, 2)}\n`));
}

function runTaskSession(options) {
  const invoke = () => options.invoke(options.prompt);
  const outcome = options.telemetry
    ? options.telemetry.measureCodexSession(invoke)
    : invoke();
  if (outcome.outcome !== "generated") {
    const detail = outcome.outcome === "questions" ? outcome.questions : outcome.problems;
    throw new StageError(options.stage, options.stageName, detail.join("\n"));
  }
  const source = options.materialize(outcome.source);
  let diagnostic;
  try {
    const diagnose = () => options.diagnose(source, outcome);
    diagnostic = options.telemetry
      ? options.telemetry.measureOuterAcceptance(diagnose)
      : diagnose();
  } catch (error) {
    throw new StageError(
      options.stage,
      options.stageName,
      `the independent outer check rejected the Codex session result:\n${formatError(error)}`,
    );
  }
  if (typeof diagnostic !== "string" || diagnostic.length === 0) {
    throw new StageError(options.stage, options.stageName, "diagnostic report was empty");
  }
  const sourceSha256 = sha256(Buffer.from(source));
  const proofTelemetry = options.telemetry
    ? options.telemetry.accept(sourceSha256)
    : null;
  const report = {
    summary: outcome.summary,
    decisions: outcome.decisions,
    attempts: [{
      number: 1,
      outcome: "accepted",
      sourceSha256,
      diagnosticSha256: sha256(Buffer.from(diagnostic)),
      diagnostic,
    }],
  };
  return {
    outcome,
    source,
    proofTelemetry,
    stageReport: {
      task: options.task,
      sourceModule: options.sourceModule,
      sourceSha256,
      reportSha256: reportDigest(report),
      report,
    },
  };
}

function formalSpecificationSource(job, generatedSource) {
  return `${generatedSource.trimEnd()}\n\nnamespace ${job.namespace}.FormalSpec\n\n` +
    `def UInt64ArrayAt (store : Wasm.Store Unit) (ptr : UInt64) ` +
    `(values : Array UInt64) : Prop :=\n` +
    `  ptr.toNat + 8 * (values.size + 1) ≤ 4294967296 ∧\n` +
    `  ptr.toNat + 8 * (values.size + 1) ≤ store.mem.pages * 65536 ∧\n` +
    `  store.mem.read64 ptr.toUInt32 = UInt64.ofNat values.size ∧\n` +
    `  ∀ (i : Nat), (h : i < values.size) →\n` +
    `    store.mem.read64\n` +
    `      (ptr + UInt64.ofNat (8 * (i + 1))).toUInt32 = values[i]\n\n` +
    `def RuntimeReady (initial : Wasm.Store Unit) (inputPtr : UInt64) ` +
    `(input : Array UInt64) : Prop :=\n` +
    `  UInt64ArrayAt initial inputPtr input ∧\n` +
    `  ∃ heapTop allocs retains releases frees : UInt64,\n` +
    `    initial.globals.globals = [.i64 heapTop, .i64 0, .i64 allocs, .i64 retains,\n` +
    `      .i64 releases, .i64 frees] ∧\n` +
    `    inputPtr.toNat + 8 * (input.size + 1) ≤ heapTop.toNat ∧\n` +
    `    heapTop.toNat + 48 + 8 * ((expected input).size + 1) ≤ 4294967296 ∧\n` +
    `    heapTop.toNat + 48 + 8 * ((expected input).size + 1) ≤\n` +
    `      initial.mem.pages * 65536 ∧\n` +
    `    initial.mem.pages ≤ 65536\n\n` +
    `def ArtifactSpec (module_ : Wasm.Module) : Prop :=\n` +
    `  ∃ entry, module_.findExport ${JSON.stringify(job.exportName)} = some entry ∧\n` +
    `    ∀ (env : Wasm.HostEnv Unit) (initial : Wasm.Store Unit)\n` +
    `      (inputPtr : UInt64) (input : Array UInt64),\n` +
    `      RuntimeReady initial inputPtr input →\n` +
    `      Wasm.TerminatesWith env module_ entry initial [.i64 inputPtr]\n` +
    `        (fun final results => ∃ outputPtr,\n` +
    `          results = [.i64 outputPtr] ∧\n` +
    `          UInt64ArrayAt final outputPtr (expected input))\n\n` +
    `end ${job.namespace}.FormalSpec\n`;
}

