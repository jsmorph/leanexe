function runCodexOutcome(options) {
  createWorkspace(options.taskRoot);
  for (const [relative, bytes] of options.contextFiles) {
    writeAtomic(path.join(options.taskRoot, ...relative.split("/")), Buffer.from(bytes));
  }
  const schemaFile = path.join(options.taskRoot, ".leanexegen-output-schema.json");
  const outputFile = path.join(options.taskRoot, ".leanexegen-outcome.json");
  writeAtomic(schemaFile, Buffer.from(`${JSON.stringify(codexOutcomeSchema(), null, 2)}\n`));
  const codexArgs = codexCommandArgs(
    options.codex, options.taskRoot, schemaFile, outputFile);
  const args = [
    leanrun,
    "--timeout", `${Math.ceil(options.timeout / 1000)}s`,
    ...codexArgs,
  ];
  const execute = options.execute || ((command, runOptions) =>
    run(options.stage, `${options.task} Codex task`, command, runOptions));
  execute(args, {
    cwd: options.taskRoot,
    input: options.prompt,
    timeout: options.timeout + 60 * 1000,
    maxBuffer: 64 * 1024 * 1024,
  });
  let response;
  try {
    response = JSON.parse(fs.readFileSync(outputFile, "utf8"));
    if (response.outcome === "generated") {
      const candidate = path.join(options.taskRoot, ...options.candidateFile.split("/"));
      const stat = fs.lstatSync(candidate);
      if (!stat.isFile() || stat.isSymbolicLink()) {
        throw new Error(`${options.candidateFile} is not a regular file`);
      }
      response.source = fs.readFileSync(candidate, "utf8");
    }
    const validated = validateCodexTaskOutcome(response, options.task);
    if (validated.outcome === "generated" && options.journalFile !== undefined) {
      const journalPath = path.join(
        options.taskRoot, ...options.journalFile.split("/"));
      const journalStat = fs.lstatSync(journalPath);
      if (!journalStat.isFile() || journalStat.isSymbolicLink()) {
        throw new Error(`${options.journalFile} is not a regular file`);
      }
      validated.proofJournal = validateProofJournal(
        fs.readFileSync(journalPath, "utf8"), options.journalFile);
    }
    if (validated.outcome === "generated" && options.knowledgeUse !== undefined) {
      const usePath = path.join(options.taskRoot, "KNOWLEDGE_USE.json");
      const useStat = fs.lstatSync(usePath);
      if (!useStat.isFile() || useStat.isSymbolicLink()) {
        throw new Error("KNOWLEDGE_USE.json is not a regular file");
      }
      validated.knowledgeUse = validateKnowledgeUse(
        JSON.parse(fs.readFileSync(usePath, "utf8")), options.knowledgeUse);
    }
    return validated;
  } catch (error) {
    throw new StageError(options.stage, options.task, `invalid Codex outcome: ${error.message}`);
  }
}

function validateKnowledgeUse(document, knowledgeTask) {
  exactKeys(document, ["schemaVersion", "entries"], "KNOWLEDGE_USE.json");
  if (document.schemaVersion !== 1 || !Array.isArray(document.entries)) {
    throw new Error("KNOWLEDGE_USE.json has an unsupported schema");
  }
  const allowed = new Map(knowledgeTask.manifest.packages.map((package_) => [
    package_.id, new Set(package_.entryIds),
  ]));
  const seen = new Set();
  const entries = document.entries.map((entry, index) => {
    exactKeys(entry, ["package", "entry", "outcome", "reason"],
      `KNOWLEDGE_USE.json entries[${index}]`);
    const key = `${entry.package}\0${entry.entry}`;
    if (typeof entry.package !== "string" || typeof entry.entry !== "string" ||
        !allowed.get(entry.package)?.has(entry.entry) || seen.has(key) ||
        !["used", "rejected"].includes(entry.outcome) ||
        typeof entry.reason !== "string" || entry.reason.trim().length === 0) {
      throw new Error(`KNOWLEDGE_USE.json entries[${index}] is invalid`);
    }
    seen.add(key);
    return {
      package: entry.package,
      entry: entry.entry,
      outcome: entry.outcome,
      reason: entry.reason.trim(),
    };
  });
  if (entries.some((entry, index) => index > 0 &&
      `${entries[index - 1].package}\0${entries[index - 1].entry}` >
        `${entry.package}\0${entry.entry}`)) {
    throw new Error("KNOWLEDGE_USE.json entries must be sorted by package and entry");
  }
  return { schemaVersion: 1, entries };
}

function reportDigest(report) {
  return sha256(Buffer.from(`${JSON.stringify(report, null, 2)}\n`));
}

function runTaskSession(options) {
  const invoke = () => options.invoke(options.prompt);
  const outcome = options.telemetry
    ? options.telemetry.measureCodexSession(invoke)
    : invoke();
  return acceptTaskOutcome(options, outcome);
}

function runDeterministicTaskSession(options) {
  const outcome = options.outcome;
  requireGeneratedOutcome(options, outcome);
  const source = options.materialize(outcome.source);
  let diagnostic;
  try {
    const diagnose = () => options.diagnose(source, outcome);
    diagnostic = options.telemetry
      ? options.telemetry.measureOuterAcceptance(diagnose)
      : diagnose();
  } catch (error) {
    throw new StageError(
      options.stage,
      options.stageName,
      `the independent outer check rejected the deterministic starter:\n${formatError(error)}`,
    );
  }
  if (diagnostic === null) return null;
  if (options.telemetry) options.telemetry.skipCodexSession();
  return acceptedTaskResult(options, outcome, source, diagnostic);
}

function acceptTaskOutcome(options, outcome) {
  requireGeneratedOutcome(options, outcome);
  const source = options.materialize(outcome.source);
  let diagnostic;
  try {
    const diagnose = () => options.diagnose(source, outcome);
    diagnostic = options.telemetry
      ? options.telemetry.measureOuterAcceptance(diagnose)
      : diagnose();
  } catch (error) {
    throw new StageError(
      options.stage,
      options.stageName,
      `the independent outer check rejected the Codex session result:\n${formatError(error)}`,
    );
  }
  return acceptedTaskResult(options, outcome, source, diagnostic);
}

function requireGeneratedOutcome(options, outcome) {
  if (outcome.outcome !== "generated") {
    const detail = outcome.outcome === "questions" ? outcome.questions : outcome.problems;
    throw new StageError(options.stage, options.stageName, detail.join("\n"));
  }
}

function acceptedTaskResult(options, outcome, source, diagnostic) {
  if (typeof diagnostic !== "string" || diagnostic.length === 0) {
    throw new StageError(options.stage, options.stageName, "diagnostic report was empty");
  }
  const sourceSha256 = sha256(Buffer.from(source));
  const proofTelemetry = options.telemetry
    ? options.telemetry.accept(sourceSha256)
    : null;
  const report = {
    summary: outcome.summary,
    decisions: outcome.decisions,
    attempts: [{
      number: 1,
      outcome: "accepted",
      sourceSha256,
      diagnosticSha256: sha256(Buffer.from(diagnostic)),
      diagnostic,
    }],
  };
  return {
    outcome,
    source,
    proofJournal: outcome.proofJournal,
    proofTelemetry,
    stageReport: {
      task: options.task,
      sourceModule: options.sourceModule,
      sourceSha256,
      reportSha256: reportDigest(report),
      report,
    },
  };
}

function deterministicArtifactProofOutcome(proofContext, job) {
  const source = proofContext.get(moduleFile(job.behaviorModule));
  if (source === undefined) {
    throw new StageError(5, "artifact proof", "proof context has no deterministic starter");
  }
  return {
    schemaVersion: codexTaskSchemaVersion,
    task: "artifact-proof",
    outcome: "generated",
    source,
    summary: "The complete deterministic starter passed the artifact-proof checks.",
    decisions: [
      "Used the checked wrapper composition and checked scalar summary without a Codex session.",
    ],
    samples: [],
    hostAssumptions: [],
    questions: [],
    problems: [],
    proofJournal: "# Proof Journal\n\n" +
      "Leanexegen selected a deterministic starter whose checked composition supplies every " +
      "artifact-proof obligation.  The independent artifact theorem, embedded-byte, and axiom " +
      "checks accepted the generated source without a Codex session.\n",
  };
}

function formalSpecificationSource(job, generatedSource) {
  return `${generatedSource.trimEnd()}\n\nnamespace ${job.namespace}.FormalSpec\n\n` +
    `def UInt64ArrayAt (store : Wasm.Store Unit) (ptr : UInt64) ` +
    `(values : Array UInt64) : Prop :=\n` +
    `  ptr.toNat + 8 * (values.size + 1) ≤ 4294967296 ∧\n` +
    `  ptr.toNat + 8 * (values.size + 1) ≤ store.mem.pages * 65536 ∧\n` +
    `  store.mem.read64 ptr.toUInt32 = UInt64.ofNat values.size ∧\n` +
    `  ∀ (i : Nat), (h : i < values.size) →\n` +
    `    store.mem.read64\n` +
    `      (ptr + UInt64.ofNat (8 * (i + 1))).toUInt32 = values[i]\n\n` +
    `def RuntimeReady (initial : Wasm.Store Unit) (inputPtr : UInt64) ` +
    `(input : Array UInt64) : Prop :=\n` +
    `  UInt64ArrayAt initial inputPtr input ∧\n` +
    `  ∃ heapTop allocs retains releases frees : UInt64,\n` +
    `    initial.globals.globals = [.i64 heapTop, .i64 0, .i64 allocs, .i64 retains,\n` +
    `      .i64 releases, .i64 frees] ∧\n` +
    `    inputPtr.toNat + 8 * (input.size + 1) ≤ heapTop.toNat ∧\n` +
    `    heapTop.toNat + 48 + 8 * ((expected input).size + 1) ≤ 4294967296 ∧\n` +
    `    heapTop.toNat + 48 + 8 * ((expected input).size + 1) ≤\n` +
    `      initial.mem.pages * 65536 ∧\n` +
    `    heapTop.toNat + heapReserveBytes input ≤ 4294967296 ∧\n` +
    `    heapTop.toNat + heapReserveBytes input ≤ initial.mem.pages * 65536 ∧\n` +
    `    initial.mem.pages ≤ 65536\n\n` +
    `def ArtifactSpec (module_ : Wasm.Module) : Prop :=\n` +
    `  ∃ entry, module_.findExport ${JSON.stringify(job.exportName)} = some entry ∧\n` +
    `    ∀ (env : Wasm.HostEnv Unit) (initial : Wasm.Store Unit)\n` +
    `      (inputPtr : UInt64) (input : Array UInt64),\n` +
    `      RuntimeReady initial inputPtr input →\n` +
    `      Wasm.TerminatesWith env module_ entry initial [.i64 inputPtr]\n` +
    `        (fun final results => ∃ outputPtr,\n` +
    `          results = [.i64 outputPtr] ∧\n` +
    `          UInt64ArrayAt final outputPtr (expected input))\n\n` +
    `end ${job.namespace}.FormalSpec\n`;
}

function formalSpecificationCheckSources(job, suffix, requireHeapReserve = true) {
  const target = `${job.namespace}.${suffix}`;
  return {
    target,
    sources: new Map([[target, `import ${job.formalSpecModule}\n\n` +
      `#check (${job.expectedDefinition} : Array UInt64 → Array UInt64)\n` +
      (requireHeapReserve
        ? `#check (${job.heapReserveDefinition} : Array UInt64 → Nat)\n`
        : "") +
      `#check (${job.formalSpecDefinition} : ${job.formalSpecType})\n`]]),
  };
}

