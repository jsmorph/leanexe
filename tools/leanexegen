  }
  if (annotated && mapAddRecipes.length === 1) {
    const recipe = mapAddRecipes[0];
    const parameters = /^Project\.ProofKit\.FixedArrayMapAdd\.wrapperProgram ([0-9]+) ([0-9]+)$/
      .exec(recipe.direct.program);
    if (parameters === null) {
      throw new Error("fixed-array map-add recipe has an invalid program");
    }
    const maximumSize = parameters[1];
    const addend = parameters[2];
    return `import ${job.formalSpecModule}
