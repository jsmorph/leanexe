      composition.functionIndex === entryIndex);
  const singletonWrapperPlan = singletonWrapperStarterPlan(proofRecipes, entryIndex);
  if (annotated && singletonWrapperPlan !== null) {
    const { composition, counterTransferSummary } = singletonWrapperPlan;
    const completeStarter = counterTransferSummary !== null
      ? `  apply FixedArraySingletonWrapper.wrapperProgram_spec
