  const proofImports = [...modules].sort().map((moduleName) =>
    `import ${moduleName}`).join("\n");
  const mapAddRecipes = (proofRecipes?.recipes ?? []).filter((recipe) =>
    recipe.regionKind === "leanexe.array.map-add.v1" &&
      recipe.functionIndex === entryIndex);
  const filterLtRecipes = (proofRecipes?.recipes ?? []).filter((recipe) =>
    recipe.regionKind === "leanexe.array.filter-lt.v1" &&
