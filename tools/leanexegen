class StageError extends Error {
  constructor(stage, name, message) {
    super(message);
    this.stage = stage;
    this.stageName = name;
  }
}

function usage() {
  return [
    "usage: leanexegen [-s] -o <program.wasm> <request.txt>",
    "       leanexegen reprove [-s] -o <program.wasm> <proof-package>",
    "       leanexegen verify [-s] <proof-package>",
  ].join("\n");
}

function parseArgs(args) {
  if (args[0] === "verify") {
    let silent = false;
    const rest = [];
    for (const argument of args.slice(1)) {
      if (argument === "-s") silent = true;
      else rest.push(argument);
    }
    if (rest.length !== 1) throw new Error(usage());
    return { command: "verify", silent, packagePath: path.resolve(rest[0]) };
  }
  const reprove = args[0] === "reprove";
  let silent = false;
  let output = null;
  const positional = [];
  for (let index = reprove ? 1 : 0; index < args.length; index += 1) {
    const argument = args[index];
    if (argument === "-s") {
      silent = true;
    } else if (argument === "-o") {
      index += 1;
      if (index >= args.length || output !== null) throw new Error(usage());
      output = args[index];
    } else if (argument.startsWith("-")) {
      throw new Error(usage());
    } else {
      positional.push(argument);
    }
  }
  if (output === null || positional.length !== 1) throw new Error(usage());
  return {
    command: reprove ? "reprove" : "generate",
    silent,
    outputPath: path.resolve(output),
    [reprove ? "packagePath" : "requestPath"]: path.resolve(positional[0]),
  };
}

function stageHeading(stage, title, startedAt = new Date()) {
  return `${startedAt.toISOString()} Stage ${stage}: ${title}\n\n`;
}

function progress(silent, stage, title) {
  if (!silent) process.stdout.write(stageHeading(stage, title));
}

function generationResult(silent, samples, invocation) {
  if (silent) return "";
  const sampleText = samples.map((sample) =>
    `Input: ${sample.arguments.join(" ")}\nOutput: ${sample.stdout}\n`).join("");
  return `${sampleText}\nRun:\n\n\`${formatCommand(invocation)}\`\n`;
}

function outputText(value) {
  if (value === undefined || value === null) return "";
  return Buffer.isBuffer(value) ? value.toString("utf8") : String(value);
}

function formatError(error) {
  if (error instanceof AggregateError) {
    return [error.message, ...error.errors.map((item) => formatError(item))].join("\n");
  }
  return error instanceof Error ? error.message : String(error);
}

function commandFailure(result) {
  const output = [outputText(result.stderr).trim(), outputText(result.stdout).trim()]
    .filter((part) => part.length > 0).join("\n");
  const termination = result.signal
    ? `terminated by ${result.signal}`
    : `exited with status ${result.status}`;
  return output.length === 0 ? termination : `${termination}:\n${output}`;
}

function parseCodexVersion(result) {
  const lines = `${outputText(result.stdout)}\n${outputText(result.stderr)}`
    .split(/\r?\n/).map((line) => line.trim()).filter((line) => line.length > 0);
  const identities = lines.filter((line) => /^codex-cli [^\s]+$/.test(line));
  if (identities.length !== 1) {
    throw new StageError(1, "job setup", "Codex returned no unique version identity");
  }
  return identities[0];
}

function run(stage, name, args, options = {}) {
  let result;
  try {
    result = spawnResult(args, {
      cwd: options.cwd || repoRoot,
      env: options.env || process.env,
      input: options.input,
      timeout: options.timeout,
      maxBuffer: options.maxBuffer || 64 * 1024 * 1024,
    });
  } catch (error) {
    throw new StageError(stage, name, error.message);
  }
  if (result.status !== 0) throw new StageError(stage, name, commandFailure(result));
  return {
    stdout: outputText(result.stdout),
    stderr: outputText(result.stderr),
  };
}

function runLean(stage, name, timeout, args, options = {}) {
  return run(stage, name, [leanrun, "--timeout", timeout, ...args], options);
}

function readRequest(file) {
  let request;
  try {
    request = fs.readFileSync(file, "utf8");
  } catch (error) {
    throw new StageError(1, "interpretation", `could not read ${file}: ${error.message}`);
  }
  if (request.trim().length === 0) {
    throw new StageError(1, "interpretation", "request file is empty");
  }
  return request;
}

function codexOutcomeSchema() {
  return {
    type: "object",
    additionalProperties: false,
    required: [
      "schemaVersion", "task", "outcome", "summary", "decisions",
      "questions", "problems", "source", "samples", "hostAssumptions",
    ],
    properties: {
      schemaVersion: { type: "integer", enum: [codexTaskSchemaVersion] },
      task: {
        type: "string",
        enum: ["formal-specification", "lean-program", "artifact-proof"],
      },
      outcome: { type: "string", enum: ["generated", "questions", "problems"] },
      summary: { type: "string", minLength: 1 },
      decisions: { type: "array", items: { type: "string", minLength: 1 } },
      questions: { type: "array", items: { type: "string", minLength: 1 } },
      problems: { type: "array", items: { type: "string", minLength: 1 } },
      source: { type: "string" },
      samples: {
        type: "array",
        items: {
          type: "object",
          additionalProperties: false,
          required: ["arguments", "expectedStdout"],
          properties: {
            arguments: {
              type: "array", items: { type: "string" }, minItems: 1, maxItems: 1,
            },
            expectedStdout: { type: "string", pattern: "^(?:0|[1-9][0-9]*)$" },
          },
        },
      },
      hostAssumptions: { type: "array", items: { type: "string", minLength: 1 } },
    },
  };
}

function codexCommandArgs(codex, workspace, schemaFile, outputFile) {
  return [
    codex,
    "exec",
    "-C", workspace,
    "--sandbox", "workspace-write",
    "--skip-git-repo-check",
    "--ephemeral",
    "--json",
    "--output-schema", schemaFile,
    "-o", outputFile,
    "--color", "never",
    "-",
  ];
}

function runCodexOutcome(options) {
  createWorkspace(options.taskRoot);
  for (const [relative, bytes] of options.contextFiles) {
    writeAtomic(path.join(options.taskRoot, ...relative.split("/")), Buffer.from(bytes));
  }
  const schemaFile = path.join(options.taskRoot, ".leanexegen-output-schema.json");
  const outputFile = path.join(options.taskRoot, ".leanexegen-outcome.json");
  writeAtomic(schemaFile, Buffer.from(`${JSON.stringify(codexOutcomeSchema(), null, 2)}\n`));
  const codexArgs = codexCommandArgs(
    options.codex, options.taskRoot, schemaFile, outputFile);
  const args = [
    leanrun,
    "--timeout", `${Math.ceil(options.timeout / 1000)}s`,
    ...codexArgs,
  ];
  const execute = options.execute || ((command, runOptions) =>
    run(options.stage, `${options.task} Codex task`, command, runOptions));
  execute(args, {
    cwd: options.taskRoot,
    input: options.prompt,
    timeout: options.timeout + 60 * 1000,
    maxBuffer: 64 * 1024 * 1024,
  });
  let response;
  try {
    response = JSON.parse(fs.readFileSync(outputFile, "utf8"));
    if (response.outcome === "generated") {
      const candidate = path.join(options.taskRoot, ...options.candidateFile.split("/"));
      const stat = fs.lstatSync(candidate);
      if (!stat.isFile() || stat.isSymbolicLink()) {
        throw new Error(`${options.candidateFile} is not a regular file`);
      }
      response.source = fs.readFileSync(candidate, "utf8");
    }
    return validateCodexTaskOutcome(response, options.task);
  } catch (error) {
    throw new StageError(options.stage, options.task, `invalid Codex outcome: ${error.message}`);
  }
}

function reportDigest(report) {
  return sha256(Buffer.from(`${JSON.stringify(report, null, 2)}\n`));
}

function runTaskSession(options) {
  const outcome = options.invoke(options.prompt);
  if (outcome.outcome !== "generated") {
    const detail = outcome.outcome === "questions" ? outcome.questions : outcome.problems;
    throw new StageError(options.stage, options.stageName, detail.join("\n"));
  }
  const source = options.materialize(outcome.source);
  let diagnostic;
  try {
    diagnostic = options.diagnose(source, outcome);
  } catch (error) {
    throw new StageError(
      options.stage,
      options.stageName,
      `the independent outer check rejected the Codex session result:\n${formatError(error)}`,
    );
  }
  if (typeof diagnostic !== "string" || diagnostic.length === 0) {
    throw new StageError(options.stage, options.stageName, "diagnostic report was empty");
  }
  const sourceSha256 = sha256(Buffer.from(source));
  const report = {
    summary: outcome.summary,
    decisions: outcome.decisions,
    attempts: [{
      number: 1,
      outcome: "accepted",
      sourceSha256,
      diagnosticSha256: sha256(Buffer.from(diagnostic)),
      diagnostic,
    }],
  };
  return {
    outcome,
    source,
    stageReport: {
      task: options.task,
      sourceModule: options.sourceModule,
      sourceSha256,
      reportSha256: reportDigest(report),
      report,
    },
  };
}

function formalSpecificationSource(job, generatedSource) {
  return `${generatedSource.trimEnd()}\n\nnamespace ${job.namespace}.FormalSpec\n\n` +
    `def ArtifactSpec (module_ : Wasm.Module) : Prop :=\n` +
    `  ∃ entry, module_.findExport ${JSON.stringify(job.exportName)} = some entry ∧\n` +
    `    ∀ (env : Wasm.HostEnv Unit) (initial : Wasm.Store Unit) (n : UInt64),\n` +
    `      Wasm.TerminatesWith env module_ entry initial [.i64 n] ` +
    `(fun _ results => results = [.i64 (expected n)])\n\n` +
    `end ${job.namespace}.FormalSpec\n`;
}

function formalSpecificationCheckSources(job, suffix) {
  const target = `${job.namespace}.${suffix}`;
  return {
    target,
    sources: new Map([[target, `import ${job.formalSpecModule}\n\n` +
      `#check (${job.expectedDefinition} : UInt64 → UInt64)\n` +
      `#check (${job.formalSpecDefinition} : ${job.formalSpecType})\n`]]),
  };
}

