function proofTaskContext(
    request, job, formalSource, generatedSources, strategies = null,
    formalInterfaceVersion = 2, artifactSha256 = null, suppliedLtgTask = null,
    suppliedProofLibrary = null, suppliedKnowledgeTask = null) {
  const context = new Map([
    ["request.txt", request],
    [moduleFile(job.formalSpecModule), formalSource],
    ...[...generatedSources].map(([moduleName, source]) => [moduleFile(moduleName), source]),
  ]);
  const program = generatedSources.get(job.programModule);
  if (program === undefined) {
    throw new StageError(5, "artifact proof", "proof task context has no Program module");
  }
  const bundle = strategies ?? proofStrategyBundle(
    program, programExportIndex(program, job.exportName));
  context.set("PROOF_STRATEGIES.md", bundle.notes);
  context.set("PROOF_TASK_FEATURES.json", `${JSON.stringify(bundle.features, null, 2)}\n`);
  context.set("PROOF_LIBRARY.md",
    suppliedProofLibrary ?? fs.readFileSync(proofKitCatalogPath, "utf8"));
  context.set("PROOF_KIT_SOURCE/README.md", `# Checked Proof-Kit Source

This directory mirrors every allowed \`Project.ProofKit\` module supplied to the proof task.  Each file has the same content covered by the proof-kit source identity in the tool pins.  Search this directory when a selected knowledge entry or proof recipe names a proof-kit declaration.
`);
  for (const [moduleName, source] of proofKitSources()) {
    context.set(`PROOF_KIT_SOURCE/${moduleFile(moduleName)}`, source);
  }
  if ((bundle.compilerAnnotations === undefined) !== (bundle.proofRecipes === undefined)) {
    throw new StageError(5, "artifact proof", "annotation and recipe context must appear together");
  }
  if (bundle.compilerAnnotations !== undefined) {
    const annotationMatches = annotationMatchesSource(bundle.compilerAnnotations, job, program);
    context.set(moduleFile(annotationMatches.module), annotationMatches.source);
    context.set("PROGRAM_ANNOTATIONS.json",
      `${JSON.stringify(bundle.compilerAnnotations, null, 2)}\n`);
    context.set("PROOF_RECIPES.json", `${JSON.stringify(bundle.proofRecipes, null, 2)}\n`);
  }
  const taskKnowledge = suppliedKnowledgeTask ?? (suppliedLtgTask === null
    ? knowledgeTaskBundle(defaultForestPath, artifactSha256)
    : null);
  if (taskKnowledge !== null) {
    for (const [relative, source] of taskKnowledge.files) {
      context.set(`KNOWLEDGE/${relative}`,
        Buffer.isBuffer(source) ? source.toString("utf8") : source);
    }
    for (const [moduleName, source] of taskKnowledge.leanSources) {
      context.set(moduleFile(moduleName), source);
    }
    context.set("KNOWLEDGE_TASK.json",
      `${JSON.stringify(taskKnowledge.manifest, null, 2)}\n`);
    context.set("KNOWLEDGE_USE.json", `${JSON.stringify({
      schemaVersion: 1,
      entries: [],
    }, null, 2)}\n`);
  } else {
    const taskLtg = suppliedLtgTask;
    for (const [relative, source] of taskLtg.files) {
      context.set(`LTG/${relative}`,
        Buffer.isBuffer(source) ? source.toString("utf8") : source);
    }
    context.set("LTG_TASK.json", `${JSON.stringify(taskLtg.manifest, null, 2)}\n`);
  }
  context.set("PROOF_IMPORT_CHECK.js", proofImportCheckSource(
    job, taskKnowledge?.allowedModules ?? new Set()));
  context.set("PROOF_JOURNAL.md", "# Proof Journal\n\n");
  context.set(moduleFile(job.behaviorModule),
    artifactProofStarter(
      job, bundle.features.exportIndex, bundle.compilerAnnotations !== undefined,
      bundle.proofRecipes ?? null, formalInterfaceVersion));
  if (context.has(moduleFile(job.sourceModule))) {
    throw new StageError(5, "artifact proof", "proof task context contains Source");
  }
  return context;
}

function knowledgeTaskBundle(
    forestPath = defaultForestPath, artifactSha256 = null) {
  return taskKnowledgeFiles({
    forestPath,
    artifactSha256,
  });
}

function ltgTaskBundle(artifactSha256 = null, excludedDerivativeGroups = []) {
  const derivativeGroups = [...excludedDerivativeGroups].sort();
  const task = taskCatalogFiles({ artifactSha256, excludedDerivativeGroups: derivativeGroups });
  return {
    files: task.files,
    manifest: {
      schemaVersion: 1,
      artifactSha256,
      derivativeGroups,
      entries: task.entryIds.length,
      entryIds: task.entryIds,
      excludedEntries: task.excludedEntryIds.length,
      excludedEntryIds: task.excludedEntryIds,
      sha256: catalogDigest(task.files),
    },
  };
}

function checkFormalSpecification(
    workspace, job, source, stage, suffix, requireHeapReserve = true) {
  installSources(workspace, new Map([[job.formalSpecModule, source]]));
  const checks = formalSpecificationCheckSources(job, suffix, requireHeapReserve);
  installSources(workspace, checks.sources);
  runLean(stage, "formal specification module", "15m", [
    "lake", "-d", workspace, "--no-ansi", "build", job.formalSpecModule,
  ]);
  runLean(stage, "formal specification declarations", "15m", [
    "lake", "-d", workspace, "--no-ansi", "build", checks.target,
  ]);
  return `Lean accepted ${job.expectedDefinition} : Array UInt64 → Array UInt64 and ` +
    (requireHeapReserve ? `${job.heapReserveDefinition} : Array UInt64 → Nat and ` : "") +
    `${job.formalSpecDefinition} : ${job.formalSpecType}.`;
}

function checkProgramCandidate(workspace, job, source) {
  installSources(workspace, new Map([
    [job.sourceModule, source],
    [`${job.namespace}.SourceCheck`, `import ${job.sourceModule}\n\n` +
      `#check (${job.sourceEntry} : Array UInt64 → Array UInt64)\n`],
  ]));
  runLean(3, "Lean source typecheck", "15m", [
    "lake", "-d", workspace, "--no-ansi", "build", `${job.namespace}.SourceCheck`,
  ]);
  runLean(3, "LeanExe acceptance", "10m", [
    "lake", "-d", workspace, "env", compiler,
    "report", "--module", job.sourceModule, "--entry", job.sourceEntry,
  ]);
  const candidate = path.join(
    workspace, `candidate-${sha256(Buffer.from(source)).slice(0, 16)}.wasm`);
  runLean(3, "LeanExe candidate compilation", "10m", [
    "lake", "-d", workspace, "env", compiler,
    "compile", "--module", job.sourceModule, "--entry", job.sourceEntry,
    "--out", candidate, "--annotations", `${candidate}.annotations.json`,
  ]);
  const candidateBytes = fs.readFileSync(candidate);
  validateAnnotationDocument(JSON.parse(
    fs.readFileSync(`${candidate}.annotations.json`, "utf8")), candidateBytes);
  return `Lean and LeanExe accepted and compiled ` +
    `${job.sourceEntry} : Array UInt64 → Array UInt64.`;
}

function removeTaskWorkspace(root, stage, name) {
  try {
    fs.rmSync(root, { recursive: true });
  } catch (error) {
    throw new StageError(stage, name, `could not remove isolated workspace: ${error.message}`);
  }
}

function findExecutable(name) {
  for (const directory of (process.env.PATH || "").split(path.delimiter)) {
    if (!directory) continue;
    const candidate = path.join(directory, name);
    try {
      fs.accessSync(candidate, fs.constants.X_OK);
      return candidate;
    } catch (error) {
      if (!["ENOENT", "ENOTDIR", "EACCES"].includes(error.code)) throw error;
    }
  }
  return null;
}

function findCodex() {
  const codex = findExecutable("codex");
  if (codex === null) {
    throw new StageError(1, "job setup", "the Codex CLI was not found on PATH");
  }
  return codex;
}

function findWasmTools() {
  const candidates = [
    process.env.WASM_TOOLS,
    findExecutable("wasm-tools"),
    path.join(os.homedir(), ".cargo", "bin", "wasm-tools"),
  ].filter(Boolean);
  for (const candidate of candidates) {
    try {
      fs.accessSync(candidate, fs.constants.X_OK);
      return path.resolve(candidate);
    } catch (error) {
      if (!["ENOENT", "ENOTDIR", "EACCES"].includes(error.code)) throw error;
    }
  }
  throw new StageError(4, "WASM compilation", "wasm-tools was not found");
}

function findWasmtime() {
  const candidates = [
    process.env.WASMTIME,
    findExecutable("wasmtime"),
    path.join(repoRoot, "build", "tools", "wasmtime", "current", "wasmtime"),
  ].filter(Boolean);
  for (const candidate of candidates) {
    try {
      fs.accessSync(candidate, fs.constants.X_OK);
      return path.resolve(candidate);
    } catch (error) {
      if (!["ENOENT", "ENOTDIR", "EACCES"].includes(error.code)) throw error;
    }
  }
  throw new StageError(6, "sample execution", "Wasmtime was not found");
}

function ensureVerifier() {
  try {
    fs.accessSync(verifier, fs.constants.X_OK);
    return;
  } catch (error) {
    if (!["ENOENT", "ENOTDIR", "EACCES"].includes(error.code)) throw error;
  }
  if (!fs.existsSync(path.join(verifierRoot, "lakefile.toml"))) {
    runLean(5, "Talos dependency update", "15m",
      ["lake", "-d", proofRoot, "--no-ansi", "update"]);
  }
  runLean(5, "Talos verifier build", "20m",
    ["lake", "-d", verifierRoot, "--no-ansi", "build"]);
  try {
    fs.accessSync(verifier, fs.constants.X_OK);
  } catch (error) {
    throw new StageError(5, "artifact proof", `Talos verifier is unavailable: ${error.message}`);
  }
}

function buildCrateInput(root, job, wasm, wat) {
  const crateRoot = path.join(root, "rust", job.caseName);
  const buildRoot = path.join(root, "rust", "build", job.caseName);
  fs.mkdirSync(crateRoot, { recursive: true });
  fs.mkdirSync(buildRoot, { recursive: true });
  writeAtomic(path.join(crateRoot, "Cargo.toml"), Buffer.from(
    `[package]\nname = "${job.caseName}"\nversion = "0.0.0"\nedition = "2021"\n`,
  ));
  fs.copyFileSync(wasm, path.join(buildRoot, "program.wasm"));
  fs.copyFileSync(wat, path.join(buildRoot, "program.wat"));
}

function emitTalosProgram(job, wasm, wat, temporaryRoot) {
  ensureVerifier();
  buildCrateInput(temporaryRoot, job, wasm, wat);
  runLean(5, "Talos model generation", "10m",
    [verifier, "emit", "--force-emit", job.caseName], { cwd: temporaryRoot });
  const generated = path.join(
    temporaryRoot, "lean", "Project", job.leanModule, "Program.lean",
  );
  if (!fs.existsSync(generated)) {
    throw new StageError(5, "artifact proof", `Talos did not generate ${generated}`);
  }
  return rewriteProgramNamespace(fs.readFileSync(generated, "utf8"), job);
}

function dumpRawModule(wasm) {
  const result = runLean(5, "artifact decoder", "5m", [
    "lake", "-d", proofRoot, "env", "lean", "--run", dumpRaw, wasm,
  ]);
  const raw = result.stdout.trim();
  if (!raw.startsWith("{") || !raw.endsWith("}")) {
    throw new StageError(5, "artifact proof", "artifact decoder returned invalid output");
  }
  return raw;
}

function auditAxioms(output) {
  if (/\bsorryAx\b/.test(output)) {
    throw new StageError(5, "artifact proof", "declaration audit found sorryAx");
  }
  const unexpected = new Set();
  for (const report of output.matchAll(/depends on axioms:\s*\[([^\]]*)\]/g)) {
    for (const printed of report[1].split(",").map((item) => item.trim()).filter(Boolean)) {
      const name = printed.replace(/✝+$/, "");
      if (!allowedAxioms.has(name) && !generatedDecisionAxiom.test(name)) {
        unexpected.add(printed);
      }
    }
  }
  if (unexpected.size > 0) {
    throw new StageError(
      5,
      "artifact proof",
      `declaration audit found unsupported axioms: ${[...unexpected].join(", ")}`,
    );
  }
  const reports = (output.match(/(?:depends on axioms|does not depend on any axioms)/g) || [])
    .length;
  if (reports !== 7) {
    throw new StageError(
      5,
      "artifact proof",
      `declaration audit produced ${reports} axiom reports; expected 7`,
    );
  }
}

function verificationCheckSources(job, artifact) {
  const prefix = job.namespace;
  const fileTarget = `${prefix}.VerifierCheckFile`;
  const declarationTarget = `${prefix}.VerifierCheckDeclarations`;
  const artifactNamespace = `${prefix}.Artifact`;
  return {
    fileTarget,
    declarationTarget,
    sources: new Map([
      [fileTarget, `import ${prefix}.ArtifactBytes

def main (args : List String) : IO UInt32 := do
  let [file] := args
    | IO.eprintln "usage: VerifierCheckFile <program.wasm>"
      return 2
  let found ← IO.FS.readBinFile file
  if found == ${artifact.artifactBytesDefinition} then
    IO.println s!"embedded bytes matched: {found.size} bytes"
    return 0
  IO.eprintln s!"embedded bytes differ: {file}"
  return 1
`],
      [declarationTarget, `import ${artifact.proofTarget}
import Project.Artifact.Binary.Proof.Decode
import Project.Artifact.Binary.Proof.Validate

open Wasm.Binary

example : decode ${artifact.artifactBytesDefinition} =
    .ok ${artifact.rawModuleDefinition} :=
  ${artifactNamespace}.decode_eq_cache

example : Translation.module ${artifact.rawModuleDefinition} =
    ${job.namespace}.«module» := by
  exact ${artifactNamespace}.translation_cache_eq

example :
    ∃ raw validated,
      decode ${artifact.artifactBytesDefinition} = .ok raw ∧
      validate raw = .ok validated ∧
      CoreValid raw ∧
      ${artifact.property} validated.toTalos :=
  ${artifact.artifactTheorem}

#print axioms Wasm.Binary.Proof.decode_sound
#print axioms Wasm.Binary.Proof.validate_sound
#print axioms ${artifactNamespace}.decode_eq_cache
#print axioms ${artifactNamespace}.translation_cache_eq
#print axioms ${artifactNamespace}.artifact_module_eq_cache
#print axioms ${artifact.behaviorTheorem}
#print axioms ${artifact.artifactTheorem}
`],
    ]),
  };
}

function checkProof(workspace, job, artifact, wasm, toolPins) {
  const checks = verificationCheckSources(job, artifact);
  requireKernelAudit(checks.sources, toolPins);
  installSources(workspace, checks.sources);
  runLean(5, "artifact theorem", "60m",
    ["lake", "-d", workspace, "--no-ansi", "build", artifact.proofTarget]);
  checkProofAfterArtifactTheorem(workspace, checks, wasm);
}

function checkProofAfterArtifactTheorem(workspace, checks, wasm) {
  runLean(5, "embedded byte checker", "15m",
    ["lake", "-d", workspace, "--no-ansi", "build", checks.fileTarget]);
  runLean(5, "embedded byte comparison", "15m", [
    "lake", "-d", workspace, "env", "lean", "--run",
    path.join(workspace, moduleFile(checks.fileTarget)), wasm,
  ]);
  const declaration = runLean(5, "declaration audit", "15m",
    ["lake", "-d", workspace, "--no-ansi", "build", checks.declarationTarget]);
  auditAxioms(`${declaration.stdout}\n${declaration.stderr}`);
}

function tryCheckProof(workspace, job, artifact, wasm, toolPins) {
  const checks = verificationCheckSources(job, artifact);
  requireKernelAudit(checks.sources, toolPins);
  installSources(workspace, checks.sources);
  let result;
  try {
    result = spawnResult([
      leanrun, "--timeout", "60m", "lake", "-d", workspace,
      "--no-ansi", "build", artifact.proofTarget,
    ], { cwd: repoRoot, env: process.env, maxBuffer: 64 * 1024 * 1024 });
  } catch (error) {
    throw new StageError(5, "deterministic starter check", error.message);
  }
  if (result.status === 1 && result.signal === null) return false;
  if (result.status !== 0) {
    throw new StageError(5, "deterministic starter check", commandFailure(result));
  }
  checkProofAfterArtifactTheorem(workspace, checks, wasm);
  return true;
}

function acceptedKnowledgeEvaluation(proof, artifact, knowledgeTask) {
  const sourceBytes = Buffer.from(proof.source);
  const lineCount = proof.source === "" ? 0 :
    proof.source.split("\n").length - (proof.source.endsWith("\n") ? 1 : 0);
  return {
    schemaVersion: 1,
    artifactSha256: artifact.sha256,
    knowledgeTaskSha256: knowledgeTask.manifest.sha256,
    status: "accepted",
    entries: proof.outcome.knowledgeUse?.entries ?? [],
    proof: {
      sourceSha256: proof.stageReport.sourceSha256,
      byteLength: sourceBytes.length,
      lineCount,
      stage5Milliseconds: proof.proofTelemetry.totalMilliseconds,
    },
  };
}

function runArtifactProof(options) {
  const {
    request, job, entryIndex, proofContext, proofRecipes, proofWorkspace,
    proofTaskRoot, artifact, wasm, toolPins, telemetry, codex,
    allowedKnowledgeModules = new Set(), knowledgeTask = null,
  } = options;
  const diagnostic = `Lean accepted ${job.behaviorTheorem} and ${artifact.artifactTheorem}.`;
  const prepare = (source) => {
    validateProofImports(
      job, [{ module: job.behaviorModule, source }], allowedKnowledgeModules);
    requireKernelAudit(new Map([[job.behaviorModule, source]]), toolPins);
    installSources(proofWorkspace, new Map([[job.behaviorModule, source]]));
  };
  const session = {
    task: "artifact-proof",
    stage: 5,
    stageName: "artifact proof",
    sourceModule: job.behaviorModule,
    telemetry,
    materialize: (source) => source,
    diagnose: (source) => {
      prepare(source);
      checkProof(proofWorkspace, job, artifact, wasm, toolPins);
      return diagnostic;
    },
  };
  let proof = null;
  if (artifactProofStarterExpectedComplete(proofRecipes, entryIndex)) {
    proof = runDeterministicTaskSession({
      ...session,
      outcome: deterministicArtifactProofOutcome(proofContext, job),
      diagnose: (source) => {
        prepare(source);
        return tryCheckProof(proofWorkspace, job, artifact, wasm, toolPins)
          ? diagnostic
          : null;
      },
    });
  }
  if (proof === null) {
    proof = runTaskSession({
      ...session,
      invoke: (prompt) => runCodexOutcome({
        codex,
        task: "artifact-proof",
        stage: 5,
        taskRoot: proofTaskRoot,
        contextFiles: proofContext,
        candidateFile: moduleFile(job.behaviorModule),
        journalFile: "PROOF_JOURNAL.md",
        knowledgeUse: knowledgeTask ?? undefined,
        timeout: artifactProofTaskTimeoutMs,
        prompt,
      }),
      prompt: proofPrompt(request, job, entryIndex, knowledgeTask !== null),
    });
  }
  return {
    ...proof,
    knowledgeEvaluation: knowledgeTask === null ? null :
      acceptedKnowledgeEvaluation(proof, artifact, knowledgeTask),
  };
}

function shellQuote(argument) {
  if (/^[A-Za-z0-9_./:=+-]+$/.test(argument)) return argument;
  return `'${argument.replaceAll("'", `'"'"'`)}'`;
}

function formatCommand(args) {
  return args.map(shellQuote).join(" ");
}

function validateUInt64Decimal(value, description) {
  if (!/^(?:0|[1-9][0-9]*)$/.test(value) || BigInt(value) >= uint64Modulus) {
    throw new Error(`${description} must be an unsigned UInt64 decimal`);
  }
  return value;
}

function formatUInt64Array(values) {
  return `[${values.join(", ")}]`;
}

function parseUInt64Array(text) {
  const match = text.match(/^\[([0-9, ]*)\]$/);
  if (match === null) return null;
  if (match[1] === "") return [];
  const values = match[1].split(", ");
  try {
    values.forEach((value, index) =>
      validateUInt64Decimal(value, `result[${index}]`));
  } catch (_error) {
    return null;
  }
  return values;
}

function requireWasmtimeHost() {
  try {
    fs.accessSync(wasmtimeHost, fs.constants.X_OK);
  } catch (error) {
    throw new StageError(
      6,
      "sample execution",
      `Wasmtime host runner is unavailable at ${wasmtimeHost}: ${error.message}`,
    );
  }
  return wasmtimeHost;
}

function runArrayWasm(wasm, exportName, input) {
  const host = requireWasmtimeHost();
  const result = run(6, "sample execution", [
    host,
    "call",
    wasm,
    exportName,
    "array-u64",
    `array-u64:${input.join(",")}`,
  ]);
  const raw = result.stdout.trimEnd();
  const output = parseUInt64Array(raw);
  if (output === null) {
    throw new StageError(
      6,
      "sample execution",
      `the Wasmtime host returned an invalid Array UInt64 value: ${JSON.stringify(raw)}`,
    );
  }
  return output;
}

function runSamples(samplesToRun, exportName, wasm, toolPins) {
  const wasmtime = findWasmtime();
  const version = run(6, "Wasmtime version", [wasmtime, "--version"]).stdout.trim();
  if (!version.startsWith(`wasmtime ${toolPins.wasmtimeVersion} `)) {
    throw new StageError(
      6,
      "sample execution",
      `expected Wasmtime ${toolPins.wasmtimeVersion}, found ${version}`,
    );
  }
  requireWasmtimeHost();
  const samples = [];
  for (const sample of samplesToRun) {
    const invocation = [
      path.join(repoRoot, "tools", "leanexegen"),
      "run",
      wasm,
      ...sample.input,
    ];
    const output = runArrayWasm(wasm, exportName, sample.input);
    if (JSON.stringify(output) !== JSON.stringify(sample.expectedOutput)) {
      throw new StageError(
        6,
        "sample execution",
        `input ${formatUInt64Array(sample.input)} produced ${formatUInt64Array(output)}; ` +
          `expected ${formatUInt64Array(sample.expectedOutput)}`,
      );
    }
    samples.push({ input: sample.input, output, invocation });
  }
  return { wasmtime, wasmtimeHost, samples };
}

function proofPackagePath(outputPath) {
  return outputPath.endsWith(".wasm")
    ? `${outputPath.slice(0, -5)}.proof`
    : `${outputPath}.proof`;
}

function requirePublicationTargetsAvailable(outputPath) {
  const packagePath = proofPackagePath(outputPath);
  if (fs.existsSync(outputPath)) {
    throw new StageError(1, "job setup", `${outputPath} exists`);
  }
  if (fs.existsSync(packagePath)) {
    throw new StageError(1, "job setup", `${packagePath} exists`);
  }
  if (fs.existsSync(`${packagePath}.failure`)) {
    throw new StageError(1, "job setup", `${packagePath}.failure exists`);
  }
  return packagePath;
}

function preserveReproveFailure(packagePath, proofTaskRoot, job, error) {
  const failurePath = `${packagePath}.failure`;
  if (fs.existsSync(failurePath)) {
    throw new Error(`${failurePath} exists`);
  }
  fs.mkdirSync(path.dirname(failurePath), { recursive: true });
  const nonce = `${process.pid}-${Date.now()}`;
  const staged = path.join(
    path.dirname(failurePath), `.${path.basename(failurePath)}.${nonce}`,
  );
  const sources = [
    [moduleFile(job.behaviorModule), "candidate.lean"],
    ["PROOF_JOURNAL.md", "proof-journal.md"],
    [".leanexegen-outcome.json", "outcome.json"],
    ["LTG_TASK.json", "ltg-task.json"],
    ["KNOWLEDGE_TASK.json", "knowledge-task.json"],
    ["KNOWLEDGE_USE.json", "knowledge-use.json"],
    ["PROGRAM_ANNOTATIONS.json", "program.annotations.json"],
    ["PROOF_RECIPES.json", "proof-recipes.json"],
    ["PROOF_STRATEGIES.md", "proof-strategies.md"],
    ["PROOF_TASK_FEATURES.json", "proof-task-features.json"],
  ];
  try {
    fs.mkdirSync(staged);
    const files = [];
    for (const [source, destination] of sources) {
      const sourcePath = path.join(proofTaskRoot, ...source.split("/"));
      if (!fs.existsSync(sourcePath)) continue;
      const stat = fs.lstatSync(sourcePath);
      if (!stat.isFile() || stat.isSymbolicLink()) {
        throw new Error(`${sourcePath} is not a regular file`);
      }
      const bytes = fs.readFileSync(sourcePath);
      fs.writeFileSync(path.join(staged, destination), bytes, { flag: "wx" });
      files.push({ path: destination, sha256: sha256(bytes) });
    }
    if (!files.some((file) => file.path === "candidate.lean") ||
        !files.some((file) => file.path === "proof-journal.md")) {
      throw new Error("failed artifact proof has no candidate or journal");
    }
    const record = {
      schemaVersion: 1,
      failedAt: new Date().toISOString(),
      stage: error instanceof StageError ? error.stage : null,
      stageName: error instanceof StageError ? error.stageName : null,
      sourceModule: job.behaviorModule,
      error: formatError(error),
      files,
    };
    fs.writeFileSync(
      path.join(staged, "failure.json"),
      `${JSON.stringify(record, null, 2)}\n`,
      { flag: "wx" },
    );
    fs.renameSync(staged, failurePath);
  } catch (preservationError) {
    fs.rmSync(staged, { recursive: true, force: true });
    throw preservationError;
  }
  return failurePath;
}

function publish(outputPath, packagePath, wasmBytes, buildPackage) {
  if (fs.existsSync(outputPath)) throw new StageError(7, "publication", `${outputPath} exists`);
  if (fs.existsSync(packagePath)) throw new StageError(7, "publication", `${packagePath} exists`);
  fs.mkdirSync(path.dirname(outputPath), { recursive: true });
  fs.mkdirSync(path.dirname(packagePath), { recursive: true });
  const nonce = `${process.pid}-${Date.now()}`;
  const stagedWasm = path.join(path.dirname(outputPath), `.${path.basename(outputPath)}.${nonce}`);
  const stagedPackage = path.join(
    path.dirname(packagePath), `.${path.basename(packagePath)}.${nonce}`,
  );
  let installedPackage = false;
  let installedWasm = false;
  try {
    fs.mkdirSync(stagedPackage, { recursive: true });
    buildPackage(stagedPackage);
    fs.writeFileSync(stagedWasm, wasmBytes, { flag: "wx" });
    fs.renameSync(stagedPackage, packagePath);
    installedPackage = true;
    fs.renameSync(stagedWasm, outputPath);
    installedWasm = true;
  } catch (error) {
    const cleanupErrors = [];
    for (const target of [
      installedWasm ? outputPath : stagedWasm,
      installedPackage ? packagePath : stagedPackage,
    ]) {
      try {
        fs.rmSync(target, { recursive: true, force: true });
      } catch (cleanupError) {
        cleanupErrors.push(cleanupError);
      }
    }
    if (cleanupErrors.length > 0) {
      throw new StageError(
        7,
        "publication",
        formatError(new AggregateError(
          [error, ...cleanupErrors], "publication rollback failed",
        )),
      );
    }
    throw new StageError(7, "publication", error.message);
  }
}

function copyPackageProof(packageRoot, workspace) {
  const proof = path.join(packageRoot, "proof");
  for (const relative of collectFiles(proof)) {
    if (!relative.endsWith(".lean")) {
      throw new StageError(5, "artifact proof", `unexpected proof file: ${relative}`);
    }
    const source = path.join(proof, ...relative.split("/"));
    writeAtomic(path.join(workspace, ...relative.split("/")), fs.readFileSync(source));
  }
}

function readPackageSources(packageRoot) {
  const sources = new Map();
  const proofRootPath = path.join(packageRoot, "proof");
  for (const relative of collectFiles(proofRootPath)) {
    if (!relative.endsWith(".lean")) {
      throw new StageError(5, "artifact proof", `unexpected proof file: ${relative}`);
    }
    const moduleName = relative.slice(0, -5).split("/").join(".");
    sources.set(moduleName, fs.readFileSync(
      path.join(proofRootPath, ...relative.split("/")), "utf8"));
  }
  return sources;
}

function reproveSourceSets(sources, job) {
  const frozen = new Map(sources);
  frozen.delete(job.behaviorModule);
  frozen.delete(annotationMatchesModule(job));
  const proofContext = new Map(frozen);
  proofContext.delete(job.formalSpecModule);
  proofContext.delete(job.sourceModule);
  return { frozen, proofContext };
}

function requireFrozenProofKitIsolation(sources) {
  for (const [moduleName, source] of sources) {
    const dependency = imports(source).find((imported) => proofKitModules.includes(imported));
    if (dependency !== undefined) {
      throw new StageError(
        5,
        "artifact proof",
        `frozen module ${moduleName} imports mutable proof-library module ${dependency}`,
      );
    }
  }
}

function comparableReprovePins(toolPins) {
  const comparable = structuredClone(toolPins);
  delete comparable.proofKitSourceSha256;
  return comparable;
}

function reprovePinsMatch(recorded, current) {
  return JSON.stringify(comparableReprovePins(recorded)) ===
    JSON.stringify(comparableReprovePins(current));
}

function requireReprovePins(packageRoot) {
  const recorded = JSON.parse(fs.readFileSync(path.join(packageRoot, "tool-pins.json"), "utf8"));
  const current = currentToolPins(repoRoot);
  if (!reprovePinsMatch(recorded, current)) {
    throw new StageError(
      5,
      "artifact proof",
      "tool pins other than the proof-library source differ from this checkout",
    );
  }
  requireMaterializedPins(current);
  return current;
}

function requirePins(packageRoot) {
  const recorded = JSON.parse(fs.readFileSync(path.join(packageRoot, "tool-pins.json"), "utf8"));
  const current = currentToolPins(repoRoot);
  if (JSON.stringify(recorded) !== JSON.stringify(current)) {
    throw new StageError(5, "artifact proof", "tool pins differ from this checkout");
  }
  const packagedCatalog = fs.readFileSync(path.join(packageRoot, "proof-library.md"));
  const currentCatalog = fs.readFileSync(proofKitCatalogPath);
  if (!packagedCatalog.equals(currentCatalog)) {
    throw new StageError(5, "artifact proof", "proof-library catalog differs from this checkout");
  }
  requireMaterializedPins(current);
  return current;
}

function requireMaterializedPins(toolPins) {
  if (process.versions.node !== toolPins.nodeVersion) {
    throw new StageError(
      5,
      "artifact proof",
      `Node version mismatch: expected ${toolPins.nodeVersion}, found ${process.versions.node}`,
    );
  }
  const manifest = JSON.parse(fs.readFileSync(
    path.join(proofRoot, "lake-manifest.json"), "utf8"));
  if (!Array.isArray(manifest.packages)) {
    throw new StageError(5, "artifact proof", "proof Lake manifest has no package array");
  }
  const gitPackages = manifest.packages.filter((item) => item.type === "git");
  if (gitPackages.length === 0) {
    throw new StageError(5, "artifact proof", "proof Lake manifest has no Git packages");
  }
  for (const item of gitPackages) {
    if (typeof item.name !== "string" || !/^[0-9a-f]{40}$/.test(item.rev)) {
      throw new StageError(5, "artifact proof", "proof Lake manifest has an invalid Git package");
    }
    const checkout = path.join(proofRoot, ".lake", "packages", item.name);
    const head = run(5, `${item.name} revision`, ["git", "rev-parse", "HEAD"], {
      cwd: checkout,
    }).stdout.trim();
    if (head !== item.rev) {
      throw new StageError(
        5,
        "artifact proof",
        `${item.name} revision mismatch: expected ${item.rev}, found ${head || "unavailable"}`,
      );
    }
    const changes = run(5, `${item.name} checkout`, [
      "git", "status", "--porcelain=v1", "--untracked-files=no", "--ignore-submodules=none",
    ], { cwd: checkout }).stdout.trim();
    if (changes !== "") {
      throw new StageError(
        5,
        "artifact proof",
        `${item.name} checkout has tracked changes:\n${changes}`,
      );
    }
  }
  const lean = runLean(5, "Lean identity", "2m", ["lean", "--version"]);
  const identity = `${lean.stdout}\n${lean.stderr}`;
  const version = toolPins.leanToolchain.split(":v")[1];
  if (!identity.includes(`version ${version}`) ||
      !identity.includes(`commit ${toolPins.leanCommit}`)) {
    throw new StageError(5, "artifact proof", `Lean identity mismatch: ${identity.trim()}`);
  }
}

function requireKernelAudit(sources, toolPins) {
  const findings = kernelAuditFindings(sources, toolPins.kernelReview);
  if (findings.length > 0) {
    throw new StageError(
      5,
      "artifact proof",
      `kernel scope audit found forbidden identifiers:\n${findings.join("\n")}`,
    );
  }
}

function proofKitSources() {
  return new Map(proofKitModules.map((moduleName) => [
    moduleName,
    fs.readFileSync(path.join(proofRoot, moduleFile(moduleName)), "utf8"),
  ]));
}

function verify(command) {
  progress(command.silent, 5, "Direct artifact proof");
  let checked;
  let toolPins;
  try {
    checked = validatePackage(command.packagePath);
    toolPins = requirePins(command.packagePath);
    const packageSources = readPackageSources(command.packagePath);
    requireKernelAudit(packageSources, toolPins);
    if (checked.knowledgeTask !== null) {
      requireKernelAudit(checked.knowledgeTask.leanSources, toolPins);
    }
    const kitSources = proofKitSources();
    validateProofImports(checked.job, [...kitSources].map(([module, source]) => ({
      module,
      source,
    })));
    requireKernelAudit(kitSources, toolPins);
  } catch (error) {
    if (error instanceof StageError) throw error;
    throw new StageError(5, "artifact proof", error.message);
  }
  const workspace = makeTemporaryDirectory("leanexegen-verify-");
  let operationError = null;
  try {
    createWorkspace(workspace);
    copyPackageProof(command.packagePath, workspace);
    if (checked.knowledgeTask !== null) {
      installSources(workspace, checked.knowledgeTask.leanSources);
    }
    checkFormalSpecification(
      workspace,
      checked.job,
      fs.readFileSync(path.join(
        command.packagePath, "proof", moduleFile(checked.job.formalSpecModule)), "utf8"),
      5,
      "VerifierFormalSpecCheck",
      checked.manifest.schemaVersion >= 6,
    );
    checkProof(
      workspace,
      checked.job,
      checked.artifact,
      path.join(command.packagePath, "program.wasm"),
      toolPins,
    );
    if (!command.silent) {
      process.stdout.write(
        `Verified ${checked.artifact.sha256} with theorem ${checked.artifact.artifactTheorem}\n`,
      );
    }
  } catch (error) {
    operationError = error;
  }
  try {
    fs.rmSync(workspace, { recursive: true });
  } catch (cleanupError) {
    if (operationError) {
      throw new StageError(
        5,
        "artifact proof",
        formatError(new AggregateError(
          [operationError, cleanupError], "verification cleanup failed",
        )),
      );
    }
    throw new StageError(5, "artifact proof", cleanupError.message);
  }
  if (operationError) throw operationError;
}

function reprove(command) {
  const packagePath = requirePublicationTargetsAvailable(command.outputPath);
  progress(command.silent, 1, "Job setup");
  let checked;
  let request;
  let interpretation;
  let hostAssumptions;
  let priorSamples;
  let packageSources;
  let sourceSets;
  let toolPins;
  let codex;
  let codexVersion;
  let formalInterfaceVersion;
  let proofLibraryCatalog;
  try {
    checked = validatePackage(command.packagePath);
    formalInterfaceVersion = checked.manifest.schemaVersion >= 6 ? 2 : 1;
    request = fs.readFileSync(path.join(command.packagePath, "request.txt"), "utf8");
    interpretation = JSON.parse(fs.readFileSync(
      path.join(command.packagePath, "interpretation.json"), "utf8"));
    hostAssumptions = JSON.parse(fs.readFileSync(
      path.join(command.packagePath, "host-assumptions.json"), "utf8")).hostAssumptions;
    priorSamples = JSON.parse(fs.readFileSync(
      path.join(command.packagePath, "samples.json"), "utf8"));
    packageSources = readPackageSources(command.packagePath);
    sourceSets = reproveSourceSets(packageSources, checked.job);
    toolPins = requireReprovePins(command.packagePath);
    requireFrozenProofKitIsolation(sourceSets.frozen);
    requireKernelAudit(sourceSets.frozen, toolPins);
    validateProgramImports(checked.job, sourceSets.frozen.get(checked.job.sourceModule));
    const kitSources = proofKitSources();
    validateProofImports(checked.job, [...kitSources].map(([module, source]) => ({
      module,
      source,
    })));
    requireKernelAudit(kitSources, toolPins);
    proofLibraryCatalog = fs.readFileSync(proofKitCatalogPath, "utf8");
    codex = findCodex();
    codexVersion = parseCodexVersion(run(1, "Codex identity", [codex, "--version"]));
    const recordedCodexVersion = stageReportCodexVersion(
      checked.stageReports, "artifactProof");
    if (codexVersion === recordedCodexVersion && command.newCodexSeries) {
      throw new StageError(
        1,
        "job setup",
        `--new-codex-series requires a Codex identity change; both identities are ` +
          `${codexVersion}`,
      );
    }
    if (codexVersion !== recordedCodexVersion && !command.newCodexSeries) {
      throw new StageError(
        1,
        "job setup",
        `Codex identity differs from the frozen stage reports: expected ` +
          `${recordedCodexVersion}, found ${codexVersion || "an empty identity"}; ` +
          `use --new-codex-series to begin a new matched timing series`,
      );
    }
  } catch (error) {
    if (error instanceof StageError) throw error;
    throw new StageError(1, "job setup", error.message);
  }

  const temporaryRoot = makeTemporaryDirectory("leanexegen-reprove-");
  let operationError = null;
  let proofTaskRoot = null;
  try {
    const stage5Telemetry = createStage5Telemetry();
    progress(command.silent, 5, "Direct artifact proof",
      new Date(stage5Telemetry.stageStartedAt));
    const proofWorkspace = path.join(temporaryRoot, "proof-workspace");
    proofTaskRoot = path.join(temporaryRoot, "proof-codex");
    fs.mkdirSync(proofWorkspace);
    fs.mkdirSync(proofTaskRoot);
    createWorkspace(proofWorkspace);
    const formalSource = sourceSets.frozen.get(checked.job.formalSpecModule);
    const sourceModule = sourceSets.frozen.get(checked.job.sourceModule);
    const programSource = sourceSets.proofContext.get(checked.job.programModule);
    if (formalSource === undefined || sourceModule === undefined || programSource === undefined) {
      throw new StageError(5, "artifact proof", "proof package lacks a frozen core source");
    }
    installSources(proofWorkspace, new Map([
      [checked.job.formalSpecModule, formalSource],
      ...sourceSets.proofContext,
    ]));
    checkFormalSpecification(
      proofWorkspace, checked.job, formalSource, 5, "ReproveFormalSpecCheck",
      formalInterfaceVersion >= 2);
    const entryIndex = programExportIndex(programSource, checked.job.exportName);
    const strategies = proofStrategyBundle(programSource, entryIndex);
    if (checked.compilerAnnotations !== null) {
      strategies.compilerAnnotations = checked.compilerAnnotations;
      strategies.proofRecipes = proofRecipePlan(
        checked.compilerAnnotations,
        programSource,
        strategies.features.selectedSections.map((section) => section.id),
        annotationMatchesModule(checked.job),
      );
      const annotationMatches = annotationMatchesSource(
        checked.compilerAnnotations, checked.job, programSource);
      sourceSets.proofContext.set(annotationMatches.module, annotationMatches.source);
      installSources(proofWorkspace,
        new Map([[annotationMatches.module, annotationMatches.source]]));
    }
    const proofKnowledgeTask = formalInterfaceVersion === 2
      ? knowledgeTaskBundle(
        command.knowledgePath || defaultForestPath, checked.artifact.sha256)
      : null;
    const proofLtgTask = formalInterfaceVersion === 2
      ? null
      : ltgTaskBundle(checked.artifact.sha256);
    if (proofKnowledgeTask !== null) {
      requireKernelAudit(proofKnowledgeTask.leanSources, toolPins);
      installSources(proofWorkspace, proofKnowledgeTask.leanSources);
    }
    const proofContext = proofTaskContext(
      request, checked.job, formalSource, sourceSets.proofContext, strategies,
      formalInterfaceVersion, checked.artifact.sha256, proofLtgTask,
      proofLibraryCatalog, proofKnowledgeTask);
    const proof = runArtifactProof({
      request,
      job: checked.job,
      entryIndex,
      proofContext,
      proofRecipes: strategies.proofRecipes,
      proofWorkspace,
      proofTaskRoot,
      artifact: checked.artifact,
      wasm: path.join(command.packagePath, "program.wasm"),
      toolPins,
      telemetry: stage5Telemetry,
      codex,
      allowedKnowledgeModules: proofKnowledgeTask?.allowedModules ?? new Set(),
      knowledgeTask: proofKnowledgeTask,
    });

    progress(command.silent, 6, "Sample execution");
    const samplesToRun = priorSamples.map((sample) => ({
      input: sample.input,
      expectedOutput: sample.output,
    }));
    const fixedWasm = path.join(command.packagePath, "program.wasm");
    const sampleResult = runSamples(
      samplesToRun, checked.job.exportName, fixedWasm, toolPins);

    progress(command.silent, 7, "Publication");
    const wasmBytes = fs.readFileSync(fixedWasm);
    const allSources = new Map(sourceSets.frozen);
    if (sourceSets.proofContext.has(annotationMatchesModule(checked.job))) {
      allSources.set(
        annotationMatchesModule(checked.job),
        sourceSets.proofContext.get(annotationMatchesModule(checked.job)));
    }
    allSources.set(checked.job.behaviorModule, proof.source);
    const priorCodexVersions = stageReportCodexVersions(checked.stageReports);
    const stageReports = checked.stageReports.schemaVersion === 2 || command.newCodexSeries
      ? {
          schemaVersion: 2,
          codexVersions: {
            formalSpecification: priorCodexVersions.formalSpecification,
            leanProgram: priorCodexVersions.leanProgram,
            artifactProof: codexVersion,
          },
          maximumAttempts: maximumTaskSessions,
          tasks: {
            formalSpecification: checked.stageReports.tasks.formalSpecification,
            leanProgram: checked.stageReports.tasks.leanProgram,
            artifactProof: proof.stageReport,
          },
        }
      : {
          schemaVersion: 1,
          codexVersion,
          maximumAttempts: maximumTaskSessions,
          tasks: {
            formalSpecification: checked.stageReports.tasks.formalSpecification,
            leanProgram: checked.stageReports.tasks.leanProgram,
            artifactProof: proof.stageReport,
          },
        };
    publish(command.outputPath, packagePath, wasmBytes, (stageRoot) => {
      createPackage(stageRoot, {
        request,
        interpretation: {
          formalSpecification: interpretation.formalSpecification,
          leanProgram: interpretation.leanProgram,
          artifactProof: {
            summary: proof.outcome.summary,
            decisions: proof.outcome.decisions,
          },
        },
        artifact: checked.artifact,
        samples: sampleResult.samples,
        hostAssumptions,
        stageReports,
        proofTelemetry: proof.proofTelemetry,
        proofJournal: proof.proofJournal,
        knowledgeEvaluation: proof.knowledgeEvaluation ?? undefined,
        toolPins,
        proofLibraryCatalog,
        proofStrategies: strategies.notes,
        proofTaskFeatures: strategies.features,
        knowledgeTask: proofKnowledgeTask ?? undefined,
        compilerAnnotations: strategies.compilerAnnotations,
        proofRecipes: strategies.proofRecipes,
        wasmBytes,
        sources: allSources,
        job: checked.job,
        formalInterfaceVersion,
        formalSpecification: checked.manifest.formalSpecification,
        warnings,
      });
      const published = validatePackage(stageRoot);
      if (!published.wasm.equals(checked.wasm) ||
          JSON.stringify(published.artifact) !== JSON.stringify(checked.artifact)) {
        throw new Error("reproof changed the frozen artifact");
      }
      const publishedSources = readPackageSources(stageRoot);
      for (const [moduleName, source] of sourceSets.frozen) {
        if (publishedSources.get(moduleName) !== source) {
          throw new Error(`reproof changed frozen module ${moduleName}`);
        }
      }
    });
    const invocation = [...sampleResult.samples[0].invocation];
    invocation[2] = command.outputPath;
    progress(command.silent, 8, "Results");
    process.stdout.write(generationResult(command.silent, sampleResult.samples, invocation));
    process.stderr.write(warnings.map((warning) => `leanexegen: warning: ${warning}\n`).join(""));
  } catch (error) {
    operationError = error;
    if (proofTaskRoot !== null && error instanceof StageError && error.stage === 5 &&
        fs.existsSync(proofTaskRoot)) {
      try {
        preserveReproveFailure(packagePath, proofTaskRoot, checked.job, error);
      } catch (preservationError) {
        operationError = new StageError(
          error.stage,
          error.stageName,
          formatError(new AggregateError(
            [error, preservationError], "artifact-proof failure preservation failed",
          )),
        );
      }
    }
  }
  try {
    fs.rmSync(temporaryRoot, { recursive: true });
  } catch (cleanupError) {
    if (operationError) {
      throw new StageError(
        operationError.stage || 7,
        operationError.stageName || "cleanup",
        formatError(new AggregateError(
          [operationError, cleanupError], "reproof cleanup failed",
        )),
      );
    }
    throw new StageError(7, "publication", cleanupError.message);
  }
  if (operationError) throw operationError;
}

function annotatePackage(command) {
  if (fs.existsSync(command.outputPath)) {
    throw new StageError(4, "WASM annotations", `${command.outputPath} exists`);
  }
  let checked;
  let packageSources;
  let toolPins;
  try {
    checked = validatePackage(command.packagePath);
    packageSources = readPackageSources(command.packagePath);
    toolPins = requireReprovePins(command.packagePath);
  } catch (error) {
    if (error instanceof StageError) throw error;
    throw new StageError(4, "WASM annotations", error.message);
  }

  const temporaryRoot = makeTemporaryDirectory("leanexegen-annotate-");
  let stagedOutput = null;
  let installed = false;
  let operationError = null;
  try {
    const workspace = path.join(temporaryRoot, "workspace");
    fs.mkdirSync(workspace);
    createWorkspace(workspace);
    const source = packageSources.get(checked.job.sourceModule);
    const program = packageSources.get(checked.job.programModule);
    if (source === undefined || program === undefined) {
      throw new StageError(4, "WASM annotations", "proof package lacks Source or Program");
    }
    installSources(workspace, new Map([[checked.job.sourceModule, source]]));
    runLean(4, "LeanExe compiler build", "15m",
      ["lake", "--no-ansi", "build", "lean-wasm"]);
    runLean(4, "frozen Source build", "15m", [
      "lake", "-d", workspace, "--no-ansi", "build", checked.job.sourceModule,
    ]);
    const compiledWasm = path.join(temporaryRoot, "program.wasm");
    const compiledAnnotations = path.join(temporaryRoot, "program.annotations.json");
    runLean(4, "annotation compilation", "10m", [
      "lake", "-d", workspace, "env", compiler,
      "compile", "--module", checked.job.sourceModule, "--entry", checked.job.sourceEntry,
      "--out", compiledWasm, "--annotations", compiledAnnotations,
    ]);
    const compiledBytes = fs.readFileSync(compiledWasm);
    if (!compiledBytes.equals(checked.wasm)) {
      throw new StageError(
        4,
        "WASM annotations",
        `current compiler produced ${sha256(compiledBytes)} instead of the frozen ` +
          `${checked.artifact.sha256}`,
      );
    }
    const completeAnnotations = validateAnnotationDocument(JSON.parse(
      fs.readFileSync(compiledAnnotations, "utf8")), checked.wasm);
    const compilerAnnotations = selectAnnotationRegions(
      completeAnnotations, command.selectedRegions);
    validateAnnotationDocument(compilerAnnotations, checked.wasm);
    const entryIndex = programExportIndex(program, checked.job.exportName);
    const strategies = proofStrategyBundle(program, entryIndex);
    const proofRecipes = proofRecipePlan(
      compilerAnnotations,
      program,
      strategies.features.selectedSections.map((section) => section.id),
      annotationMatchesModule(checked.job),
    );
    const annotationMatches = annotationMatchesSource(
      compilerAnnotations, checked.job, program);
    packageSources.set(annotationMatches.module, annotationMatches.source);
    installSources(workspace, new Map([
      [checked.job.programModule, program],
      [annotationMatches.module, annotationMatches.source],
    ]));
    runLean(4, "checked annotation regions", "15m", [
      "lake", "-d", workspace, "--no-ansi", "build", annotationMatches.module,
    ]);
    const request = fs.readFileSync(path.join(command.packagePath, "request.txt"), "utf8");
    const interpretation = JSON.parse(fs.readFileSync(
      path.join(command.packagePath, "interpretation.json"), "utf8"));
    const samples = JSON.parse(fs.readFileSync(
      path.join(command.packagePath, "samples.json"), "utf8"));
    const hostAssumptions = JSON.parse(fs.readFileSync(
      path.join(command.packagePath, "host-assumptions.json"), "utf8")).hostAssumptions;
    const proofLibraryCatalog = fs.readFileSync(proofKitCatalogPath, "utf8");
    fs.mkdirSync(path.dirname(command.outputPath), { recursive: true });
    stagedOutput = path.join(
      path.dirname(command.outputPath),
      `.${path.basename(command.outputPath)}.${process.pid}-${Date.now()}`,
    );
    createPackage(stagedOutput, {
      request,
      interpretation,
      artifact: checked.artifact,
      samples,
      hostAssumptions,
      stageReports: checked.stageReports,
      proofTelemetry: checked.proofTelemetry === null ? undefined : checked.proofTelemetry,
      proofJournal: checked.proofJournal === null ? undefined : checked.proofJournal,
      knowledgeEvaluation: checked.knowledgeEvaluation ?? undefined,
      toolPins,
      proofLibraryCatalog,
      proofStrategies: strategies.notes,
      proofTaskFeatures: strategies.features,
      ltgTask: checked.knowledgeTask === null ? checked.ltgTask ?? undefined : undefined,
      knowledgeTask: checked.knowledgeTask ?? undefined,
      compilerAnnotations,
      proofRecipes,
      wasmBytes: checked.wasm,
      sources: packageSources,
      job: checked.job,
      formalInterfaceVersion: checked.manifest.schemaVersion >= 6 ? 2 : 1,
      formalSpecification: checked.manifest.formalSpecification,
      warnings: checked.manifest.warnings,
    });
    validatePackage(stagedOutput);
    fs.renameSync(stagedOutput, command.outputPath);
    installed = true;
    process.stdout.write(
      `Annotated ${checked.artifact.sha256} in ${command.outputPath}\n`,
    );
  } catch (error) {
    operationError = error;
  }
  const cleanupErrors = [];
  if (stagedOutput !== null && !installed) {
    try {
      fs.rmSync(stagedOutput, { recursive: true, force: true });
    } catch (error) {
      cleanupErrors.push(error);
    }
  }
  try {
    fs.rmSync(temporaryRoot, { recursive: true });
  } catch (error) {
    cleanupErrors.push(error);
  }
  if (operationError !== null || cleanupErrors.length > 0) {
    const errors = operationError === null ? cleanupErrors : [operationError, ...cleanupErrors];
    throw new StageError(
      4,
      "WASM annotations",
      formatError(new AggregateError(errors, "annotation package creation failed")),
    );
  }
}

function selectAnnotationRegions(document, selectedRegions) {
  if (selectedRegions.length === 0) return document;
  const counts = new Map();
  for (const function_ of document.functions) {
    for (const region of function_.regions) {
      counts.set(region.id, (counts.get(region.id) || 0) + 1);
    }
  }
  for (const regionId of selectedRegions) {
    const count = counts.get(regionId) || 0;
    if (count === 0) throw new Error(`annotation region does not exist: ${regionId}`);
    if (count !== 1) throw new Error(`annotation region is ambiguous: ${regionId}`);
  }
  const selected = new Set(selectedRegions);
  for (const function_ of document.functions) {
    for (const region of function_.regions) {
      if (region.kind === "leanexe.call.direct.v1") selected.add(region.id);
    }
  }
  const result = structuredClone(document);
  for (const function_ of result.functions) {
    function_.regions = function_.regions.filter((region) => selected.has(region.id));
  }
  return result;
}

function coreKnowledgeCategories() {
  return JSON.parse(fs.readFileSync(path.join(repoRoot, "ltg", "categories.json"), "utf8"));
}

function learningEntryId(checked, prefix) {
  const proofSha256 = checked.stageReports.tasks.artifactProof.sourceSha256;
  return `${prefix}-${checked.artifact.sha256.slice(0, 12)}-${proofSha256.slice(0, 12)}`;
}

function learningEvidence(packagePath, checked, entryId, mode, extra = new Map()) {
  const evidence = new Map();
  const addPackageFile = (sourceName, destinationName) => {
    const source = path.join(packagePath, sourceName);
    if (!fs.existsSync(source)) return;
    const stat = fs.lstatSync(source);
    if (!stat.isFile() || stat.isSymbolicLink()) {
      throw new Error(`${sourceName} is not a regular proof-package file`);
    }
    evidence.set(`evidence/${destinationName}`, {
      source: fs.readFileSync(source),
      entries: [entryId],
    });
  };
  for (const [source, destination] of [
    ["proof-journal.md", "proof-journal.md"],
    ["proof-telemetry.json", "proof-telemetry.json"],
    ["proof-task-features.json", "proof-task-features.json"],
    ["program.annotations.json", "program.annotations.json"],
    ["proof-recipes.json", "proof-recipes.json"],
    ["knowledge-task.json", "knowledge-task.json"],
    ["knowledge-evaluation.json", "knowledge-evaluation.json"],
    ["ltg-task.json", "ltg-task.json"],
  ]) addPackageFile(source, destination);
  const behaviorRelative = path.join(
    "proof", ...moduleFile(checked.job.behaviorModule).split("/"));
  addPackageFile(behaviorRelative, "accepted-proof.lean");
  const record = {
    schemaVersion: 1,
    mode,
    artifactSha256: checked.artifact.sha256,
    requestSha256: checked.manifest.requestSha256,
    behaviorTheorem: checked.artifact.behaviorTheorem,
    proofSourceSha256: checked.stageReports.tasks.artifactProof.sourceSha256,
    firstAcceptedAt: checked.proofTelemetry?.firstAcceptedAt ?? null,
    stage5Milliseconds: checked.proofTelemetry?.totalMilliseconds ?? null,
    knowledgeSnapshot: checked.knowledgeTask === null ?
      checked.ltgTask === null ? null : {
        kind: "ltg",
        sha256: checked.ltgTask.manifest.sha256,
      } : {
        kind: "forest",
        sha256: checked.knowledgeTask.manifest.sha256,
        packages: checked.knowledgeTask.manifest.packages.map((package_) => ({
          id: package_.id,
          version: package_.version,
          sha256: package_.sha256,
        })),
      },
  };
  evidence.set("evidence/run.json", {
    source: Buffer.from(`${JSON.stringify(record, null, 2)}\n`),
    entries: [entryId],
  });
  for (const [relative, source] of extra) {
    evidence.set(relative, { source: Buffer.from(source), entries: [entryId] });
  }
  return evidence;
}

function learningFeatures(packagePath, checked) {
  const features = new Set(["accepted-artifact-proof", "run-derived"]);
  const featurePath = path.join(packagePath, "proof-task-features.json");
  if (fs.existsSync(featurePath)) {
    const document = JSON.parse(fs.readFileSync(featurePath, "utf8"));
    for (const section of document.selectedSections || []) {
      if (typeof section.id === "string") features.add(section.id.replaceAll(".", "-"));
    }
  }
  if (checked.compilerAnnotations !== null) {
    for (const function_ of checked.compilerAnnotations.functions) {
      for (const region of function_.regions) features.add(region.kind);
    }
  }
  return [...features].sort();
}

function recordKnowledge(command) {
  const checked = validatePackage(command.inputPath);
  const entryId = learningEntryId(checked, "run");
  const elapsed = checked.proofTelemetry === null
    ? "The proof package contains no Stage 5 telemetry."
    : `Stage 5 completed in ${Math.round(checked.proofTelemetry.totalMilliseconds)} milliseconds.`;
  const entry = {
    schemaVersion: 4,
    id: entryId,
    title: `Artifact-proof run ${checked.artifact.sha256.slice(0, 12)}`,
    summary: "Records one independently accepted artifact proof, its journal, selected knowledge, annotations, recipes, and telemetry.",
    roles: ["worked-example"],
    categories: ["worked-examples"],
    scope: "benchmark-local",
    evidenceStatus: "provisional",
    features: learningFeatures(command.inputPath, checked),
    annotationKinds: checked.compilerAnnotations === null ? [] : [...new Set(
      checked.compilerAnnotations.functions.flatMap((function_) =>
        function_.regions.map((region) => region.kind)))].sort(),
    modules: [],
    declarations: [],
    premises: [
      "The outer artifact check accepted the recorded behavior theorem.",
      "The run record preserves the exact artifact and proof-source digests.",
      "The journal and task inputs retain the agent's retrieval and proof-construction evidence.",
    ],
    result: elapsed,
    consumers: [],
    relatedEntries: [],
    exclusion: {
      artifactSha256: [checked.artifact.sha256],
    },
    tactics: [],
  };
  createKnowledgePackage(command.outputPath, {
    manifest: {
      schemaVersion: 1,
      id: entryId,
      version: 1,
      title: entry.title,
      summary: entry.summary,
      maturity: "experimental",
      dependencies: [],
      catalogRoot: "catalog",
      leanSources: [],
      evidence: [],
    },
    catalogReadme: `# Run-derived proof knowledge\n\n` +
      `This package records one accepted artifact-proof run.  Its entry summarizes the result, ` +
      `while the evidence directory preserves the journal, accepted proof, and task inputs.  ` +
      `The exact-artifact exclusion keeps this worked example out of a reproof of its source artifact.\n`,
    categories: coreKnowledgeCategories(),
    entries: [{
      metadata: entry,
      readme: `# ${entry.title}\n\n` +
        `${entry.summary}  ${elapsed}  The evidence files identify every retained input by the ` +
        `package manifest and its recorded digests.\n`,
    }],
    leanSources: new Map(),
    evidence: learningEvidence(command.inputPath, checked, entryId, "record"),
    dependencyForestPath: null,
  });
  process.stdout.write(`Recorded ${entryId} in ${command.outputPath}\n`);
}

function knowledgeProposalSchema(categories) {
  return {
    type: "object",
    additionalProperties: false,
    required: [
      "schemaVersion", "kind", "summary", "entryId", "title", "entrySummary",
      "scope", "categories", "features", "annotationKinds", "premises", "result",
      "guidance", "declarations", "tactics",
    ],
    properties: {
      schemaVersion: { type: "integer", enum: [1] },
      kind: {
        type: "string",
        enum: ["none", "guidance", "checked-lemma", "checked-tactic", "worked-example"],
      },
      summary: { type: "string", minLength: 1 },
      entryId: { type: "string" },
      title: { type: "string" },
      entrySummary: { type: "string" },
      scope: {
        type: "string",
        enum: ["benchmark-local", "compiler-runtime-motif", "generic-semantics"],
      },
      categories: {
        type: "array",
        items: { type: "string", enum: categories },
      },
      features: {
        type: "array",
        items: { type: "string", minLength: 1 },
      },
      annotationKinds: {
        type: "array",
        items: { type: "string", minLength: 1 },
      },
      premises: {
        type: "array",
        items: { type: "string", minLength: 1 },
      },
      result: { type: "string" },
      guidance: { type: "string" },
      declarations: {
        type: "array",
        items: { type: "string", minLength: 1 },
      },
      tactics: {
        type: "array",
        items: {
          type: "object",
          additionalProperties: false,
          required: [
            "command", "goalShape", "premises", "annotationKinds",
            "fallbackDeclaration",
          ],
          properties: {
            command: { type: "string", pattern: "^[A-Za-z][A-Za-z0-9_]*$" },
            goalShape: { type: "string", minLength: 1 },
            premises: {
              type: "array", minItems: 1,
              items: { type: "string", minLength: 1 },
            },
            annotationKinds: {
              type: "array",
              items: { type: "string", minLength: 1 },
            },
            fallbackDeclaration: { type: "string", minLength: 1 },
          },
        },
      },
    },
  };
}

function validateKnowledgeProposal(value, categoryIds, moduleName) {
  exactKeys(value, [
    "schemaVersion", "kind", "summary", "entryId", "title", "entrySummary",
    "scope", "categories", "features", "annotationKinds", "premises", "result",
    "guidance", "declarations", "tactics",
  ], "knowledge proposal");
  if (value.schemaVersion !== 1 ||
      !["none", "guidance", "checked-lemma", "checked-tactic", "worked-example"]
        .includes(value.kind)) {
    throw new Error("knowledge proposal has an invalid schema or kind");
  }
  if (typeof value.summary !== "string" || value.summary.trim().length === 0) {
    throw new Error("knowledge proposal summary is empty");
  }
  if (value.kind === "none") {
    for (const field of ["entryId", "title", "entrySummary", "result", "guidance"]) {
      if (value[field] !== "") {
        throw new Error(`declined knowledge proposal ${field} must be empty`);
      }
    }
    for (const field of [
      "categories", "features", "annotationKinds", "premises", "declarations", "tactics",
    ]) {
      if (!Array.isArray(value[field]) || value[field].length !== 0) {
        throw new Error(`declined knowledge proposal ${field} must be empty`);
      }
    }
    if (value.scope !== "benchmark-local") {
      throw new Error("declined knowledge proposal scope must be benchmark-local");
    }
    return value;
  }
  if (!/^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$/.test(value.entryId)) {
    throw new Error("knowledge proposal entry identifier is invalid");
  }
  for (const field of ["title", "entrySummary", "result", "guidance"]) {
    if (typeof value[field] !== "string" || value[field].trim().length === 0) {
      throw new Error(`knowledge proposal ${field} is empty`);
    }
  }
  if (!["benchmark-local", "compiler-runtime-motif", "generic-semantics"]
      .includes(value.scope)) {
    throw new Error("knowledge proposal scope is invalid");
  }
  const arrays = ["categories", "features", "annotationKinds", "premises", "declarations"];
  for (const field of arrays) {
    if (!Array.isArray(value[field]) || new Set(value[field]).size !== value[field].length ||
        value[field].some((item) => typeof item !== "string" || item.trim().length === 0)) {
      throw new Error(`knowledge proposal ${field} is invalid`);
    }
  }
  if (value.categories.length === 0 ||
      value.categories.some((category) => !categoryIds.has(category)) ||
      value.features.length === 0 || value.premises.length === 0 ||
      !Array.isArray(value.tactics)) {
    throw new Error("knowledge proposal has incomplete retrieval metadata");
  }
  const checked = value.kind === "checked-lemma" || value.kind === "checked-tactic";
  if (checked !== (value.declarations.length > 0) ||
      (value.kind === "checked-tactic") !== (value.tactics.length > 0) ||
      value.declarations.some((declaration) => !declaration.startsWith(`${moduleName}.`))) {
    throw new Error("knowledge proposal declarations disagree with its kind or module");
  }
  const tacticCommands = new Set();
  for (const tactic of value.tactics) {
    exactKeys(tactic, [
      "command", "goalShape", "premises", "annotationKinds", "fallbackDeclaration",
    ], "knowledge proposal tactic");
    if (!/^[A-Za-z][A-Za-z0-9_]*$/.test(tactic.command) ||
        tacticCommands.has(tactic.command) ||
        typeof tactic.goalShape !== "string" ||
        tactic.goalShape.trim().length === 0 ||
        !Array.isArray(tactic.premises) || tactic.premises.length === 0 ||
        new Set(tactic.premises).size !== tactic.premises.length ||
        tactic.premises.some((premise) =>
          typeof premise !== "string" || premise.trim().length === 0) ||
        !Array.isArray(tactic.annotationKinds) ||
        new Set(tactic.annotationKinds).size !== tactic.annotationKinds.length ||
        tactic.annotationKinds.some((kind) =>
          typeof kind !== "string" || !value.annotationKinds.includes(kind)) ||
        !value.declarations.includes(tactic.fallbackDeclaration)) {
      throw new Error("knowledge proposal tactic metadata is invalid");
    }
    tacticCommands.add(tactic.command);
  }
  return value;
}

function createDeclinedKnowledgeReport(outputPath, checked, proposal, journal) {
  if (fs.existsSync(outputPath)) throw new Error(`${outputPath} exists`);
  fs.mkdirSync(path.dirname(outputPath), { recursive: true });
  const staged = path.join(path.dirname(outputPath),
    `.${path.basename(outputPath)}.${process.pid}-${Date.now()}`);
  try {
    fs.mkdirSync(staged);
    const proposalBytes = Buffer.from(`${JSON.stringify(proposal, null, 2)}\n`);
    const journalBytes = Buffer.from(journal);
    writeAtomic(path.join(staged, "proposal.json"), proposalBytes);
    writeAtomic(path.join(staged, "learning-journal.md"), journalBytes);
    writeAtomic(path.join(staged, "learning-report.json"), Buffer.from(`${JSON.stringify({
      schemaVersion: 1,
      outcome: "no-entry",
      summary: proposal.summary.trim(),
      artifactSha256: checked.artifact.sha256,
      proofSourceSha256: checked.stageReports.tasks.artifactProof.sourceSha256,
      knowledgeSnapshotSha256: checked.knowledgeTask?.manifest.sha256 ??
        checked.ltgTask?.manifest.sha256 ?? null,
      files: [
        {
          path: "learning-journal.md",
          sha256: sha256(journalBytes),
          byteLength: journalBytes.length,
        },
        {
          path: "proposal.json",
          sha256: sha256(proposalBytes),
          byteLength: proposalBytes.length,
        },
      ],
    }, null, 2)}\n`));
    fs.renameSync(staged, outputPath);
  } catch (error) {
    try {
      fs.rmSync(staged, { recursive: true, force: true });
    } catch (cleanupError) {
      throw new AggregateError([error, cleanupError], `could not create ${outputPath}`);
    }
    throw error;
  }
}

function proposeKnowledge(command) {
  const checked = validatePackage(command.inputPath);
  const packageId = learningEntryId(checked, "proposal");
  const moduleName = `LeanExeGen.Knowledge.${packagePascalName(packageId)}.Proposed`;
  const candidate = moduleFile(moduleName);
  const temporaryRoot = makeTemporaryDirectory("leanexegen-learn-");
  let operationError = null;
  try {
    createWorkspace(temporaryRoot);
    const evidence = learningEvidence(
      command.inputPath, checked, packageId, "propose");
    for (const [relative, record] of evidence) {
      writeAtomic(path.join(temporaryRoot, "RUN", ...relative.split("/")),
        Buffer.from(record.source));
    }
    for (const directory of ["knowledge", "ltg"]) {
      const sourceRoot = path.join(command.inputPath, directory);
      if (!fs.existsSync(sourceRoot)) continue;
      for (const relative of collectFiles(sourceRoot)) {
        writeAtomic(path.join(temporaryRoot, "RUN", directory, ...relative.split("/")),
          fs.readFileSync(path.join(sourceRoot, ...relative.split("/"))));
      }
    }
    for (const [proofModule, source] of proofKitSources()) {
      writeAtomic(path.join(temporaryRoot, "PROOF_KIT_SOURCE", moduleFile(proofModule)),
        Buffer.from(source));
    }
    writeAtomic(path.join(temporaryRoot, "LEARNING_JOURNAL.md"),
      Buffer.from("# Learning Journal\n\n"));
    const categories = coreKnowledgeCategories();
    const categoryIds = categories.categories.map((category) => category.id);
    const schemaPath = path.join(temporaryRoot, ".leanexegen-learning-schema.json");
    const outputPath = path.join(temporaryRoot, ".leanexegen-learning-outcome.json");
    writeAtomic(schemaPath,
      Buffer.from(`${JSON.stringify(knowledgeProposalSchema(categoryIds), null, 2)}\n`));
    const codex = command.codex || findCodex();
    const commandArgs = [
      leanrun, "--timeout", "90m",
      ...codexCommandArgs(codex, temporaryRoot, schemaPath, outputPath),
    ];
    const build = formatCommand([
      leanrun, "--timeout", "15m", "lake", "-d", ".", "--no-ansi", "build", moduleName,
    ]);
    const prompt = `Study the accepted artifact-proof run under RUN and decide whether it supports ` +
      `one knowledge entry that can help a later artifact proof.  Read the proof journal, accepted ` +
      `proof, annotations, recipes, telemetry, task features, and archived knowledge that are ` +
      `present.  Search the archived package indexes, inspect relevant entry bodies, and inspect ` +
      `ProofKit source and compiler recipes before selecting a candidate.  Compare each candidate ` +
      `with the closest ` +
      `existing theorem, tactic, guidance, and exact compiler composition.  Prefer a small checked ` +
      `theorem that composes existing checked results across a repeated missing proof boundary.  ` +
      `Return kind none when existing support covers every observed boundary or the evidence ` +
      `supports no useful entry.  For kind none, provide the reason in summary, use benchmark-local ` +
      `scope, and leave entryId, title, entrySummary, result, guidance, and every array empty.  Keep ` +
      `LEARNING_JOURNAL.md as frequent prose recording what you examined, what appears general, ` +
      `what appears artifact-specific, and why you selected or rejected each candidate.  Choose ` +
      `guidance or a worked example when the evidence supports prose only.  Choose checked-lemma ` +
      `or checked-tactic when a small general Lean result follows from the supplied ProofKit.  For ` +
      `checked Lean, write the complete module ${candidate}, declare namespace ${moduleName}, ` +
      `inspect proof sources only under PROOF_KIT_SOURCE, and run this command after each edit:\n\n` +
      `${build}\n\nUse only ProofKit, CodeLib, Interpreter, Init, Std, or Mathlib imports.  A ` +
      `checked tactic must include a checked fallback declaration in the same module.  Update the ` +
      `journal after every Lean result and before changing approach.  Return one JSON object ` +
      `matching the output schema.  Put fully qualified declarations under ${moduleName}; leave ` +
      `declarations and tactics empty for prose-only entries.`;
    const execute = command.execute || ((args, options) =>
      run(9, "knowledge proposal Codex task", args, options));
    execute(commandArgs, {
      cwd: temporaryRoot,
      input: prompt,
      timeout: 91 * 60 * 1000,
      maxBuffer: 64 * 1024 * 1024,
    });
    const proposal = validateKnowledgeProposal(
      JSON.parse(fs.readFileSync(outputPath, "utf8")), new Set(categoryIds), moduleName);
    const journal = validateProofJournal(
      fs.readFileSync(path.join(temporaryRoot, "LEARNING_JOURNAL.md"), "utf8"),
      "LEARNING_JOURNAL.md");
    if (proposal.kind === "none") {
      createDeclinedKnowledgeReport(command.outputPath, checked, proposal, journal);
      process.stdout.write(`Recorded no-entry assessment in ${command.outputPath}\n`);
    } else {
      const checkedSource = proposal.kind === "checked-lemma" ||
        proposal.kind === "checked-tactic";
      const leanSources = new Map();
      if (checkedSource) {
        const sourcePath = path.join(temporaryRoot, candidate);
        const stat = fs.lstatSync(sourcePath);
        if (!stat.isFile() || stat.isSymbolicLink()) {
          throw new Error(`${candidate} is not a regular file`);
        }
        const source = fs.readFileSync(sourcePath, "utf8");
        validateProofImports({ namespace: moduleName, sourceModule: "" }, [
          { module: moduleName, source },
        ]);
        requireKernelAudit(new Map([[moduleName, source]]), currentToolPins(repoRoot));
        runLean(9, "knowledge proposal Lean check", "15m", [
          "lake", "-d", temporaryRoot, "--no-ansi", "build", moduleName,
        ]);
        leanSources.set(moduleName, source);
      }
      const roles = proposal.kind === "checked-tactic"
        ? ["checked-proof-asset", "guidance", "proof-generation-mechanism"]
        : proposal.kind === "checked-lemma"
          ? ["checked-proof-asset", "guidance"]
          : proposal.kind === "worked-example" ? ["worked-example"] : ["guidance"];
      const metadata = {
        schemaVersion: 4,
        id: proposal.entryId,
        title: proposal.title,
        summary: proposal.entrySummary,
        roles,
        categories: [...proposal.categories].sort(),
        scope: proposal.scope,
        evidenceStatus: "provisional",
        features: [...proposal.features].sort(),
        annotationKinds: [...proposal.annotationKinds].sort(),
        modules: checkedSource ? [moduleName] : [],
        declarations: [...proposal.declarations].sort(),
        premises: proposal.premises,
        result: proposal.result,
        consumers: [],
        relatedEntries: [],
        exclusion: {
          artifactSha256: [checked.artifact.sha256],
        },
        tactics: proposal.tactics.map((tactic) => ({
          command: tactic.command,
          module: moduleName,
          goalShape: tactic.goalShape,
          premises: tactic.premises,
          annotationKinds: [...tactic.annotationKinds].sort(),
          fallbackDeclaration: tactic.fallbackDeclaration,
        })).sort((left, right) => left.command.localeCompare(right.command)),
      };
      for (const record of evidence.values()) record.entries = [metadata.id];
      evidence.set("evidence/proposal.json", {
        source: Buffer.from(`${JSON.stringify(proposal, null, 2)}\n`),
        entries: [metadata.id],
      });
      evidence.set("evidence/learning-journal.md", {
        source: Buffer.from(journal),
        entries: [metadata.id],
      });
      createKnowledgePackage(command.outputPath, {
        manifest: {
          schemaVersion: 1,
          id: packageId,
          version: 1,
          title: proposal.title,
          summary: proposal.summary,
          maturity: "experimental",
          dependencies: [],
          catalogRoot: "catalog",
          leanSources: [],
          evidence: [],
        },
        catalogReadme: `# Proposed proof knowledge\n\n` +
          `This package contains one run-derived proposal.  Its catalog entry records the proposed ` +
          `use and its evidence directory preserves the source run and learning journal.  ` +
          `The package remains experimental until an explicit promotion creates a new snapshot.\n`,
        categories,
        entries: [{
          metadata,
          readme: `# ${proposal.title}\n\n${proposal.guidance.trim()}\n`,
        }],
        leanSources,
        evidence,
        dependencyForestPath: null,
      });
      process.stdout.write(`Proposed ${metadata.id} in ${command.outputPath}\n`);
    }
  } catch (error) {
    operationError = error;
  }
  try {
    fs.rmSync(temporaryRoot, { recursive: true });
  } catch (cleanupError) {
    operationError = operationError === null ? cleanupError :
      new AggregateError([operationError, cleanupError], "learning cleanup failed");
  }
  if (operationError !== null) throw operationError;
}

function checkPromotedKnowledgeSources(forest, packageId) {
  const promoted = forest.packages.find((package_) => package_.id === packageId);
  const modules = [...new Set(promoted.catalog.entries.flatMap((entry) =>
    entry.modules))].sort();
  const declarations = [...new Set(promoted.catalog.entries.flatMap((entry) =>
    entry.declarations))].sort();
  if (promoted.sourceModules.size === 0 && declarations.length === 0) return;
  const workspace = makeTemporaryDirectory("leanexegen-promote-");
  let operationError = null;
  try {
    createWorkspace(workspace);
    const sources = new Map(forest.packages.flatMap((package_) =>
      [...package_.sourceModules]));
    const checkModule =
      `LeanExeGen.Knowledge.${packagePascalName(packageId)}.CatalogCheck`;
    if (sources.has(checkModule)) {
      throw new Error(`${packageId} reserves ${checkModule} for its promotion check`);
    }
    sources.set(checkModule,
      `${modules.map((moduleName) => `import ${moduleName}`).join("\n")}\n\n` +
      `${declarations.map((declaration) => `#check ${declaration}`).join("\n")}\n`);
    requireKernelAudit(sources, currentToolPins(repoRoot));
    installSources(workspace, sources);
    for (const moduleName of promoted.sourceModules.keys()) {
      runLean(9, `promoted knowledge module ${moduleName}`, "15m", [
        "lake", "-d", workspace, "--no-ansi", "build", moduleName,
      ]);
    }
    runLean(9, `promoted knowledge catalog ${packageId}`, "15m", [
      "lake", "-d", workspace, "--no-ansi", "build", checkModule,
    ]);
  } catch (error) {
    operationError = error;
  }
  try {
    fs.rmSync(workspace, { recursive: true });
  } catch (cleanupError) {
    operationError = operationError === null ? cleanupError :
      new AggregateError([operationError, cleanupError], "promotion check cleanup failed");
  }
  if (operationError !== null) throw operationError;
}

function promoteKnowledge(command) {
  if (fs.existsSync(command.outputPath)) throw new Error(`${command.outputPath} exists`);
  const forest = loadForest(command.forestPath);
  const candidate = readPackageDescriptor(command.inputPath);
  if (candidate.maturity !== "experimental") {
    throw new Error(`${candidate.id} is not an experimental knowledge package`);
  }
  if (forest.packages.some((package_) => package_.id === candidate.id)) {
    throw new Error(`knowledge forest already contains ${candidate.id}`);
  }
  const available = new Set(forest.packages.map((package_) => package_.id));
  if (candidate.dependencies.some((dependency) => !available.has(dependency))) {
    throw new Error(`${candidate.id} has a dependency absent from the selected forest`);
  }
  fs.mkdirSync(path.dirname(command.outputPath), { recursive: true });
  const staged = path.join(path.dirname(command.outputPath),
    `.${path.basename(command.outputPath)}.${process.pid}-${Date.now()}`);
  try {
    fs.mkdirSync(path.join(staged, "packages"), { recursive: true });
    for (const package_ of forest.packages) {
      fs.cpSync(package_.root, path.join(staged, "packages", package_.id), {
        recursive: true,
        errorOnExist: true,
      });
    }
    const promotedRoot = path.join(staged, "packages", candidate.id);
    fs.cpSync(command.inputPath, promotedRoot, { recursive: true, errorOnExist: true });
    const promotedManifestPath = path.join(promotedRoot, "knowledge-package.json");
    const promotedManifest = JSON.parse(fs.readFileSync(promotedManifestPath, "utf8"));
    promotedManifest.version += 1;
    promotedManifest.maturity = "promoted";
    writeAtomic(promotedManifestPath,
      Buffer.from(`${JSON.stringify(promotedManifest, null, 2)}\n`));
    const mounts = forest.packages.map((package_) => ({
      id: package_.id,
      path: `packages/${package_.id}`,
    }));
    mounts.push({ id: candidate.id, path: `packages/${candidate.id}` });
    mounts.sort((left, right) => left.id.localeCompare(right.id));
    writeAtomic(path.join(staged, "forest.json"), Buffer.from(`${JSON.stringify({
      schemaVersion: 1,
      packages: mounts,
    }, null, 2)}\n`));
    const promotedForest = loadForest(path.join(staged, "forest.json"));
    checkPromotedKnowledgeSources(promotedForest, candidate.id);
    fs.renameSync(staged, command.outputPath);
  } catch (error) {
    try {
      fs.rmSync(staged, { recursive: true, force: true });
    } catch (cleanupError) {
      throw new AggregateError([error, cleanupError], "knowledge promotion failed");
    }
    throw error;
  }
  process.stdout.write(
    `Promoted ${candidate.id} in ${path.join(command.outputPath, "forest.json")}\n`,
  );
}

function learn(command) {
  try {
    if (command.mode === "record") recordKnowledge(command);
    else if (command.mode === "propose") proposeKnowledge(command);
    else promoteKnowledge(command);
  } catch (error) {
    throw new LearningError(command.mode, formatError(error));
  }
}

function benchmark(command) {
  const definition = checkBenchmark(command.benchmarkRoot);
  const reference = definition.runs.find((run) => run.id === definition.referenceRun);
  const referencePackage = path.join(
    command.benchmarkRoot, reference.path, "program.proof");
  reprove({
    command: "reprove",
    silent: false,
    outputPath: command.outputPath,
    packagePath: referencePackage,
  });
  const packagePath = proofPackagePath(command.outputPath);
  comparePackage(command.benchmarkRoot, packagePath);
  verify({ command: "verify", silent: false, packagePath });
}

function generate(command) {
  const packagePath = requirePublicationTargetsAvailable(command.outputPath);
  progress(command.silent, 1, "Job setup");
  const request = readRequest(command.requestPath);
  const job = makeJob(request);
  const codex = findCodex();
  const codexVersion = parseCodexVersion(run(1, "Codex identity", [codex, "--version"]));
  let toolPins;
  try {
    toolPins = currentToolPins(repoRoot);
  } catch (error) {
    if (error instanceof StageError) throw error;
    throw new StageError(5, "artifact proof", error.message);
  }
  const proofLibraryCatalog = fs.readFileSync(proofKitCatalogPath, "utf8");
  const kitSources = proofKitSources();
  validateProofImports(job, [...kitSources].map(([module, source]) => ({ module, source })));
  requireKernelAudit(kitSources, toolPins);

  const temporaryRoot = makeTemporaryDirectory("leanexegen-");
  let operationError = null;
  try {
    progress(command.silent, 2, "Formal specification");
    const formalWorkspace = path.join(temporaryRoot, "formal-workspace");
    const formalTaskRoot = path.join(temporaryRoot, "formal-codex");
    fs.mkdirSync(formalWorkspace);
    fs.mkdirSync(formalTaskRoot);
    createWorkspace(formalWorkspace);
    const formalContext = formalTaskContext(request, job);
    const formal = runTaskSession({
      task: "formal-specification",
      stage: 2,
      stageName: "formal specification",
      sourceModule: job.formalSpecModule,
      invoke: (prompt) => runCodexOutcome({
        codex,
        task: "formal-specification",
        stage: 2,
        taskRoot: formalTaskRoot,
        contextFiles: formalContext,
        candidateFile: moduleFile(job.formalSpecModule),
        timeout: 45 * 60 * 1000,
        prompt,
      }),
      prompt: formalPrompt(request, job),
      materialize: (source) => formalSpecificationSource(job, source),
      diagnose: (source) => {
        validateProofImports(job, [{ module: job.formalSpecModule, source }]);
        requireKernelAudit(new Map([[job.formalSpecModule, source]]), toolPins);
        return checkFormalSpecification(
          formalWorkspace, job, source, 2, "FormalSpecCheck");
      },
    });
    removeTaskWorkspace(formalWorkspace, 2, "formal specification");
    removeTaskWorkspace(formalTaskRoot, 2, "formal specification");

    progress(command.silent, 3, "Lean program");
    const programWorkspace = path.join(temporaryRoot, "program-workspace");
    const programTaskRoot = path.join(temporaryRoot, "program-codex");
    fs.mkdirSync(programWorkspace);
    fs.mkdirSync(programTaskRoot);
    createWorkspace(programWorkspace);
    runLean(3, "LeanExe compiler build", "15m",
      ["lake", "--no-ansi", "build", "lean-wasm"]);
    const programContext = programTaskContext(request, job, formal.source);
    const programTask = runTaskSession({
      task: "lean-program",
      stage: 3,
      stageName: "Lean program",
      sourceModule: job.sourceModule,
      invoke: (prompt) => runCodexOutcome({
        codex,
        task: "lean-program",
        stage: 3,
        taskRoot: programTaskRoot,
        contextFiles: programContext,
        candidateFile: moduleFile(job.sourceModule),
        timeout: 60 * 60 * 1000,
        prompt,
      }),
      prompt: programPrompt(request, job),
      materialize: (source) => source,
      diagnose: (source) => {
        validateProgramImports(job, source);
        requireKernelAudit(new Map([[job.sourceModule, source]]), toolPins);
        return checkProgramCandidate(programWorkspace, job, source);
      },
    });

    progress(command.silent, 4, "WASM compilation and freezing");
    const compiledWasm = path.join(programWorkspace, "program.wasm");
    const compiledWat = path.join(programWorkspace, "program.wat");
    const compiledAnnotations = path.join(programWorkspace, "program.annotations.json");
    runLean(4, "WASM compilation", "10m", [
      "lake", "-d", programWorkspace, "env", compiler,
      "compile", "--module", job.sourceModule, "--entry", job.sourceEntry,
      "--out", compiledWasm, "--annotations", compiledAnnotations,
    ]);
    const wasmTools = findWasmTools();
    run(4, "wasm-tools version", [path.join(repoRoot, "tools", "check-wasm-tools-version.sh")], {
      env: { ...process.env, WASM_TOOLS: wasmTools },
    });
    run(4, "WAT rendering", [wasmTools, "print", compiledWasm, "-o", compiledWat]);
    const artifactRoot = path.join(temporaryRoot, "frozen-artifact");
    fs.mkdirSync(artifactRoot);
    const wasm = path.join(artifactRoot, "program.wasm");
    const wat = path.join(artifactRoot, "program.wat");
    const annotationsPath = path.join(artifactRoot, "program.annotations.json");
    fs.copyFileSync(compiledWasm, wasm, fs.constants.COPYFILE_EXCL);
    fs.copyFileSync(compiledWat, wat, fs.constants.COPYFILE_EXCL);
    fs.copyFileSync(compiledAnnotations, annotationsPath, fs.constants.COPYFILE_EXCL);
    const wasmBytes = fs.readFileSync(wasm);
    const compilerAnnotations = validateAnnotationDocument(
      JSON.parse(fs.readFileSync(annotationsPath, "utf8")), wasmBytes);
    removeTaskWorkspace(programWorkspace, 4, "WASM compilation");
    removeTaskWorkspace(programTaskRoot, 4, "WASM compilation");

    const stage5Telemetry = createStage5Telemetry();
    progress(command.silent, 5, "Direct artifact proof",
      new Date(stage5Telemetry.stageStartedAt));
    requireMaterializedPins(toolPins);
    const proofWorkspace = path.join(temporaryRoot, "proof-workspace");
    const proofTaskRoot = path.join(temporaryRoot, "proof-codex");
    const talosRoot = path.join(temporaryRoot, "talos");
    fs.mkdirSync(proofWorkspace);
    fs.mkdirSync(proofTaskRoot);
    fs.mkdirSync(talosRoot);
    createWorkspace(proofWorkspace);
    const talosProgram = emitTalosProgram(job, wasm, wat, talosRoot);
    const entryIndex = programExportIndex(talosProgram, job.exportName);
    const strategies = proofStrategyBundle(talosProgram, entryIndex);
    strategies.compilerAnnotations = compilerAnnotations;
    strategies.proofRecipes = proofRecipePlan(
      compilerAnnotations,
      talosProgram,
      strategies.features.selectedSections.map((section) => section.id),
      annotationMatchesModule(job),
    );
    const raw = dumpRawModule(wasm);
    const generated = artifactSources(job, wasmBytes, raw, talosProgram);
    const annotationMatches = annotationMatchesSource(compilerAnnotations, job, talosProgram);
    generated.sources.set(annotationMatches.module, annotationMatches.source);
    requireKernelAudit(generated.sources, toolPins);
    installSources(proofWorkspace, new Map([
      [job.formalSpecModule, formal.source],
      ...generated.sources,
    ]));
    checkFormalSpecification(
      proofWorkspace, job, formal.source, 5, "ProofFormalSpecCheck");
    const proofKnowledgeTask = knowledgeTaskBundle(
      command.knowledgePath || defaultForestPath, generated.artifact.sha256);
    requireKernelAudit(proofKnowledgeTask.leanSources, toolPins);
    installSources(proofWorkspace, proofKnowledgeTask.leanSources);
    const proofContext = proofTaskContext(
      request, job, formal.source, generated.sources, strategies, 2,
      generated.artifact.sha256, null, proofLibraryCatalog, proofKnowledgeTask);
    const proof = runArtifactProof({
      request,
      job,
      entryIndex,
      proofContext,
      proofRecipes: strategies.proofRecipes,
      proofWorkspace,
      proofTaskRoot,
      artifact: generated.artifact,
      wasm,
      toolPins,
      telemetry: stage5Telemetry,
      codex,
      allowedKnowledgeModules: proofKnowledgeTask.allowedModules,
      knowledgeTask: proofKnowledgeTask,
    });

    progress(command.silent, 6, "Sample execution");
    const sampleResult = runSamples(
      programTask.outcome.samples, job.exportName, wasm, toolPins);
    progress(command.silent, 7, "Publication");
    const allSources = new Map([
      [job.formalSpecModule, formal.source],
      [job.sourceModule, programTask.source],
      [job.behaviorModule, proof.source],
    ]);
    for (const [moduleName, source] of generated.sources) allSources.set(moduleName, source);
    const artifact = {
      ...generated.artifact,
      export: job.exportName,
      invocation: [
        path.join(repoRoot, "tools", "leanexegen"),
        "run",
        "<program.wasm>",
        "<UInt64>...",
      ],
    };
    const stageReports = {
      schemaVersion: 1,
      codexVersion,
      maximumAttempts: maximumTaskSessions,
      tasks: {
        formalSpecification: formal.stageReport,
        leanProgram: programTask.stageReport,
        artifactProof: proof.stageReport,
      },
    };
    publish(command.outputPath, packagePath, wasmBytes, (stageRoot) => {
      createPackage(stageRoot, {
        request,
        interpretation: {
          formalSpecification: {
            summary: formal.outcome.summary,
            decisions: formal.outcome.decisions,
          },
          leanProgram: {
            summary: programTask.outcome.summary,
            decisions: programTask.outcome.decisions,
          },
          artifactProof: {
            summary: proof.outcome.summary,
            decisions: proof.outcome.decisions,
          },
        },
        artifact,
        samples: sampleResult.samples,
        hostAssumptions: formal.outcome.hostAssumptions,
        stageReports,
        proofTelemetry: proof.proofTelemetry,
        proofJournal: proof.proofJournal,
        knowledgeEvaluation: proof.knowledgeEvaluation,
        toolPins,
        proofLibraryCatalog,
        proofStrategies: strategies.notes,
        proofTaskFeatures: strategies.features,
        knowledgeTask: proofKnowledgeTask,
        compilerAnnotations: strategies.compilerAnnotations,
        proofRecipes: strategies.proofRecipes,
        wasmBytes,
        sources: allSources,
        job,
        formalSpecification: {
          module: job.formalSpecModule,
          definition: job.formalSpecDefinition,
          type: job.formalSpecType,
        },
        warnings,
      });
    });
    const invocation = [...sampleResult.samples[0].invocation];
    invocation[2] = command.outputPath;
    progress(command.silent, 8, "Results");
    process.stdout.write(generationResult(command.silent, sampleResult.samples, invocation));
    process.stderr.write(warnings.map((warning) => `leanexegen: warning: ${warning}\n`).join(""));
  } catch (error) {
    operationError = error;
  }
  const cleanupErrors = [];
  try {
    fs.rmSync(temporaryRoot, { recursive: true });
  } catch (error) {
    cleanupErrors.push(error);
  }
  if (operationError && cleanupErrors.length > 0) {
    throw new StageError(
      operationError.stage || 7,
      operationError.stageName || "cleanup",
      formatError(new AggregateError(
        [operationError, ...cleanupErrors], "operation cleanup failed",
      )),
    );
  }
  if (operationError) throw operationError;
  if (cleanupErrors.length > 0) {
    throw new StageError(
      7,
      "publication",
      formatError(new AggregateError(
        cleanupErrors, "temporary-directory cleanup failed",
      )),
    );
  }
}

function runArtifact(command) {
  if (command.input.length > 256) {
    throw new StageError(6, "sample execution", "input contains more than 256 UInt64 values");
  }
  try {
    command.input.forEach((value, index) =>
      validateUInt64Decimal(value, `input[${index}]`));
  } catch (error) {
    throw new StageError(6, "sample execution", error.message);
  }
  const output = runArrayWasm(command.wasmPath, "compute", command.input);
  process.stdout.write(`${formatUInt64Array(output)}\n`);
}

function main() {
  let command;
  try {
    command = parseArgs(process.argv.slice(2));
  } catch (error) {
    process.stderr.write(`${error.message}\n`);
    process.exitCode = 64;
    return;
  }
  try {
    if (command.command === "benchmark") {
      benchmark(command);
    } else if (command.command === "learn") {
      learn(command);
    } else if (command.command === "run") runArtifact(command);
    else if (command.command === "verify") verify(command);
    else if (command.command === "reprove") reprove(command);
    else if (command.command === "annotate") annotatePackage(command);
    else generate(command);
  } catch (error) {
    if (error instanceof LearningError) {
      process.stderr.write(`leanexegen: learn ${error.mode}: ${error.message}\n`);
      process.exitCode = 1;
      return;
    }
    if (error instanceof StageError) {
      process.stderr.write(
        `leanexegen: stage ${error.stage} (${error.stageName}): ${error.message}\n`,
      );
      process.exitCode = error.stage;
      return;
    }
    process.stderr.write(`leanexegen: internal error: ${error.message}\n`);
    process.exitCode = 70;
  }
}

if (require.main === module) main();

