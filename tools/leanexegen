class StageError extends Error {
  constructor(stage, name, message) {
    super(message);
    this.stage = stage;
    this.stageName = name;
  }
}

function usage() {
  return [
    "usage: leanexegen [-s] -o <program.wasm> <request.txt>",
    "       leanexegen reprove [-s] -o <program.wasm> <proof-package>",
    "       leanexegen annotate -o <annotated-proof-package> <proof-package>",
    "       leanexegen verify [-s] <proof-package>",
    "       leanexegen benchmark -o <program.wasm> [benchmark-directory]",
    "       leanexegen run <program.wasm> [UInt64 ...]",
  ].join("\n");
}

function parseArgs(args) {
  if (args[0] === "annotate") {
    let output = null;
    const positional = [];
    for (let index = 1; index < args.length; index += 1) {
      const argument = args[index];
      if (argument === "-o") {
        index += 1;
        if (index >= args.length || output !== null) throw new Error(usage());
        output = args[index];
      } else if (argument.startsWith("-")) {
        throw new Error(usage());
      } else {
        positional.push(argument);
      }
    }
    if (output === null || positional.length !== 1) throw new Error(usage());
    return {
      command: "annotate",
      outputPath: path.resolve(output),
      packagePath: path.resolve(positional[0]),
    };
  }
  if (args[0] === "benchmark") {
    let output = null;
    const positional = [];
    for (let index = 1; index < args.length; index += 1) {
      const argument = args[index];
      if (argument === "-o") {
        index += 1;
        if (index >= args.length || output !== null) throw new Error(usage());
        output = args[index];
      } else if (argument.startsWith("-")) {
        throw new Error(usage());
      } else {
        positional.push(argument);
      }
    }
    if (output === null || positional.length > 1) throw new Error(usage());
    return {
      command: "benchmark",
      outputPath: path.resolve(output),
      benchmarkRoot: path.resolve(positional[0] || defaultBenchmark),
    };
  }
  if (args[0] === "run") {
    if (args.length < 2) throw new Error(usage());
    return {
      command: "run",
      wasmPath: path.resolve(args[1]),
      input: args.slice(2),
    };
  }
  if (args[0] === "verify") {
    let silent = false;
    const rest = [];
    for (const argument of args.slice(1)) {
      if (argument === "-s") silent = true;
      else rest.push(argument);
    }
    if (rest.length !== 1) throw new Error(usage());
    return { command: "verify", silent, packagePath: path.resolve(rest[0]) };
  }
  const reprove = args[0] === "reprove";
  let silent = false;
  let output = null;
  const positional = [];
  for (let index = reprove ? 1 : 0; index < args.length; index += 1) {
    const argument = args[index];
    if (argument === "-s") {
      silent = true;
    } else if (argument === "-o") {
      index += 1;
      if (index >= args.length || output !== null) throw new Error(usage());
      output = args[index];
    } else if (argument.startsWith("-")) {
      throw new Error(usage());
    } else {
      positional.push(argument);
    }
  }
  if (output === null || positional.length !== 1) throw new Error(usage());
  return {
    command: reprove ? "reprove" : "generate",
    silent,
    outputPath: path.resolve(output),
    [reprove ? "packagePath" : "requestPath"]: path.resolve(positional[0]),
  };
}

function stageHeading(stage, title, startedAt = new Date()) {
  return `${startedAt.toISOString()} Stage ${stage}: ${title}\n\n`;
}

function progress(silent, stage, title, startedAt = new Date()) {
  if (!silent) process.stdout.write(stageHeading(stage, title, startedAt));
}

function generationResult(silent, samples, invocation) {
  if (silent) return "";
  const sampleText = samples.map((sample) =>
    `Input: ${formatUInt64Array(sample.input)}\n` +
    `Output: ${formatUInt64Array(sample.output)}\n`).join("");
  return `${sampleText}\nRun:\n\n\`${formatCommand(invocation)}\`\n`;
}

function outputText(value) {
  if (value === undefined || value === null) return "";
  return Buffer.isBuffer(value) ? value.toString("utf8") : String(value);
}

function formatError(error) {
  if (error instanceof AggregateError) {
    return [error.message, ...error.errors.map((item) => formatError(item))].join("\n");
  }
  return error instanceof Error ? error.message : String(error);
}

function commandFailure(result) {
  const output = [outputText(result.stderr).trim(), outputText(result.stdout).trim()]
    .filter((part) => part.length > 0).join("\n");
  const termination = result.signal
    ? `terminated by ${result.signal}`
    : `exited with status ${result.status}`;
  return output.length === 0 ? termination : `${termination}:\n${output}`;
}

function parseCodexVersion(result) {
  const lines = `${outputText(result.stdout)}\n${outputText(result.stderr)}`
    .split(/\r?\n/).map((line) => line.trim()).filter((line) => line.length > 0);
  const identities = lines.filter((line) => /^codex-cli [^\s]+$/.test(line));
  if (identities.length !== 1) {
    throw new StageError(1, "job setup", "Codex returned no unique version identity");
  }
  return identities[0];
}

function run(stage, name, args, options = {}) {
  let result;
  try {
    result = spawnResult(args, {
      cwd: options.cwd || repoRoot,
      env: options.env || process.env,
      input: options.input,
      timeout: options.timeout,
      maxBuffer: options.maxBuffer || 64 * 1024 * 1024,
    });
  } catch (error) {
    throw new StageError(stage, name, error.message);
  }
  if (result.status !== 0) throw new StageError(stage, name, commandFailure(result));
  return {
    stdout: outputText(result.stdout),
    stderr: outputText(result.stderr),
  };
}

function runLean(stage, name, timeout, args, options = {}) {
  return run(stage, name, [leanrun, "--timeout", timeout, ...args], options);
}

function readRequest(file) {
  let request;
  try {
    request = fs.readFileSync(file, "utf8");
  } catch (error) {
    throw new StageError(1, "interpretation", `could not read ${file}: ${error.message}`);
  }
  if (request.trim().length === 0) {
    throw new StageError(1, "interpretation", "request file is empty");
  }
  return request;
}

function codexOutcomeSchema() {
  return {
    type: "object",
    additionalProperties: false,
    required: [
      "schemaVersion", "task", "outcome", "summary", "decisions",
      "questions", "problems", "source", "samples", "hostAssumptions",
    ],
    properties: {
      schemaVersion: { type: "integer", enum: [codexTaskSchemaVersion] },
      task: {
        type: "string",
        enum: ["formal-specification", "lean-program", "artifact-proof"],
      },
      outcome: { type: "string", enum: ["generated", "questions", "problems"] },
      summary: { type: "string", minLength: 1 },
      decisions: { type: "array", items: { type: "string", minLength: 1 } },
      questions: { type: "array", items: { type: "string", minLength: 1 } },
      problems: { type: "array", items: { type: "string", minLength: 1 } },
      source: { type: "string" },
      samples: {
        type: "array",
        items: {
          type: "object",
          additionalProperties: false,
          required: ["input", "expectedOutput"],
          properties: {
            input: {
              type: "array",
              maxItems: 256,
              items: { type: "string", pattern: "^(?:0|[1-9][0-9]*)$" },
            },
            expectedOutput: {
              type: "array",
              maxItems: 256,
              items: { type: "string", pattern: "^(?:0|[1-9][0-9]*)$" },
            },
          },
        },
      },
      hostAssumptions: { type: "array", items: { type: "string", minLength: 1 } },
    },
  };
}

function codexCommandArgs(codex, workspace, schemaFile, outputFile) {
