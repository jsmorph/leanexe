function formalTaskContext(request, job) {
  const checkTarget = `${job.namespace}.FormalSessionCheck`;
  return new Map([
    ["request.txt", request],
    [moduleFile(checkTarget), `import ${job.formalSpecModule}\n\n` +
      `#check (${job.expectedDefinition} : UInt64 → UInt64)\n`],
  ]);
}

function programTaskContext(request, job, formalSource) {
  return new Map([
    ["request.txt", request],
    [moduleFile(job.formalSpecModule), formalSource],
    [moduleFile(`${job.namespace}.SourceCheck`), `import ${job.sourceModule}\n\n` +
      `#check (${job.sourceEntry} : UInt64 → UInt64)\n`],
  ]);
}

function proofTaskContext(request, job, formalSource, generatedSources) {
  const context = new Map([
    ["request.txt", request],
    ["PROOF_LIBRARY.md", fs.readFileSync(proofKitCatalogPath, "utf8")],
    [moduleFile(job.formalSpecModule), formalSource],
    ...[...generatedSources].map(([moduleName, source]) => [moduleFile(moduleName), source]),
  ]);
  if (context.has(moduleFile(job.sourceModule))) {
    throw new StageError(5, "artifact proof", "proof task context contains Source");
  }
  return context;
}

function checkFormalSpecification(workspace, job, source, stage, suffix) {
  installSources(workspace, new Map([[job.formalSpecModule, source]]));
  const checks = formalSpecificationCheckSources(job, suffix);
  installSources(workspace, checks.sources);
  runLean(stage, "formal specification module", "15m", [
    "lake", "-d", workspace, "--no-ansi", "build", job.formalSpecModule,
  ]);
  runLean(stage, "formal specification declarations", "15m", [
    "lake", "-d", workspace, "--no-ansi", "build", checks.target,
  ]);
  return `Lean accepted ${job.expectedDefinition} : UInt64 → UInt64 and ` +
    `${job.formalSpecDefinition} : ${job.formalSpecType}.`;
}

function checkProgramCandidate(workspace, job, source) {
  installSources(workspace, new Map([
    [job.sourceModule, source],
    [`${job.namespace}.SourceCheck`, `import ${job.sourceModule}\n\n` +
      `#check (${job.sourceEntry} : UInt64 → UInt64)\n`],
  ]));
  runLean(3, "Lean source typecheck", "15m", [
    "lake", "-d", workspace, "--no-ansi", "build", `${job.namespace}.SourceCheck`,
  ]);
  runLean(3, "LeanExe acceptance", "10m", [
    "lake", "-d", workspace, "env", compiler,
    "report", "--module", job.sourceModule, "--entry", job.sourceEntry,
  ]);
  const candidate = path.join(
    workspace, `candidate-${sha256(Buffer.from(source)).slice(0, 16)}.wasm`);
  runLean(3, "LeanExe candidate compilation", "10m", [
    "lake", "-d", workspace, "env", compiler,
    "compile", "--module", job.sourceModule, "--entry", job.sourceEntry,
    "--out", candidate,
  ]);
  return `Lean and LeanExe accepted and compiled ${job.sourceEntry} : UInt64 → UInt64.`;
}

function removeTaskWorkspace(root, stage, name) {
  try {
    fs.rmSync(root, { recursive: true });
  } catch (error) {
    throw new StageError(stage, name, `could not remove isolated workspace: ${error.message}`);
  }
}

function findExecutable(name) {
  for (const directory of (process.env.PATH || "").split(path.delimiter)) {
    if (!directory) continue;
    const candidate = path.join(directory, name);
    try {
      fs.accessSync(candidate, fs.constants.X_OK);
      return candidate;
    } catch (error) {
      if (!["ENOENT", "ENOTDIR", "EACCES"].includes(error.code)) throw error;
    }
  }
  return null;
}

function findCodex() {
  const codex = findExecutable("codex");
  if (codex === null) {
    throw new StageError(1, "job setup", "the Codex CLI was not found on PATH");
  }
  return codex;
}

function findWasmTools() {
  const candidates = [
    process.env.WASM_TOOLS,
    findExecutable("wasm-tools"),
    path.join(os.homedir(), ".cargo", "bin", "wasm-tools"),
  ].filter(Boolean);
  for (const candidate of candidates) {
    try {
      fs.accessSync(candidate, fs.constants.X_OK);
      return path.resolve(candidate);
    } catch (error) {
      if (!["ENOENT", "ENOTDIR", "EACCES"].includes(error.code)) throw error;
    }
  }
  throw new StageError(4, "WASM compilation", "wasm-tools was not found");
}

function findWasmtime() {
  const candidates = [
    process.env.WASMTIME,
    findExecutable("wasmtime"),
    path.join(repoRoot, "build", "tools", "wasmtime", "current", "wasmtime"),
  ].filter(Boolean);
  for (const candidate of candidates) {
    try {
      fs.accessSync(candidate, fs.constants.X_OK);
      return path.resolve(candidate);
    } catch (error) {
      if (!["ENOENT", "ENOTDIR", "EACCES"].includes(error.code)) throw error;
    }
  }
  throw new StageError(6, "sample execution", "Wasmtime was not found");
}

function ensureVerifier() {
  try {
    fs.accessSync(verifier, fs.constants.X_OK);
    return;
  } catch (error) {
    if (!["ENOENT", "ENOTDIR", "EACCES"].includes(error.code)) throw error;
  }
  if (!fs.existsSync(path.join(verifierRoot, "lakefile.toml"))) {
    runLean(5, "Talos dependency update", "15m",
      ["lake", "-d", proofRoot, "--no-ansi", "update"]);
  }
  runLean(5, "Talos verifier build", "20m",
    ["lake", "-d", verifierRoot, "--no-ansi", "build"]);
  try {
    fs.accessSync(verifier, fs.constants.X_OK);
  } catch (error) {
    throw new StageError(5, "artifact proof", `Talos verifier is unavailable: ${error.message}`);
  }
}

function buildCrateInput(root, job, wasm, wat) {
  const crateRoot = path.join(root, "rust", job.caseName);
  const buildRoot = path.join(root, "rust", "build", job.caseName);
  fs.mkdirSync(crateRoot, { recursive: true });
  fs.mkdirSync(buildRoot, { recursive: true });
  writeAtomic(path.join(crateRoot, "Cargo.toml"), Buffer.from(
    `[package]\nname = "${job.caseName}"\nversion = "0.0.0"\nedition = "2021"\n`,
  ));
  fs.copyFileSync(wasm, path.join(buildRoot, "program.wasm"));
  fs.copyFileSync(wat, path.join(buildRoot, "program.wat"));
}

function emitTalosProgram(job, wasm, wat, temporaryRoot) {
  ensureVerifier();
  buildCrateInput(temporaryRoot, job, wasm, wat);
  runLean(5, "Talos model generation", "10m",
    [verifier, "emit", "--force-emit", job.caseName], { cwd: temporaryRoot });
  const generated = path.join(
    temporaryRoot, "lean", "Project", job.leanModule, "Program.lean",
  );
  if (!fs.existsSync(generated)) {
    throw new StageError(5, "artifact proof", `Talos did not generate ${generated}`);
  }
  return rewriteProgramNamespace(fs.readFileSync(generated, "utf8"), job);
}

function dumpRawModule(wasm) {
  const result = runLean(5, "artifact decoder", "5m", [
    "lake", "-d", proofRoot, "env", "lean", "--run", dumpRaw, wasm,
  ]);
  const raw = result.stdout.trim();
  if (!raw.startsWith("{") || !raw.endsWith("}")) {
    throw new StageError(5, "artifact proof", "artifact decoder returned invalid output");
  }
  return raw;
}

function auditAxioms(output) {
  if (/\bsorryAx\b/.test(output)) {
    throw new StageError(5, "artifact proof", "declaration audit found sorryAx");
  }
  const unexpected = new Set();
  for (const report of output.matchAll(/depends on axioms:\s*\[([^\]]*)\]/g)) {
    for (const printed of report[1].split(",").map((item) => item.trim()).filter(Boolean)) {
      const name = printed.replace(/✝+$/, "");
      if (!allowedAxioms.has(name) && !generatedDecisionAxiom.test(name)) {
        unexpected.add(printed);
      }
    }
  }
  if (unexpected.size > 0) {
    throw new StageError(
      5,
      "artifact proof",
      `declaration audit found unsupported axioms: ${[...unexpected].join(", ")}`,
    );
  }
  const reports = (output.match(/(?:depends on axioms|does not depend on any axioms)/g) || [])
    .length;
  if (reports !== 7) {
    throw new StageError(
      5,
      "artifact proof",
      `declaration audit produced ${reports} axiom reports; expected 7`,
    );
  }
}

function verificationCheckSources(job, artifact) {
  const prefix = job.namespace;
  const fileTarget = `${prefix}.VerifierCheckFile`;
  const declarationTarget = `${prefix}.VerifierCheckDeclarations`;
  const artifactNamespace = `${prefix}.Artifact`;
  return {
    fileTarget,
    declarationTarget,
    sources: new Map([
      [fileTarget, `import ${prefix}.ArtifactBytes

def main (args : List String) : IO UInt32 := do
  let [file] := args
    | IO.eprintln "usage: VerifierCheckFile <program.wasm>"
      return 2
  let found ← IO.FS.readBinFile file
  if found == ${artifact.artifactBytesDefinition} then
    IO.println s!"embedded bytes matched: {found.size} bytes"
    return 0
  IO.eprintln s!"embedded bytes differ: {file}"
  return 1
`],
      [declarationTarget, `import ${artifact.proofTarget}
import Project.Artifact.Binary.Proof.Decode
import Project.Artifact.Binary.Proof.Validate

open Wasm.Binary

example : decode ${artifact.artifactBytesDefinition} =
    .ok ${artifact.rawModuleDefinition} :=
  ${artifactNamespace}.decode_eq_cache

example : Translation.module ${artifact.rawModuleDefinition} =
    ${job.namespace}.«module» := by
  exact ${artifactNamespace}.translation_cache_eq

example :
    ∃ raw validated,
      decode ${artifact.artifactBytesDefinition} = .ok raw ∧
      validate raw = .ok validated ∧
      CoreValid raw ∧
      ${artifact.property} validated.toTalos :=
  ${artifact.artifactTheorem}

#print axioms Wasm.Binary.Proof.decode_sound
#print axioms Wasm.Binary.Proof.validate_sound
#print axioms ${artifactNamespace}.decode_eq_cache
#print axioms ${artifactNamespace}.translation_cache_eq
#print axioms ${artifactNamespace}.artifact_module_eq_cache
#print axioms ${artifact.behaviorTheorem}
#print axioms ${artifact.artifactTheorem}
`],
    ]),
  };
}

function checkProof(workspace, job, artifact, wasm, toolPins) {
  const checks = verificationCheckSources(job, artifact);
  requireKernelAudit(checks.sources, toolPins);
  installSources(workspace, checks.sources);
  runLean(5, "artifact theorem", "60m",
    ["lake", "-d", workspace, "--no-ansi", "build", artifact.proofTarget]);
  runLean(5, "embedded byte checker", "15m",
    ["lake", "-d", workspace, "--no-ansi", "build", checks.fileTarget]);
  runLean(5, "embedded byte comparison", "15m", [
    "lake", "-d", workspace, "env", "lean", "--run",
    path.join(workspace, moduleFile(checks.fileTarget)), wasm,
  ]);
  const declaration = runLean(5, "declaration audit", "15m",
    ["lake", "-d", workspace, "--no-ansi", "build", checks.declarationTarget]);
  auditAxioms(`${declaration.stdout}\n${declaration.stderr}`);
}

function shellQuote(argument) {
  if (/^[A-Za-z0-9_./:=+-]+$/.test(argument)) return argument;
  return `'${argument.replaceAll("'", `'"'"'`)}'`;
}

function formatCommand(args) {
  return args.map(shellQuote).join(" ");
}

function toWasmtimeI64(decimal) {
  const value = BigInt(decimal);
  return (value <= int64Maximum ? value : value - uint64Modulus).toString();
}

function fromWasmtimeI64(decimal) {
  if (!/^(?:0|[1-9][0-9]*|-[1-9][0-9]*)$/.test(decimal)) return null;
  const value = BigInt(decimal);
  if (value < int64Minimum || value > int64Maximum) return null;
  return (value < 0n ? value + uint64Modulus : value).toString();
}

function runSamples(samplesToRun, exportName, wasm, toolPins) {
  const wasmtime = findWasmtime();
  const version = run(6, "Wasmtime version", [wasmtime, "--version"]).stdout.trim();
  if (!version.startsWith(`wasmtime ${toolPins.wasmtimeVersion} `)) {
    throw new StageError(
      6,
      "sample execution",
      `expected Wasmtime ${toolPins.wasmtimeVersion}, found ${version}`,
    );
  }
  const samples = [];
  for (const sample of samplesToRun) {
    const invocation = [
      wasmtime,
      "run",
      "--invoke",
      exportName,
      wasm,
      ...sample.arguments.map(toWasmtimeI64),
    ];
    const result = run(6, "sample execution", invocation);
    if (result.stderr.length > 0) process.stderr.write(result.stderr);
    const rawStdout = result.stdout.trimEnd();
    const stdout = fromWasmtimeI64(rawStdout);
    if (stdout === null) {
      throw new StageError(
        6,
        "sample execution",
        `input ${sample.arguments.join(" ")} produced a non-i64 result ` +
          `${JSON.stringify(rawStdout)}`,
      );
    }
    if (stdout !== sample.expectedStdout) {
      throw new StageError(
        6,
        "sample execution",
        `input ${sample.arguments.join(" ")} produced ${JSON.stringify(stdout)}; ` +
          `expected ${JSON.stringify(sample.expectedStdout)}`,
      );
    }
    samples.push({ arguments: sample.arguments, stdout, invocation });
  }
  return { wasmtime, samples };
}

function proofPackagePath(outputPath) {
  return outputPath.endsWith(".wasm")
    ? `${outputPath.slice(0, -5)}.proof`
    : `${outputPath}.proof`;
}

function publish(outputPath, packagePath, wasmBytes, buildPackage) {
  if (fs.existsSync(outputPath)) throw new StageError(7, "publication", `${outputPath} exists`);
  if (fs.existsSync(packagePath)) throw new StageError(7, "publication", `${packagePath} exists`);
  fs.mkdirSync(path.dirname(outputPath), { recursive: true });
  fs.mkdirSync(path.dirname(packagePath), { recursive: true });
  const nonce = `${process.pid}-${Date.now()}`;
  const stagedWasm = path.join(path.dirname(outputPath), `.${path.basename(outputPath)}.${nonce}`);
  const stagedPackage = path.join(
    path.dirname(packagePath), `.${path.basename(packagePath)}.${nonce}`,
  );
  let installedPackage = false;
  let installedWasm = false;
  try {
    fs.mkdirSync(stagedPackage, { recursive: true });
    buildPackage(stagedPackage);
    fs.writeFileSync(stagedWasm, wasmBytes, { flag: "wx" });
    fs.renameSync(stagedPackage, packagePath);
    installedPackage = true;
    fs.renameSync(stagedWasm, outputPath);
    installedWasm = true;
  } catch (error) {
    const cleanupErrors = [];
    for (const target of [
      installedWasm ? outputPath : stagedWasm,
      installedPackage ? packagePath : stagedPackage,
    ]) {
      try {
        fs.rmSync(target, { recursive: true, force: true });
      } catch (cleanupError) {
        cleanupErrors.push(cleanupError);
      }
    }
    if (cleanupErrors.length > 0) {
      throw new StageError(
        7,
        "publication",
        formatError(new AggregateError(
          [error, ...cleanupErrors], "publication rollback failed",
        )),
      );
    }
    throw new StageError(7, "publication", error.message);
  }
}

function copyPackageProof(packageRoot, workspace) {
  const proof = path.join(packageRoot, "proof");
  for (const relative of collectFiles(proof)) {
    if (!relative.endsWith(".lean")) {
      throw new StageError(5, "artifact proof", `unexpected proof file: ${relative}`);
    }
    const source = path.join(proof, ...relative.split("/"));
    writeAtomic(path.join(workspace, ...relative.split("/")), fs.readFileSync(source));
  }
}

function readPackageSources(packageRoot) {
  const sources = new Map();
  const proofRootPath = path.join(packageRoot, "proof");
  for (const relative of collectFiles(proofRootPath)) {
    if (!relative.endsWith(".lean")) {
      throw new StageError(5, "artifact proof", `unexpected proof file: ${relative}`);
    }
    const moduleName = relative.slice(0, -5).split("/").join(".");
    sources.set(moduleName, fs.readFileSync(
      path.join(proofRootPath, ...relative.split("/")), "utf8"));
  }
  return sources;
}

function reproveSourceSets(sources, job) {
  const frozen = new Map(sources);
  frozen.delete(job.behaviorModule);
  const proofContext = new Map(frozen);
  proofContext.delete(job.formalSpecModule);
  proofContext.delete(job.sourceModule);
  return { frozen, proofContext };
}

function requireFrozenProofKitIsolation(sources) {
  for (const [moduleName, source] of sources) {
    const dependency = imports(source).find((imported) => proofKitModules.includes(imported));
    if (dependency !== undefined) {
      throw new StageError(
        5,
        "artifact proof",
        `frozen module ${moduleName} imports mutable proof-library module ${dependency}`,
      );
    }
  }
}

function comparableReprovePins(toolPins) {
  const comparable = structuredClone(toolPins);
  delete comparable.proofKitSourceSha256;
  return comparable;
}

function reprovePinsMatch(recorded, current) {
  return JSON.stringify(comparableReprovePins(recorded)) ===
    JSON.stringify(comparableReprovePins(current));
}

function requireReprovePins(packageRoot) {
  const recorded = JSON.parse(fs.readFileSync(path.join(packageRoot, "tool-pins.json"), "utf8"));
  const current = currentToolPins(repoRoot);
  if (!reprovePinsMatch(recorded, current)) {
    throw new StageError(
      5,
      "artifact proof",
      "tool pins other than the proof-library source differ from this checkout",
    );
  }
  requireMaterializedPins(current);
  return current;
}

function requirePins(packageRoot) {
  const recorded = JSON.parse(fs.readFileSync(path.join(packageRoot, "tool-pins.json"), "utf8"));
  const current = currentToolPins(repoRoot);
  if (JSON.stringify(recorded) !== JSON.stringify(current)) {
    throw new StageError(5, "artifact proof", "tool pins differ from this checkout");
  }
  const packagedCatalog = fs.readFileSync(path.join(packageRoot, "proof-library.md"));
  const currentCatalog = fs.readFileSync(proofKitCatalogPath);
  if (!packagedCatalog.equals(currentCatalog)) {
    throw new StageError(5, "artifact proof", "proof-library catalog differs from this checkout");
  }
  requireMaterializedPins(current);
  return current;
}

function requireMaterializedPins(toolPins) {
  if (process.versions.node !== toolPins.nodeVersion) {
    throw new StageError(
      5,
      "artifact proof",
      `Node version mismatch: expected ${toolPins.nodeVersion}, found ${process.versions.node}`,
    );
  }
  const manifest = JSON.parse(fs.readFileSync(
    path.join(proofRoot, "lake-manifest.json"), "utf8"));
  if (!Array.isArray(manifest.packages)) {
    throw new StageError(5, "artifact proof", "proof Lake manifest has no package array");
  }
  const gitPackages = manifest.packages.filter((item) => item.type === "git");
  if (gitPackages.length === 0) {
    throw new StageError(5, "artifact proof", "proof Lake manifest has no Git packages");
  }
  for (const item of gitPackages) {
    if (typeof item.name !== "string" || !/^[0-9a-f]{40}$/.test(item.rev)) {
      throw new StageError(5, "artifact proof", "proof Lake manifest has an invalid Git package");
    }
    const checkout = path.join(proofRoot, ".lake", "packages", item.name);
    const head = run(5, `${item.name} revision`, ["git", "rev-parse", "HEAD"], {
      cwd: checkout,
    }).stdout.trim();
    if (head !== item.rev) {
      throw new StageError(
        5,
        "artifact proof",
        `${item.name} revision mismatch: expected ${item.rev}, found ${head || "unavailable"}`,
      );
    }
    const changes = run(5, `${item.name} checkout`, [
      "git", "status", "--porcelain=v1", "--untracked-files=no", "--ignore-submodules=none",
    ], { cwd: checkout }).stdout.trim();
    if (changes !== "") {
      throw new StageError(
        5,
        "artifact proof",
        `${item.name} checkout has tracked changes:\n${changes}`,
      );
    }
  }
  const lean = runLean(5, "Lean identity", "2m", ["lean", "--version"]);
  const identity = `${lean.stdout}\n${lean.stderr}`;
  const version = toolPins.leanToolchain.split(":v")[1];
  if (!identity.includes(`version ${version}`) ||
      !identity.includes(`commit ${toolPins.leanCommit}`)) {
    throw new StageError(5, "artifact proof", `Lean identity mismatch: ${identity.trim()}`);
  }
}

function requireKernelAudit(sources, toolPins) {
  const findings = kernelAuditFindings(sources, toolPins.kernelReview);
  if (findings.length > 0) {
    throw new StageError(
      5,
      "artifact proof",
      `kernel scope audit found forbidden identifiers:\n${findings.join("\n")}`,
    );
  }
}

function proofKitSources() {
  return new Map(proofKitModules.map((moduleName) => [
    moduleName,
    fs.readFileSync(path.join(proofRoot, moduleFile(moduleName)), "utf8"),
  ]));
}

function verify(command) {
  progress(command.silent, 5, "Direct artifact proof");
  let checked;
  let toolPins;
  try {
    checked = validatePackage(command.packagePath);
    toolPins = requirePins(command.packagePath);
    const packageSources = readPackageSources(command.packagePath);
    requireKernelAudit(packageSources, toolPins);
    const kitSources = proofKitSources();
    validateProofImports(checked.job, [...kitSources].map(([module, source]) => ({
      module,
      source,
    })));
    requireKernelAudit(kitSources, toolPins);
  } catch (error) {
    if (error instanceof StageError) throw error;
    throw new StageError(5, "artifact proof", error.message);
  }
  const workspace = fs.mkdtempSync(path.join(os.tmpdir(), "leanexegen-verify-"));
  let operationError = null;
  try {
    createWorkspace(workspace);
    copyPackageProof(command.packagePath, workspace);
    checkFormalSpecification(
      workspace,
      checked.job,
      fs.readFileSync(path.join(
        command.packagePath, "proof", moduleFile(checked.job.formalSpecModule)), "utf8"),
      5,
      "VerifierFormalSpecCheck",
    );
    checkProof(
      workspace,
      checked.job,
      checked.artifact,
      path.join(command.packagePath, "program.wasm"),
      toolPins,
    );
    if (!command.silent) {
      process.stdout.write(
        `Verified ${checked.artifact.sha256} with theorem ${checked.artifact.artifactTheorem}\n`,
      );
    }
  } catch (error) {
    operationError = error;
  }
  try {
    fs.rmSync(workspace, { recursive: true });
  } catch (cleanupError) {
    if (operationError) {
      throw new StageError(
        5,
        "artifact proof",
        formatError(new AggregateError(
          [operationError, cleanupError], "verification cleanup failed",
        )),
      );
    }
    throw new StageError(5, "artifact proof", cleanupError.message);
  }
  if (operationError) throw operationError;
}

function reprove(command) {
  progress(command.silent, 1, "Job setup");
  let checked;
  let request;
  let interpretation;
  let hostAssumptions;
  let priorSamples;
  let packageSources;
  let sourceSets;
  let toolPins;
  let codex;
  let codexVersion;
  try {
    checked = validatePackage(command.packagePath);
    request = fs.readFileSync(path.join(command.packagePath, "request.txt"), "utf8");
    interpretation = JSON.parse(fs.readFileSync(
      path.join(command.packagePath, "interpretation.json"), "utf8"));
    hostAssumptions = JSON.parse(fs.readFileSync(
      path.join(command.packagePath, "host-assumptions.json"), "utf8")).hostAssumptions;
    priorSamples = JSON.parse(fs.readFileSync(
      path.join(command.packagePath, "samples.json"), "utf8"));
    packageSources = readPackageSources(command.packagePath);
    sourceSets = reproveSourceSets(packageSources, checked.job);
    toolPins = requireReprovePins(command.packagePath);
    requireFrozenProofKitIsolation(sourceSets.frozen);
    requireKernelAudit(sourceSets.frozen, toolPins);
    validateProgramImports(checked.job, sourceSets.frozen.get(checked.job.sourceModule));
    const kitSources = proofKitSources();
    validateProofImports(checked.job, [...kitSources].map(([module, source]) => ({
      module,
      source,
    })));
    requireKernelAudit(kitSources, toolPins);
    codex = findCodex();
    codexVersion = parseCodexVersion(run(1, "Codex identity", [codex, "--version"]));
    if (codexVersion !== checked.stageReports.codexVersion) {
      throw new StageError(
        1,
        "job setup",
        `Codex identity differs from the frozen stage reports: expected ` +
          `${checked.stageReports.codexVersion}, found ${codexVersion || "an empty identity"}`,
      );
    }
  } catch (error) {
    if (error instanceof StageError) throw error;
    throw new StageError(1, "job setup", error.message);
  }

  const temporaryRoot = fs.mkdtempSync(path.join(os.tmpdir(), "leanexegen-reprove-"));
  let operationError = null;
  try {
    progress(command.silent, 5, "Direct artifact proof");
    const proofWorkspace = path.join(temporaryRoot, "proof-workspace");
    const proofTaskRoot = path.join(temporaryRoot, "proof-codex");
    fs.mkdirSync(proofWorkspace);
    fs.mkdirSync(proofTaskRoot);
    createWorkspace(proofWorkspace);
    const formalSource = sourceSets.frozen.get(checked.job.formalSpecModule);
    const sourceModule = sourceSets.frozen.get(checked.job.sourceModule);
    const programSource = sourceSets.proofContext.get(checked.job.programModule);
    if (formalSource === undefined || sourceModule === undefined || programSource === undefined) {
      throw new StageError(5, "artifact proof", "proof package lacks a frozen core source");
    }
    installSources(proofWorkspace, new Map([
      [checked.job.formalSpecModule, formalSource],
      ...sourceSets.proofContext,
    ]));
    checkFormalSpecification(
      proofWorkspace, checked.job, formalSource, 5, "ReproveFormalSpecCheck");
    const entryIndex = programExportIndex(programSource, checked.job.exportName);
    const proofContext = proofTaskContext(
      request, checked.job, formalSource, sourceSets.proofContext);
    const proof = runTaskSession({
      task: "artifact-proof",
      stage: 5,
      stageName: "artifact proof",
      sourceModule: checked.job.behaviorModule,
      invoke: (prompt) => runCodexOutcome({
        codex,
        task: "artifact-proof",
        stage: 5,
        taskRoot: proofTaskRoot,
        contextFiles: proofContext,
        candidateFile: moduleFile(checked.job.behaviorModule),
        timeout: 2 * 60 * 60 * 1000,
        prompt,
      }),
      prompt: proofPrompt(request, checked.job, entryIndex),
      materialize: (source) => source,
      diagnose: (source) => {
        validateProofImports(checked.job, [{
          module: checked.job.behaviorModule,
          source,
        }]);
        requireKernelAudit(new Map([[checked.job.behaviorModule, source]]), toolPins);
        installSources(proofWorkspace, new Map([[checked.job.behaviorModule, source]]));
        checkProof(
          proofWorkspace,
          checked.job,
          checked.artifact,
          path.join(command.packagePath, "program.wasm"),
          toolPins,
        );
        return `Lean accepted ${checked.job.behaviorTheorem} and ` +
          `${checked.artifact.artifactTheorem}.`;
      },
    });

    progress(command.silent, 6, "Sample execution");
    const samplesToRun = priorSamples.map((sample) => ({
      arguments: sample.arguments,
      expectedStdout: sample.stdout,
    }));
    const fixedWasm = path.join(command.packagePath, "program.wasm");
    const sampleResult = runSamples(
      samplesToRun, checked.job.exportName, fixedWasm, toolPins);

    progress(command.silent, 7, "Publication");
    const packagePath = proofPackagePath(command.outputPath);
    const wasmBytes = fs.readFileSync(fixedWasm);
    const allSources = new Map(sourceSets.frozen);
    allSources.set(checked.job.behaviorModule, proof.source);
    const stageReports = {
      schemaVersion: 1,
      codexVersion,
      maximumAttempts: maximumTaskSessions,
      tasks: {
        formalSpecification: checked.stageReports.tasks.formalSpecification,
        leanProgram: checked.stageReports.tasks.leanProgram,
        artifactProof: proof.stageReport,
      },
    };
    const proofLibraryCatalog = fs.readFileSync(proofKitCatalogPath, "utf8");
    publish(command.outputPath, packagePath, wasmBytes, (stageRoot) => {
      createPackage(stageRoot, {
        request,
        interpretation: {
          formalSpecification: interpretation.formalSpecification,
          leanProgram: interpretation.leanProgram,
          artifactProof: {
            summary: proof.outcome.summary,
            decisions: proof.outcome.decisions,
          },
        },
        artifact: checked.artifact,
        samples: sampleResult.samples,
        hostAssumptions,
        stageReports,
        toolPins,
        proofLibraryCatalog,
        wasmBytes,
        sources: allSources,
        job: checked.job,
        formalSpecification: checked.manifest.formalSpecification,
        warnings,
      });
      const published = validatePackage(stageRoot);
      if (!published.wasm.equals(checked.wasm) ||
          JSON.stringify(published.artifact) !== JSON.stringify(checked.artifact)) {
        throw new Error("reproof changed the frozen artifact");
      }
      const publishedSources = readPackageSources(stageRoot);
      for (const [moduleName, source] of sourceSets.frozen) {
        if (publishedSources.get(moduleName) !== source) {
          throw new Error(`reproof changed frozen module ${moduleName}`);
        }
      }
    });
    const invocation = [...sampleResult.samples[0].invocation];
    invocation[4] = command.outputPath;
    progress(command.silent, 8, "Results");
    process.stdout.write(generationResult(command.silent, sampleResult.samples, invocation));
    process.stderr.write(warnings.map((warning) => `leanexegen: warning: ${warning}\n`).join(""));
  } catch (error) {
    operationError = error;
  }
  try {
    fs.rmSync(temporaryRoot, { recursive: true });
  } catch (cleanupError) {
    if (operationError) {
      throw new StageError(
        operationError.stage || 7,
        operationError.stageName || "cleanup",
        formatError(new AggregateError(
          [operationError, cleanupError], "reproof cleanup failed",
        )),
      );
    }
    throw new StageError(7, "publication", cleanupError.message);
  }
  if (operationError) throw operationError;
}

function generate(command) {
  progress(command.silent, 1, "Job setup");
  const request = readRequest(command.requestPath);
  const job = makeJob(request);
  const codex = findCodex();
  const codexVersion = parseCodexVersion(run(1, "Codex identity", [codex, "--version"]));
  let toolPins;
  try {
    toolPins = currentToolPins(repoRoot);
  } catch (error) {
    if (error instanceof StageError) throw error;
    throw new StageError(5, "artifact proof", error.message);
  }
  const proofLibraryCatalog = fs.readFileSync(proofKitCatalogPath, "utf8");
  const kitSources = proofKitSources();
  validateProofImports(job, [...kitSources].map(([module, source]) => ({ module, source })));
  requireKernelAudit(kitSources, toolPins);

  const temporaryRoot = fs.mkdtempSync(path.join(os.tmpdir(), "leanexegen-"));
  let operationError = null;
  try {
    progress(command.silent, 2, "Formal specification");
    const formalWorkspace = path.join(temporaryRoot, "formal-workspace");
    const formalTaskRoot = path.join(temporaryRoot, "formal-codex");
    fs.mkdirSync(formalWorkspace);
    fs.mkdirSync(formalTaskRoot);
    createWorkspace(formalWorkspace);
    const formalContext = formalTaskContext(request, job);
    const formal = runTaskSession({
      task: "formal-specification",
      stage: 2,
      stageName: "formal specification",
      sourceModule: job.formalSpecModule,
      invoke: (prompt) => runCodexOutcome({
        codex,
        task: "formal-specification",
        stage: 2,
        taskRoot: formalTaskRoot,
        contextFiles: formalContext,
        candidateFile: moduleFile(job.formalSpecModule),
        timeout: 45 * 60 * 1000,
        prompt,
      }),
      prompt: formalPrompt(request, job),
      materialize: (source) => formalSpecificationSource(job, source),
      diagnose: (source) => {
        validateProofImports(job, [{ module: job.formalSpecModule, source }]);
        requireKernelAudit(new Map([[job.formalSpecModule, source]]), toolPins);
        return checkFormalSpecification(
          formalWorkspace, job, source, 2, "FormalSpecCheck");
      },
    });
    removeTaskWorkspace(formalWorkspace, 2, "formal specification");
    removeTaskWorkspace(formalTaskRoot, 2, "formal specification");

    progress(command.silent, 3, "Lean program");
    const programWorkspace = path.join(temporaryRoot, "program-workspace");
    const programTaskRoot = path.join(temporaryRoot, "program-codex");
    fs.mkdirSync(programWorkspace);
    fs.mkdirSync(programTaskRoot);
    createWorkspace(programWorkspace);
    runLean(3, "LeanExe compiler build", "15m",
      ["lake", "--no-ansi", "build", "lean-wasm"]);
    const programContext = programTaskContext(request, job, formal.source);
    const programTask = runTaskSession({
      task: "lean-program",
      stage: 3,
      stageName: "Lean program",
      sourceModule: job.sourceModule,
      invoke: (prompt) => runCodexOutcome({
        codex,
        task: "lean-program",
        stage: 3,
        taskRoot: programTaskRoot,
        contextFiles: programContext,
        candidateFile: moduleFile(job.sourceModule),
        timeout: 60 * 60 * 1000,
        prompt,
      }),
      prompt: programPrompt(request, job),
      materialize: (source) => source,
      diagnose: (source) => {
        validateProgramImports(job, source);
        requireKernelAudit(new Map([[job.sourceModule, source]]), toolPins);
        return checkProgramCandidate(programWorkspace, job, source);
      },
    });

    progress(command.silent, 4, "WASM compilation and freezing");
    const compiledWasm = path.join(programWorkspace, "program.wasm");
    const compiledWat = path.join(programWorkspace, "program.wat");
    runLean(4, "WASM compilation", "10m", [
      "lake", "-d", programWorkspace, "env", compiler,
      "compile", "--module", job.sourceModule, "--entry", job.sourceEntry,
      "--out", compiledWasm,
    ]);
    const wasmTools = findWasmTools();
    run(4, "wasm-tools version", [path.join(repoRoot, "tools", "check-wasm-tools-version.sh")], {
      env: { ...process.env, WASM_TOOLS: wasmTools },
    });
    run(4, "WAT rendering", [wasmTools, "print", compiledWasm, "-o", compiledWat]);
    const artifactRoot = path.join(temporaryRoot, "frozen-artifact");
    fs.mkdirSync(artifactRoot);
    const wasm = path.join(artifactRoot, "program.wasm");
    const wat = path.join(artifactRoot, "program.wat");
    fs.copyFileSync(compiledWasm, wasm, fs.constants.COPYFILE_EXCL);
    fs.copyFileSync(compiledWat, wat, fs.constants.COPYFILE_EXCL);
    const wasmBytes = fs.readFileSync(wasm);
    removeTaskWorkspace(programWorkspace, 4, "WASM compilation");
    removeTaskWorkspace(programTaskRoot, 4, "WASM compilation");

    progress(command.silent, 5, "Direct artifact proof");
    requireMaterializedPins(toolPins);
    const proofWorkspace = path.join(temporaryRoot, "proof-workspace");
    const proofTaskRoot = path.join(temporaryRoot, "proof-codex");
    const talosRoot = path.join(temporaryRoot, "talos");
    fs.mkdirSync(proofWorkspace);
    fs.mkdirSync(proofTaskRoot);
    fs.mkdirSync(talosRoot);
    createWorkspace(proofWorkspace);
    const talosProgram = emitTalosProgram(job, wasm, wat, talosRoot);
    const entryIndex = programExportIndex(talosProgram, job.exportName);
    const raw = dumpRawModule(wasm);
    const generated = artifactSources(job, wasmBytes, raw, talosProgram);
    requireKernelAudit(generated.sources, toolPins);
    installSources(proofWorkspace, new Map([
      [job.formalSpecModule, formal.source],
      ...generated.sources,
    ]));
    checkFormalSpecification(
      proofWorkspace, job, formal.source, 5, "ProofFormalSpecCheck");
    const proofContext = proofTaskContext(
      request, job, formal.source, generated.sources);
    const proof = runTaskSession({
      task: "artifact-proof",
      stage: 5,
      stageName: "artifact proof",
      sourceModule: job.behaviorModule,
      invoke: (prompt) => runCodexOutcome({
        codex,
        task: "artifact-proof",
        stage: 5,
        taskRoot: proofTaskRoot,
        contextFiles: proofContext,
        candidateFile: moduleFile(job.behaviorModule),
        timeout: 2 * 60 * 60 * 1000,
        prompt,
      }),
      prompt: proofPrompt(request, job, entryIndex),
      materialize: (source) => source,
      diagnose: (source) => {
        validateProofImports(job, [{ module: job.behaviorModule, source }]);
        requireKernelAudit(new Map([[job.behaviorModule, source]]), toolPins);
        installSources(proofWorkspace, new Map([[job.behaviorModule, source]]));
        checkProof(proofWorkspace, job, generated.artifact, wasm, toolPins);
        return `Lean accepted ${job.behaviorTheorem} and ` +
          `${generated.artifact.artifactTheorem}.`;
      },
    });

    progress(command.silent, 6, "Sample execution");
    const sampleResult = runSamples(
      programTask.outcome.samples, job.exportName, wasm, toolPins);
    progress(command.silent, 7, "Publication");
    const packagePath = proofPackagePath(command.outputPath);
    const allSources = new Map([
      [job.formalSpecModule, formal.source],
      [job.sourceModule, programTask.source],
      [job.behaviorModule, proof.source],
    ]);
    for (const [moduleName, source] of generated.sources) allSources.set(moduleName, source);
    const artifact = {
      ...generated.artifact,
      export: job.exportName,
      invocation: [
        sampleResult.wasmtime,
        "run",
        "--invoke",
        job.exportName,
        "<program.wasm>",
        ...programTask.outcome.samples[0].arguments.map(
          (_, index) => `<argument-${index + 1}>`),
      ],
    };
    const stageReports = {
      schemaVersion: 1,
      codexVersion,
      maximumAttempts: maximumTaskSessions,
      tasks: {
        formalSpecification: formal.stageReport,
        leanProgram: programTask.stageReport,
        artifactProof: proof.stageReport,
      },
    };
    publish(command.outputPath, packagePath, wasmBytes, (stageRoot) => {
      createPackage(stageRoot, {
        request,
        interpretation: {
          formalSpecification: {
            summary: formal.outcome.summary,
            decisions: formal.outcome.decisions,
          },
          leanProgram: {
            summary: programTask.outcome.summary,
            decisions: programTask.outcome.decisions,
          },
          artifactProof: {
            summary: proof.outcome.summary,
            decisions: proof.outcome.decisions,
          },
        },
        artifact,
        samples: sampleResult.samples,
        hostAssumptions: formal.outcome.hostAssumptions,
        stageReports,
        toolPins,
        proofLibraryCatalog,
        wasmBytes,
        sources: allSources,
        job,
        formalSpecification: {
          module: job.formalSpecModule,
          definition: job.formalSpecDefinition,
          type: job.formalSpecType,
        },
        warnings,
      });
    });
    const invocation = [...sampleResult.samples[0].invocation];
    invocation[4] = command.outputPath;
    progress(command.silent, 8, "Results");
    process.stdout.write(generationResult(command.silent, sampleResult.samples, invocation));
    process.stderr.write(warnings.map((warning) => `leanexegen: warning: ${warning}\n`).join(""));
  } catch (error) {
    operationError = error;
  }
  const cleanupErrors = [];
  try {
    fs.rmSync(temporaryRoot, { recursive: true });
  } catch (error) {
    cleanupErrors.push(error);
  }
  if (operationError && cleanupErrors.length > 0) {
    throw new StageError(
      operationError.stage || 7,
      operationError.stageName || "cleanup",
      formatError(new AggregateError(
        [operationError, ...cleanupErrors], "operation cleanup failed",
      )),
    );
  }
  if (operationError) throw operationError;
  if (cleanupErrors.length > 0) {
    throw new StageError(
      7,
      "publication",
      formatError(new AggregateError(
        cleanupErrors, "temporary-directory cleanup failed",
      )),
    );
  }
}

function main() {
  let command;
  try {
    command = parseArgs(process.argv.slice(2));
  } catch (error) {
    process.stderr.write(`${error.message}\n`);
    process.exitCode = 64;
    return;
  }
  try {
    if (command.command === "verify") verify(command);
    else if (command.command === "reprove") reprove(command);
    else generate(command);
  } catch (error) {
    if (error instanceof StageError) {
      process.stderr.write(
        `leanexegen: stage ${error.stage} (${error.stageName}): ${error.message}\n`,
      );
      process.exitCode = error.stage;
      return;
    }
    process.stderr.write(`leanexegen: internal error: ${error.message}\n`);
    process.exitCode = 70;
  }
}

if (require.main === module) main();

module.exports = {
  StageError,
  auditAxioms,
  codexCommandArgs,
  codexOutcomeSchema,
  parseCodexVersion,
  formalSpecificationCheckSources,
  formalSpecificationSource,
  formalTaskContext,
  formatCommand,
  generationResult,
  parseArgs,
  publish,
  programPrompt,
  programTaskContext,
  proofPrompt,
  proofPackagePath,
  proofTaskContext,
  readPackageSources,
  requireFrozenProofKitIsolation,
  reprovePinsMatch,
  reproveSourceSets,
  fromWasmtimeI64,
  runCodexOutcome,
  runTaskSession,
  stageHeading,
  toWasmtimeI64,
  verificationCheckSources,
  warnings,
};
