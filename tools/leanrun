#!/bin/sh
set -eu

script_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
repo_root="$(CDPATH= cd -- "$script_dir/.." && pwd)"
toolchain_name="$(sed -n '1p' "$repo_root/lean-toolchain")"
toolchain_key="$(printf '%s' "$toolchain_name" | sed 's,/,--,g; s,:,---,g')"
elan_root="${ELAN_HOME:-$HOME/.elan}"
toolchain="${LEANRUN_TOOLCHAIN:-$elan_root/toolchains/$toolchain_key}"
run_timeout="${LEANRUN_TIMEOUT:-900}"
lock_timeout="${LEANRUN_LOCK_TIMEOUT:-900}"
lock_timeout_set="${LEANRUN_LOCK_TIMEOUT+x}"
lock_dir="${LEANRUN_LOCKDIR:-${VQ_LOCKDIR:-${TMPDIR:-/tmp}/vq-leanrun.$(id -u)}}"
cache_dir="${LEANRUN_CACHE_HOME:-$repo_root/.lake/cache}"
local_mode="${LEANRUN_LOCAL:-0}"

usage() {
  echo "usage: tools/leanrun [--timeout DURATION] [--lock-timeout SECONDS] [--toolchain DIR] <command> [args]" >&2
  exit 2
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --timeout)
      [ "$#" -ge 2 ] || usage
      run_timeout="$2"
      shift 2
      ;;
    --lock-timeout)
      [ "$#" -ge 2 ] || usage
      lock_timeout="$2"
      lock_timeout_set=x
      shift 2
      ;;
    --toolchain)
      [ "$#" -ge 2 ] || usage
      toolchain="$2"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    -*)
      usage
      ;;
    *)
      break
      ;;
  esac
done

if [ "$#" -eq 0 ]; then
  usage
fi

case "$lock_timeout" in
  ''|*[!0-9]*)
    echo "leanrun: --lock-timeout must be a nonnegative integer" >&2
    exit 2
    ;;
esac

if [ -z "$run_timeout" ]; then
  echo "leanrun: --timeout must not be empty" >&2
  exit 2
fi

case "$local_mode" in
  0|1)
    ;;
  *)
    echo "leanrun: LEANRUN_LOCAL must be 0 or 1" >&2
    exit 2
    ;;
esac

if [ "$local_mode" = "0" ] && [ "$lock_timeout_set" = x ]; then
  echo "leanrun: --lock-timeout applies only to local mode; standard mode waits for the shared slot" >&2
  exit 2
fi

if [ "${LEANRUN_LOCAL_IN_SCOPE:-0}" = "1" ]; then
  echo "leanrun: nested tools/leanrun is not supported in LEANRUN_LOCAL mode (LEANRUN_LOCAL=1); invoke the repository driver directly" >&2
  exit 1
fi

if [ ! -x "$toolchain/bin/lean" ]; then
  echo "leanrun: no Lean toolchain at $toolchain" >&2
  exit 2
fi

PATH="$toolchain/bin:$PATH"
LEAN_NUM_THREADS=1
NO_COLOR=1
XDG_CACHE_HOME="$cache_dir"
mkdir -p "$XDG_CACHE_HOME"
export PATH LEAN_NUM_THREADS NO_COLOR XDG_CACHE_HOME

if [ "${LEANRUN_IN_SCOPE:-}" = "1" ]; then
  cgroup_path="$(sed -n 's/^0:://p' /proc/self/cgroup)"
  case "$cgroup_path" in
    */leanrun.slice/*) ;;
    *)
      echo "leanrun: inherited scope must belong to leanrun.slice" >&2
      exit 1
      ;;
  esac
  cgroup_dir="/sys/fs/cgroup$cgroup_path"
  if [ ! -d "$cgroup_dir" ] ||
     [ "$(cat "$cgroup_dir/memory.high")" != "4294967296" ] ||
     [ "$(cat "$cgroup_dir/memory.max")" != "6442450944" ] ||
     [ "$(cat "$cgroup_dir/memory.swap.max")" != "1073741824" ] ||
     [ "$(cat "$cgroup_dir/cpu.max")" != "100000 100000" ] ||
     [ "$(cat "$cgroup_dir/pids.max")" != "512" ]; then
    echo "leanrun: inherited scope does not have the required resource limits" >&2
    exit 1
  fi
  exec ionice -c 3 timeout "$run_timeout" "$@"
fi

if [ "$(uname -s)" = "Darwin" ]; then
  if [ "$local_mode" != "1" ]; then
    echo "leanrun: macOS requires explicit LEANRUN_LOCAL=1; systemd cgroups are unavailable" >&2
    exit 2
  fi
  helper_hash="$(shasum -a 256 "$script_dir/leanrun-macos.c")"
  helper="$cache_dir/leanrun-macos-${helper_hash%% *}"
  if [ ! -x "$helper" ]; then
    staging="$(mktemp -d "$cache_dir/leanrun-macos-build.XXXXXX")"
    cc -std=c11 -Wall -Wextra -Werror -O2 "$script_dir/leanrun-macos.c" -o "$staging/runner"
    # Publish without overwriting an existing helper; retain staging as local state.
    if ! ln "$staging/runner" "$helper"; then
      [ -x "$helper" ] || exit 2
    fi
  fi
  mkdir -p "$lock_dir"
  echo "leanrun: LEANRUN_LOCAL=1; macOS has no cgroup CPU/memory/swap limits or ionice" >&2
  exec "$helper" "$lock_dir/1" "$lock_timeout" "$run_timeout" "$@"
fi

if [ "$local_mode" = "1" ]; then
  mkdir -p "$lock_dir"
  exec 9>"$lock_dir/1"
  if ! flock -w "$lock_timeout" 9; then
    echo "leanrun: timed out waiting for the machine-wide Lean slot" >&2
    exit 75
  fi
  echo "leanrun: LEANRUN_LOCAL=1; cgroup CPU, memory, and swap limits are not enforced" >&2
  exec env LEANRUN_LOCAL_IN_SCOPE=1 nice -n 10 ionice -c 3 \
    timeout "$run_timeout" "$@"
fi

case "$run_timeout" in
  *s) duration="${run_timeout%s}"; multiplier=1 ;;
  *m) duration="${run_timeout%m}"; multiplier=60 ;;
  *h) duration="${run_timeout%h}"; multiplier=3600 ;;
  *d) duration="${run_timeout%d}"; multiplier=86400 ;;
  *) duration="$run_timeout"; multiplier=1 ;;
esac
case "$duration" in
  ''|*[!0-9]*)
    echo "leanrun: standard-mode timeout requires a positive integer with optional s, m, h, or d suffix" >&2
    exit 2
    ;;
esac
duration="$(printf '%s' "$duration" | sed 's/^0*//')"
if [ -z "$duration" ] || [ "${#duration}" -gt 9 ]; then
  echo "leanrun: standard-mode timeout is outside the supported range" >&2
  exit 2
fi
timeout_seconds=$((duration * multiplier))
if [ "$timeout_seconds" -gt 2147483647 ]; then
  echo "leanrun: standard-mode timeout exceeds 2147483647 seconds" >&2
  exit 2
fi
runner="${LEANRUN_RUNNER:-$HOME/src/leanrunner/leanrun}"
if [ ! -x "$runner" ]; then
  echo "leanrun: installed runner not found at $runner; set LEANRUN_RUNNER" >&2
  exit 2
fi

exec env LEANRUN_TOOLCHAIN="$toolchain" LEANRUN_TIMEOUT="$timeout_seconds" \
  LEANRUN_MEMORY_HIGH=4G LEANRUN_MEMORY_MAX=6G LEANRUN_SWAP_MAX=1G \
  LEANRUN_CPU_QUOTA=100% LEANRUN_TASKS_MAX=512 LEANRUN_NICE=10 LEANRUN_JOBS=1 \
  "$runner" env LEANRUN_IN_SCOPE=1 \
  timeout "$run_timeout" "$@"
