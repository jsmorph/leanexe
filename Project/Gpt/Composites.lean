    (fun store state => store = initial ∧ state = start) _
  -- The first layer norm.
  refine Stmt.seq_spec (Live.call layerNormRows_implements rfl hNorm rfl (Live.start hHeap) hRoom
    (x := (x, g1, b1, t, nh * dh, eps))
