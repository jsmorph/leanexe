      rfl, ⟨pB1, rfl, hB1⟩, rfl⟩
    (by rw [hStart]; decide)) ?_
  apply Triple.of_forall
  rintro store1 t1 ⟨heap1, ph1, hLive1, rfl⟩
  let s1 := start.update 22 (.i64 ph1)
  have hS1 : s1.params.length + s1.locals.length = 29 := by rw [hLen, hStart]
  -- Attention.
