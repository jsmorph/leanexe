      .get 16⟩, ⟨.u64, .get 17⟩, ⟨.u64, .bin .mul (.get 18) (.get 19)⟩, ⟨.u64,
      .get 20⟩] [26])
    (.seq (.call 10 [⟨.u64, .get 24⟩, ⟨.u64, .get 26⟩] [27])
    (.seq (.assign 28 (.get 27))
