              (∀ (locals : List ScalarBinding) (declName : Lean.Name) (type value body : Lean.Expr) (nondep : Bool)
                  (val : LeanExe.Source.Scalar.ResultType),
                  scalarResultType? type = some val →
                    (∀ (result : LeanExe.IR.Expr), motive (ScalarBinding.word result :: locals) body) →
                      motive locals (Lean.Expr.letE declName type value body nondep)) →
                (∀ (locals : List ScalarBinding) (declName : Lean.Name) (type value body : Lean.Expr) (nondep : Bool),
                    scalarResultType? type = none →
                      (∀ (result : LeanExe.IR.Expr), motive (ScalarBinding.boolean result :: locals) body) →
                        motive locals (Lean.Expr.letE declName type value body nondep)) →
                  (∀ (locals : List ScalarBinding) (x : Lean.Expr),
                      (∀ (value : Lean.Expr),
                          x =
                              ((Lean.Expr.const `ForInStep.yield [Lean.Level.zero]).app (Lean.Expr.const `Bool [])).app
                                value →
                            False) →
                        (∀ (value : Lean.Expr),
                            x =
                                ((Lean.Expr.const `ForInStep.done [Lean.Level.zero]).app (Lean.Expr.const `Bool [])).app
                                  value →
                              False) →
                          (∀ (type body : Lean.Expr),
                              x = ((Lean.Expr.const `Id.run [Lean.Level.zero]).app type).app body → False) →
                            (∀ (type body : Lean.Expr),
                                x =
                                    ((((Lean.Expr.const `Pure.pure [Lean.Level.zero, Lean.Level.zero]).app
                                                  (Lean.Expr.const `Id [Lean.Level.zero])).app
                                              (((Lean.Expr.const `Applicative.toPure
                                                        [Lean.Level.zero, Lean.Level.zero]).app
                                                    (Lean.Expr.const `Id [Lean.Level.zero])).app
                                                (((Lean.Expr.const `Monad.toApplicative
                                                          [Lean.Level.zero, Lean.Level.zero]).app
                                                      (Lean.Expr.const `Id [Lean.Level.zero])).app
                                                  (Lean.Expr.const `Id.instMonad [Lean.Level.zero])))).app
                                          type).app
                                      body →
                                  False) →
                              (∀ (data : Lean.MData) (body : Lean.Expr), x = Lean.Expr.mdata data body → False) →
                                (∀ (type condition evidence yes no : Lean.Expr),
                                    x =
                                        (((((Lean.Expr.const `ite [Lean.Level.zero.succ]).app type).app condition).app
