                                              yes).app
                                          no →
                                      False) →
                                  (∀ (declName : Lean.Name) (type value body : Lean.Expr) (nondep : Bool),
                                      x = Lean.Expr.letE declName type value body nondep → False) →
                                    motive locals x) →
                    ∀ (locals : List ScalarBinding) (a : Lean.Expr), motive locals a :=
id fun motive case1 case2 case3 case4 case5 case6 case7 case8 case9 locals a =>
  extractBooleanStepWith._unary.induct (fun _x => PSigma.casesOn _x fun locals a => motive locals a) case1 case2 case3
