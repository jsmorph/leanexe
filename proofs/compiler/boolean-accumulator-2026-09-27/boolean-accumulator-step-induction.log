theorem LeanExe.Extract.Core.extractBooleanStepWith.induct : ∀ (motive : List ScalarBinding → Lean.Expr → Prop),
  (∀ (locals : List ScalarBinding) (value : Lean.Expr),
      motive locals (((Lean.Expr.const `ForInStep.yield [Lean.Level.zero]).app (Lean.Expr.const `Bool [])).app value)) →
    (∀ (locals : List ScalarBinding) (value : Lean.Expr),
        motive locals
          (((Lean.Expr.const `ForInStep.done [Lean.Level.zero]).app (Lean.Expr.const `Bool [])).app value)) →
      (∀ (locals : List ScalarBinding) (type body : Lean.Expr),
          motive locals body → motive locals (((Lean.Expr.const `Id.run [Lean.Level.zero]).app type).app body)) →
        (∀ (locals : List ScalarBinding) (type body : Lean.Expr),
            motive locals body →
              motive locals
                (((((Lean.Expr.const `Pure.pure [Lean.Level.zero, Lean.Level.zero]).app
                              (Lean.Expr.const `Id [Lean.Level.zero])).app
                          (((Lean.Expr.const `Applicative.toPure [Lean.Level.zero, Lean.Level.zero]).app
                                (Lean.Expr.const `Id [Lean.Level.zero])).app
                            (((Lean.Expr.const `Monad.toApplicative [Lean.Level.zero, Lean.Level.zero]).app
                                  (Lean.Expr.const `Id [Lean.Level.zero])).app
                              (Lean.Expr.const `Id.instMonad [Lean.Level.zero])))).app
                      type).app
                  body)) →
          (∀ (locals : List ScalarBinding) (data : Lean.MData) (body : Lean.Expr),
              motive locals body → motive locals (Lean.Expr.mdata data body)) →
            (∀ (locals : List ScalarBinding) (type condition evidence yes no : Lean.Expr),
                motive locals yes →
                  motive locals no →
                    motive locals
                      ((((((Lean.Expr.const `ite [Lean.Level.zero.succ]).app type).app condition).app evidence).app
                            yes).app
