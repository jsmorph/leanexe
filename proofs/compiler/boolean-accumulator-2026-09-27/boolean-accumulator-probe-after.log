BooleanAccumulatorProbe.toggle: fun count seed =>
  @Id.run Bool
    (have flag :=
      @BEq.beq UInt64 (@instBEqOfDecidableEq UInt64 instDecidableEqUInt64) seed
        (@OfNat.ofNat UInt64 (nat_lit 0) (@UInt64.instOfNat (nat_lit 0)));
    @bind Id (@Monad.toBind Id Id.instMonad) Bool Bool
      (@forIn Id Std.Legacy.Range Nat
        (@instForInOfForIn' Id Std.Legacy.Range Nat
          (@inferInstance (Membership Nat Std.Legacy.Range) Std.Legacy.instMembershipNatRange)
          (@Std.Legacy.Range.instForIn'NatInferInstanceMembershipOfMonad Id Id.instMonad))
        Bool [:count.toNat] flag fun x __s =>
        have flag := __s;
        have flag := flag.not;
        @pure Id (@Applicative.toPure Id (@Monad.toApplicative Id Id.instMonad)) (ForInStep Bool)
          (@ForInStep.yield Bool flag))
      fun __s =>
      have flag := __s;
      @pure Id (@Applicative.toPure Id (@Monad.toApplicative Id Id.instMonad)) Bool flag)
BooleanAccumulatorProbe.earlyExit: fun count seed =>
  @Id.run Bool
    (have flag :=
      @BEq.beq UInt64 (@instBEqOfDecidableEq UInt64 instDecidableEqUInt64) seed
        (@OfNat.ofNat UInt64 (nat_lit 0) (@UInt64.instOfNat (nat_lit 0)));
    @bind Id (@Monad.toBind Id Id.instMonad) Bool Bool
      (@forIn Id Std.Legacy.Range Nat
        (@instForInOfForIn' Id Std.Legacy.Range Nat
          (@inferInstance (Membership Nat Std.Legacy.Range) Std.Legacy.instMembershipNatRange)
          (@Std.Legacy.Range.instForIn'NatInferInstanceMembershipOfMonad Id Id.instMonad))
        Bool [:count.toNat] flag fun i __s =>
        have flag := __s;
        have flag :=
          @bne Bool (@instBEqOfDecidableEq Bool instDecidableEqBool) flag
            (@BEq.beq UInt64 (@instBEqOfDecidableEq UInt64 instDecidableEqUInt64) i.toUInt64 seed);
        @ite (Id (ForInStep Bool)) (@Eq Bool flag true) (instDecidableEqBool flag true)
          (@pure Id (@Applicative.toPure Id (@Monad.toApplicative Id Id.instMonad)) (ForInStep Bool)
            (@ForInStep.done Bool flag))
          (@pure Id (@Applicative.toPure Id (@Monad.toApplicative Id Id.instMonad)) (ForInStep Bool)
            (@ForInStep.yield Bool flag)))
      fun __s =>
      have flag := __s;
      @pure Id (@Applicative.toPure Id (@Monad.toApplicative Id Id.instMonad)) Bool flag)
