constructor LeanExe.Source.Scalar.Step.Eval.chooseScope : ∀ {flag : Bool} {t e : Lean.Expr}
  {values : List LeanExe.Source.Scalar.Step.Value} {value : ForInStep UInt64}
  (guard : LeanExe.Source.Scalar.BooleanScopeGuard) (type : LeanExe.Source.Scalar.Step.ResultAnnotation),
  LeanExe.Source.Scalar.EvalWith guard.operand (List.map LeanExe.Source.Scalar.Step.Value.toScalar values)
      flag.toUInt64 →
    LeanExe.Source.Scalar.Step.Eval (if flag = true then t else e) values value →
      LeanExe.Source.Scalar.Step.Eval (guard.branch (LeanExe.Source.Scalar.Step.resultType type) t e) values value
